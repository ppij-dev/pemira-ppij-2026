{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ppij-election-system",
  // The adapter's unified entrypoint handles astro dev and production deploys.
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Non-secret environment variables. Configuration in wrangler.jsonc is the
  // source of truth for Workers Builds: edit these values in your repository
  // fork and commit them. Editing them in the Cloudflare dashboard will be
  // overwritten on subsequent deployments.
  "vars": {
    "ONELOGIN_ISSUER": "https://sso.ppijepang.app/realms/ppij",
    "ONELOGIN_CLIENT_ID": "election-client",
    "SERVICE_API_URL": "https://service-api.example",
    "SERVICE_API_CLIENT_ID": "election-service",
    "SITE_SCOPE": "/ppij/okayama",
    "SITE_BASE_URL": "https://pemilihan.example.org",
    "SITE_NAME": "Pemilihan PPI Jepang",
    "SITE_LOGO_PATH": "/logo.svg"
  },
  // Placeholder values: the Deploy to Cloudflare button provisions the D1
  // database and R2 bucket and rewrites the IDs in the cloned repository.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ppij-election",
      "database_id": "placeholder-provisioned-by-deploy-button",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "ppij-election-media"
    }
  ]
}
