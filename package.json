{
  "name": "ppij-election-system",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro sync && astro check && tsc --noEmit",
    "test": "vitest run",
    "bootstrap": "node scripts/bootstrap.mjs",
    "recovery-invite": "node scripts/recovery-invite.mjs",
    "provision:oidc-test": "node scripts/provision-election-test.mjs",
    "e2e": "playwright test",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "cloudflare": {
    "bindings": {
      "APP_MASTER_KEY": {
        "description": "Kunci master AES-256-GCM untuk mengenkripsi rahasia di D1. Buat dengan `openssl rand -base64 32`."
      }
    }
  },
  "dependencies": {
    "@astrojs/cloudflare": "~14.3.0",
    "@tabler/icons-astro": "^3.49.0",
    "astro": "~7.3.0",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@cloudflare/workers-types": "^5.20261018.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.151.1"
  }
}
