---
import "../styles/global.css";
import { env } from "cloudflare:workers";
import { getSiteLogo } from "../server/lib/logo";
import { SESSION_COOKIE, isAdminPageAuthorized, type AdminBindings } from "../pages/admin/admin-auth";
const cookie = Astro.cookies.get(SESSION_COOKIE)?.value;
const bindings = env as unknown as AdminBindings;
const authorized = await isAdminPageAuthorized(cookie, bindings);
if (!authorized) Astro.response.status = 403;
const title = Astro.props.title ?? "Admin Voting";
let configuredLogo: string | undefined;
if (authorized && bindings.DB) {
  try {
    configuredLogo = (await bindings.DB.prepare("SELECT value FROM system_config WHERE key = 'site_logo_path'").first<{ value: string }>())?.value;
  } catch { /* The bundled logo remains available. */ }
}
const logo = getSiteLogo(configuredLogo);
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Administrasi pemilihan PPI Jepang." />
    <title>{title} · PPIJ Pemilu</title>
    <link rel="icon" href={logo.src} type={logo.faviconType} />
    <link rel="preload" href="/fonts/plus-jakarta-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="min-h-dvh bg-background text-foreground antialiased">
    <header class="border-b border-border bg-card">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-4 py-3">
        <a href="/admin" class="inline-flex min-h-11 items-center gap-2 font-semibold tracking-tight text-foreground"><img src={logo.src} alt="" class="h-8 w-auto max-w-12 object-contain" />PPIJ Pemilu · Admin</a>
        <nav aria-label="Navigasi admin" class="flex flex-wrap gap-1 sm:gap-2">
          <a href="/admin" class="inline-flex min-h-11 items-center rounded-lg px-3 font-medium text-muted-foreground hover:bg-accent focus-visible:outline-2 focus-visible:outline-ring">Panitia</a>
          <a href="/admin/pemilih" class="inline-flex min-h-11 items-center rounded-lg px-3 font-medium text-muted-foreground hover:bg-accent focus-visible:outline-2 focus-visible:outline-ring">Pemilih</a>
          <a href="/admin/kandidat" class="inline-flex min-h-11 items-center rounded-lg px-3 font-medium text-muted-foreground hover:bg-accent focus-visible:outline-2 focus-visible:outline-ring">Kandidat</a>
          <a href="/admin/pemilihan" class="inline-flex min-h-11 items-center rounded-lg px-3 font-medium text-muted-foreground hover:bg-accent focus-visible:outline-2 focus-visible:outline-ring">Pemilihan</a>
          <a href="/" class="inline-flex min-h-11 items-center rounded-lg border border-border px-3 font-medium text-foreground hover:bg-accent focus-visible:outline-2 focus-visible:outline-ring">Mode Pemilih</a>
        </nav>
      </div>
    </header>
    <main class="mx-auto w-full max-w-5xl px-4 py-6 sm:py-8">
      {authorized ? <slot /> : <section class="rounded-xl border border-border bg-card p-6 shadow-sm sm:p-8"><h1 class="text-xl font-bold">Akses khusus Admin Voting</h1><p class="mt-2 text-muted-foreground">Anda tidak memiliki akses ke halaman ini.</p></section>}
    </main>
  </body>
</html>
