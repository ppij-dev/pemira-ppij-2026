---
import "../styles/global.css";
import { env } from "cloudflare:workers";
import { SESSION_COOKIE, isAdminPageAuthorized, type AdminBindings } from "../pages/admin/admin-auth";
const cookie = Astro.cookies.get(SESSION_COOKIE)?.value;
const bindings = env as unknown as AdminBindings;
const authorized = await isAdminPageAuthorized(cookie, bindings);
if (!authorized) Astro.response.status = 403;
const title = Astro.props.title ?? "Admin Voting";
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Administrasi pemilihan PPI Jepang." />
    <title>{title} · PPIJ Pemilu</title>
  </head>
  <body class="min-h-dvh bg-slate-50 text-slate-900 antialiased">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-4 py-3">
        <a href="/admin" class="inline-flex min-h-11 items-center font-semibold tracking-tight text-slate-900">PPIJ Pemilu · Admin</a>
        <nav aria-label="Navigasi admin" class="flex flex-wrap gap-1 sm:gap-2">
          <a href="/admin" class="inline-flex min-h-11 items-center rounded-lg px-3 font-medium text-slate-700 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-brand-600">Panitia</a>
          <a href="/admin/pemilih" class="inline-flex min-h-11 items-center rounded-lg px-3 font-medium text-slate-700 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-brand-600">Pemilih</a>
          <a href="/admin/kandidat" class="inline-flex min-h-11 items-center rounded-lg px-3 font-medium text-slate-700 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-brand-600">Kandidat</a>
          <a href="/admin/pemilihan" class="inline-flex min-h-11 items-center rounded-lg px-3 font-medium text-slate-700 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-brand-600">Pemilihan</a>
          <a href="/" class="inline-flex min-h-11 items-center rounded-lg border border-slate-300 px-3 font-medium text-slate-700 hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-brand-600">Mode Pemilih</a>
        </nav>
      </div>
    </header>
    <main class="mx-auto w-full max-w-5xl px-4 py-6 sm:py-8">
      {authorized ? <slot /> : <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8"><h1 class="text-xl font-bold">Akses khusus Admin Voting</h1><p class="mt-2 text-slate-600">Anda tidak memiliki akses ke halaman ini.</p></section>}
    </main>
  </body>
</html>
