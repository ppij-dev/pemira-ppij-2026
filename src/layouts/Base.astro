---
import "../styles/global.css";
import { IconHome2, IconRosetteDiscountCheck, IconSpeakerphone, IconUsers } from "@tabler/icons-astro";
import { env } from "cloudflare:workers";
import { getSiteLogo } from "../server/lib/logo";
import { SESSION_COOKIE, openSession, type SessionData } from "../server/auth/session";

interface Props {
  title: string;
  description?: string;
  siteName?: string;
  siteLogoPath?: string;
  showHasil?: boolean;
  /** "white" mengganti kanvas halaman dari abu-abu hangat menjadi putih. */
  canvas?: "default" | "white";
}

const {
  title,
  description = "Portal pemilihan PPI Jepang: rahasia, satu suara per anggota, dan bisa diverifikasi.",
  siteName: providedSiteName,
  siteLogoPath,
  showHasil,
  canvas = "default",
} = Astro.props;
const db = (env as unknown as { DB?: D1Database }).DB;
let siteName = providedSiteName;
if (!siteName && db) {
  try {
    const row = await db.prepare("SELECT value FROM system_config WHERE key = 'site_name'").first<{ value: string }>();
    siteName = row?.value;
  } catch {
    // A fresh instance can render before system_config is available.
  }
}
siteName ||= "PPIJ Pemilu";

let rawLogoPath: string | null | undefined = siteLogoPath;
if (rawLogoPath === undefined && db) {
  try {
    const row = await db.prepare("SELECT value FROM system_config WHERE key = 'site_logo_path'").first<{ value: string }>();
    rawLogoPath = row?.value;
  } catch {
    rawLogoPath = null;
  }
}
const logo = getSiteLogo(rawLogoPath);
const rawSessionCookie = Astro.cookies.get(SESSION_COOKIE)?.value;
const session: SessionData | null =
  rawSessionCookie && (env as unknown as { APP_MASTER_KEY?: string }).APP_MASTER_KEY
    ? await openSession(rawSessionCookie, ((env as unknown as { APP_MASTER_KEY?: string }).APP_MASTER_KEY)!)
    : null;
const accountInitial = (session?.name ?? "").trim().charAt(0).toUpperCase() || "?";
// Percobaan masuk yang tidak menghasilkan sesi = peramban menolak cookie.
const loginRetry = !session && Astro.url.searchParams.has("masuk");
const election = await db?.prepare("SELECT status_lock FROM elections ORDER BY id LIMIT 1").first<{ status_lock: string }>();
const showResultsTab = showHasil ?? election?.status_lock === "published";
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <link rel="icon" href={logo.src} type={logo.faviconType} />
    <link rel="preload" href="/fonts/plus-jakarta-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class:list={["min-h-dvh text-foreground antialiased", canvas === "white" ? "bg-white" : "bg-background"]}>
    <header class="sticky top-0 z-20 border-b border-border bg-card/95 backdrop-blur">
      <div class="mx-auto flex w-full max-w-3xl items-center justify-between gap-3 px-4 py-3 sm:px-6">
        <a href="/" aria-label={`${siteName} · Beranda`} class="inline-flex min-h-11 min-w-0 items-center gap-3 rounded-md focus-visible:outline-2 focus-visible:outline-ring">
          <img src={logo.src} alt="" class="h-10 w-auto max-w-16 object-contain" />
          <span class="min-w-0 truncate text-base font-semibold tracking-tight sm:text-lg">{siteName}</span>
        </a>
        {session && <a href="/akun" aria-label={`Akun: ${session.name}`} class="flex size-11 shrink-0 items-center justify-center rounded-full border border-border bg-card font-semibold text-foreground transition hover:bg-accent focus-visible:outline-2 focus-visible:outline-ring">{accountInitial}</a>}
      </div>
    </header>
    <main class="mx-auto w-full max-w-3xl px-4 py-8 pb-28 sm:px-6 sm:py-10 sm:pb-32">
      {loginRetry && <section class="mb-6 rounded-xl border border-amber-200 bg-amber-50 p-5 text-amber-900" role="alert">
        <h2 class="text-base font-semibold">Sesi masuk tidak tersimpan</h2>
        <p class="mt-2 text-sm leading-6">Masuk Anda berhasil, tetapi peramban ini menolak menyimpan cookie sesi untuk situs ini. Periksa izin cookie (ikon di bilah alamat → Cookie → izinkan pemira2026.ppijepang.app), matikan sementara ekstensi pemblokir, atau gunakan jendela penjelajahan pribadi, lalu masuk kembali.</p>
        <a href="/api/auth/login" class="mt-4 inline-flex min-h-11 items-center rounded-md bg-primary px-4 font-semibold text-primary-foreground hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-ring">Coba masuk lagi</a>
      </section>}
      <slot />
    </main>
    <nav aria-label="Navigasi pemilih" class="fixed inset-x-0 bottom-0 z-10 border-t border-border bg-card/95 pb-[env(safe-area-inset-bottom)] shadow-[0_-8px_24px_-20px_rgba(28,31,35,0.4)] backdrop-blur">
      <div class={`mx-auto grid w-full max-w-3xl ${showResultsTab ? "grid-cols-5" : "grid-cols-4"}`}>
        <a href="/" aria-current={path === "/" || path === "/papan-bukti" ? "page" : undefined} class:list={["flex min-h-16 flex-col items-center justify-center gap-1 px-1 text-xs font-medium hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-[-3px] focus-visible:outline-ring", path === "/" || path === "/papan-bukti" ? "bg-brand-50 text-brand-800" : "text-muted-foreground hover:text-primary"]}>
          <IconHome2 size={21} stroke={1.8} aria-hidden="true" /><span>Beranda</span>
        </a>
        <a href="/kandidat" aria-current={path.startsWith("/kandidat") ? "page" : undefined} class:list={["flex min-h-16 flex-col items-center justify-center gap-1 px-2 text-xs font-medium hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-[-3px] focus-visible:outline-ring", path.startsWith("/kandidat") ? "bg-brand-50 text-brand-800" : "text-muted-foreground hover:text-primary"]}>
          <IconUsers size={21} stroke={1.8} aria-hidden="true" /><span>Kandidat</span>
        </a>
        <a href="/pilih-suara" aria-current={path === "/pilih-suara" ? "page" : undefined} class:list={["flex min-h-16 flex-col items-center justify-center gap-1 px-2 text-xs font-medium hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-[-3px] focus-visible:outline-ring", path === "/pilih-suara" ? "bg-brand-50 text-brand-800" : "text-muted-foreground hover:text-primary"]}>
          <IconSpeakerphone size={21} stroke={1.8} aria-hidden="true" /><span>Pilih Suara</span>
        </a>
        <a href="/surat-suara" aria-current={path === "/surat-suara" ? "page" : undefined} class:list={["flex min-h-16 flex-col items-center justify-center gap-1 px-1 text-xs font-medium hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-[-3px] focus-visible:outline-ring", path === "/surat-suara" ? "bg-brand-50 text-brand-800" : "text-muted-foreground hover:text-primary"]}>
          <IconRosetteDiscountCheck size={21} stroke={1.8} aria-hidden="true" /><span>Bukti Suara</span>
        </a>
        {showResultsTab && <a href="/hasil" aria-current={path === "/hasil" ? "page" : undefined} class:list={["flex min-h-16 flex-col items-center justify-center gap-1 px-2 text-xs font-medium hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-[-3px] focus-visible:outline-ring", path === "/hasil" ? "bg-brand-50 text-brand-800" : "text-muted-foreground hover:text-primary"]}><IconRosetteDiscountCheck size={21} stroke={1.8} aria-hidden="true" /><span>Hasil</span></a>}
      </div>
    </nav>
  </body>
</html>
