---
import "../styles/global.css";
import { IconShieldCheck } from "@tabler/icons-astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Portal pemilihan PPI Jepang: rahasia, satu suara per anggota, dan bisa diverifikasi." } =
  Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="min-h-dvh bg-slate-50 text-slate-900 antialiased">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex w-full max-w-3xl items-center gap-2 px-4 py-3">
        <IconShieldCheck size={24} class="text-slate-900" aria-hidden="true" />
        <span class="font-semibold tracking-tight">PPIJ Pemilu</span>
      </div>
    </header>
    <main class="mx-auto w-full max-w-3xl px-4 py-10">
      <slot />
    </main>
  </body>
</html>
