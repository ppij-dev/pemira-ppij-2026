---
import "../styles/global.css";
import { IconRosetteDiscountCheck, IconSpeakerphone, IconUsers } from "@tabler/icons-astro";
import { env } from "cloudflare:workers";
import { getSiteLogo } from "../server/lib/logo";

interface Props {
  title: string;
  description?: string;
  siteName?: string;
  siteLogoPath?: string;
  showHasil?: boolean;
}

const {
  title,
  description = "Portal pemilihan PPI Jepang: rahasia, satu suara per anggota, dan bisa diverifikasi.",
  siteName = "PPIJ Pemilu",
  siteLogoPath,
  showHasil,
} = Astro.props;
const db = (env as unknown as { DB?: D1Database }).DB;

let rawLogoPath: string | null | undefined = siteLogoPath;
if (rawLogoPath === undefined && db) {
  try {
    const row = await db.prepare("SELECT value FROM system_config WHERE key = 'site_logo_path'").first<{ value: string }>();
    rawLogoPath = row?.value;
  } catch {
    rawLogoPath = null;
  }
}
const logo = getSiteLogo(rawLogoPath);
const election = await db?.prepare("SELECT status_lock FROM elections ORDER BY id LIMIT 1").first<{ status_lock: string }>();
const showResultsTab = showHasil ?? election?.status_lock === "published";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <link rel="icon" href={logo.src} type={logo.faviconType} />
    <link rel="preload" href="/fonts/plus-jakarta-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="min-h-dvh bg-background text-foreground antialiased">
    <header class="border-b border-border bg-card">
      <div class="mx-auto flex w-full max-w-3xl items-center gap-3 px-4 py-4">
        <img src={logo.src} alt="" class="size-10 rounded-full" />
        <span class="text-lg font-semibold tracking-tight">{siteName}</span>
      </div>
    </header>
    <main class="mx-auto w-full max-w-3xl px-4 py-8 pb-28 sm:py-10 sm:pb-32">
      <slot />
    </main>
    <nav aria-label="Navigasi pemilih" class="fixed inset-x-0 bottom-0 z-10 border-t border-border bg-card/95 pb-[env(safe-area-inset-bottom)] shadow-[0_-8px_24px_-20px_rgba(28,31,35,0.4)] backdrop-blur">
      <div class={`mx-auto grid w-full max-w-3xl ${showResultsTab ? "grid-cols-4" : "grid-cols-3"}`}>
        <a href="/kandidat" class="flex min-h-16 flex-col items-center justify-center gap-1 px-2 text-xs font-medium text-muted-foreground hover:bg-accent hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-[-3px] focus-visible:outline-ring">
          <IconUsers size={21} stroke={1.8} aria-hidden="true" /><span>Kandidat</span>
        </a>
        <a href="/pilih-suara" class="flex min-h-16 flex-col items-center justify-center gap-1 px-2 text-xs font-medium text-muted-foreground hover:bg-accent hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-[-3px] focus-visible:outline-ring">
          <IconSpeakerphone size={21} stroke={1.8} aria-hidden="true" /><span>Pilih Suara</span>
        </a>
        <a href="/surat-suara" class="flex min-h-16 flex-col items-center justify-center gap-1 px-2 text-xs font-medium text-muted-foreground hover:bg-accent hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-[-3px] focus-visible:outline-ring">
          <IconRosetteDiscountCheck size={21} stroke={1.8} aria-hidden="true" /><span>Bukti Suara</span>
        </a>
        {showResultsTab && <a href="/hasil" class="flex min-h-16 flex-col items-center justify-center gap-1 px-2 text-xs font-medium text-muted-foreground hover:bg-accent hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-[-3px] focus-visible:outline-ring"><IconRosetteDiscountCheck size={21} stroke={1.8} aria-hidden="true" /><span>Hasil</span></a>}
      </div>
    </nav>
  </body>
</html>
