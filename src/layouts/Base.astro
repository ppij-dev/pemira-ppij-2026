---
import "../styles/global.css";
import { IconHome2, IconRosetteDiscountCheck, IconSpeakerphone, IconUsers } from "@tabler/icons-astro";
import { env } from "cloudflare:workers";
import BottomBar from "../components/ui/BottomBar.astro";
import Button from "../components/ui/Button.astro";
import { getSiteLogo } from "../server/lib/logo";
import { NEUTRAL_ACCOUNT_NAME, initialsFor, resolveDisplayName } from "../server/lib/displayName";
import { SESSION_COOKIE, openSession, type SessionData } from "../server/auth/session";

interface Props {
  title: string;
  description?: string;
  siteName?: string;
  siteLogoPath?: string;
  showHasil?: boolean;
  /** "white" mengganti kanvas halaman dari abu-abu hangat menjadi putih. */
  canvas?: "default" | "white";
  /** Jalur atau URL gambar pratinjau berbagi (Open Graph). */
  ogImage?: string;
  /** Deskripsi pratinjau berbagi; memakai description halaman bila kosong. */
  ogDescription?: string;
  /** Tipe Open Graph; "profile" untuk halaman kandidat. */
  ogType?: "website" | "article" | "profile";
}

const {
  title,
  description = "Portal pemilihan PPI Jepang: rahasia, satu suara per anggota, dan bisa diverifikasi.",
  siteName: providedSiteName,
  siteLogoPath,
  showHasil,
  canvas = "default",
  ogImage,
  ogDescription,
  ogType = "website",
} = Astro.props;
const db = (env as unknown as { DB?: D1Database }).DB;
let siteName = providedSiteName;
if (!siteName && db) {
  try {
    const row = await db.prepare("SELECT value FROM system_config WHERE key = 'site_name'").first<{ value: string }>();
    siteName = row?.value;
  } catch {
    // A fresh instance can render before system_config is available.
  }
}
siteName ||= "PPIJ Pemilu";

let rawLogoPath: string | null | undefined = siteLogoPath;
if (rawLogoPath === undefined && db) {
  try {
    const row = await db.prepare("SELECT value FROM system_config WHERE key = 'site_logo_path'").first<{ value: string }>();
    rawLogoPath = row?.value;
  } catch {
    rawLogoPath = null;
  }
}
const logo = getSiteLogo(rawLogoPath);
const rawSessionCookie = Astro.request.headers.get("cookie") ?? Astro.cookies.get(SESSION_COOKIE)?.value;
const session: SessionData | null =
  rawSessionCookie && (env as unknown as { APP_MASTER_KEY?: string }).APP_MASTER_KEY
    ? await openSession(rawSessionCookie, ((env as unknown as { APP_MASTER_KEY?: string }).APP_MASTER_KEY)!)
    : null;
// Nama akun pemilih: nama resmi dari roll (sinkronisasi portal), bukan UUID.
const accountName = session && db
  ? await resolveDisplayName(db, session.member_id, session.name, NEUTRAL_ACCOUNT_NAME)
  : null;
const accountInitial = initialsFor(accountName);
const accountLabel = accountName && accountName !== NEUTRAL_ACCOUNT_NAME ? `Akun: ${accountName}` : "Akun";
const hasMasukParam = Astro.url.searchParams.has("masuk");
const election = await db?.prepare("SELECT status_lock FROM elections ORDER BY id LIMIT 1").first<{ status_lock: string }>();
const showResultsTab = showHasil ?? election?.status_lock === "published";
const path = Astro.url.pathname;
const pageUrl = new URL(path, Astro.url.origin).href;
const ogImageAbs = new URL(ogImage ?? logo.src, Astro.url.origin).href;
const ogTitle = `${title} · ${siteName}`;
const loginHref = `/api/auth/login?return_to=${encodeURIComponent(path)}`;

// Navigasi pemilih: satu sumber untuk ponsel (bilah bawah) dan tidak memakai
// tab tambahan saat hasil belum diumumkan.
const navItems = [
  { href: "/", label: "Beranda", icon: IconHome2, current: path === "/" || path === "/papan-bukti" },
  { href: "/kandidat", label: "Kandidat", icon: IconUsers, current: path.startsWith("/kandidat") },
  { href: "/pilih-suara", label: "Pilih Suara", icon: IconSpeakerphone, current: path === "/pilih-suara" },
  { href: "/surat-suara", label: "Bukti Suara", icon: IconRosetteDiscountCheck, current: path === "/surat-suara" },
  ...(showResultsTab
    ? [{ href: "/hasil", label: "Hasil", icon: IconRosetteDiscountCheck, current: path === "/hasil" }]
    : []),
];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:alt" content={ogTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href={logo.src} type={logo.faviconType} />
    <link rel="preload" href="/fonts/plus-jakarta-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class:list={["min-h-dvh text-brand-ink antialiased", canvas === "white" ? "bg-white" : "bg-background"]}>
    <a href="#konten" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-card focus:px-4 focus:py-3 focus:font-semibold focus:outline-2 focus:outline-ring">Lewati ke konten</a>
    <header class="sticky top-0 z-20 border-b border-brand-border bg-card/95 backdrop-blur">
      <div class="mx-auto flex min-h-14 w-full max-w-3xl flex-wrap items-center justify-between gap-x-2 gap-y-1 px-4 py-1.5 sm:px-6">
        <a href="/" aria-label={`${siteName} · Beranda`} class="inline-flex min-h-11 min-w-0 items-center gap-2.5 rounded-lg text-brand-ink focus-visible:outline-2 focus-visible:outline-ring">
          <img src={logo.src} alt="" class="block h-9 w-auto shrink-0 object-contain" />
          <span class="min-w-0 truncate border-l border-brand-border pl-2.5 text-[15px] font-bold tracking-tight text-brand-ink sm:text-base">{siteName}</span>
        </a>
        <nav aria-label="Navigasi pemilih" class="hidden md:block">
          <ul class="flex items-center gap-1">
            {navItems.map((item) => (
              <li>
                <a href={item.href} aria-current={item.current ? "page" : undefined} class:list={["flex min-h-11 items-center rounded-lg px-3 text-sm font-semibold focus-visible:outline-2 focus-visible:outline-ring", item.current ? "text-brand-red" : "text-brand-muted hover:text-brand-ink"]}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="ms-auto flex min-w-0 shrink-0 items-center gap-2">
          {session
            ? <a href="/akun" aria-label={accountLabel} aria-current={path === "/akun" ? "page" : undefined} class:list={["flex size-11 shrink-0 items-center justify-center rounded-full border bg-card text-sm font-bold transition focus-visible:outline-2 focus-visible:outline-ring", path === "/akun" ? "border-brand-red text-brand-red" : "border-brand-border text-brand-ink hover:bg-accent"]}>{accountInitial}</a>
            : <Button href={loginHref} variant="secondary" size="sm">Masuk</Button>}
        </div>
      </div>
    </header>
    <main id="konten" class="mx-auto w-full max-w-3xl px-4 py-6 pb-28 sm:px-6 sm:py-8 md:pb-12">
      {hasMasukParam && <script is:inline>try{const u=new URL(location.href);if(u.searchParams.has('masuk')){u.searchParams.delete('masuk');history.replaceState(null,'',u.pathname+u.search+u.hash)}}catch{}</script>}
      <slot />
    </main>
    <div class="fixed inset-x-0 bottom-0 z-10 shadow-[0_-8px_24px_-20px_rgba(28,31,35,0.4)] md:hidden">
      <BottomBar items={navItems} ariaLabel="Navigasi pemilih" />
    </div>
  </body>
</html>
