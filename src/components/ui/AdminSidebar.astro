---
/**
 * Sidebar Admin Voting untuk Astro, mengikuti shell `prototypes/redesign-adminv1`
 * di ppij-design-system: lebar 254px, dapat dilipat ke 72px, item navigasi 42px,
 * aktif dengan latar merah muda dan teks brand. Di bawah 701px sidebar diganti
 * BottomBar.
 */
import type { Component } from "astro";
import { IconChevronLeft, IconLogout, IconLayoutSidebar } from "@tabler/icons-astro";

interface NavItem {
  href: string;
  label: string;
  icon: Component;
}
interface Props {
  items: NavItem[];
  current: string;
  identity: { name: string; initials: string };
  brand: { src: string; alt: string; label: string; caption: string };
  /** Tautan ke mode Pemilih. */
  voterHref: string;
}
const { items, current, identity, brand, voterHref } = Astro.props;
---
<div
  data-slot="admin-sidebar-column"
  class="hidden w-[254px] shrink-0 border-r border-brand-border bg-card min-[701px]:block group-data-[collapsed=true]/shell:w-[72px]"
>
<aside
  data-slot="admin-sidebar"
  aria-label="Navigasi Admin Voting"
  class="sticky top-0 z-30 flex h-screen flex-col px-[13px] pt-[22px] pb-[15px] group-data-[collapsed=true]/shell:px-3"
>
  <div class="flex items-center gap-[11px] px-[11px] pb-[25px] group-data-[collapsed=true]/shell:grid group-data-[collapsed=true]/shell:justify-items-center group-data-[collapsed=true]/shell:gap-2.5 group-data-[collapsed=true]/shell:px-0 group-data-[collapsed=true]/shell:pb-[22px]">
    <span class="grid size-[43px] shrink-0 place-items-center overflow-hidden rounded-[11px] border border-[#e7e7e7] bg-card">
      <img src={brand.src} alt={brand.alt} class="size-[41px] object-contain" />
    </span>
    <span class="min-w-0 group-data-[collapsed=true]/shell:hidden">
      <span class="block text-[17px] leading-[1.1] font-bold tracking-[-0.03em] text-brand-ink">{brand.label}</span>
      <span class="block text-[11px] font-extrabold tracking-[0.15em] text-[#868d95] uppercase">{brand.caption}</span>
    </span>
    <button
      type="button"
      data-slot="sidebar-toggle"
      aria-controls="admin-sidebar"
      aria-expanded="true"
      data-sidebar-toggle
      class="ml-auto grid size-8 shrink-0 place-items-center rounded-lg border-0 bg-[#f3f5f6] text-[#4d5962] transition-colors hover:bg-[#e9edf0] focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-none group-data-[collapsed=true]/shell:ml-0 group-data-[collapsed=true]/shell:rotate-180"
    >
      <IconLayoutSidebar size={16} stroke={1.8} aria-hidden="true" />
      <span class="sr-only" data-sidebar-toggle-label>Tampilkan navigasi</span>
    </button>
  </div>

  <p class="mt-[29px] mb-[11px] px-[11px] text-[12px] font-extrabold tracking-[0.12em] text-[#959ba2] group-data-[collapsed=true]/shell:hidden">MENU UTAMA</p>

  <nav aria-label="Halaman Admin Voting">
    <ul class="m-0 grid list-none gap-1 p-0 group-data-[collapsed=true]/shell:mt-[22px]">
      {items.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={current === item.href ? "page" : undefined}
            title={item.label}
            class:list={[
              "flex h-[42px] w-full items-center gap-[11px] rounded-lg px-[11px] text-sm font-semibold text-[#555d66] transition-colors no-underline hover:bg-[#f4f5f6] hover:text-brand-ink focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-none",
              current === item.href && "bg-brand-red/8 font-extrabold text-brand-red",
              "group-data-[collapsed=true]/shell:size-12 group-data-[collapsed=true]/shell:justify-center group-data-[collapsed=true]/shell:p-0",
            ]}
          >
            <item.icon size={19} stroke={1.85} aria-hidden="true" />
            <span class="truncate group-data-[collapsed=true]/shell:hidden">{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="mt-auto grid gap-2 border-t border-[#e8eaec] px-[9px] pt-[17px] pb-0.5 group-data-[collapsed=true]/shell:justify-items-center group-data-[collapsed=true]/shell:px-0 group-data-[collapsed=true]/shell:pt-3.5">
    <p class="flex items-center gap-2.5 text-xs text-brand-muted group-data-[collapsed=true]/shell:justify-center">
      <span aria-hidden="true" class="grid size-8 shrink-0 place-items-center rounded-full bg-brand-red/8 text-xs font-extrabold text-brand-red">{identity.initials}</span>
      <span class="min-w-0 group-data-[collapsed=true]/shell:hidden"><span class="block truncate font-bold text-brand-ink">{identity.name}</span><span class="block text-xs">Admin Voting</span></span>
    </p>
    <a href={voterHref} class="flex min-h-11 items-center gap-2 rounded-lg text-[13px] font-bold text-[#5c646d] no-underline hover:text-brand-ink focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-none group-data-[collapsed=true]/shell:justify-center">
      <IconLogout size={17} stroke={1.8} aria-hidden="true" />
      <span class="group-data-[collapsed=true]/shell:hidden">Mode Pemilih</span>
    </a>
  </div>
</aside>
</div>