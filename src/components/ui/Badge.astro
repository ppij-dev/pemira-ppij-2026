---
interface Props {
  tone?: "neutral" | "brand" | "success";
}
const { tone = "neutral" } = Astro.props;
const toneClass = { neutral: "bg-muted text-muted-foreground", brand: "bg-brand-50 text-brand-800", success: "bg-emerald-50 text-emerald-800" }[tone];
---
<span class:list={["inline-flex items-center rounded-full px-3 py-1 text-sm font-medium", toneClass]}><slot /></span>
