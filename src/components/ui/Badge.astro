---
/**
 * PPIJ design system `Badge` untuk Astro.
 * Sumber: ppij-design-system/packages/ui/src/components/badge.tsx.
 * `size="sm"` adalah skala admin (12px, padding 2/8) yang dipakai halaman
 * Admin Voting; ukuran bawaan tetap 14px untuk halaman yang sudah ada.
 */
interface Props {
  tone?: "neutral" | "brand" | "success" | "warning" | "danger" | "info" | "outline";
  size?: "default" | "sm";
}
const { tone = "neutral", size = "default" } = Astro.props;
const toneClass = {
  neutral: "bg-muted text-muted-foreground",
  brand: "bg-brand-50 text-brand-800",
  success: "bg-emerald-50 text-emerald-800",
  warning: "bg-amber-50 text-amber-900",
  danger: "bg-red-50 text-red-800",
  info: "bg-sky-50 text-sky-900",
  outline: "border border-border bg-card text-foreground",
}[tone];
const sizeClass = size === "sm" ? "gap-1 px-2 py-0.5 text-xs [&_svg]:size-3" : "px-3 py-1 text-sm";
---
<span class:list={["inline-flex w-fit shrink-0 items-center justify-center rounded-full font-medium whitespace-nowrap", sizeClass, toneClass]}><slot /></span>