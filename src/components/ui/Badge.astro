---
interface Props {
  tone?: "neutral" | "brand" | "success" | "warning" | "danger";
}
const { tone = "neutral" } = Astro.props;
const toneClass = { neutral: "bg-muted text-muted-foreground", brand: "bg-brand-50 text-brand-800", success: "bg-emerald-50 text-emerald-800", warning: "bg-amber-50 text-amber-900", danger: "bg-red-50 text-red-800" }[tone];
---
<span class:list={["inline-flex items-center rounded-full px-3 py-1 text-sm font-medium", toneClass]}><slot /></span>
