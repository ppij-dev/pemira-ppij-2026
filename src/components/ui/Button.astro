---
interface Props {
  href?: string;
  variant?: "primary" | "secondary";
  type?: "button" | "submit";
}
const { href, variant = "primary", type = "button" } = Astro.props;
const base = "inline-flex min-h-11 items-center justify-center gap-2 rounded-md px-4 py-2 font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:pointer-events-none disabled:opacity-50";
const variantClass = variant === "primary" ? "bg-primary text-primary-foreground hover:bg-primary-hover" : "border border-border bg-card text-card-foreground hover:bg-accent";
---
{href ? <a href={href} class:list={[base, variantClass]}><slot /></a> : <button type={type} class:list={[base, variantClass]}><slot /></button>}
