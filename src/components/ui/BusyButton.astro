---
/**
 * BusyButton: helper tombol sibuk bersama untuk semua halaman.
 * window.withBusy(button, "Menyimpan…", fn) menonaktifkan tombol selama fn
 * berjalan, mengganti isinya dengan ikon berputar dan label sibuk (aria-busy),
 * mencegah kirim ganda, lalu memulihkan isi dan status dinonaktifkan semula.
 * Dipasang sekali per layout bersama komponen Toast.
 */
---
<script is:inline>
(function(){
  if(window.withBusy)return;
  // Spinner gaya Tabler loader-2; ukuran mengikuti ikon tombol (size-4).
  const SPINNER='<svg class="animate-spin size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>';
  window.withBusy=async function(button,busyLabel,run){
    if(!button||button.getAttribute('data-busy')==='1')return undefined;
    const original=button.innerHTML,wasDisabled=button.disabled;
    button.setAttribute('data-busy','1');
    button.disabled=true;
    button.setAttribute('aria-busy','true');
    button.innerHTML=SPINNER+'<span></span>';
    const label=button.lastElementChild;
    if(label)label.textContent=String(busyLabel??'Memproses…');
    try{return await run()}
    finally{
      button.innerHTML=original;
      button.disabled=wasDisabled;
      button.removeAttribute('aria-busy');
      button.removeAttribute('data-busy');
    }
  };
})();
</script>
