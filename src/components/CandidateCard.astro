---
import { IconArrowUpRight } from "@tabler/icons-astro";
import { formatUnitPath } from "../lib/formatKomsat";

interface Props {
  headingLevel?: 2 | 3;
  candidate: {
    number: number;
    name: string;
    nickname: string;
    komsat_path: string;
    short_intro: string | null;
    color: string | null;
  };
}

const { candidate, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";
const unit = formatUnitPath(candidate.komsat_path) || "PPI Jepang";
---
<a
  href={`/kandidat/${candidate.number}-${encodeURIComponent(candidate.nickname)}`}
  class="group grid grid-cols-[5.25rem_minmax(0,1fr)] gap-x-4 rounded-xl border border-border bg-card p-4 transition-colors hover:border-brand-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring sm:grid-cols-[8.25rem_minmax(0,1fr)] sm:gap-x-5 sm:p-5"
>
  <div class="relative aspect-[3/4] w-full self-start overflow-hidden rounded-md bg-muted" data-candidate-portrait>
    <img src="/placeholder-candidate.png" alt="" loading="lazy" decoding="async" width="600" height="800" class="block size-full object-cover" />
    <span class="absolute bottom-2 left-2 flex size-8 items-center justify-center rounded-md text-sm font-bold text-white sm:size-9 sm:text-base" style={`background-color:${candidate.color || '#c8102e'}`}>
      <span class="sr-only">Nomor urut </span>{candidate.number}
    </span>
  </div>
  <div class="contents min-w-0 sm:flex sm:flex-col">
    <div class="col-start-2 row-start-1 min-w-0">
      <Heading class="break-words text-lg font-semibold leading-tight tracking-tight group-hover:text-primary sm:text-xl">{candidate.nickname}</Heading>
      <p class="mt-1 break-words text-sm text-muted-foreground">{candidate.name}</p>
      <p class="mt-1 break-words text-xs text-muted-foreground">{unit}</p>
    </div>
    {candidate.short_intro && <p class="col-span-2 mt-3 break-words text-sm leading-6 text-foreground">{candidate.short_intro}</p>}
    <span class="col-span-2 mt-1 inline-flex min-h-11 items-center justify-end gap-1 text-xs font-semibold text-primary group-hover:underline group-hover:underline-offset-4 sm:mt-auto sm:self-end sm:pt-3 sm:text-sm">Lihat selengkapnya <IconArrowUpRight size={17} stroke={1.8} aria-hidden="true" /></span>
  </div>
</a>
