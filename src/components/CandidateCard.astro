---
import { IconArrowUpRight } from "@tabler/icons-astro";
import { formatUnitPath } from "../lib/formatKomsat";
import { candidatePhotoSrc } from "../lib/candidatePhoto";

interface Props {
  headingLevel?: 2 | 3;
  candidate: {
    number: number;
    name: string;
    nickname: string;
    komsat_path: string;
    short_intro: string | null;
    color: string | null;
    photo_key?: string | null;
  };
}

const { candidate, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";
const unit = formatUnitPath(candidate.komsat_path) || "PPI Jepang";
---
<a
  href={`/kandidat/${candidate.number}-${encodeURIComponent(candidate.nickname)}`}
  class="group flex min-w-0 flex-col overflow-hidden rounded-xl border border-border bg-card transition-colors hover:border-brand-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
>
  <div class="aspect-[3/4] w-full overflow-hidden bg-muted" data-candidate-portrait>
    <img src={candidatePhotoSrc(candidate.photo_key)} alt="" loading="lazy" decoding="async" width="600" height="800" class="block size-full object-cover" />
  </div>
  <div class="flex min-h-11 w-full items-center justify-center px-4 py-2 text-lg font-semibold text-white" style={`background-color:${candidate.color || '#c8102e'}`} data-candidate-number>
    <span class="sr-only">Nomor urut </span>{candidate.number}
  </div>
  <div class="flex min-w-0 flex-1 flex-col p-4 sm:p-5">
    <Heading class="break-words text-xl font-semibold leading-tight tracking-tight group-hover:text-primary">{candidate.nickname}</Heading>
    <p class="mt-1 break-words text-sm text-muted-foreground">{candidate.name}</p>
    <p class="mt-1 break-words text-xs text-muted-foreground">{unit}</p>
    {candidate.short_intro && <p class="mt-3 break-words text-sm leading-6 text-foreground">{candidate.short_intro}</p>}
    <span class="mt-auto inline-flex min-h-11 items-center justify-end gap-1 pt-3 text-sm font-semibold text-primary group-hover:underline group-hover:underline-offset-4">Lihat selengkapnya <IconArrowUpRight size={17} stroke={1.8} aria-hidden="true" /></span>
  </div>
</a>
