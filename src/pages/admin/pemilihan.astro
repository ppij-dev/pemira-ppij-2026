---
import { env } from "cloudflare:workers";import AdminLayout from "../../layouts/AdminLayout.astro";import {isAdminPageAuthorized,SESSION_COOKIE,type AdminBindings} from "./admin-auth";const bindings=env as unknown as AdminBindings;const authorized=await isAdminPageAuthorized(Astro.cookies.get(SESSION_COOKIE)?.value,bindings);const db=authorized?bindings.DB:undefined;const e=await db?.prepare('SELECT title,description,opens_at,closes_at FROM elections ORDER BY id LIMIT 1').first<any>();
---
<AdminLayout title="Pemilihan"><h1 class="mb-5 text-2xl font-bold">Persiapan Pemilihan</h1><section class="mb-5 rounded-xl border bg-white p-5"><h2 class="text-lg font-semibold">Jadwal dan informasi</h2><form id="schedule" class="mt-4 grid gap-3"><input name="title" required placeholder="Judul pemilihan" value={e?.title??''} class="rounded-lg border p-3"/><textarea name="description" placeholder="Deskripsi" class="rounded-lg border p-3">{e?.description??''}</textarea><label>Mulai <input name="opens_at" type="datetime-local" required value={e?.opens_at?.slice(0,16)??''} class="block rounded-lg border p-3"/></label><label>Selesai <input name="closes_at" type="datetime-local" required value={e?.closes_at?.slice(0,16)??''} class="block rounded-lg border p-3"/></label><p class="text-sm text-slate-600">Waktu mengikuti zona waktu Jepang (JST).</p><button class="min-h-11 rounded-lg bg-blue-800 px-4 text-white">Simpan Jadwal</button></form></section><section class="mb-5 rounded-xl border bg-white p-5"><h2 class="text-lg font-semibold">Kesiapan</h2><ul id="checks" class="mt-3 space-y-2"><li>Memuat pemeriksaan…</li></ul><button id="refresh" class="mt-3 rounded-lg border px-4 py-2">Periksa ulang</button></section><p id="message" class="mb-4" aria-live="polite"></p><div class="grid gap-4 sm:grid-cols-2"><button id="lock" class="rounded-lg bg-blue-800 px-4 py-3 font-semibold text-white">Kunci &amp; Jadwalkan</button><form id="extend" class="grid gap-2 rounded-xl border bg-white p-4"><h2 class="font-semibold">Perpanjang waktu</h2><input name="closes_at" type="datetime-local" required class="rounded-lg border p-3"/><input name="reason" required placeholder="Alasan" class="rounded-lg border p-3"/><button class="rounded-lg border p-3">Perpanjang</button></form><form id="close" class="grid gap-2 rounded-xl border bg-white p-4"><h2 class="font-semibold">Tutup sekarang</h2><input name="reason" required placeholder="Alasan" class="rounded-lg border p-3"/><button class="rounded-lg border p-3">Tutup Sekarang</button></form><button id="publish" class="rounded-lg border px-4 py-3">Umumkan Hasil</button></div><script is:inline>
const msg=document.querySelector('#message'),list=document.querySelector('#checks'),labels={schedule:'Jadwal pemilihan valid',opens_future:'Waktu mulai di masa depan',candidate_count:'Jumlah kandidat memenuhi ketentuan',nicknames:'Nickname kandidat unik',roll_synced:'Daftar pemilih telah disinkronkan',admin_candidate:'Admin Voting bukan kandidat'};async function readiness(){const r=await fetch('/api/election/readiness'),d=await r.json();list.replaceChildren();for(const c of d.checks||[]){const li=document.createElement('li');li.textContent=(c.ok?'✓ ':'× ')+(labels[c.key]||c.message||c.key);li.className=c.ok?'text-emerald-700':'text-red-700';list.append(li)}if(!d.checks?.length)list.textContent=d.error||'Tidak ada pemeriksaan tersedia'}function values(form){const v=Object.fromEntries(new FormData(form));for(const k of ['opens_at','closes_at'])if(v[k]&&/^\d{4}-\d\d-\d\dT\d\d:\d\d$/.test(v[k]))v[k]+=':00+09:00';return v}async function action(path,body={},confirmText){if(confirmText&&!confirm(confirmText))return;msg.textContent='Memproses…';const r=await fetch('/api/election/'+path,{method:path==='schedule'?'PUT':'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)}),d=await r.json().catch(()=>({}));msg.textContent=r.ok?'Perubahan berhasil disimpan.':(d.error||'Tindakan gagal')+(d.checks?' — '+d.checks.filter(c=>!c.ok).map(c=>c.message).join('; '):'');await readiness()}document.querySelector('#refresh').onclick=readiness;document.querySelector('#schedule').onsubmit=e=>{e.preventDefault();action('schedule',values(e.currentTarget))};document.querySelector('#lock').onclick=()=>action('lock',{},'Kunci pemilihan dan jadwalkan sekarang?');document.querySelector('#extend').onsubmit=e=>{e.preventDefault();action('extend',values(e.currentTarget))};document.querySelector('#close').onsubmit=e=>{e.preventDefault();action('close',values(e.currentTarget),'Tutup pemilihan sekarang?')};document.querySelector('#publish').onclick=()=>action('publish',{},'Umumkan hasil pemilihan?');readiness();
</script></AdminLayout>
