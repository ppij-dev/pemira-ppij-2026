---
import { env } from "cloudflare:workers";
import { IconCalendarEvent, IconChecklist, IconCircleCheck, IconCircleX, IconLock, IconSpeakerphone } from "@tabler/icons-astro";
import AdminLayout from "../../layouts/AdminLayout.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import PanelCard from "../../components/ui/PanelCard.astro";
import Callout from "../../components/ui/Callout.astro";
import Badge from "../../components/ui/Badge.astro";
import Button from "../../components/ui/Button.astro";
import FormField from "../../components/ui/FormField.astro";
import { isAdminPageAuthorized, SESSION_COOKIE, type AdminBindings } from "./admin-auth";
const bindings = env as unknown as AdminBindings;
const authorized = await isAdminPageAuthorized(Astro.cookies.get(SESSION_COOKIE)?.value, bindings);
const db = authorized ? bindings.DB : undefined;
const e = await db?.prepare('SELECT title,description,opens_at,closes_at,preview_mode,status_lock,single_candidate_mode FROM elections ORDER BY id LIMIT 1').first<any>();
// Mode kandidat tunggal hanya dapat diubah saat Draf; setelah Kunci tampil baca-saja.
const singleCandidateMode = e?.single_candidate_mode === 1;
const singleCandidateEditable = e?.status_lock === 'draft';
const control = "w-full min-w-0 rounded-md border border-input bg-card px-3 text-base shadow-xs transition-[color,box-shadow] placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-none min-[600px]:text-[13px]";
---
<AdminLayout title="Pemilihan">
  <PageHeader title="Persiapan Pemilihan" eyebrow="Admin Voting" description="Atur jadwal, periksa kesiapan, dan kelola tahap pemungutan suara." />
  <div class="mt-5 grid gap-[17px] min-[901px]:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]">
    <PanelCard title="Jadwal dan informasi" description="Semua waktu mengikuti zona waktu Jepang (JST)." icon={IconCalendarEvent}>
      <form id="schedule" class="grid grid-cols-1 items-start gap-x-3.5 gap-y-4 min-[601px]:grid-cols-2 [&_input]:min-[600px]:h-8 [&_input]:max-[600px]:min-h-11">
        <FormField label="Judul pemilihan" for="election-title" wide>
          <input id="election-title" name="title" required placeholder="Judul pemilihan" value={e?.title ?? ''} class={control} />
        </FormField>
        <FormField label="Deskripsi" for="election-description" wide>
          <textarea id="election-description" name="description" placeholder="Ringkasan pemilihan" class="min-h-28 w-full rounded-md border border-input bg-card px-3 py-2 text-base shadow-xs focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-none min-[600px]:text-[13px]">{e?.description ?? ''}</textarea>
        </FormField>
        <FormField label="Mulai · JST" for="opens-at">
          <input id="opens-at" name="opens_at" type="datetime-local" required value={e?.opens_at?.slice(0, 16) ?? ''} class={control} />
        </FormField>
        <FormField label="Selesai · JST" for="closes-at">
          <input id="closes-at" name="closes_at" type="datetime-local" required value={e?.closes_at?.slice(0, 16) ?? ''} class={control} />
        </FormField>
        <div class="col-span-full">
          <label for="preview-mode" class="flex items-start gap-3 rounded-lg bg-[#fff5e6] px-3.5 py-3 text-[13px] leading-5 text-[#7c5014]">
            <input id="preview-mode" name="preview_mode" type="checkbox" class="mt-1 size-4" checked={Boolean(e?.preview_mode)} />
            <span class="min-w-0">
              <strong class="block font-bold">Mode Pratinjau</strong>
              <span class="block text-xs">Anggota aktif dalam cakupan terdaftar otomatis saat masuk dan dapat langsung memilih, tanpa daftar beku dan tanpa sinkronisasi Service API. Untuk uji coba; matikan untuk pemilihan resmi.</span>
            </span>
          </label>
        </div>
        <div class="col-span-full border-t border-brand-border pt-4">
          <Button type="submit" variant="primary" size="sm">Simpan Jadwal</Button>
        </div>
      </form>
      <div class="mt-5 border-t border-brand-border pt-4">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="m-0 text-sm leading-snug font-bold text-brand-ink">Mode kandidat tunggal</h3>
              <Badge tone={singleCandidateMode ? 'brand' : 'neutral'} size="sm">{singleCandidateMode ? 'Aktif' : 'Tidak aktif'}</Badge>
            </div>
            <p class="mt-1 text-xs leading-5 text-brand-muted">Hanya dapat diubah saat Draf. Saat aktif, Kunci &amp; Jadwalkan menuntut tepat satu kandidat dan surat suara menanyakan Setuju atau Tidak Setuju untuk kandidat itu.</p>
          </div>
          <label for="single-candidate-mode" class="mt-1 inline-flex shrink-0 cursor-pointer items-center">
            <input id="single-candidate-mode" type="checkbox" role="switch" aria-label="Mode kandidat tunggal" class="peer sr-only" checked={singleCandidateMode} disabled={!singleCandidateEditable} data-editable={singleCandidateEditable ? '1' : '0'} />
            <span aria-hidden="true" class="relative h-6 w-11 shrink-0 rounded-full bg-brand-border transition-colors after:absolute after:top-0.5 after:left-0.5 after:size-5 after:rounded-full after:bg-white after:shadow-sm after:transition-transform peer-checked:bg-primary peer-checked:after:translate-x-5 peer-focus-visible:ring-[3px] peer-focus-visible:ring-ring/50 peer-disabled:cursor-not-allowed peer-disabled:opacity-50"></span>
          </label>
        </div>
        {!singleCandidateEditable && <p class="mt-2 text-xs leading-5 text-brand-muted">Nilai ini dibekukan setelah Kunci &amp; Jadwalkan.</p>}
        <Callout id="single-candidate-error" tone="danger" class="mt-3" hidden></Callout>
        <p id="single-candidate-status" role="status" aria-live="polite" class="mt-2 text-[13px] text-brand-muted"></p>
      </div>
    </PanelCard>

    <PanelCard title="Kesiapan" description="Selesaikan semua pemeriksaan sebelum mengunci pemilihan." icon={IconChecklist}>
      <ul id="checks" class="m-0 grid list-none gap-3 p-0 text-sm">
        <li class="text-brand-muted">Memuat pemeriksaan...</li>
      </ul>
      <template id="check-ok"><IconCircleCheck size={17} stroke={1.9} class="shrink-0 text-[#35604a]" aria-hidden="true" /></template>
      <template id="check-fail"><IconCircleX size={17} stroke={1.9} class="shrink-0 text-destructive" aria-hidden="true" /></template>
      <div class="mt-4 flex flex-wrap gap-2">
        <Button id="refresh" type="button" variant="secondary" size="sm">Periksa ulang</Button>
      </div>
      <div class="mt-5 border-t border-brand-border pt-5">
        <p class="m-0 text-[13px] text-brand-muted">Kunci &amp; Jadwalkan akan membekukan daftar Pemilih.</p>
        <Button id="lock" type="button" variant="primary" size="sm" class="mt-3 w-full"><IconLock size={16} stroke={1.8} aria-hidden="true" /> Kunci &amp; Jadwalkan</Button>
      </div>
    </PanelCard>
  </div>
  <p id="message" role="status" aria-live="polite" class="my-4 text-[13px] text-brand-muted"></p>
  <section aria-labelledby="stage-actions-title" class="mt-2">
    <h2 id="stage-actions-title" class="mb-4 text-lg leading-snug font-bold tracking-tight text-brand-ink">Tindakan tahap</h2>
    <PanelCard padding="none" class="grid grid-cols-1 min-[901px]:grid-cols-3 [&>form]:min-w-0">
      <form id="extend" class="grid content-start gap-3 border-b border-brand-border p-[22px] max-[700px]:p-[17px] min-[901px]:border-b-0">
        <h3 class="m-0 text-sm leading-snug font-bold text-brand-ink">Perpanjang waktu</h3>
        <p class="m-0 text-xs leading-5 text-brand-muted">Catat waktu penutupan baru dan alasannya.</p>
        <FormField label="Selesai · JST" for="extend-closes">
          <input id="extend-closes" name="closes_at" type="datetime-local" required class={control} />
        </FormField>
        <FormField label="Alasan" for="extend-reason">
          <input id="extend-reason" name="reason" required placeholder="Alasan perpanjangan" class={control} />
        </FormField>
        <Button type="submit" variant="secondary" size="sm" class="mt-1 w-fit">Perpanjang</Button>
      </form>
      <form id="close" class="grid content-start gap-3 border-b border-brand-border p-[22px] max-[700px]:p-[17px] min-[901px]:border-r min-[901px]:border-b-0 min-[901px]:border-l">
        <h3 class="m-0 text-sm leading-snug font-bold text-brand-ink">Tutup sekarang</h3>
        <p class="m-0 text-xs leading-5 text-brand-muted">Pemungutan suara akan berhenti. Catat alasan tindakan ini.</p>
        <FormField label="Alasan" for="close-reason">
          <input id="close-reason" name="reason" required placeholder="Alasan penutupan" class={control} />
        </FormField>
        <Button type="submit" variant="secondary" size="sm" class="mt-1 w-fit text-destructive hover:bg-red-50">Tutup Sekarang</Button>
      </form>
      <div class="grid content-start gap-3 p-[22px] max-[700px]:p-[17px]">
        <h3 class="m-0 text-sm leading-snug font-bold text-brand-ink">Umumkan hasil</h3>
        <p class="m-0 text-xs leading-5 text-brand-muted">Hasil baru dapat dilihat pemilih setelah diumumkan.</p>
        <Button id="publish" type="button" variant="secondary" size="sm" class="mt-1 w-fit text-brand-red hover:bg-brand-red/5"><IconSpeakerphone size={16} stroke={1.8} aria-hidden="true" /> Umumkan Hasil</Button>
      </div>
    </PanelCard>
  </section>
  <script is:inline>
// Penjaga null: setiap tombol dipasang sendiri-sendiri, jadi satu elemen yang
// hilang tidak lagi mematikan seluruh skrip tindakan admin.
const msg=document.querySelector('#message'),list=document.querySelector('#checks'),labels={schedule:'Jadwal pemilihan valid',candidate_count:'Jumlah kandidat memenuhi ketentuan',nicknames:'Nickname kandidat unik',admin_candidate:'Admin Voting bukan kandidat'};
const okTemplate=document.querySelector('#check-ok'),failTemplate=document.querySelector('#check-fail');
const say=(text)=>{if(msg)msg.textContent=text};
const on=(selector,event,handler)=>{const el=document.querySelector(selector);if(el)el.addEventListener(event,handler)};
async function readiness(){const r=await fetch('/api/election/readiness'),d=await r.json();if(!list)return;list.replaceChildren();for(const c of d.checks||[]){const li=document.createElement('li');li.className='flex items-start gap-2 '+(c.ok?'text-brand-ink':'text-destructive');const icon=document.createElement('span');icon.className='mt-0.5 shrink-0';icon.append((c.ok?okTemplate:failTemplate).content.cloneNode(true));const text=document.createElement('span');text.className='min-w-0 text-[13px]';text.textContent=(c.ok?'':'Belum siap: ')+(labels[c.key]||c.message||c.key);li.append(icon,text);list.append(li)}if(!d.checks?.length)list.textContent=d.error||'Tidak ada pemeriksaan tersedia'}
function values(form){const v=Object.fromEntries(new FormData(form));for(const k of ['opens_at','closes_at'])if(v[k]&&/^\d{4}-\d\d-\d\dT\d\d:\d\d$/.test(v[k]))v[k]+=':00+09:00';return v}
async function action(path,body={},confirmText){if(confirmText&&!confirm(confirmText))return;say('Memproses...');const r=await fetch('/api/election/'+path,{method:path==='schedule'?'PUT':'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)}),d=await r.json().catch(()=>({}));say(r.ok?'Perubahan berhasil disimpan.':(d.error||'Tindakan gagal')+(d.checks?' — '+d.checks.filter(c=>!c.ok).map(c=>c.message).join('; '):''));await readiness()}
on('#refresh','click',readiness);
// Saklar mode kandidat tunggal: kirim seluruh nilai (bukan selisih), tampilkan
// teks galat server apa adanya, dan kembalikan saklar bila ditolak.
const scToggle=document.querySelector('#single-candidate-mode'),scError=document.querySelector('#single-candidate-error'),scStatus=document.querySelector('#single-candidate-status');
const scClear=()=>{if(scError){scError.textContent='';scError.setAttribute('hidden','')}};
if(scToggle)scToggle.addEventListener('change',async()=>{const enabled=scToggle.checked;scClear();if(scStatus)scStatus.textContent='Menyimpan...';scToggle.disabled=true;try{const r=await fetch('/api/election/single-candidate-mode',{method:'PUT',credentials:'same-origin',headers:{'content-type':'application/json'},body:JSON.stringify({enabled})}),d=await r.json().catch(()=>({}));if(!r.ok){scToggle.checked=!enabled;if(scError){scError.textContent=d.error||'Mode kandidat tunggal gagal disimpan.';scError.removeAttribute('hidden')}if(scStatus)scStatus.textContent='';return}if(scStatus)scStatus.textContent=enabled?'Mode kandidat tunggal diaktifkan.':'Mode kandidat tunggal dinonaktifkan.';await readiness()}catch{scToggle.checked=!enabled;if(scError){scError.textContent='Perubahan belum tersimpan. Periksa koneksi lalu coba lagi.';scError.removeAttribute('hidden')}}finally{scToggle.disabled=scToggle.dataset.editable!=='1'}});
on('#schedule','submit',e=>{e.preventDefault();const form=e.currentTarget;const v=values(form);v.preview_mode=document.querySelector('#preview-mode').checked;action('schedule',v)});
on('#lock','click',()=>action('lock',{},'Kunci pemilihan dan jadwalkan sekarang?'));
on('#extend','submit',e=>{e.preventDefault();action('extend',values(e.currentTarget))});
on('#close','submit',e=>{e.preventDefault();action('close',values(e.currentTarget),'Tutup pemilihan sekarang?')});
on('#publish','click',()=>action('publish',{},'Umumkan hasil pemilihan?'));
readiness();
</script>
</AdminLayout>