---
import { env } from "cloudflare:workers";import AdminLayout from "../../layouts/AdminLayout.astro";import {isAdminPageAuthorized,SESSION_COOKIE,type AdminBindings} from "./admin-auth";const bindings=env as unknown as AdminBindings;const authorized=await isAdminPageAuthorized(Astro.cookies.get(SESSION_COOKIE)?.value,bindings);const db=authorized?bindings.DB:undefined;const e=await db?.prepare('SELECT title,description,opens_at,closes_at FROM elections ORDER BY id LIMIT 1').first<any>();
---
<AdminLayout title="Pemilihan">
  <div class="mb-6"><p class="text-sm font-semibold text-primary">ADMIN VOTING</p><h1 class="mt-1 text-3xl font-bold tracking-tight">Persiapan Pemilihan</h1><p class="mt-2 text-muted-foreground">Atur jadwal, periksa kesiapan, dan kelola tahap pemungutan suara.</p></div>
  <div class="grid gap-5 lg:grid-cols-[minmax(0,1.4fr)_minmax(18rem,1fr)]">
    <section class="rounded-xl border border-border bg-card p-4 shadow-sm sm:p-6"><h2 class="text-lg font-semibold">Jadwal dan informasi</h2><p class="mt-1 text-sm text-muted-foreground">Semua waktu mengikuti zona waktu Jepang (JST).</p><form id="schedule" class="mt-5 grid gap-4"><div><label for="election-title" class="text-sm font-semibold">Judul pemilihan</label><input id="election-title" name="title" required placeholder="Judul pemilihan" value={e?.title??''} class="mt-1 min-h-11 w-full rounded-md border border-input bg-card px-3 focus-visible:outline-2 focus-visible:outline-ring"/></div><div><label for="election-description" class="text-sm font-semibold">Deskripsi</label><textarea id="election-description" name="description" placeholder="Ringkasan pemilihan" class="mt-1 min-h-28 w-full rounded-md border border-input bg-card p-3 focus-visible:outline-2 focus-visible:outline-ring">{e?.description??''}</textarea></div><div class="grid gap-4 sm:grid-cols-2"><div><label for="opens-at" class="text-sm font-semibold">Mulai · JST</label><input id="opens-at" name="opens_at" type="datetime-local" required value={e?.opens_at?.slice(0,16)??''} class="mt-1 min-h-11 w-full rounded-md border border-input bg-card px-3 focus-visible:outline-2 focus-visible:outline-ring"/></div><div><label for="closes-at" class="text-sm font-semibold">Selesai · JST</label><input id="closes-at" name="closes_at" type="datetime-local" required value={e?.closes_at?.slice(0,16)??''} class="mt-1 min-h-11 w-full rounded-md border border-input bg-card px-3 focus-visible:outline-2 focus-visible:outline-ring"/></div></div><div class="border-t border-border pt-4"><button class="min-h-11 rounded-md bg-primary px-4 font-semibold text-primary-foreground hover:bg-primary-hover">Simpan Jadwal</button></div></form></section>
    <section class="rounded-xl border border-border bg-card p-4 shadow-sm sm:p-6"><h2 class="text-lg font-semibold">Kesiapan</h2><p class="mt-1 text-sm text-muted-foreground">Selesaikan semua pemeriksaan sebelum mengunci pemilihan.</p><ul id="checks" class="mt-5 space-y-3 text-sm"><li>Memuat pemeriksaan…</li></ul><button id="refresh" type="button" class="mt-4 min-h-11 rounded-md border border-border bg-card px-4 font-semibold hover:bg-accent">Periksa ulang</button><div class="mt-5 border-t border-border pt-5"><p class="text-sm text-muted-foreground">Kunci &amp; Jadwalkan akan membekukan daftar Pemilih.</p><button id="lock" type="button" class="mt-3 min-h-11 w-full rounded-md bg-primary px-4 font-semibold text-primary-foreground hover:bg-primary-hover">Kunci &amp; Jadwalkan</button></div></section>
  </div>
  <p id="message" role="status" class="my-4 text-sm text-muted-foreground" aria-live="polite"></p>
  <section aria-labelledby="stage-actions-title" class="mt-6"><h2 id="stage-actions-title" class="mb-4 text-lg font-semibold">Tindakan tahap</h2><div class="grid gap-4 md:grid-cols-3"><form id="extend" class="grid gap-3 rounded-xl border border-border bg-card p-4 shadow-sm sm:p-5"><h3 class="font-semibold">Perpanjang waktu</h3><p class="text-sm text-muted-foreground">Catat waktu penutupan baru dan alasannya.</p><label for="extend-closes" class="text-sm font-semibold">Selesai · JST</label><input id="extend-closes" name="closes_at" type="datetime-local" required class="min-h-11 w-full rounded-md border border-input bg-card px-3"/><label for="extend-reason" class="text-sm font-semibold">Alasan</label><input id="extend-reason" name="reason" required placeholder="Alasan perpanjangan" class="min-h-11 w-full rounded-md border border-input bg-card px-3"/><button class="min-h-11 rounded-md border border-border bg-card px-4 font-semibold hover:bg-accent">Perpanjang</button></form><form id="close" class="grid content-start gap-3 rounded-xl border border-border bg-card p-4 shadow-sm sm:p-5"><h3 class="font-semibold">Tutup sekarang</h3><p class="text-sm text-muted-foreground">Pemungutan suara akan berhenti. Catat alasan tindakan ini.</p><label for="close-reason" class="text-sm font-semibold">Alasan</label><input id="close-reason" name="reason" required placeholder="Alasan penutupan" class="min-h-11 w-full rounded-md border border-input bg-card px-3"/><button class="min-h-11 rounded-md border border-red-200 bg-card px-4 font-semibold text-destructive hover:bg-red-50">Tutup Sekarang</button></form><div class="rounded-xl border border-border bg-card p-4 shadow-sm sm:p-5"><h3 class="font-semibold">Umumkan hasil</h3><p class="mt-3 text-sm text-muted-foreground">Hasil baru dapat dilihat pemilih setelah diumumkan.</p><button id="publish" type="button" class="mt-5 min-h-11 rounded-md border border-border bg-card px-4 font-semibold text-primary hover:bg-brand-50">Umumkan Hasil</button></div></div></section>
  <script is:inline>
const msg=document.querySelector('#message'),list=document.querySelector('#checks'),labels={schedule:'Jadwal pemilihan valid',opens_future:'Waktu mulai di masa depan',candidate_count:'Jumlah kandidat memenuhi ketentuan',nicknames:'Nickname kandidat unik',roll_synced:'Daftar pemilih telah disinkronkan',admin_candidate:'Admin Voting bukan kandidat'};async function readiness(){const r=await fetch('/api/election/readiness'),d=await r.json();list.replaceChildren();for(const c of d.checks||[]){const li=document.createElement('li');li.textContent=(c.ok?'✓ ':'× ')+(labels[c.key]||c.message||c.key);li.className=c.ok?'text-emerald-700':'text-red-700';list.append(li)}if(!d.checks?.length)list.textContent=d.error||'Tidak ada pemeriksaan tersedia'}function values(form){const v=Object.fromEntries(new FormData(form));for(const k of ['opens_at','closes_at'])if(v[k]&&/^\d{4}-\d\d-\d\dT\d\d:\d\d$/.test(v[k]))v[k]+=':00+09:00';return v}async function action(path,body={},confirmText){if(confirmText&&!confirm(confirmText))return;msg.textContent='Memproses…';const r=await fetch('/api/election/'+path,{method:path==='schedule'?'PUT':'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)}),d=await r.json().catch(()=>({}));msg.textContent=r.ok?'Perubahan berhasil disimpan.':(d.error||'Tindakan gagal')+(d.checks?' — '+d.checks.filter(c=>!c.ok).map(c=>c.message).join('; '):'');await readiness()}document.querySelector('#refresh').onclick=readiness;document.querySelector('#schedule').onsubmit=e=>{e.preventDefault();action('schedule',values(e.currentTarget))};document.querySelector('#lock').onclick=()=>action('lock',{},'Kunci pemilihan dan jadwalkan sekarang?');document.querySelector('#extend').onsubmit=e=>{e.preventDefault();action('extend',values(e.currentTarget))};document.querySelector('#close').onsubmit=e=>{e.preventDefault();action('close',values(e.currentTarget),'Tutup pemilihan sekarang?')};document.querySelector('#publish').onclick=()=>action('publish',{},'Umumkan hasil pemilihan?');readiness();
</script></AdminLayout>
