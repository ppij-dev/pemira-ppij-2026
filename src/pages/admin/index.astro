---
import { env } from "cloudflare:workers";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { isAdminPageAuthorized, SESSION_COOKIE, type AdminBindings } from "./admin-auth";
const bindings = env as unknown as AdminBindings;
const authorized = await isAdminPageAuthorized(Astro.cookies.get(SESSION_COOKIE)?.value, bindings);
const [admins, invitations] = authorized && bindings.DB ? await Promise.all([
  bindings.DB.prepare("SELECT member_id,name,is_technical,created_at FROM admin_voting ORDER BY created_at").all(),
  bindings.DB.prepare("SELECT i.token_hash AS id,i.member_id,v.name AS member_name,i.created_at,i.expires_at,i.accepted_at,i.cancelled_at FROM invitations i LEFT JOIN voters v ON v.member_id=i.member_id ORDER BY i.created_at DESC").all(),
]) : [{ results: [] }, { results: [] }];
---
<AdminLayout title="Panitia">
  <div class="mb-6"><p class="text-sm font-semibold text-primary">ADMIN VOTING</p><h1 class="mt-1 text-3xl font-bold tracking-tight">Panitia Pemilihan</h1><p class="mt-2 text-muted-foreground">Kelola Admin Voting dan undangan untuk anggota aktif dalam cakupan.</p></div>
  <div class="grid gap-5 lg:grid-cols-2">
    <section class="rounded-xl border border-border bg-card p-4 shadow-sm sm:p-6"><h2 class="text-lg font-semibold">Admin Voting</h2><p class="mt-1 text-sm text-muted-foreground">Semua Admin Voting memiliki hak yang sama.</p>
      {admins.results.length ? <ul class="mt-4 divide-y divide-border">{admins.results.map((a:any)=><li class="flex flex-wrap items-center justify-between gap-3 py-4"><div><p class="font-semibold">{a.name}</p><p class="text-sm text-muted-foreground">{a.member_id}</p>{a.is_technical ? <span class="mt-2 inline-flex rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-800">Technical Admin</span> : null}</div><button type="button" class="min-h-11 rounded-md px-3 font-semibold text-destructive hover:bg-red-50" data-remove={a.member_id}>Hapus</button></li>)}</ul> : <p class="mt-4 rounded-md bg-background p-4 text-sm text-muted-foreground">Belum ada Admin Voting.</p>}
    </section>
    <div class="space-y-5"><section class="rounded-xl border border-border bg-card p-4 shadow-sm sm:p-6"><h2 class="text-lg font-semibold">Undang Admin</h2><p class="mt-1 text-sm text-muted-foreground">Buat tautan undangan untuk anggota yang sudah ada di daftar pemilih.</p><form id="invite" class="mt-4 flex flex-wrap items-end gap-3"><div class="min-w-52 flex-1"><label class="text-sm font-semibold" for="member_id">ID anggota atau nomor kartu</label><input class="mt-1 min-h-11 w-full rounded-md border border-input bg-card px-3 focus-visible:outline-2 focus-visible:outline-ring" name="member_id" id="member_id" required placeholder="mis. OKA-2026-0001 atau UUID anggota"/></div><button class="min-h-11 rounded-md bg-primary px-4 font-semibold text-primary-foreground hover:bg-primary-hover">Buat undangan</button></form><p id="message" role="status" class="mt-3 break-all text-sm text-muted-foreground" aria-live="polite"></p></section>
      <section class="rounded-xl border border-border bg-card p-4 shadow-sm sm:p-6"><h2 class="text-lg font-semibold">Undangan</h2>{invitations.results.length ? <ul class="mt-4 divide-y divide-border">{invitations.results.map((inv:any)=><li class="flex flex-wrap items-center justify-between gap-2 py-3"><div><p class="font-semibold">{inv.member_name ?? inv.member_id}</p><p class="mt-1 text-xs text-muted-foreground">{inv.accepted_at ? "Diterima" : inv.cancelled_at ? "Dibatalkan" : inv.expires_at <= new Date().toISOString() ? "Kedaluwarsa" : "Menunggu"}</p></div>{!inv.accepted_at && !inv.cancelled_at && <button type="button" class="min-h-11 rounded-md px-3 font-semibold text-destructive hover:bg-red-50" data-cancel={inv.id}>Batalkan</button>}</li>)}</ul> : <p class="mt-4 rounded-md bg-background p-4 text-sm text-muted-foreground">Belum ada undangan.</p>}</section></div>
  </div>
  <script is:inline>
const msg=document.querySelector('#message');document.querySelector('#invite').addEventListener('submit',async e=>{e.preventDefault();msg.textContent='Memproses…';const r=await fetch('/api/admin/invitations',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({member_id:new FormData(e.currentTarget).get('member_id')})});const d=await r.json();msg.textContent=d.invitation_url?'Undangan dibuat: '+d.invitation_url:(d.error||'Gagal membuat undangan');if(d.invitation_url){const b=document.createElement('button');b.textContent='Salin Tautan';b.className='ml-2 underline';b.onclick=()=>navigator.clipboard.writeText(d.invitation_url);msg.append(b)}});document.querySelectorAll('[data-remove]').forEach(b=>b.onclick=async()=>{if(confirm('Hapus admin ini?')){const r=await fetch('/api/admin/'+encodeURIComponent(b.dataset.remove),{method:'DELETE'});if(r.ok)location.reload();else msg.textContent=(await r.json()).error||'Gagal menghapus'}});document.querySelectorAll('[data-cancel]').forEach(b=>b.onclick=async()=>{if(confirm('Batalkan undangan ini?')){const r=await fetch('/api/admin/invitations/'+encodeURIComponent(b.dataset.cancel),{method:'DELETE'});if(r.ok)location.reload();else msg.textContent=(await r.json()).error||'Gagal membatalkan'}});
</script></AdminLayout>
