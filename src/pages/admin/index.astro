---
import { env } from "cloudflare:workers";
import { IconUserPlus, IconUsers, IconMail } from "@tabler/icons-astro";
import AdminLayout from "../../layouts/AdminLayout.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import PanelCard from "../../components/ui/PanelCard.astro";
import ListRow from "../../components/ui/ListRow.astro";
import Badge from "../../components/ui/Badge.astro";
import Button from "../../components/ui/Button.astro";
import Empty from "../../components/ui/Empty.astro";
import FormField from "../../components/ui/FormField.astro";
import { isAdminPageAuthorized, SESSION_COOKIE, type AdminBindings } from "./admin-auth";
const bindings = env as unknown as AdminBindings;
const authorized = await isAdminPageAuthorized(Astro.cookies.get(SESSION_COOKIE)?.value, bindings);
const [admins, invitations] = authorized && bindings.DB ? await Promise.all([
  // Nama tampilan: nama resmi dari roll (sinkronisasi) menang atas nama dari
  // sesi saat undangan diterima; UUID tidak ditampilkan sebagai nama.
  bindings.DB.prepare("SELECT a.member_id, v.name AS roll_name, v.member_number AS roll_number, a.name AS invite_name, a.is_technical, a.created_at FROM admin_voting a LEFT JOIN voters v ON v.member_id=a.member_id ORDER BY a.created_at").all(),
  bindings.DB.prepare("SELECT i.token_hash AS id,i.member_id,v.name AS member_name,v.member_number AS member_number,i.created_at,i.expires_at,i.accepted_at,i.cancelled_at FROM invitations i LEFT JOIN voters v ON v.member_id=i.member_id ORDER BY i.created_at DESC").all(),
]) : [{ results: [] }, { results: [] }];
// Nama tampilan: nama resmi dari roll menang; label undangan ("Technical
// Admin") memakai nama sesi; UUID tidak pernah ditampilkan sebagai nama.
const displayName = (rollName: string | null, inviteName: string | null, memberId: string) =>
  rollName && rollName !== memberId ? rollName : inviteName && inviteName !== memberId ? inviteName : null;
const formatJst = (value: string) =>
  new Intl.DateTimeFormat("id-ID", { timeZone: "Asia/Tokyo", day: "numeric", month: "short", year: "numeric" }).format(new Date(value));
const invitationState = (inv: any) =>
  inv.accepted_at ? { label: "Diterima", tone: "success" as const }
  : inv.cancelled_at ? { label: "Dibatalkan", tone: "neutral" as const }
  : inv.expires_at <= new Date().toISOString() ? { label: "Kedaluwarsa", tone: "warning" as const }
  : { label: "Menunggu", tone: "info" as const };
---
<AdminLayout title="Panitia">
  <PageHeader title="Panitia Pemilihan" eyebrow="Admin Voting" description="Kelola Admin Voting dan undangan untuk anggota aktif dalam cakupan." />
  <div class="mt-5 grid items-start gap-[17px] min-[901px]:grid-cols-2">
    <PanelCard title="Admin Voting" description="Semua Admin Voting memiliki hak yang sama." icon={IconUsers}>
      {admins.results.length
        ? <div>{admins.results.map((a: any) => (
            <ListRow title={displayName(a.roll_name, a.invite_name, a.member_id) ?? "Nama belum tersedia dari portal"} subtitle={a.roll_number ?? "Nomor kartu belum tersedia dari portal"} tone={displayName(a.roll_name, a.invite_name, a.member_id) ? "default" : "muted"}>
              {a.is_technical ? <span slot="badge"><Badge tone="brand" size="sm">Technical Admin</Badge></span> : null}
              <span slot="meta" class="whitespace-nowrap">{formatJst(a.created_at)}</span>
              <span slot="trailing"><Button type="button" variant="ghost" size="sm" data-remove={a.member_id} class="text-destructive hover:bg-red-50">Hapus</Button></span>
            </ListRow>
          ))}</div>
        : <Empty icon={IconUsers} title="Belum ada Admin Voting" description="Undang anggota aktif dengan nomor kartu di formulir sebelah." />}
    </PanelCard>
    <div class="grid content-start gap-[17px]">
      <PanelCard title="Undang Admin Voting" description="Buat tautan undangan untuk anggota yang sudah ada di daftar pemilih." icon={IconUserPlus}>
        <form id="invite" class="grid items-start gap-x-3.5 gap-y-4 [&_input]:min-[600px]:h-8 [&_input]:max-[600px]:min-h-11">
          <FormField label="Nomor kartu anggota" for="member_id" hint="Contoh: OKA-2026-0001. UUID anggota juga diterima.">
            <input class="w-full min-w-0 rounded-md border border-input bg-card px-3 text-base shadow-xs transition-[color,box-shadow] placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-none min-[600px]:text-[13px]" name="member_id" id="member_id" required placeholder="OKA-2026-0001" />
          </FormField>
          <Button type="submit" variant="primary" size="sm" class="w-fit">Buat undangan</Button>
        </form>
        <p id="message" role="status" aria-live="polite" class="mt-3 mb-0 break-all text-[13px] text-brand-muted"></p>
      </PanelCard>
      <PanelCard title="Undangan" description="Undangan yang belum diterima tetap dapat dibatalkan." icon={IconMail}>
        {invitations.results.length
          ? <div>{invitations.results.map((inv: any) => (
              <ListRow title={inv.member_name ?? "Anggota di luar daftar pemilih"} subtitle={`${inv.member_number ?? "Nomor kartu belum tersedia dari portal"} · Dibuat ${formatJst(inv.created_at)} · Berakhir ${formatJst(inv.expires_at)}`}>
                <span slot="badge"><Badge tone={invitationState(inv).tone} size="sm">{invitationState(inv).label}</Badge></span>
                {!inv.accepted_at && !inv.cancelled_at && <span slot="trailing"><Button type="button" variant="ghost" size="sm" data-cancel={inv.id} class="text-destructive hover:bg-red-50">Batalkan</Button></span>}
              </ListRow>
            ))}</div>
          : <Empty icon={IconMail} title="Belum ada undangan" description="Undangan yang Anda buat akan muncul di sini." />}
      </PanelCard>
    </div>
  </div>
  <script is:inline>
const msg=document.querySelector('#message');document.querySelector('#invite').addEventListener('submit',async e=>{e.preventDefault();msg.textContent='Memproses...';const r=await fetch('/api/admin/invitations',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({member_id:new FormData(e.currentTarget).get('member_id')})});const d=await r.json();msg.textContent=d.invitation_url?'Undangan dibuat: '+d.invitation_url:(d.error||'Undangan belum dibuat. Coba kembali.');if(d.invitation_url){const b=document.createElement('button');b.textContent='Salin tautan';b.className='ml-2 min-h-11 font-semibold text-primary underline underline-offset-2';b.onclick=()=>navigator.clipboard.writeText(d.invitation_url);msg.append(b)}});document.querySelectorAll('[data-remove]').forEach(b=>b.onclick=async()=>{if(confirm('Hapus Admin Voting ini?')){const r=await fetch('/api/admin/'+encodeURIComponent(b.dataset.remove),{method:'DELETE'});if(r.ok)location.reload();else msg.textContent=(await r.json()).error||'Admin Voting belum terhapus. Coba kembali.'}});document.querySelectorAll('[data-cancel]').forEach(b=>b.onclick=async()=>{if(confirm('Batalkan undangan ini?')){const r=await fetch('/api/admin/invitations/'+encodeURIComponent(b.dataset.cancel),{method:'DELETE'});if(r.ok)location.reload();else msg.textContent=(await r.json()).error||'Undangan belum dibatalkan. Coba kembali.'}});
</script>
</AdminLayout>