---
import { env } from "cloudflare:workers";
import { IconAlertTriangle, IconRefresh, IconSearch, IconUsers } from "@tabler/icons-astro";
import AdminLayout from "../../layouts/AdminLayout.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import PanelCard from "../../components/ui/PanelCard.astro";
import DataTable from "../../components/ui/DataTable.astro";
import ListRow from "../../components/ui/ListRow.astro";
import Badge from "../../components/ui/Badge.astro";
import Button from "../../components/ui/Button.astro";
import FormField from "../../components/ui/FormField.astro";
import Empty from "../../components/ui/Empty.astro";
import Callout from "../../components/ui/Callout.astro";
import { memberCategoryLabel } from "../../lib/memberCategory";
import { unitPathLabel, type UnitNames } from "../../lib/formatKomsat";
import { isAdminPageAuthorized, SESSION_COOKIE, type AdminBindings } from "./admin-auth";
const bindings = env as unknown as AdminBindings;
const authorized = await isAdminPageAuthorized(Astro.cookies.get(SESSION_COOKIE)?.value, bindings);
const db = authorized ? bindings.DB : undefined;
const page = Math.max(1, Number(Astro.url.searchParams.get('page') || 1));
const q = Astro.url.searchParams.get('q') || '';
const komsat = Astro.url.searchParams.get('komsat') || '';
const filter = Astro.url.searchParams.get('status') || '';
// Baris roll tanpa nomor kartu tetap tampil dengan tanda hubung; nama unit
// selalu nama resmi portal dari tabel units, bukan pecahan jalur.
const rows = await db?.prepare("SELECT v.member_id,v.name,v.member_number,v.category,v.can_vote,v.komsat_path,p.voted_at,CASE WHEN p.member_id IS NULL THEN 0 ELSE 1 END AS voted FROM voters v LEFT JOIN participation p ON p.member_id=v.member_id AND p.election_id=(SELECT MAX(id) FROM elections) WHERE (?='' OR v.name LIKE ?) AND (?='' OR v.komsat_path=?) AND (?='' OR (?='voted' AND p.member_id IS NOT NULL) OR (?='not-voted' AND p.member_id IS NULL)) ORDER BY v.name LIMIT 50 OFFSET ?").bind(q,q?`%${q}%`:'',komsat,komsat,filter,filter,filter,(page-1)*50).all() ?? { results: [] };
const units = await db?.prepare('SELECT DISTINCT v.komsat_path FROM voters v ORDER BY v.komsat_path').all<{ komsat_path: string }>() ?? { results: [] };
const unitNames = (await db?.prepare('SELECT path,name FROM units').all<{ path: string; name: string }>() ?? { results: [] }).results.reduce((map, unit) => ({ ...map, [unit.path]: unit.name }), {} as UnitNames);
// Baris roll yang hak pilihnya (can_vote) belum ditetapkan portal belum bisa
// memilih; panitia perlu meminta portal menetapkannya lalu menyegarkan roll.
const undetermined = (await db?.prepare('SELECT COUNT(*) AS n FROM voters WHERE can_vote IS NULL').first<{ n: number }>())?.n ?? 0;
const sync = await db?.prepare("SELECT value FROM system_config WHERE key='pemilih_last_sync'").first<{ value: string }>();
const formatJst = (value: string) => new Intl.DateTimeFormat("id-ID", { timeZone: "Asia/Tokyo", day: "numeric", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit", hourCycle: "h23" }).format(new Date(value)) + " JST";
const pageQuery = (target: number) => `?q=${encodeURIComponent(q)}&komsat=${encodeURIComponent(komsat)}&status=${filter}&page=${Math.max(1, target)}`;
const controlClass = "w-full min-w-0 rounded-md border border-input bg-card px-3 text-base shadow-xs transition-[color,box-shadow] placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-none min-[600px]:text-[13px]";
---
<AdminLayout title="Pemilih">
  <PageHeader title="Daftar Pemilih" eyebrow="Admin Voting" description="Cari anggota, periksa status partisipasi, dan sinkronkan daftar secara manual.">
    <Button id="sync" type="button" variant="secondary" size="sm" aria-controls="sync-status"><IconRefresh size={16} stroke={1.8} aria-hidden="true" /> Sinkronkan Data Pemilih</Button>
    <Button id="sync-names" type="button" variant="secondary" size="sm" aria-controls="sync-status">Perbarui Nama &amp; Kategori dari Portal</Button>
  </PageHeader>
  <Callout id="sync-status" tone="info" role="status" aria-live="polite" hidden class="mt-4"><span id="sync-status-text"></span></Callout>
  <PanelCard title="Pencarian anggota" description={`Terakhir sinkron: ${sync?.value ? formatJst(sync.value) : "Belum pernah"}`} icon={IconSearch} class="mt-5">
    {undetermined > 0 && <Callout tone="warning" icon={IconAlertTriangle} title="Hak pilih belum ditentukan" class="mb-4">{undetermined} anggota belum ditentukan hak pilihnya oleh portal dan belum bisa memilih. Minta Admin Portal menetapkan kategori anggota, lalu tekan "Perbarui Nama &amp; Kategori dari Portal".</Callout>}
    <form class="grid items-start gap-x-3.5 gap-y-4 min-[601px]:grid-cols-2 min-[1101px]:grid-cols-[minmax(12rem,1fr)_minmax(10rem,1fr)_minmax(10rem,1fr)_auto] min-[1101px]:items-end [&_input]:min-[600px]:h-8 [&_input]:max-[600px]:min-h-11 [&_select]:min-[600px]:h-8 [&_select]:max-[600px]:min-h-11">
      <FormField label="Nama anggota" for="voter-query">
        <input id="voter-query" class={controlClass} name="q" value={q} placeholder="Cari nama" />
      </FormField>
      <FormField label="Komsat" for="voter-komsat">
        <select id="voter-komsat" class={controlClass} name="komsat">
          <option value="">Semua komsat</option>
          {units.results.map((u: any) => <option selected={komsat === u.komsat_path} value={u.komsat_path}>{unitPathLabel(u.komsat_path, unitNames)}</option>)}
        </select>
      </FormField>
      <FormField label="Status suara" for="voter-status">
        <select id="voter-status" class={controlClass} name="status">
          <option value="">Semua status</option>
          <option value="voted" selected={filter === 'voted'}>Sudah memilih</option>
          <option value="not-voted" selected={filter === 'not-voted'}>Belum memilih</option>
        </select>
      </FormField>
      <Button type="submit" variant="primary" size="sm" class="min-[601px]:col-span-2 min-[1101px]:col-span-1">Cari</Button>
    </form>
  </PanelCard>
  <DataTable
    class="mt-5"
    title="Hasil pencarian"
    description="Status partisipasi terlihat oleh Admin Voting; pilihan suara tetap rahasia."
    footerText={`${rows.results.length} baris ditampilkan`}
    pageLabel={`Halaman ${page}`}
    previousHref={pageQuery(page - 1)}
    nextHref={pageQuery(page + 1)}
    previousDisabled={page <= 1}
    nextDisabled={rows.results.length === 0}
  >
    {rows.results.length
      ? <>
          <table class="w-full min-w-[44rem] caption-bottom text-sm max-[759px]:hidden">
            <thead>
              <tr class="border-b border-brand-border">
                <th class="h-10 px-4 text-left align-middle text-xs font-medium whitespace-nowrap text-brand-muted sm:px-5">Nama</th>
                <th class="h-10 px-2 text-left align-middle text-xs font-medium whitespace-nowrap text-brand-muted">Nomor kartu</th>
                <th class="h-10 px-2 text-left align-middle text-xs font-medium whitespace-nowrap text-brand-muted">Kategori</th>
                <th class="h-10 px-2 text-left align-middle text-xs font-medium whitespace-nowrap text-brand-muted">Komsat</th>
                <th class="h-10 py-0 pr-4 pl-2 text-left align-middle text-xs font-medium whitespace-nowrap text-brand-muted sm:pr-5">Status</th>
              </tr>
            </thead>
            <tbody>
              {rows.results.map((v: any) => (
                <tr class="border-b border-brand-border transition-colors last:border-b-0 hover:bg-muted/50">
                  <th scope="row" class="px-4 py-3 text-left align-middle text-[13px] font-semibold text-brand-ink sm:px-5">{v.name}</th>
                  <td class="px-2 py-3 align-middle font-mono text-xs whitespace-nowrap text-brand-muted">{v.member_number ?? "—"}</td>
                  <td class="px-2 py-3 align-middle">
                    <Badge tone={v.can_vote === 1 ? "neutral" : v.can_vote === 0 ? "danger" : "warning"} size="sm">
                      {v.can_vote === 1 ? memberCategoryLabel(v.category) : v.can_vote === 0 ? "Tidak berhak memilih" : "Belum ditentukan"}
                    </Badge>
                  </td>
                  <td class="px-2 py-3 align-middle text-[13px]">{unitPathLabel(v.komsat_path, unitNames)}</td>
                  <td class="py-3 pr-4 pl-2 align-middle sm:pr-5">
                    <Badge tone={v.voted ? "success" : "neutral"} size="sm">{v.voted ? "Sudah memilih" : "Belum memilih"}</Badge>
                    {v.voted ? <p class="mt-1 mb-0 text-xs whitespace-nowrap text-brand-muted">{formatJst(v.voted_at)}</p> : null}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          <div class="min-[760px]:hidden">
            {rows.results.map((v: any) => (
              <ListRow title={v.name} subtitle={`${v.member_number ?? "Nomor kartu belum tersedia"} · ${unitPathLabel(v.komsat_path, unitNames)}`}>
                <span slot="trailing" class="flex flex-col items-end gap-1">
                  <Badge tone={v.voted ? "success" : "neutral"} size="sm">{v.voted ? "Sudah memilih" : "Belum memilih"}</Badge>
                  <Badge tone={v.can_vote === 1 ? "neutral" : v.can_vote === 0 ? "danger" : "warning"} size="sm">{v.can_vote === 1 ? memberCategoryLabel(v.category) : v.can_vote === 0 ? "Tidak berhak memilih" : "Belum ditentukan"}</Badge>
                </span>
              </ListRow>
            ))}
          </div>
        </>
      : <Empty icon={IconUsers} title="Tidak ada pemilih yang cocok" description="Ubah kata kunci, komsat, atau status suara lalu cari kembali." class="m-4 border-0 bg-transparent" />}
  </DataTable>
  <script is:inline>
(function () {
  // Tombol aksi admin: setiap tombol mengirim permintaannya sendiri dan hasilnya
  // tampil tepat di bawah judul halaman. Sebelumnya hasil ditulis di panel
  // pencarian, jauh di bawah tombol, sehingga di ponsel sebuah klik tampak
  // tidak melakukan apa-apa. Pendengar juga dipasang dengan penjaga null supaya
  // satu elemen yang hilang tidak mematikan sisa skrip.
  const status = document.querySelector('#sync-status');
  const statusText = document.querySelector('#sync-status-text');
  const syncButton = document.querySelector('#sync');
  const namesButton = document.querySelector('#sync-names');
  const buttons = [syncButton, namesButton];
  const TONE_CLASSES = {
    info: ['bg-[#f0f4fa]', 'text-[#4c627b]'],
    success: ['bg-[#f1f5f3]', 'text-[#35604a]'],
    danger: ['border', 'border-[#f0ccd4]', 'bg-[#fdf2f4]', 'text-[#8f1730]'],
  };
  const ALL_TONES = TONE_CLASSES.info.concat(TONE_CLASSES.success, TONE_CLASSES.danger);
  function showStatus(tone, text) {
    if (!status || !statusText) return;
    status.hidden = false;
    status.setAttribute('data-tone', tone);
    status.setAttribute('role', tone === 'danger' ? 'alert' : 'status');
    ALL_TONES.forEach(function (name) { status.classList.remove(name); });
    TONE_CLASSES[tone].forEach(function (name) { status.classList.add(name); });
    statusText.textContent = text;
  }
  function setBusy(busy) {
    buttons.forEach(function (button) {
      if (!button) return;
      button.disabled = busy;
      button.setAttribute('aria-busy', busy ? 'true' : 'false');
    });
  }
  function failureText(response, body) {
    // Server mengirim pesan Bahasa Indonesia; balasan tanpa JSON (mis. halaman
    // galat Cloudflare) diterjemahkan dari kode status.
    if (body && typeof body.error === 'string' && body.error) return body.error;
    if (response.status === 401) return 'Sesi Anda tidak diizinkan menyinkronkan data (401). Masuk kembali lalu coba lagi.';
    if (response.status === 403) return 'Akun ini tidak berwenang menyinkronkan data (403). Masuk sebagai Admin Voting.';
    if (response.status === 409) return 'Sinkronisasi hanya bisa dijalankan saat pemilihan berstatus draf (409).';
    if (response.status === 502 || response.status === 504) return 'Portal belum bisa dihubungi (' + response.status + '). Coba lagi beberapa saat.';
    return 'Sinkronisasi gagal (' + response.status + '). Coba lagi beberapa saat.';
  }
  async function run(button, path, busyText, done) {
    if (!button || button.disabled) return;
    setBusy(true);
    showStatus('info', busyText);
    try {
      const response = await fetch(path, { method: 'POST', credentials: 'same-origin', headers: { accept: 'application/json' } });
      let body = null;
      try { body = await response.json(); } catch { body = null; }
      if (response.ok) showStatus('success', done(body || {}));
      else showStatus('danger', failureText(response, body));
    } catch {
      showStatus('danger', 'Tidak dapat menghubungi server. Periksa koneksi internet lalu coba lagi.');
    } finally {
      setBusy(false);
    }
  }
  if (syncButton) syncButton.addEventListener('click', function () {
    run(syncButton, '/api/admin/sync', 'Menyinkronkan data pemilih dari portal...', function (body) {
      return 'Sinkronisasi selesai: ' + (body.added || 0) + ' pemilih baru, ' + (body.removed || 0) + ' keluar.' + (body.excluded ? ' ' + body.excluded + ' anggota tanpa hak pilih tidak dimasukkan.' : '');
    });
  });
  if (namesButton) namesButton.addEventListener('click', function () {
    run(namesButton, '/api/admin/sync-names', 'Memperbarui nama, nomor kartu, dan kategori dari portal...', function (body) {
      return 'Nama, nomor kartu, dan kategori diperbarui untuk ' + (body.updated || 0) + ' pemilih.';
    });
  });
})();
</script>
</AdminLayout>
