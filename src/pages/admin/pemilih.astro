---
import { env } from "cloudflare:workers";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { isAdminPageAuthorized, SESSION_COOKIE, type AdminBindings } from "./admin-auth";
const bindings=env as unknown as AdminBindings;const authorized=await isAdminPageAuthorized(Astro.cookies.get(SESSION_COOKIE)?.value,bindings);const db=authorized?bindings.DB:undefined;const page=Math.max(1,Number(Astro.url.searchParams.get('page')||1));const q=Astro.url.searchParams.get('q')||'';const komsat=Astro.url.searchParams.get('komsat')||'';const filter=Astro.url.searchParams.get('status')||'';
const rows=await db?.prepare("SELECT v.member_id,v.name,v.komsat_path,p.voted_at,CASE WHEN p.member_id IS NULL THEN 0 ELSE 1 END AS voted FROM voters v LEFT JOIN participation p ON p.member_id=v.member_id AND p.election_id=(SELECT MAX(id) FROM elections) WHERE (?='' OR v.name LIKE ?) AND (?='' OR v.komsat_path=?) AND (?='' OR (?='voted' AND p.member_id IS NOT NULL) OR (?='not-voted' AND p.member_id IS NULL)) ORDER BY v.name LIMIT 50 OFFSET ?").bind(q,q?`%${q}%`:'',komsat,komsat,filter,filter,filter,(page-1)*50).all()??{results:[]};
const units=await db?.prepare('SELECT DISTINCT komsat_path FROM voters ORDER BY komsat_path').all<{komsat_path:string}>()??{results:[]};const sync=await db?.prepare("SELECT value FROM system_config WHERE key='pemilih_last_sync'").first<{value:string}>();const formatUnitPath=(path:string)=>path.split('/').filter(Boolean).slice(1).map((part)=>part.replace(/[-_]+/g,' ').replace(/(^|\s)\S/g,(c)=>c.toUpperCase())).join(' · ');const formatJst=(value:string)=>new Intl.DateTimeFormat("id-ID",{timeZone:"Asia/Tokyo",day:"numeric",month:"short",year:"numeric",hour:"2-digit",minute:"2-digit",hourCycle:"h23"}).format(new Date(value))+" JST";
---
<AdminLayout title="Pemilih">
  <div class="mb-6"><p class="text-sm font-semibold text-primary">ADMIN VOTING</p><h1 class="mt-1 text-3xl font-bold tracking-tight">Daftar Pemilih</h1><p class="mt-2 text-muted-foreground">Cari anggota, periksa status partisipasi, dan sinkronkan daftar secara manual.</p></div>
  <section class="rounded-xl border border-border bg-card p-4 shadow-sm sm:p-6">
    <div class="flex flex-wrap items-start justify-between gap-4"><div><h2 class="text-lg font-semibold">Pencarian anggota</h2><p class="mt-1 text-sm text-muted-foreground">Terakhir sinkron: {sync?.value ? formatJst(sync.value) : "Belum pernah"}</p></div><button id="sync" type="button" class="min-h-11 rounded-md border border-border bg-card px-4 font-semibold hover:bg-accent focus-visible:outline-2 focus-visible:outline-ring">Sinkronkan Data Pemilih</button><button id="sync-names" type="button" class="min-h-11 rounded-md border border-border bg-card px-4 font-semibold hover:bg-accent focus-visible:outline-2 focus-visible:outline-ring">Perbarui Nama dari Portal</button></div>
    <form class="mt-5 grid gap-4 border-t border-border pt-5 sm:grid-cols-2 lg:grid-cols-[minmax(12rem,1fr)_minmax(10rem,1fr)_minmax(10rem,1fr)_auto] lg:items-end">
      <div><label for="voter-query" class="text-sm font-semibold">Nama anggota</label><input id="voter-query" class="mt-1 min-h-11 w-full rounded-md border border-input bg-card px-3 focus-visible:outline-2 focus-visible:outline-ring" name="q" value={q} placeholder="Cari nama"/></div>
      <div><label for="voter-komsat" class="text-sm font-semibold">Komsat</label><select id="voter-komsat" class="mt-1 min-h-11 w-full rounded-md border border-input bg-card px-3 focus-visible:outline-2 focus-visible:outline-ring" name="komsat"><option value="">Semua komsat</option>{units.results.map((u:any)=><option selected={komsat===u.komsat_path} value={u.komsat_path}>{formatUnitPath(u.komsat_path)}</option>)}</select></div>
      <div><label for="voter-status" class="text-sm font-semibold">Status suara</label><select id="voter-status" class="mt-1 min-h-11 w-full rounded-md border border-input bg-card px-3 focus-visible:outline-2 focus-visible:outline-ring" name="status"><option value="">Semua status</option><option value="voted" selected={filter==='voted'}>Sudah memilih</option><option value="not-voted" selected={filter==='not-voted'}>Belum memilih</option></select></div>
      <button class="min-h-11 rounded-md bg-primary px-4 font-semibold text-primary-foreground hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-ring">Cari</button>
    </form>
    <p id="sync-result" role="status" aria-live="polite" class="mt-4 text-sm text-muted-foreground"></p>
  </section>
  <section aria-labelledby="voter-results-title" class="mt-5 overflow-hidden rounded-xl border border-border bg-card shadow-sm"><div class="border-b border-border px-4 py-4 sm:px-6"><h2 id="voter-results-title" class="text-lg font-semibold">Hasil pencarian</h2><p class="text-sm text-muted-foreground">Status partisipasi terlihat oleh Admin Voting; pilihan suara tetap rahasia.</p></div>
    {rows.results.length ? <div class="overflow-x-auto"><table class="w-full min-w-[38rem] text-left text-sm"><thead class="bg-background text-muted-foreground"><tr><th class="px-4 py-3 font-semibold sm:px-6">Nama</th><th class="px-4 py-3 font-semibold">ID</th><th class="px-4 py-3 font-semibold">Komsat</th><th class="px-4 py-3 font-semibold">Status</th></tr></thead><tbody>{rows.results.map((v:any)=><tr class="border-t border-border"><td class="px-4 py-3 font-semibold sm:px-6">{v.name}</td><td class="px-4 py-3 font-mono text-xs">{v.member_id}</td><td class="px-4 py-3">{formatUnitPath(v.komsat_path)}</td><td class="px-4 py-3"><span class:list={["inline-flex rounded-full px-3 py-1 text-xs font-semibold", v.voted ? "bg-emerald-50 text-emerald-800" : "bg-muted text-muted-foreground"]}>{v.voted?'Sudah memilih · '+formatJst(v.voted_at):'Belum memilih'}</span></td></tr>)}</tbody></table></div> : <p class="p-6 text-muted-foreground">Tidak ada pemilih yang cocok dengan pencarian ini.</p>}
  </section>
  <nav aria-label="Halaman daftar pemilih" class="mt-4 flex items-center justify-between gap-3 text-sm font-semibold"><a class="min-h-11 rounded-md px-3 py-2 text-primary hover:bg-brand-50" href={`?q=${encodeURIComponent(q)}&komsat=${encodeURIComponent(komsat)}&status=${filter}&page=${Math.max(1,page-1)}`}>Sebelumnya</a><span class="text-muted-foreground">Halaman {page}</span><a class="min-h-11 rounded-md px-3 py-2 text-primary hover:bg-brand-50" href={`?q=${encodeURIComponent(q)}&komsat=${encodeURIComponent(komsat)}&status=${filter}&page=${page+1}`}>Berikutnya</a></nav>
  <script is:inline>document.querySelector('#sync').onclick=async()=>{const out=document.querySelector('#sync-result');out.textContent='Sinkronisasi berjalan…';try{const r=await fetch('/api/admin/sync',{method:'POST'});const d=await r.json();out.textContent=r.ok?`Sinkronisasi selesai: +${d.added??0} baru / -${d.removed??0} keluar`:(d.error||'Sinkronisasi gagal')}catch{out.textContent='Sinkronisasi gagal'}};document.querySelector('#sync-names').onclick=async()=>{const out=document.querySelector('#sync-result');out.textContent='Memperbarui nama…';try{const r=await fetch('/api/admin/sync-names',{method:'POST'});const d=await r.json();out.textContent=r.ok?`Nama diperbarui untuk ${d.updated??0} pemilih`:(d.error||'Pembaruan gagal')}catch{out.textContent='Pembaruan gagal'}}</script></AdminLayout>
