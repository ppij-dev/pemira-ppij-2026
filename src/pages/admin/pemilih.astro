---
import { env } from "cloudflare:workers";
import { IconRefresh, IconSearch, IconUsers } from "@tabler/icons-astro";
import AdminLayout from "../../layouts/AdminLayout.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import PanelCard from "../../components/ui/PanelCard.astro";
import DataTable from "../../components/ui/DataTable.astro";
import ListRow from "../../components/ui/ListRow.astro";
import Badge from "../../components/ui/Badge.astro";
import Button from "../../components/ui/Button.astro";
import FormField from "../../components/ui/FormField.astro";
import Empty from "../../components/ui/Empty.astro";
import { isAdminPageAuthorized, SESSION_COOKIE, type AdminBindings } from "./admin-auth";
const bindings = env as unknown as AdminBindings;
const authorized = await isAdminPageAuthorized(Astro.cookies.get(SESSION_COOKIE)?.value, bindings);
const db = authorized ? bindings.DB : undefined;
const page = Math.max(1, Number(Astro.url.searchParams.get('page') || 1));
const q = Astro.url.searchParams.get('q') || '';
const komsat = Astro.url.searchParams.get('komsat') || '';
const filter = Astro.url.searchParams.get('status') || '';
const rows = await db?.prepare("SELECT v.member_id,v.name,v.komsat_path,p.voted_at,CASE WHEN p.member_id IS NULL THEN 0 ELSE 1 END AS voted FROM voters v LEFT JOIN participation p ON p.member_id=v.member_id AND p.election_id=(SELECT MAX(id) FROM elections) WHERE (?='' OR v.name LIKE ?) AND (?='' OR v.komsat_path=?) AND (?='' OR (?='voted' AND p.member_id IS NOT NULL) OR (?='not-voted' AND p.member_id IS NULL)) ORDER BY v.name LIMIT 50 OFFSET ?").bind(q,q?`%${q}%`:'',komsat,komsat,filter,filter,filter,(page-1)*50).all() ?? { results: [] };
const units = await db?.prepare('SELECT DISTINCT komsat_path FROM voters ORDER BY komsat_path').all<{ komsat_path: string }>() ?? { results: [] };
const sync = await db?.prepare("SELECT value FROM system_config WHERE key='pemilih_last_sync'").first<{ value: string }>();
const formatUnitPath = (path: string) => path.split('/').filter(Boolean).slice(1).map((part) => part.replace(/[-_]+/g, ' ').replace(/(^|\s)\S/g, (c) => c.toUpperCase())).join(' · ');
const formatJst = (value: string) => new Intl.DateTimeFormat("id-ID", { timeZone: "Asia/Tokyo", day: "numeric", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit", hourCycle: "h23" }).format(new Date(value)) + " JST";
const pageQuery = (target: number) => `?q=${encodeURIComponent(q)}&komsat=${encodeURIComponent(komsat)}&status=${filter}&page=${Math.max(1, target)}`;
const controlClass = "w-full min-w-0 rounded-md border border-input bg-card px-3 text-base shadow-xs transition-[color,box-shadow] placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-none min-[600px]:text-[13px]";
---
<AdminLayout title="Pemilih">
  <PageHeader title="Daftar Pemilih" eyebrow="Admin Voting" description="Cari anggota, periksa status partisipasi, dan sinkronkan daftar secara manual.">
    <Button id="sync" type="button" variant="secondary" size="sm"><IconRefresh size={16} stroke={1.8} aria-hidden="true" /> Sinkronkan Data Pemilih</Button>
    <Button id="sync-names" type="button" variant="secondary" size="sm">Perbarui Nama dari Portal</Button>
  </PageHeader>
  <PanelCard title="Pencarian anggota" description={`Terakhir sinkron: ${sync?.value ? formatJst(sync.value) : "Belum pernah"}`} icon={IconSearch} class="mt-5">
    <form class="grid items-start gap-x-3.5 gap-y-4 min-[601px]:grid-cols-2 min-[1101px]:grid-cols-[minmax(12rem,1fr)_minmax(10rem,1fr)_minmax(10rem,1fr)_auto] min-[1101px]:items-end [&_input]:min-[600px]:h-8 [&_input]:max-[600px]:min-h-11 [&_select]:min-[600px]:h-8 [&_select]:max-[600px]:min-h-11">
      <FormField label="Nama anggota" for="voter-query">
        <input id="voter-query" class={controlClass} name="q" value={q} placeholder="Cari nama" />
      </FormField>
      <FormField label="Komsat" for="voter-komsat">
        <select id="voter-komsat" class={controlClass} name="komsat">
          <option value="">Semua komsat</option>
          {units.results.map((u: any) => <option selected={komsat === u.komsat_path} value={u.komsat_path}>{formatUnitPath(u.komsat_path)}</option>)}
        </select>
      </FormField>
      <FormField label="Status suara" for="voter-status">
        <select id="voter-status" class={controlClass} name="status">
          <option value="">Semua status</option>
          <option value="voted" selected={filter === 'voted'}>Sudah memilih</option>
          <option value="not-voted" selected={filter === 'not-voted'}>Belum memilih</option>
        </select>
      </FormField>
      <Button type="submit" variant="primary" size="sm" class="min-[601px]:col-span-2 min-[1101px]:col-span-1">Cari</Button>
    </form>
    <p id="sync-result" role="status" aria-live="polite" class="mt-4 mb-0 text-[13px] text-brand-muted"></p>
  </PanelCard>
  <DataTable
    class="mt-5"
    title="Hasil pencarian"
    description="Status partisipasi terlihat oleh Admin Voting; pilihan suara tetap rahasia."
    footerText={`${rows.results.length} baris ditampilkan`}
    pageLabel={`Halaman ${page}`}
    previousHref={pageQuery(page - 1)}
    nextHref={pageQuery(page + 1)}
    previousDisabled={page <= 1}
    nextDisabled={rows.results.length === 0}
  >
    {rows.results.length
      ? <>
          <table class="w-full min-w-[38rem] caption-bottom text-sm max-[759px]:hidden">
            <thead>
              <tr class="border-b border-brand-border">
                <th class="h-10 px-4 text-left align-middle text-xs font-medium whitespace-nowrap text-brand-muted sm:px-5">Nama</th>
                <th class="h-10 px-2 text-left align-middle text-xs font-medium whitespace-nowrap text-brand-muted">ID</th>
                <th class="h-10 px-2 text-left align-middle text-xs font-medium whitespace-nowrap text-brand-muted">Komsat</th>
                <th class="h-10 px-2 text-left align-middle text-xs font-medium whitespace-nowrap text-brand-muted">Status</th>
              </tr>
            </thead>
            <tbody>
              {rows.results.map((v: any) => (
                <tr class="border-b border-brand-border transition-colors last:border-b-0 hover:bg-muted/50">
                  <th scope="row" class="px-4 py-3 text-left align-middle text-[13px] font-semibold text-brand-ink sm:px-5">{v.name}</th>
                  <td class="px-2 py-3 align-middle font-mono text-xs whitespace-nowrap text-brand-muted">{v.member_id}</td>
                  <td class="px-2 py-3 align-middle text-[13px]">{formatUnitPath(v.komsat_path)}</td>
                  <td class="px-2 py-3 align-middle">
                    <Badge tone={v.voted ? "success" : "neutral"} size="sm">{v.voted ? `Sudah memilih · ${formatJst(v.voted_at)}` : "Belum memilih"}</Badge>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          <div class="min-[760px]:hidden">
            {rows.results.map((v: any) => (
              <ListRow title={v.name} subtitle={`${v.member_id} · ${formatUnitPath(v.komsat_path)}`}>
                <span slot="trailing"><Badge tone={v.voted ? "success" : "neutral"} size="sm">{v.voted ? "Sudah memilih" : "Belum memilih"}</Badge></span>
              </ListRow>
            ))}
          </div>
        </>
      : <Empty icon={IconUsers} title="Tidak ada pemilih yang cocok" description="Ubah kata kunci, komsat, atau status suara lalu cari kembali." class="m-4 border-0 bg-transparent" />}
  </DataTable>
  <script is:inline>
document.querySelector('#sync').onclick=async()=>{const out=document.querySelector('#sync-result');out.textContent='Sinkronisasi berjalan...';try{const r=await fetch('/api/admin/sync',{method:'POST'});const d=await r.json();out.textContent=r.ok?`Sinkronisasi selesai: +${d.added??0} baru / -${d.removed??0} keluar`:(d.error||'Sinkronisasi gagal')}catch{out.textContent='Sinkronisasi gagal. Periksa jaringan lalu coba kembali.'}};document.querySelector('#sync-names').onclick=async()=>{const out=document.querySelector('#sync-result');out.textContent='Memperbarui nama...';try{const r=await fetch('/api/admin/sync-names',{method:'POST'});const d=await r.json();out.textContent=r.ok?`Nama diperbarui untuk ${d.updated??0} pemilih`:(d.error||'Pembaruan gagal')}catch{out.textContent='Pembaruan gagal. Periksa jaringan lalu coba kembali.'}}
</script>
</AdminLayout>