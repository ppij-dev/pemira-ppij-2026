---
import { env } from "cloudflare:workers";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { isAdminPageAuthorized, SESSION_COOKIE, type AdminBindings } from "./admin-auth";
const bindings=env as unknown as AdminBindings;const authorized=await isAdminPageAuthorized(Astro.cookies.get(SESSION_COOKIE)?.value,bindings);const db=authorized?bindings.DB:undefined;const page=Math.max(1,Number(Astro.url.searchParams.get('page')||1));const q=Astro.url.searchParams.get('q')||'';const komsat=Astro.url.searchParams.get('komsat')||'';const filter=Astro.url.searchParams.get('status')||'';
const rows=await db?.prepare("SELECT v.member_id,v.name,v.komsat_path,p.voted_at,CASE WHEN p.member_id IS NULL THEN 0 ELSE 1 END AS voted FROM voters v LEFT JOIN participation p ON p.member_id=v.member_id AND p.election_id=(SELECT MAX(id) FROM elections) WHERE (?='' OR v.name LIKE ?) AND (?='' OR v.komsat_path=?) AND (?='' OR (?='voted' AND p.member_id IS NOT NULL) OR (?='not-voted' AND p.member_id IS NULL)) ORDER BY v.name LIMIT 50 OFFSET ?").bind(q,q?`%${q}%`:'',komsat,komsat,filter,filter,filter,(page-1)*50).all()??{results:[]};
const units=await db?.prepare('SELECT DISTINCT komsat_path FROM voters ORDER BY komsat_path').all<{komsat_path:string}>()??{results:[]};const sync=await db?.prepare("SELECT value FROM system_config WHERE key='pemilih_last_sync'").first<{value:string}>();const formatJst=(value:string)=>new Intl.DateTimeFormat("id-ID",{timeZone:"Asia/Tokyo",day:"numeric",month:"short",year:"numeric",hour:"2-digit",minute:"2-digit",hourCycle:"h23"}).format(new Date(value))+" JST";
---
<AdminLayout title="Pemilih"><h1 class="mb-5 text-2xl font-bold">Daftar Pemilih</h1><section class="mb-5 rounded-xl border bg-white p-4"><form class="flex flex-wrap gap-2"><input class="min-h-11 rounded-lg border px-3" name="q" value={q} placeholder="Cari nama"/><select class="min-h-11 rounded-lg border px-3" name="komsat"><option value="">Semua komsat</option>{units.results.map((u:any)=><option selected={komsat===u.komsat_path} value={u.komsat_path}>{u.komsat_path}</option>)}</select><select class="min-h-11 rounded-lg border px-3" name="status"><option value="">Semua status suara</option><option value="voted" selected={filter==='voted'}>Sudah memilih</option><option value="not-voted" selected={filter==='not-voted'}>Belum memilih</option></select><button class="rounded-lg bg-primary px-4 text-white">Cari</button></form><p class="mt-3 text-sm text-slate-600">Terakhir sinkron: {sync?.value ? formatJst(sync.value) : "Belum pernah"}</p><button id="sync" class="mt-2 min-h-11 rounded-lg border px-4 font-semibold">Sinkronkan Data Pemilih</button><p id="sync-result" aria-live="polite"></p></section><div class="overflow-x-auto rounded-xl border bg-white"><table class="w-full text-left"><thead><tr class="border-b"><th class="p-3">Nama</th><th class="p-3">ID</th><th class="p-3">Komsat</th><th class="p-3">Status</th></tr></thead><tbody>{rows.results.map((v:any)=><tr class="border-b"><td class="p-3">{v.name}</td><td class="p-3">{v.member_id}</td><td class="p-3">{v.komsat_path}</td><td class="p-3">{v.voted?'Sudah memilih · '+formatJst(v.voted_at):'Belum memilih'}</td></tr>)}</tbody></table></div><nav class="mt-4 flex justify-between"><a class="underline" href={`?q=${encodeURIComponent(q)}&komsat=${encodeURIComponent(komsat)}&status=${filter}&page=${Math.max(1,page-1)}`}>Sebelumnya</a><span>Halaman {page}</span><a class="underline" href={`?q=${encodeURIComponent(q)}&komsat=${encodeURIComponent(komsat)}&status=${filter}&page=${page+1}`}>Berikutnya</a></nav><script is:inline>document.querySelector('#sync').onclick=async()=>{const out=document.querySelector('#sync-result');out.textContent='Sinkronisasi berjalan…';try{const r=await fetch('/api/admin/sync',{method:'POST'});const d=await r.json();out.textContent=r.ok?`Sinkronisasi selesai: +${d.added??0} baru / -${d.removed??0} keluar`:(d.error||'Sinkronisasi gagal')}catch{out.textContent='Sinkronisasi gagal'}}</script></AdminLayout>
