---
import { env } from "cloudflare:workers";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { isAdminPageAuthorized, SESSION_COOKIE, type AdminBindings } from "./admin-auth";
import { markdownToPlain } from "../../server/lib/markdown";
const bindings=env as unknown as AdminBindings;const authorized=await isAdminPageAuthorized(Astro.cookies.get(SESSION_COOKIE)?.value,bindings);const db=authorized?bindings.DB:undefined;
const formatUnitPath=(path:string)=>path.split('/').filter(Boolean).slice(1).map((part)=>part.replace(/[-_]+/g,' ').replace(/(^|\s)\S/g,(c)=>c.toUpperCase())).join(' · ');
const candidates=await db?.prepare('SELECT id,member_id,number,name,nickname,komsat_path,description,color FROM candidates ORDER BY number').all()??{results:[]};
const voters=await db?.prepare('SELECT member_id,name FROM voters WHERE status=? ORDER BY name LIMIT 500').bind('ACTIVE').all()??{results:[]};
---
<AdminLayout title="Kandidat">
  <div class="mb-6"><p class="text-sm font-semibold text-primary">ADMIN VOTING</p><h1 class="mt-1 text-3xl font-bold tracking-tight">Kandidat</h1><p class="mt-2 text-muted-foreground">Kelola kandidat dari anggota aktif sebelum pemilihan dikunci.</p></div>
  <section class="mb-6 rounded-xl border border-border bg-card p-4 shadow-sm sm:p-6">
    <div class="border-b border-border pb-4"><h2 class="text-lg font-semibold">Tambah / Ubah Kandidat</h2><p class="mt-1 text-sm text-muted-foreground">Gunakan deskripsi teks biasa. Nomor dan nickname setiap kandidat harus berbeda.</p></div>
    <form id="candidate" class="mt-5 grid gap-4 sm:grid-cols-2">
      <div><label for="candidate-member" class="text-sm font-semibold">ID anggota</label><input id="candidate-member" name="member_id" list="members" required placeholder="Pilih anggota aktif" class="mt-1 min-h-11 w-full rounded-md border border-input bg-card px-3 focus-visible:outline-2 focus-visible:outline-ring"/><datalist id="members">{voters.results.map((v:any)=><option value={v.member_id}>{v.name}</option>)}</datalist></div>
      <div><label for="candidate-number" class="text-sm font-semibold">Nomor urut</label><input id="candidate-number" name="number" type="number" min="1" required placeholder="Nomor urut kandidat" class="mt-1 min-h-11 w-full rounded-md border border-input bg-card px-3 focus-visible:outline-2 focus-visible:outline-ring"/></div>
      <div><label for="candidate-name" class="text-sm font-semibold">Nama</label><input id="candidate-name" name="name" required placeholder="Nama lengkap" class="mt-1 min-h-11 w-full rounded-md border border-input bg-card px-3 focus-visible:outline-2 focus-visible:outline-ring"/></div>
      <div><label for="candidate-nickname" class="text-sm font-semibold">Nama panggilan</label><input id="candidate-nickname" name="nickname" required placeholder="Nickname untuk konfirmasi suara" class="mt-1 min-h-11 w-full rounded-md border border-input bg-card px-3 focus-visible:outline-2 focus-visible:outline-ring"/></div>
      <div><label for="candidate-color" class="text-sm font-semibold">Warna kandidat</label><input id="candidate-color" name="color" type="color" class="mt-1 h-11 w-24 rounded-md border border-input bg-card p-1 focus-visible:outline-2 focus-visible:outline-ring"/></div>
      <div class="sm:col-span-2"><label for="candidate-description" class="text-sm font-semibold">Konten artikel (Markdown)</label><p class="mt-1 text-xs text-muted-foreground">Mendukung judul (#/##), **tebal**, *miring*, daftar (-), kutipan (&gt;), tautan, dan URL YouTube pada baris sendiri untuk embed video.</p><textarea id="candidate-description" name="description" placeholder="Contoh: ## Visi, daftar dengan - , dan URL YouTube pada baris sendiri untuk embed video" class="mt-1 min-h-44 w-full rounded-md border border-input bg-card p-3 focus-visible:outline-2 focus-visible:outline-ring"></textarea></div>
      <div class="flex flex-wrap gap-3 border-t border-border pt-4 sm:col-span-2"><button class="min-h-11 rounded-md bg-primary px-4 font-semibold text-primary-foreground hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-ring">Simpan Kandidat</button><button type="button" id="reset" class="min-h-11 rounded-md border border-border bg-card px-4 font-semibold hover:bg-accent">Kosongkan</button></div>
    </form>
    <p id="message" role="status" aria-live="polite" class="mt-4 text-sm text-destructive"></p>
  </section>
  <section aria-labelledby="candidate-list-title"><h2 id="candidate-list-title" class="mb-4 text-lg font-semibold">Kandidat terdaftar</h2>
    {candidates.results.length ? <div class="grid gap-3 sm:grid-cols-2">{candidates.results.map((c:any)=><article class="rounded-xl border border-border bg-card p-4 shadow-sm sm:p-5"><div class="flex items-start gap-4"><span class="flex size-11 shrink-0 items-center justify-center rounded-full font-bold text-white" style={`background-color:${c.color||'#334155'}`}>{c.number}</span><div class="min-w-0 flex-1"><h3 class="font-semibold">{c.nickname}</h3><p class="text-sm text-muted-foreground">{c.name} · {c.member_id}</p><p class="mt-1 text-xs text-muted-foreground">{formatUnitPath(c.komsat_path)}</p></div></div>{c.description && <p class="mt-4 line-clamp-3 text-sm text-muted-foreground">{markdownToPlain(c.description)}</p>}<div class="mt-4 flex justify-end gap-4 border-t border-border pt-3"><button type="button" class="min-h-11 font-semibold text-destructive" data-delete={c.id}>Hapus</button><button type="button" class="min-h-11 font-semibold text-primary" data-edit={c.id} data-member={c.member_id} data-number={c.number} data-name={c.name} data-nickname={c.nickname} data-color={c.color||'#334155'} data-description={c.description}>Ubah</button></div></article>)}</div> : <div class="rounded-xl border border-border bg-card p-6 text-muted-foreground">Belum ada kandidat. Tambahkan anggota aktif menggunakan formulir di atas.</div>}
  </section>
  <script is:inline>
const form=document.querySelector('#candidate'),msg=document.querySelector('#message');document.querySelector('#reset').onclick=()=>{form.reset();delete form.dataset.id};form.onsubmit=async e=>{e.preventDefault();const fields=Object.fromEntries(new FormData(form));const number=Number(fields.number);if(!Number.isInteger(number)||number<=0){msg.textContent='Nomor kandidat harus berupa bilangan bulat lebih besar dari 0.';form.elements.number.focus();return}const body={...fields,number};const id=form.dataset.id;const r=await fetch('/api/election/candidates'+(id?'/'+id:''),{method:id?'PUT':'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)});const d=await r.json();if(r.ok)location.reload();else msg.textContent=d.error||'Gagal menyimpan'};document.querySelectorAll('[data-edit]').forEach(b=>b.onclick=()=>{form.dataset.id=b.dataset.edit;for(const k of ['member','number','name','nickname','color','description'])form.elements[k==='member'?'member_id':k].value=b.dataset[k]});document.querySelectorAll('[data-delete]').forEach(b=>b.onclick=async()=>{if(confirm('Hapus kandidat ini?')){const r=await fetch('/api/election/candidates/'+b.dataset.delete,{method:'DELETE'});if(r.ok)location.reload();else msg.textContent=(await r.json()).error||'Gagal menghapus'}});
</script></AdminLayout>
