---
import { env } from "cloudflare:workers";
import { IconId, IconPlus } from "@tabler/icons-astro";
import AdminLayout from "../../layouts/AdminLayout.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import PanelCard from "../../components/ui/PanelCard.astro";
import Badge from "../../components/ui/Badge.astro";
import Button from "../../components/ui/Button.astro";
import FormField from "../../components/ui/FormField.astro";
import Empty from "../../components/ui/Empty.astro";
import { isAdminPageAuthorized, SESSION_COOKIE, type AdminBindings } from "./admin-auth";
const bindings = env as unknown as AdminBindings;
const authorized = await isAdminPageAuthorized(Astro.cookies.get(SESSION_COOKIE)?.value, bindings);
const db = authorized ? bindings.DB : undefined;
const formatUnitPath = (path: string) => path.split('/').filter(Boolean).slice(1).map((part) => part.replace(/[-_]+/g, ' ').replace(/(^|\s)\S/g, (c) => c.toUpperCase())).join(' · ');
const candidates = await db?.prepare('SELECT id,member_id,number,name,nickname,komsat_path,description,short_intro,color FROM candidates ORDER BY number').all() ?? { results: [] };
const voters = await db?.prepare('SELECT member_id,name FROM voters WHERE status=? ORDER BY name LIMIT 500').bind('ACTIVE').all() ?? { results: [] };
const control = "w-full min-w-0 rounded-md border border-input bg-card px-3 text-base shadow-xs transition-[color,box-shadow] placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-none min-[600px]:text-[13px]";
---
<AdminLayout title="Kandidat">
  <PageHeader title="Kandidat" eyebrow="Admin Voting" description="Kelola kandidat dari anggota aktif sebelum pemilihan dikunci." />
  <PanelCard title="Tambah / Ubah Kandidat" description="Nomor urut dan nama panggilan setiap kandidat harus berbeda." icon={IconId} class="mt-5">
    <form id="candidate" class="grid grid-cols-1 items-start gap-x-3.5 gap-y-4 min-[601px]:grid-cols-2 [&_input]:min-[600px]:h-8 [&_input]:max-[600px]:min-h-11">
      <FormField label="ID anggota" for="candidate-member">
        <input id="candidate-member" name="member_id" list="members" required placeholder="Pilih anggota aktif" class={control} />
        <datalist id="members">{voters.results.map((v: any) => <option value={v.member_id}>{v.name}</option>)}</datalist>
      </FormField>
      <FormField label="Nomor urut" for="candidate-number">
        <input id="candidate-number" name="number" type="number" min="1" required placeholder="Nomor urut kandidat" class={control} />
      </FormField>
      <FormField label="Nama" for="candidate-name">
        <input id="candidate-name" name="name" required placeholder="Nama lengkap" maxlength="60" class={control} />
      </FormField>
      <FormField label="Nama panggilan" for="candidate-nickname" hint="Tampil di surat suara dan saat konfirmasi pilihan.">
        <input id="candidate-nickname" name="nickname" required placeholder="Nama panggilan" maxlength="24" class={control} />
      </FormField>
      <FormField label="Warna kandidat" for="candidate-color" hint="Warna dipakai pada nomor urut kandidat.">
        <input id="candidate-color" name="color" type="color" class="h-11 w-24 rounded-md border border-input bg-card p-1 focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-none min-[600px]:h-8" />
      </FormField>
      <FormField label="Intro singkat" for="candidate-short-intro" hint="Hanya tampil di kartu kandidat. Maksimal 100 karakter." wide>
        <textarea id="candidate-short-intro" name="short_intro" maxlength="100" rows="2" aria-describedby="short-intro-count" class="mt-0.5 min-h-20 w-full rounded-md border border-input bg-card px-3 py-2 text-base shadow-xs focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-none min-[600px]:text-[13px]"></textarea>
        <p class="mt-1 flex justify-end text-xs text-brand-muted"><span id="short-intro-count" class="shrink-0 tabular-nums">0/100</span></p>
      </FormField>
      <FormField label="Konten artikel (HTML)" for="candidate-description" hint="Mendukung tag artikel (h2, h3, p, ul/li, strong, em, blockquote, a, img) serta kode semat iframe dari YouTube atau SlideShare." wide>
        <textarea id="candidate-description" name="description" rows="8" placeholder="Contoh: <h2>Visi</h2><p>...</p>" class="min-h-52 w-full rounded-md border border-input bg-card px-3 py-2 font-mono text-base shadow-xs focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-none min-[600px]:text-[13px]"></textarea>
      </FormField>
      <div class="col-span-full flex flex-wrap items-center gap-2 border-t border-brand-border pt-4">
        <Button type="submit" variant="primary" size="sm">Simpan Kandidat</Button>
        <Button type="button" id="reset" variant="secondary" size="sm">Kosongkan</Button>
      </div>
    </form>
    <p id="message" role="status" aria-live="polite" class="mt-3 mb-0 text-[13px] font-semibold text-destructive"></p>
  </PanelCard>

  <section aria-labelledby="candidate-list-title" class="mt-7">
    <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 id="candidate-list-title" class="text-lg leading-snug font-bold tracking-tight text-brand-ink">Kandidat terdaftar</h2>
        <p class="mt-1 text-[13px] text-brand-muted">Nomor urut, nama panggilan, dan warna tampil di surat suara.</p>
      </div>
      <Badge tone="outline" size="sm">{candidates.results.length} kandidat</Badge>
    </div>
    {candidates.results.length
      ? <div class="grid grid-cols-1 gap-[17px] min-[641px]:grid-cols-2">
          {candidates.results.map((c: any) => (
            <article class="min-w-0 rounded-xl border border-brand-border bg-card p-[22px] text-brand-ink max-[700px]:p-[17px]">
              <div class="flex items-start gap-3">
                <span aria-hidden="true" class="grid size-11 shrink-0 place-items-center rounded-lg text-base font-extrabold text-white" style={`background-color:${c.color || '#c8102e'}`}>{c.number}</span>
                <div class="min-w-0">
                  <h3 class="text-base leading-snug font-bold break-words text-brand-ink">{c.nickname}</h3>
                  <p class="mt-0.5 text-[13px] break-words text-brand-muted">{c.name} · {c.member_id}</p>
                  <p class="mt-1 text-xs text-brand-muted">{formatUnitPath(c.komsat_path)}</p>
                </div>
              </div>
              {c.short_intro && <p class="mt-3 mb-0 text-[13px] leading-5 text-brand-ink">{c.short_intro}</p>}
              <div class="mt-4 flex flex-wrap justify-end gap-2 border-t border-brand-border pt-3">
                <Button type="button" variant="ghost" size="sm" data-edit={c.id} data-member={c.member_id} data-number={c.number} data-name={c.name} data-nickname={c.nickname} data-color={c.color || '#c8102e'} data-description={c.description || ''} data-short-intro={c.short_intro || ''}>Ubah</Button>
                <Button type="button" variant="ghost" size="sm" data-delete={c.id} class="text-destructive hover:bg-red-50">Hapus</Button>
              </div>
            </article>
          ))}
        </div>
      : <Empty icon={IconPlus} title="Belum ada kandidat" description="Tambahkan anggota aktif menggunakan formulir di atas." />}
  </section>
  <script is:inline>
const form=document.querySelector('#candidate'),msg=document.querySelector('#message');
const intro=form.elements.short_intro,count=document.querySelector('#short-intro-count');
const updateCount=()=>{count.textContent=`${intro.value.length}/100`};
intro.addEventListener('input',updateCount);
document.querySelector('#reset').onclick=()=>{form.reset();delete form.dataset.id;msg.textContent='';updateCount()};
form.onsubmit=async e=>{
  e.preventDefault();
  const fields=Object.fromEntries(new FormData(form)),number=Number(fields.number);
  if(!Number.isInteger(number)||number<=0){msg.textContent='Nomor kandidat harus berupa bilangan bulat lebih besar dari 0.';form.elements.number.focus();return}
  const button=form.querySelector('button[type="submit"]');
  button.disabled=true;button.textContent='Menyimpan...';msg.textContent='';
  try{
    const id=form.dataset.id;
    const r=await fetch('/api/election/candidates'+(id?'/'+id:''),{method:id?'PUT':'POST',headers:{'content-type':'application/json'},body:JSON.stringify({...fields,number})});
    const d=await r.json();
    if(r.ok)location.reload();else msg.textContent=d.error||'Kandidat belum tersimpan. Coba kembali.';
  }catch{msg.textContent='Koneksi bermasalah. Periksa jaringan lalu simpan kembali.'}
  finally{button.disabled=false;button.textContent='Simpan Kandidat'}
};
document.querySelectorAll('[data-edit]').forEach(b=>b.onclick=()=>{
  form.dataset.id=b.dataset.edit;
  for(const k of ['member','number','name','nickname','color','description'])form.elements[k==='member'?'member_id':k].value=b.dataset[k]||'';
  intro.value=b.dataset.shortIntro||'';updateCount();msg.textContent='';
});
document.querySelectorAll('[data-delete]').forEach(b=>b.onclick=async()=>{if(confirm('Hapus kandidat ini?')){const r=await fetch('/api/election/candidates/'+b.dataset.delete,{method:'DELETE'});if(r.ok)location.reload();else msg.textContent=(await r.json()).error||'Gagal menghapus'}});
</script>
</AdminLayout>