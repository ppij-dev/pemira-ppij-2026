---
import AdminLayout from "../../layouts/AdminLayout.astro";const locals=Astro.locals as typeof Astro.locals & {runtime?:{env?:{DB?:D1Database}}};const db=locals.runtime?.env?.DB;const candidates=await db?.prepare('SELECT id,member_id,number,name,nickname,komsat_path,description,color FROM candidates ORDER BY number').all()??{results:[]};const voters=await db?.prepare('SELECT member_id,name FROM voters WHERE status=? ORDER BY name LIMIT 500').bind('ACTIVE').all()??{results:[]};
---
<AdminLayout title="Kandidat"><h1 class="mb-5 text-2xl font-bold">Kandidat</h1><section class="mb-5 rounded-xl border bg-white p-5"><h2 class="text-lg font-semibold">Tambah / Ubah Kandidat</h2><form id="candidate" class="mt-4 grid gap-3 sm:grid-cols-2"><input name="member_id" list="members" required placeholder="ID anggota" class="rounded-lg border p-3"/><datalist id="members">{voters.results.map((v:any)=><option value={v.member_id}>{v.name}</option>)}</datalist><input name="number" type="number" min="1" required placeholder="Nomor urut" class="rounded-lg border p-3"/><input name="name" required placeholder="Nama" class="rounded-lg border p-3"/><input name="nickname" required placeholder="Nama panggilan" class="rounded-lg border p-3"/><input name="color" type="color" aria-label="Warna kandidat" class="h-12 rounded-lg border p-2"/><textarea name="description" placeholder="Deskripsi (teks biasa)" class="min-h-28 rounded-lg border p-3 sm:col-span-2"></textarea><button class="min-h-11 rounded-lg bg-blue-800 px-4 font-semibold text-white">Simpan Kandidat</button><button type="button" id="reset" class="rounded-lg border px-4">Kosongkan</button></form><p id="message" aria-live="polite"></p></section><section class="grid gap-3">{candidates.results.map((c:any)=><article class="flex items-center gap-4 rounded-xl border bg-white p-4"><span class="flex size-10 items-center justify-center rounded-full font-bold text-white" style={`background-color:${c.color||'#334155'}`}>{c.number}</span><div class="min-w-0 flex-1"><h2 class="font-semibold">{c.nickname} · {c.name}</h2><p class="text-sm text-slate-600">{c.member_id} · {c.description}</p></div><button class="text-red-700" data-delete={c.id}>Hapus</button><button class="underline" data-edit={c.id} data-member={c.member_id} data-number={c.number} data-name={c.name} data-nickname={c.nickname} data-color={c.color||'#334155'} data-description={c.description}>Ubah</button></article>)}</section><script is:inline>
const form=document.querySelector('#candidate'),msg=document.querySelector('#message');document.querySelector('#reset').onclick=()=>{form.reset();delete form.dataset.id};form.onsubmit=async e=>{e.preventDefault();const body=Object.fromEntries(new FormData(form));const id=form.dataset.id;const r=await fetch('/api/election/candidates'+(id?'/'+id:''),{method:id?'PUT':'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)});const d=await r.json();if(r.ok)location.reload();else msg.textContent=d.error||'Gagal menyimpan'};document.querySelectorAll('[data-edit]').forEach(b=>b.onclick=()=>{form.dataset.id=b.dataset.edit;for(const k of ['member','number','name','nickname','color','description'])form.elements[k==='member'?'member_id':k].value=b.dataset[k]});document.querySelectorAll('[data-delete]').forEach(b=>b.onclick=async()=>{if(confirm('Hapus kandidat ini?')){const r=await fetch('/api/election/candidates/'+b.dataset.delete,{method:'DELETE'});if(r.ok)location.reload();else msg.textContent=(await r.json()).error||'Gagal menghapus'}});
</script></AdminLayout>
