---
import AdminLayout from "../../layouts/AdminLayout.astro";
---
<AdminLayout title="Dasbor">
  <div class="flex flex-wrap items-center justify-between gap-3"><div><h1 class="text-3xl font-bold tracking-tight">Dasbor</h1><p class="mt-1 text-slate-600">Ringkasan pemungutan suara dan perolehan suara.</p></div><button id="refresh" type="button" class="inline-flex min-h-11 items-center rounded-lg bg-brand-700 px-4 font-semibold text-white hover:bg-brand-900">Muat Ulang Data</button></div>
  <div id="error" role="alert" class="mt-4 hidden rounded-xl border border-red-200 bg-red-50 p-4 text-red-800"></div><div id="access" class="mt-4 hidden rounded-xl border border-amber-200 bg-amber-50 p-5"><h2 class="font-bold">Akses khusus Admin Voting</h2><p class="mt-1">Anda tidak memiliki akses ke data dasbor.</p></div>
  <div id="dashboard" class="mt-5 space-y-5" aria-live="polite"><p class="rounded-xl bg-white p-5 text-slate-600">Memuat data…</p></div>
  <script is:inline>
    const root=document.querySelector('#dashboard'),error=document.querySelector('#error'),access=document.querySelector('#access');
    const num=n=>new Intl.NumberFormat('id-ID').format(n);
    const percent=n=>new Intl.NumberFormat('id-ID',{maximumFractionDigits:1}).format(n)+'%';
    const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    let timer,target,stage;
    const countdown=()=>{const el=document.querySelector('#countdown');if(!el||!target)return;const sec=Math.max(0,Math.floor((Date.parse(target)-Date.now())/1000));el.textContent=[Math.floor(sec/86400),Math.floor(sec%86400/3600),Math.floor(sec%3600/60),sec%60].map(n=>String(n).padStart(2,'0')).join(' : ')};
    async function load(){
      error.classList.add('hidden');access.classList.add('hidden');root.innerHTML='<p class="rounded-xl bg-white p-5 text-slate-600">Memuat data…</p>';
      try{
        const r=await fetch('/api/dashboard',{credentials:'same-origin'}),d=await r.json();
        if(r.status===403){root.replaceChildren();access.classList.remove('hidden');return}
        if(!r.ok)throw new Error(d.error||'Data dasbor gagal dimuat.');
        stage=d.stage;target=stage==='open'?d.closes_at:d.opens_at;clearInterval(timer);
        const count=['draft','scheduled','open'].includes(stage);timer=count?setInterval(countdown,1000):null;
        const cards=[['Hak pilih',d.eligible_count],['Sudah digunakan',d.used_count],['Belum digunakan',d.unused_count],['Partisipasi',d.turnout_percentage,percent(d.turnout_percentage)]];
        root.innerHTML=(d.committee_warning?'<div class="rounded-xl border border-amber-300 bg-amber-50 p-4 font-semibold text-amber-900">Sebaiknya ada minimal 2 Admin Voting · <a class="underline" href="/admin">Kelola Admin Voting</a></div>':'')+
          '<section class="rounded-2xl border border-slate-200 bg-white p-5"><p class="text-sm font-semibold text-brand-700">'+({draft:'Draf',scheduled:'Terjadwal',open:'Dibuka',closed:'Ditutup',published:'Diumumkan'}[stage]||stage)+'</p>'+(count?'<p class="mt-2 text-sm text-slate-600">'+(stage==='open'?'Pemungutan suara ditutup dalam':'Pemungutan suara dibuka dalam')+'</p><p id="countdown" class="mt-1 font-mono text-3xl font-bold tracking-tight" aria-live="off">-- : -- : -- : --</p>':'<p class="mt-2 text-xl font-bold">Pemungutan suara ditutup.</p>')+'</section>'+
          '<section class="grid gap-3 sm:grid-cols-4">'+cards.map(([k,v,shown])=>'<article class="rounded-xl border border-slate-200 bg-white p-4"><p class="text-sm text-slate-600">'+k+'</p><p class="mt-1 text-2xl font-bold">'+(shown??num(v))+'</p></article>').join('')+'</section>'+
          '<section class="rounded-xl border border-slate-200 bg-white p-4"><p class="font-semibold">Surat Suara Terkirim: '+num(d.participation_count)+' · Jumlah Suara di Kotak: '+num(d.ballot_count)+' · <strong class="'+(d.count_matches?'text-emerald-700':'text-red-700')+'">'+(d.count_matches?'Sesuai':'Tidak sesuai')+'</strong></p><p class="mt-2 text-sm text-slate-600">Diperbarui '+new Intl.DateTimeFormat('id-ID',{timeZone:'Asia/Tokyo',dateStyle:'medium',timeStyle:'medium'}).format(new Date(d.updated_at))+' JST</p></section>'+
          (d.test?'<p class="rounded-xl border border-amber-300 bg-amber-50 p-4 font-semibold text-amber-900">Uji Coba — Partisipasi '+num(d.test.participation_count)+' · Suara di kotak '+num(d.test.ballot_count)+'</p>':'')+
          '<section class="rounded-2xl border border-slate-200 bg-white p-5"><h2 class="text-xl font-bold">Perolehan suara keseluruhan</h2><div class="mt-4 flex flex-wrap gap-2">'+d.candidates.map(c=>'<span class="inline-flex items-center gap-2 rounded-full border border-slate-200 px-3 py-2"><span class="size-3 rounded-full" style="background-color:'+esc(c.color||'#334155')+'"></span><strong>'+esc(c.number)+' · '+esc(c.nickname)+'</strong><span>'+num(c.votes)+' suara</span></span>').join('')+'</div></section>'+
          '<section class="overflow-x-auto rounded-2xl border border-slate-200 bg-white p-5"><h2 class="text-xl font-bold">Hasil per korda</h2><table class="mt-4 w-full text-left text-sm"><thead><tr class="border-b"><th class="p-2">Korda</th><th class="p-2">Hak pilih</th><th class="p-2">Digunakan</th><th class="p-2">Partisipasi</th><th class="p-2">Perolehan kandidat</th></tr></thead><tbody>'+d.korda.map(k=>'<tr class="border-b"><th class="p-2">'+esc(k.name)+'</th><td class="p-2">'+num(k.eligible_count)+'</td><td class="p-2">'+num(k.used_count)+'</td><td class="p-2">'+(k.turnout_percentage===null?'—':percent(k.turnout_percentage))+'</td><td class="p-2">'+(k.suppressed?'Data terlalu sedikit':k.candidates.map(c=>esc(c.nickname)+': '+num(c.votes)).join(' · '))+'</td></tr>').join('')+'</tbody></table></section>';
        countdown();
      }catch(e){root.replaceChildren();error.textContent=e.message||'Data dasbor gagal dimuat.';error.classList.remove('hidden')}
    }
    document.querySelector('#refresh').addEventListener('click',load);load();
  </script>
</AdminLayout>
