---
import AdminLayout from "../../layouts/AdminLayout.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import Button from "../../components/ui/Button.astro";
import Callout from "../../components/ui/Callout.astro";
import { IconAlertCircle, IconAlertTriangle, IconRefresh } from "@tabler/icons-astro";
---
<AdminLayout title="Dasbor">
  <PageHeader title="Dasbor" eyebrow="Admin Voting" description="Ringkasan pemungutan suara dan perolehan suara. Data hanya diperbarui lewat aksi manual.">
    <Button id="refresh" variant="secondary" size="sm" type="button"><IconRefresh size={16} stroke={1.8} aria-hidden="true" /><span id="refresh-label">Muat Ulang Data</span></Button>
  </PageHeader>
  <Callout id="error" tone="danger" icon={IconAlertCircle} class="mt-5" hidden></Callout>
  <Callout id="access" tone="warning" icon={IconAlertTriangle} title="Akses khusus Admin Voting" class="mt-5" hidden>
    Anda tidak memiliki akses ke data dasbor.
  </Callout>
  <div id="dashboard" class="mt-5 grid gap-[17px] [&>*]:min-w-0" aria-live="polite">
    <section class="rounded-xl border border-brand-border bg-card p-[22px] max-[700px]:p-[17px]">
      <p class="text-[13px] text-brand-muted">Memuat data dasbor...</p>
      <div aria-hidden="true" class="mt-3 grid gap-2">
        <span class="block h-5 w-40 rounded bg-secondary"></span>
        <span class="block h-9 w-56 rounded bg-secondary"></span>
      </div>
    </section>
  </div>
  <script is:inline>
    const root=document.querySelector('#dashboard'),error=document.querySelector('#error'),access=document.querySelector('#access'),refresh=document.querySelector('#refresh'),refreshLabel=document.querySelector('#refresh-label');
    const num=n=>new Intl.NumberFormat('id-ID').format(n);
    const percent=n=>new Intl.NumberFormat('id-ID',{maximumFractionDigits:1}).format(n)+'%';
    const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    // Mode kandidat tunggal: tiga angka jawaban dengan porsi Hak pilih. Tidak memilih
    // dihitung dari total Hak pilih beku dikurangi partisipasi, tidak pernah per orang.
    const outcomeLabel={terpilih:'Terpilih',tidak_terpilih:'Tidak terpilih',seri:'Seri, keputusan diserahkan kepada panitia',menunggu_penutupan:'Menunggu penutupan pemungutan suara'};
    const shareText=(count,eligible)=>{if(!eligible||count===null)return '—';return percent(Math.round((count/eligible)*1000)/10)};
    const choiceRows=(row)=>[{label:'Setuju',count:row.setuju_count},{label:'Tidak Setuju',count:row.tidak_setuju_count},{label:'Tidak memilih (dihitung Tidak Setuju)',count:row.tidak_memilih_count??Math.max(0,(row.eligible_count??0)-(row.participation_count??row.used_count??0))}];
    const choiceList=(row)=>'<dl class="mt-4 mb-0 grid grid-cols-[minmax(0,1fr)_auto_auto] items-baseline gap-x-4 gap-y-3">'+choiceRows(row).map(c=>'<dt class="min-w-0 text-[13px] text-brand-ink">'+esc(c.label)+'</dt><dd class="m-0 text-right text-[13px] font-bold text-brand-ink tabular-nums">'+num(c.count??0)+' suara</dd><dd class="m-0 w-14 text-right text-[13px] text-brand-muted tabular-nums">'+shareText(c.count,row.eligible_count)+'</dd>').join('')+'</dl>';
    const panel='min-w-0 rounded-xl border border-brand-border bg-card p-[22px] max-[700px]:p-[17px]';
    const panelTitle='text-lg leading-snug font-bold tracking-tight text-brand-ink';
    const badge=(text,tone)=>'<span class="inline-flex w-fit shrink-0 items-center justify-center rounded-full px-2 py-0.5 text-xs font-medium whitespace-nowrap '+tone+'">'+esc(text)+'</span>';
    const stageTone={draft:'bg-muted text-muted-foreground',scheduled:'bg-[#f0f4fa] text-[#4c627b]',open:'bg-[#f1f5f3] text-[#35604a]',closed:'bg-[#fff5e6] text-[#7c5014]',published:'bg-brand-50 text-brand-800'};
    const stageLabel={draft:'Draf',scheduled:'Terjadwal',open:'Dibuka',closed:'Ditutup',published:'Diumumkan'};
    let timer,target,stage;
    const countdown=()=>{const el=document.querySelector('#countdown');if(!el||!target)return;const sec=Math.max(0,Math.floor((Date.parse(target)-Date.now())/1000));const d=Math.floor(sec/86400),clock=[Math.floor(sec%86400/3600),Math.floor(sec%3600/60),sec%60].map(n=>String(n).padStart(2,'0')).join(':');el.textContent=d>0?d+' hari '+clock:clock};
    async function load(){
      error.setAttribute('hidden','');access.setAttribute('hidden','');refresh.disabled=true;refreshLabel.textContent='Memuat...';
      try{
        const r=await fetch('/api/dashboard',{credentials:'same-origin'}),d=await r.json();
        if(r.status===403){root.replaceChildren();access.removeAttribute('hidden');return}
        if(!r.ok)throw new Error(d.error||'Data dasbor gagal dimuat.');
        stage=d.stage;target=stage==='open'?d.closes_at:d.opens_at;clearInterval(timer);
        const count=['scheduled','open'].includes(stage);timer=count?setInterval(countdown,1000):null;
        const cards=[['Hak pilih',d.eligible_count],['Sudah digunakan',d.used_count],['Belum digunakan',d.unused_count],['Partisipasi',d.turnout_percentage,percent(d.turnout_percentage)]];
        // Mode kandidat tunggal mengganti panel perolehan kandidat dengan keputusan dan
        // tiga angka jawaban; mode biasa tetap memakai panel perolehan kandidat.
        const single=Boolean(d.single_candidate_mode);
        const outcomeText=outcomeLabel[d.outcome]??(['closed','published'].includes(stage)?'Tidak terpilih':'Menunggu penutupan pemungutan suara');
        const tallyPanel=single
          ? '<section class="'+panel+'"><div class="mb-4"><h2 class="'+panelTitle+'">Keputusan pemilihan</h2><p class="mt-1 text-[13px] text-brand-muted">Setuju menang bila lebih dari separuh Hak pilih. Pemilih yang tidak memilih dihitung Tidak Setuju.</p></div><p class="m-0 text-xl leading-snug font-bold text-brand-ink">'+esc(outcomeText)+'</p></section>'+
            '<section class="'+panel+'"><div class="mb-4"><h2 class="'+panelTitle+'">Sikap suara</h2><p class="mt-1 text-[13px] text-brand-muted">Persentase dihitung dari Hak pilih.</p></div>'+choiceList(d)+'</section>'
          : '<section class="'+panel+'"><div class="mb-4 flex flex-wrap items-start justify-between gap-x-4 gap-y-2"><h2 class="'+panelTitle+'">Perolehan suara keseluruhan</h2></div><ul class="m-0 grid list-none gap-0 p-0">'+d.candidates.map(c=>'<li class="flex flex-wrap items-center gap-3 border-t border-brand-border px-1 py-3 first:border-t-0"><span aria-hidden="true" class="size-3 shrink-0 rounded-full" style="background-color:'+esc(c.color||'#334155')+'"></span><strong class="min-w-0 text-sm font-semibold text-brand-ink break-words">'+esc(c.number)+' · '+esc(c.nickname)+'</strong><span class="ml-auto text-sm text-brand-muted tabular-nums">'+num(c.votes)+' suara</span></li>').join('')+'</ul></section>';
        const kordaHead=single
          ? '<th class="h-10 px-2 text-left align-middle text-xs font-medium text-brand-muted whitespace-nowrap">Setuju</th><th class="h-10 px-2 text-left align-middle text-xs font-medium text-brand-muted whitespace-nowrap">Tidak Setuju</th><th class="h-10 px-2 text-left align-middle text-xs font-medium text-brand-muted whitespace-nowrap">Tidak memilih</th>'
          : '<th class="h-10 px-2 text-left align-middle text-xs font-medium text-brand-muted whitespace-nowrap">Perolehan kandidat</th>';
        const kordaCells=(k)=>single
          ? (k.suppressed||k.setuju_count===null
            ? '<td colspan="3" class="p-2 align-middle text-[13px] text-brand-muted">Data terlalu sedikit</td>'
            : choiceRows(k).map(c=>'<td class="p-2 align-middle text-[13px] whitespace-nowrap tabular-nums">'+num(c.count??0)+' <span class="text-brand-muted">'+shareText(c.count,k.eligible_count)+'</span></td>').join(''))
          : '<td class="p-2 align-middle text-[13px]">'+(k.suppressed?'Data terlalu sedikit':k.candidates.map(c=>esc(c.nickname)+': '+num(c.votes)).join(' · '))+'</td>';
        root.innerHTML=
          (d.committee_warning?'<div class="rounded-lg bg-[#fff5e6] px-3.5 py-3 text-[13px] leading-5 text-[#7c5014]"><strong class="block font-bold">Sebaiknya ada minimal 2 Admin Voting</strong><a class="underline underline-offset-2" href="/admin">Kelola Admin Voting</a></div>':'')+
          '<section class="'+panel+'"><div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2"><div class="min-w-0"><h2 class="'+panelTitle+'">Tahap pemilihan</h2><div class="mt-2">'+badge(stageLabel[stage]||stage,stageTone[stage]||stageTone.draft)+'</div></div></div>'+
          (count?'<p class="mt-4 text-[13px] text-brand-muted">'+(stage==='open'?'Pemungutan suara ditutup dalam':'Pemungutan suara dibuka dalam')+'</p><p id="countdown" class="mt-1 font-mono text-[30px] leading-tight font-extrabold tracking-tight tabular-nums text-brand-ink" aria-live="off">—</p>':'<p class="mt-4 text-lg leading-snug font-bold text-brand-ink">'+({draft:'Pemilihan masih dalam persiapan.',closed:'Pemungutan suara telah ditutup.',published:'Hasil pemilihan telah diumumkan.'}[stage]||'Status pemilihan tersedia.')+'</p>')+'</section>'+
          '<section aria-label="Angka partisipasi" class="grid min-w-0 grid-cols-2 gap-[17px] min-[901px]:grid-cols-4">'+cards.map(([k,v,shown])=>'<article class="grid min-w-0 gap-2 rounded-xl border border-brand-border bg-card p-5"><p class="text-sm font-medium text-muted-foreground">'+k+'</p><p class="text-3xl font-bold tracking-tight text-brand-ink tabular-nums max-[600px]:text-[26px]">'+(shown??num(v))+'</p></article>').join('')+'</section>'+
          '<section class="'+panel+'"><div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2"><h2 class="'+panelTitle+'">Pemeriksaan surat suara</h2><div class="mt-0.5">'+badge(d.count_matches?'Sesuai':'Tidak sesuai',d.count_matches?'bg-[#f1f5f3] text-[#35604a]':'border border-[#f0ccd4] bg-[#fdf2f4] text-[#8f1730]')+'</div></div>'+
          '<dl class="mt-4 mb-0 grid grid-cols-2 gap-x-5 gap-y-3 max-[600px]:grid-cols-1"><div class="grid min-w-0 gap-0.5"><dt class="text-xs text-brand-muted">Surat suara terkirim</dt><dd class="m-0 text-[22px] leading-tight font-bold text-brand-ink tabular-nums">'+num(d.participation_count)+'</dd></div><div class="grid min-w-0 gap-0.5"><dt class="text-xs text-brand-muted">Suara di kotak</dt><dd class="m-0 text-[22px] leading-tight font-bold text-brand-ink tabular-nums">'+num(d.ballot_count)+'</dd></div></dl>'+
          '<p class="mt-3 border-t border-brand-border pt-2.5 text-xs text-brand-muted">Diperbarui '+new Intl.DateTimeFormat('id-ID',{timeZone:'Asia/Tokyo',dateStyle:'medium',timeStyle:'medium'}).format(new Date(d.updated_at))+' JST</p></section>'+
          (d.test?'<div class="rounded-lg bg-[#fff5e6] px-3.5 py-3 text-[13px] leading-5 text-[#7c5014]"><strong class="block font-bold">Uji coba</strong>Partisipasi '+num(d.test.participation_count)+' · Suara di kotak '+num(d.test.ballot_count)+'</div>':'')+
          tallyPanel+
          '<section class="'+panel+'"><div class="mb-4 flex flex-wrap items-start justify-between gap-x-4 gap-y-2"><h2 class="'+panelTitle+'">Hasil per korda</h2></div><div class="overflow-x-auto"><table class="w-full caption-bottom text-sm'+(single?' min-w-[34rem]':'')+'"><thead><tr class="border-b border-brand-border"><th class="h-10 px-2 text-left align-middle text-xs font-medium text-brand-muted whitespace-nowrap">Korda</th><th class="h-10 px-2 text-left align-middle text-xs font-medium text-brand-muted whitespace-nowrap">Hak pilih</th><th class="h-10 px-2 text-left align-middle text-xs font-medium text-brand-muted whitespace-nowrap">Digunakan</th><th class="h-10 px-2 text-left align-middle text-xs font-medium text-brand-muted whitespace-nowrap">Partisipasi</th><th class="h-10 px-2 text-left align-middle text-xs font-medium text-brand-muted whitespace-nowrap">'+kordaHead+'</tr></thead><tbody>'+d.korda.map(k=>'<tr class="border-b border-brand-border last:border-b-0"><th scope="row" class="p-2 text-left align-middle text-[13px] font-semibold text-brand-ink">'+esc(k.name)+'</th><td class="p-2 align-middle text-[13px] tabular-nums">'+num(k.eligible_count)+'</td><td class="p-2 align-middle text-[13px] tabular-nums">'+num(k.used_count)+'</td><td class="p-2 align-middle text-[13px] tabular-nums">'+(k.turnout_percentage===null?'—':percent(k.turnout_percentage))+'</td>'+kordaCells(k)+'</tr>').join('')+'</tbody></table></div></section>';
        countdown();
      }catch(e){error.textContent=(e.message||'Data dasbor gagal dimuat.')+' Coba muat ulang.';error.removeAttribute('hidden')}finally{refresh.disabled=false;refreshLabel.textContent='Muat Ulang Data'}
    }
    // Penjaga null: tanpa tombol, skrip tetap tidak boleh melempar galat.
    if(refresh)refresh.addEventListener('click',load);
    if(root)load();
  </script>
</AdminLayout>