---
import { env } from "cloudflare:workers";
import AdminLayout from "../../layouts/AdminLayout.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import Button from "../../components/ui/Button.astro";
import Callout from "../../components/ui/Callout.astro";
import { IconAlertCircle, IconAlertTriangle, IconRefresh } from "@tabler/icons-astro";
import { isAdminPageAuthorized, SESSION_COOKIE, type AdminBindings } from "./admin-auth";
const bindings = env as unknown as AdminBindings;
const authorized = await isAdminPageAuthorized(Astro.cookies.get(SESSION_COOKIE)?.value, bindings);
const db = authorized ? bindings.DB : undefined;
// Catatan dan peringatan view portal (mode "Tidak Membekukan DPT", keputusan
// owner 2026-11-19): tahap dihitung dari jam pada saat halaman dirender; tanpa
// polling. View dianggap usang bila watermark portal lebih tua dari 5 menit.
const election = await db?.prepare('SELECT status_lock,opens_at,closes_at,closed_early_at,live_voter_roll FROM elections ORDER BY id LIMIT 1').first<{ status_lock: string; opens_at: string | null; closes_at: string | null; closed_early_at: string | null; live_voter_roll: number }>();
const liveRoll = election?.live_voter_roll === 1;
const stageOf = (): string => {
  if (!election) return 'draft';
  if (election.status_lock === 'draft') return 'draft';
  if (election.status_lock === 'published') return 'published';
  const nowMs = Date.now();
  if (election.opens_at && nowMs < Date.parse(election.opens_at)) return 'scheduled';
  if (election.closed_early_at != null || (election.closes_at && nowMs >= Date.parse(election.closes_at))) return 'closed';
  return 'open';
};
const currentStage = stageOf();
const STALE_VIEW_MS = 5 * 60 * 1000;
const watermark = await db?.prepare("SELECT value FROM system_config WHERE key='pemilih_last_sync'").first<{ value: string }>();
const watermarkAt = watermark?.value ? Date.parse(watermark.value) : NaN;
const viewStale = liveRoll && currentStage === 'open' && (!Number.isFinite(watermarkAt) || Date.now() - watermarkAt > STALE_VIEW_MS);
const formatJst = (value: string) => new Intl.DateTimeFormat('id-ID', { timeZone: 'Asia/Tokyo', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).format(new Date(value)) + ' JST';
const lastRefreshText = Number.isFinite(watermarkAt) ? formatJst(watermark.value!) : 'belum pernah';
---
<AdminLayout title="Dasbor">
  <PageHeader title="Dasbor" eyebrow="Admin Voting" description="Ringkasan pemungutan suara dan perolehan suara. Data hanya diperbarui lewat aksi manual.">
    <Button id="refresh" variant="secondary" size="sm" type="button"><IconRefresh size={16} stroke={1.8} aria-hidden="true" /><span id="refresh-label">Muat Ulang Data</span></Button>
  </PageHeader>
  <Callout id="error" tone="danger" icon={IconAlertCircle} class="mt-5" hidden></Callout>
  <Callout id="access" tone="warning" icon={IconAlertTriangle} title="Akses khusus Admin Voting" class="mt-5" hidden>
    Anda tidak memiliki akses ke data dasbor.
  </Callout>
  {liveRoll && <Callout tone="neutral" title="Roll mengikuti portal (tidak dibekukan)" class="mt-5">Hak pilih dihitung dari daftar Pemilih terkini selama pemungutan suara dibuka dan ditetapkan saat pemungutan ditutup. Terakhir diperbarui dari portal: {lastRefreshText}.</Callout>}
  {viewStale && <Callout tone="warning" icon={IconAlertTriangle} title="Daftar Pemilih sudah lama tidak diperbarui dari portal" class="mt-5">Portal belum berhasil dihubungi kembali sejak {lastRefreshText}. Pemilih tetap dapat memilih berdasarkan daftar terakhir ini; periksa koneksi portal bila keadaan ini berlarut.</Callout>}
  <div id="dashboard" class="mt-5 grid gap-[17px] [&>*]:min-w-0" aria-live="polite">
    <section class="rounded-xl border border-brand-border bg-card p-[22px] max-[700px]:p-[17px]">
      <p class="text-[13px] text-brand-muted">Memuat data dasbor...</p>
      <div aria-hidden="true" class="mt-3 grid gap-2">
        <span class="block h-5 w-40 rounded bg-secondary"></span>
        <span class="block h-9 w-56 rounded bg-secondary"></span>
      </div>
    </section>
  </div>
  <script is:inline>
    const root=document.querySelector('#dashboard'),error=document.querySelector('#error'),access=document.querySelector('#access'),refresh=document.querySelector('#refresh'),refreshLabel=document.querySelector('#refresh-label');
    const num=n=>new Intl.NumberFormat('id-ID').format(n);
    const percent=n=>new Intl.NumberFormat('id-ID',{maximumFractionDigits:1}).format(n)+'%';
    const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    // Mode kandidat tunggal: tiga angka jawaban (Setuju, Tidak Setuju, Abstain) dengan
    // porsi Hak pilih dan tanpa baris keputusan: sistem tidak menyatakan hasil. Abstain
    // dirinci menjadi yang diberikan Pemilih dan tidak memilih (Hak pilih beku dikurangi
    // partisipasi, tidak pernah per orang).
    const shareText=(count,eligible)=>{if(!eligible||count===null)return '—';return percent(Math.round((count/eligible)*1000)/10)};
    // Tidak memilih baru dihitung Abstain setelah Admin Voting menjalankan Hitung Abstain (Q193);
    // sebelumnya hanya angka 'belum dihitung' dan korda tidak menampilkan rinciannya.
    const tidakMemilihOf=(row)=>row.tidak_memilih_count??0;
    const choiceRows=(row)=>[{label:'Setuju',count:row.setuju_count},{label:'Tidak Setuju',count:row.tidak_setuju_count},{label:'Abstain',count:row.abstain_count??(row.abstain_cast_count??0)}];
    const abstainParts=(row)=>[{label:'Abstain diberikan',count:row.abstain_cast_count??0},{label:'Tidak memilih (dihitung Abstain)',count:tidakMemilihOf(row)}];
    const choiceList=(row,counted)=>'<dl class="mt-4 mb-0 grid grid-cols-[minmax(0,1fr)_auto_auto] items-baseline gap-x-4 gap-y-3">'+choiceRows(row).map(c=>'<dt class="min-w-0 text-[13px] text-brand-ink">'+esc(c.label)+'</dt><dd class="m-0 text-right text-[13px] font-bold text-brand-ink tabular-nums">'+num(c.count??0)+' suara</dd><dd class="m-0 w-14 text-right text-[13px] text-brand-muted tabular-nums">'+shareText(c.count,row.eligible_count)+'</dd>').join('')+(counted?abstainParts(row):[]).map(c=>'<dt class="min-w-0 pl-4 text-xs text-brand-muted">'+esc(c.label)+'</dt><dd class="m-0 text-right text-xs text-brand-muted tabular-nums">'+num(c.count)+' suara</dd><dd class="m-0 w-14 text-right text-xs text-brand-muted tabular-nums">'+shareText(c.count,row.eligible_count)+'</dd>').join('')+'</dl>'+(counted?'':'<p id="abstain-pending" class="mt-3 mb-0 text-xs text-brand-muted">'+num(tidakMemilihOf(row))+' tidak memilih (belum dihitung)</p>');
    const panel='min-w-0 rounded-xl border border-brand-border bg-card p-[22px] max-[700px]:p-[17px]';
    const panelTitle='text-lg leading-snug font-bold tracking-tight text-brand-ink';
    const badge=(text,tone)=>'<span class="inline-flex w-fit shrink-0 items-center justify-center rounded-full px-2 py-0.5 text-xs font-medium whitespace-nowrap '+tone+'">'+esc(text)+'</span>';
    // Angka pilihan disegel sampai Umumkan Hasil (keputusan owner 2026-11-21). Server
    // sudah tidak mengirim angkanya; panel ini menjelaskan keadaannya tanpa satu angka pun.
    const lockIcon='<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true"><path d="M5 13a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v6a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-6"/><path d="M11 16a1 1 0 1 0 2 0a1 1 0 0 0 -2 0"/><path d="M8 11v-4a4 4 0 1 1 8 0v4"/></svg>';
    const sealedNote='<div class="flex items-start gap-3"><span class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-full bg-secondary text-brand-muted">'+lockIcon+'</span><div class="min-w-0"><p class="m-0 text-sm font-semibold text-brand-ink">Hasil disegel sampai Umumkan Hasil</p><p class="m-0 mt-1 text-[13px] leading-5 text-brand-muted">Panitia tidak melihat arah suara selama pemungutan berlangsung, supaya penghitungan tetap netral dan pilihan setiap Pemilih tetap rahasia. Angka dan bagiannya terbuka setelah hasil diumumkan.</p></div></div>';
    const sealedPanel=(title,extra)=>'<section class="'+panel+'"><div class="mb-4"><h2 class="'+panelTitle+'">'+title+'</h2></div>'+sealedNote+(extra||'')+'</section>';
    const stageTone={draft:'bg-muted text-muted-foreground',scheduled:'bg-[#f0f4fa] text-[#4c627b]',open:'bg-[#f1f5f3] text-[#35604a]',closed:'bg-[#fff5e6] text-[#7c5014]',published:'bg-brand-50 text-brand-800'};
    const stageLabel={draft:'Draf',scheduled:'Terjadwal',open:'Dibuka',closed:'Ditutup',published:'Diumumkan'};
    let timer,target,stage;
    const countdown=()=>{const el=document.querySelector('#countdown');if(!el||!target)return;const sec=Math.max(0,Math.floor((Date.parse(target)-Date.now())/1000));const d=Math.floor(sec/86400),clock=[Math.floor(sec%86400/3600),Math.floor(sec%3600/60),sec%60].map(n=>String(n).padStart(2,'0')).join(':');el.textContent=d>0?d+' hari '+clock:clock};
    async function load(manual){
      error.setAttribute('hidden','');access.setAttribute('hidden','');
      // Muat otomatis pertama memakai label lama; muat manual dikunci window.withBusy.
      if(!manual){refresh.disabled=true;refreshLabel.textContent='Memuat...'}
      try{
        const r=await fetch('/api/dashboard',{credentials:'same-origin'}),d=await r.json();
        if(r.status===403){root.replaceChildren();access.removeAttribute('hidden');return}
        if(!r.ok)throw new Error(d.error||'Data dasbor gagal dimuat.');
        stage=d.stage;target=stage==='open'?d.closes_at:d.opens_at;clearInterval(timer);
        const count=['scheduled','open'].includes(stage);timer=count?setInterval(countdown,1000):null;
        const cards=[['Hak pilih',d.eligible_count],['Sudah digunakan',d.used_count],['Belum digunakan',d.unused_count],['Partisipasi',d.turnout_percentage,percent(d.turnout_percentage)]];
        // Mode kandidat tunggal mengganti panel perolehan kandidat dengan tiga angka
        // jawaban; mode biasa tetap memakai panel perolehan kandidat.
        const single=Boolean(d.single_candidate_mode);
        // Segel dari server: sebelum Diumumkan setiap angka pilihan null dan tally_sealed true.
        const sealed=Boolean(d.tally_sealed);
        const tallyPanelUnsealed=single
          ? '<section class="'+panel+'"><div class="mb-4"><h2 class="'+panelTitle+'">Sikap suara</h2><p class="mt-1 text-[13px] text-brand-muted">Persentase dihitung dari Hak pilih. '+(d.abstain_counted?'Pemilih yang tidak memilih dihitung Abstain sejak Hitung Abstain dijalankan'+(d.abstain_counted_at?' ('+new Intl.DateTimeFormat('id-ID',{timeZone:'Asia/Tokyo',dateStyle:'medium',timeStyle:'short'}).format(new Date(d.abstain_counted_at))+' JST)':'')+'.':'Pemilih yang tidak memilih belum dihitung Abstain.')+'</p></div>'+choiceList(d,Boolean(d.abstain_counted))+(stage==='closed'&&!d.abstain_counted?'<p class="mt-3 mb-0 rounded-lg bg-[#fff5e6] px-3.5 py-3 text-[13px] leading-5 text-[#7c5014]"><strong class="block font-bold">Hitung Abstain belum dijalankan</strong>Hasil belum dapat diumumkan sebelum Hitung Abstain dijalankan. <a class="underline underline-offset-2" href="/admin/pemilihan">Buka Tindakan tahap</a></p>':'')+'</section>'
          : '<section class="'+panel+'"><div class="mb-4 flex flex-wrap items-start justify-between gap-x-4 gap-y-2"><h2 class="'+panelTitle+'">Perolehan suara keseluruhan</h2></div><ul class="m-0 grid list-none gap-0 p-0">'+d.candidates.map(c=>'<li class="flex flex-wrap items-center gap-3 border-t border-brand-border px-1 py-3 first:border-t-0"><span aria-hidden="true" class="size-3 shrink-0 rounded-full" style="background-color:'+esc(c.color||'#334155')+'"></span><strong class="min-w-0 text-sm font-semibold text-brand-ink break-words">'+esc(c.number)+' · '+esc(c.nickname)+'</strong><span class="ml-auto text-sm text-brand-muted tabular-nums">'+num(c.votes)+' suara</span></li>').join('')+'</ul></section>';
        // Sebelum Diumumkan panel yang sama menampilkan kunci; peringatan Hitung Abstain
        // tetap muncul karena itu urusan tahap, bukan angka pilihan.
        const tallyPanel=sealed
          ? sealedPanel(single?'Sikap suara':'Perolehan suara keseluruhan',stage==='closed'&&!d.abstain_counted?'<p class="mt-4 mb-0 rounded-lg bg-[#fff5e6] px-3.5 py-3 text-[13px] leading-5 text-[#7c5014]"><strong class="block font-bold">Hitung Abstain belum dijalankan</strong>Hasil belum dapat diumumkan sebelum Hitung Abstain dijalankan. <a class="underline underline-offset-2" href="/admin/pemilihan">Buka Tindakan tahap</a></p>':'')
          : tallyPanelUnsealed;
        // Selama angka disegel, kolom pilihan tidak dirender sama sekali; tabel
        // partisipasi saja pas di layar 390 px dan satu catatan menjelaskan segelnya.
        const kordaHead=sealed?'':single
          ? '<th class="h-10 px-2 text-left align-middle text-xs font-medium text-brand-muted whitespace-nowrap">Setuju</th><th class="h-10 px-2 text-left align-middle text-xs font-medium text-brand-muted whitespace-nowrap">Tidak Setuju</th><th class="h-10 px-2 text-left align-middle text-xs font-medium text-brand-muted whitespace-nowrap">Abstain</th>'
          : '<th class="h-10 px-2 text-left align-middle text-xs font-medium text-brand-muted whitespace-nowrap">Perolehan kandidat</th>';
        const kordaCellsUnsealed=(k)=>single
          ? (k.suppressed||k.setuju_count===null
            ? '<td colspan="3" class="p-2 align-middle text-[13px] text-brand-muted">Data terlalu sedikit</td>'
            : choiceRows(k).map((c,i)=>'<td class="p-2 align-middle text-[13px] whitespace-nowrap tabular-nums">'+num(c.count??0)+' <span class="text-brand-muted">'+shareText(c.count,k.eligible_count)+'</span>'+(i===2&&d.abstain_counted?'<span class="block text-xs text-brand-muted">'+num(k.abstain_cast_count??0)+' diberikan · '+num(tidakMemilihOf(k))+' tidak memilih</span>':'')+'</td>').join(''))
          : '<td class="p-2 align-middle text-[13px]">'+(k.suppressed?'Data terlalu sedikit':k.candidates.map(c=>esc(c.nickname)+': '+num(c.votes)).join(' · '))+'</td>';
        const kordaCells=(k)=>sealed?'':kordaCellsUnsealed(k);
        root.innerHTML=
          (d.committee_warning?'<div class="rounded-lg bg-[#fff5e6] px-3.5 py-3 text-[13px] leading-5 text-[#7c5014]"><strong class="block font-bold">Sebaiknya ada minimal 2 Admin Voting</strong><a class="underline underline-offset-2" href="/admin">Kelola Admin Voting</a></div>':'')+
          '<section class="'+panel+'"><div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2"><div class="min-w-0"><h2 class="'+panelTitle+'">Tahap pemilihan</h2><div class="mt-2">'+badge(stageLabel[stage]||stage,stageTone[stage]||stageTone.draft)+'</div></div></div>'+
          (count?'<p class="mt-4 text-[13px] text-brand-muted">'+(stage==='open'?'Pemungutan suara ditutup dalam':'Pemungutan suara dibuka dalam')+'</p><p id="countdown" class="mt-1 font-mono text-[30px] leading-tight font-extrabold tracking-tight tabular-nums text-brand-ink" aria-live="off">—</p>':'<p class="mt-4 text-lg leading-snug font-bold text-brand-ink">'+({draft:'Pemilihan masih dalam persiapan.',closed:'Pemungutan suara telah ditutup.',published:'Hasil pemilihan telah diumumkan.'}[stage]||'Status pemilihan tersedia.')+'</p>')+'</section>'+
          '<section aria-label="Angka partisipasi" class="grid min-w-0 grid-cols-2 gap-[17px] min-[901px]:grid-cols-4">'+cards.map(([k,v,shown])=>'<article class="grid min-w-0 gap-2 rounded-xl border border-brand-border bg-card p-5"><p class="text-sm font-medium text-muted-foreground">'+k+'</p><p class="text-3xl font-bold tracking-tight text-brand-ink tabular-nums max-[600px]:text-[26px]">'+(shown??num(v))+'</p></article>').join('')+'</section>'+
          '<section class="'+panel+'"><div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2"><h2 class="'+panelTitle+'">Pemeriksaan surat suara</h2><div class="mt-0.5">'+badge(d.count_matches?'Sesuai':'Tidak sesuai',d.count_matches?'bg-[#f1f5f3] text-[#35604a]':'border border-[#f0ccd4] bg-[#fdf2f4] text-[#8f1730]')+'</div></div>'+
          '<dl class="mt-4 mb-0 grid grid-cols-2 gap-x-5 gap-y-3 max-[600px]:grid-cols-1"><div class="grid min-w-0 gap-0.5"><dt class="text-xs text-brand-muted">Surat suara terkirim</dt><dd class="m-0 text-[22px] leading-tight font-bold text-brand-ink tabular-nums">'+num(d.participation_count)+'</dd></div><div class="grid min-w-0 gap-0.5"><dt class="text-xs text-brand-muted">Suara di kotak</dt><dd class="m-0 text-[22px] leading-tight font-bold text-brand-ink tabular-nums">'+num(d.ballot_count)+'</dd></div></dl>'+
          '<p class="mt-3 border-t border-brand-border pt-2.5 text-xs text-brand-muted">Diperbarui '+new Intl.DateTimeFormat('id-ID',{timeZone:'Asia/Tokyo',dateStyle:'medium',timeStyle:'medium'}).format(new Date(d.updated_at))+' JST</p></section>'+
          (d.test?'<div class="rounded-lg bg-[#fff5e6] px-3.5 py-3 text-[13px] leading-5 text-[#7c5014]"><strong class="block font-bold">Uji coba</strong>Partisipasi '+num(d.test.participation_count)+' · Suara di kotak '+num(d.test.ballot_count)+'</div>':'')+
          tallyPanel+
          '<section class="'+panel+'"><div class="mb-4 flex flex-wrap items-start justify-between gap-x-4 gap-y-2"><h2 class="'+panelTitle+'">Hasil per korda</h2></div><div class="overflow-x-auto"><table class="w-full caption-bottom text-sm'+(single&&!sealed?' min-w-[34rem]':'')+'"><thead><tr class="border-b border-brand-border"><th class="h-10 px-2 text-left align-middle text-xs font-medium text-brand-muted whitespace-nowrap">Korda</th><th class="h-10 px-2 text-left align-middle text-xs font-medium text-brand-muted whitespace-nowrap">Hak pilih</th><th class="h-10 px-2 text-left align-middle text-xs font-medium text-brand-muted whitespace-nowrap">Digunakan</th><th class="h-10 px-2 text-left align-middle text-xs font-medium text-brand-muted whitespace-nowrap">Partisipasi</th><th class="h-10 px-2 text-left align-middle text-xs font-medium text-brand-muted whitespace-nowrap">'+kordaHead+'</tr></thead><tbody>'+d.korda.map(k=>'<tr class="border-b border-brand-border last:border-b-0"><th scope="row" class="p-2 text-left align-middle text-[13px] font-semibold text-brand-ink">'+esc(k.name)+'</th><td class="p-2 align-middle text-[13px] tabular-nums">'+num(k.eligible_count)+'</td><td class="p-2 align-middle text-[13px] tabular-nums">'+num(k.used_count)+'</td><td class="p-2 align-middle text-[13px] tabular-nums">'+(k.turnout_percentage===null?'—':percent(k.turnout_percentage))+'</td>'+kordaCells(k)+'</tr>').join('')+'</tbody></table></div>'+(sealed?'<p class="mt-3 mb-0 text-xs text-brand-muted">Angka pilihan per korda muncul setelah Umumkan Hasil.</p>':'')+'</section>';
        countdown();
        // Toast hanya pada muat manual; muat awal halaman tidak berisik.
        if(manual)window.toast('Data dasbor dimuat ulang.',{variant:'success'})
      }catch(e){error.textContent=(e.message||'Data dasbor gagal dimuat.')+' Coba muat ulang.';error.removeAttribute('hidden');if(manual)window.toast((e.message||'Data dasbor gagal dimuat.')+' Coba muat ulang.',{variant:'error'})}finally{if(!manual){refresh.disabled=false;refreshLabel.textContent='Muat Ulang Data'}}
    }
    // Penjaga null: tanpa tombol, skrip tetap tidak boleh melempar galat.
    if(refresh)refresh.addEventListener('click',()=>window.withBusy(refresh,'Memuat…',()=>load(true)));
    if(root)load();
  </script>
</AdminLayout>