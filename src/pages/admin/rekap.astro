---
/**
 * Rekapitulasi Suara (keputusan owner Q232–Q234, 2026-11-22): tindakan Admin
 * Voting sekali jalan setelah pemungutan suara ditutup, menggantikan Hitung
 * Abstain. Sebelum rekap halaman menampilkan keadaan tahap dan dialog
 * konfirmasi yang menyebut angka tidak memilih; setelah rekap lima tab data
 * (Ringkasan, Korda, Komsat, Kotak suara, Abstain) dan tombol Unduh Excel yang
 * membangun .xlsx di peramban dari JSON yang sama (server tidak pernah
 * mengirim berkas). Setiap muatan data dan setiap unduhan dicatat di audit.
 */
import { env } from "cloudflare:workers";
import { IconAlertCircle, IconAlertTriangle, IconDownload, IconSpeakerphone, IconTable } from "@tabler/icons-astro";
import AdminLayout from "../../layouts/AdminLayout.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import Button from "../../components/ui/Button.astro";
import Callout from "../../components/ui/Callout.astro";
import { isAdminPageAuthorized, SESSION_COOKIE, type AdminBindings } from "./admin-auth";
const bindings = env as unknown as AdminBindings;
const authorized = await isAdminPageAuthorized(Astro.cookies.get(SESSION_COOKIE)?.value, bindings);
const panel = "min-w-0 rounded-xl border border-brand-border bg-card p-[22px] max-[700px]:p-[17px]";
---
<AdminLayout title="Rekapitulasi">
  <PageHeader title="Rekapitulasi Suara" eyebrow="Admin Voting" description="Rekap satu kali setelah pemungutan suara ditutup: angkanya disimpan sebagai Abstain untuk Pemilih yang tidak memilih, lalu hasil siap diumumkan.">
    <Button id="export" variant="secondary" size="sm" type="button" hidden><IconDownload size={16} stroke={1.8} aria-hidden="true" />Unduh Excel</Button>
  </PageHeader>

  {!authorized && <Callout tone="warning" icon={IconAlertTriangle} title="Akses khusus Admin Voting" class="mt-5">Anda tidak memiliki akses ke halaman rekapitulasi.</Callout>}

  {authorized && <>
    <Callout id="recap-error" tone="danger" icon={IconAlertCircle} class="mt-5" hidden></Callout>

    <section id="recap-state" class={panel + " mt-5"} aria-label="Keadaan rekapitulasi">
      <p class="text-[13px] text-brand-muted">Memuat keadaan rekapitulasi...</p>
    </section>

    <section id="recap-tabs" hidden class="mt-5 grid gap-[17px]" aria-label="Data rekapitulasi">
      <div class="min-w-0 overflow-x-auto">
        <div id="tab-list" role="tablist" aria-label="Tab rekapitulasi" class="flex min-w-max gap-1 rounded-lg border border-brand-border bg-card p-1"></div>
      </div>
      <div id="tab-panels" class="min-w-0"></div>
      <Callout tone="info" icon={IconSpeakerphone} title="Langkah berikutnya: Umumkan Hasil" class="mt-1">
        Hasil baru terlihat publik setelah diumumkan. Buka <a class="underline underline-offset-2" href="/admin/pemilihan">Umumkan Hasil di Pengaturan</a> untuk mengumumkannya.
      </Callout>
    </section>
  </>}
</AdminLayout>

{authorized && <>
  <div id="recap-backdrop" hidden class="fixed inset-0 z-30 bg-foreground/40"></div>
  <section id="recap-dialog" hidden role="dialog" aria-modal="true" aria-labelledby="recap-dialog-title" class="fixed inset-x-0 bottom-0 z-40 mx-auto max-h-[85dvh] w-full max-w-lg overflow-auto rounded-t-xl border border-brand-border bg-card p-5 pb-[max(1.25rem,env(safe-area-inset-bottom))] shadow-2xl">
    <div class="mx-auto mb-4 h-1 w-10 rounded-full bg-border" aria-hidden="true"></div>
    <h2 id="recap-dialog-title" class="text-xl font-bold tracking-tight text-brand-ink">Rekapitulasi Suara</h2>
    <p class="mt-2 text-sm leading-6 text-brand-muted"><strong id="recap-number" class="text-brand-ink tabular-nums">0</strong> Pemilih yang tidak memilih akan dihitung sebagai Abstain. Angkanya Hak pilih dikurangi yang sudah memilih, hanya jumlah dan tidak pernah per orang. <span id="recap-links" hidden></span> Tindakan ini hanya dapat dijalankan sekali dan tidak dapat dibatalkan.</p>
    <Callout id="recap-dialog-error" tone="danger" class="mt-3" hidden></Callout>
    <p id="recap-dialog-status" role="status" aria-live="polite" class="mt-2 text-[13px] text-brand-muted"></p>
    <div class="mt-4 flex flex-wrap gap-3 border-t border-brand-border pt-4">
      <Button id="recap-confirm" type="button" variant="danger" class="flex-1">Rekapitulasi Suara</Button>
      <Button id="recap-cancel" type="button" variant="secondary">Batal</Button>
    </div>
  </section>
  <script>
    import writeExcelFile from "write-excel-file/browser";

    type RegionRow = { key: string; name: string; hak_pilih: number; used: number; participation_pct: number | null; remainder: boolean };
    type KomsatRow = { path: string; name: string; korda: string; hak_pilih: number; used: number; participation_pct: number | null; remainder: boolean };
    type BallotRow = { receipt_hash: string; choice: string };
    type AbstainRow = { korda: string; name: string; abstain: number; hak_pilih: number; share: number | null; remainder: boolean };
    type Summary = {
      title: string; opens_at: string | null; closes_at: string | null; recap_at: string | null; exported_at: string;
      dpt_source: "frozen" | "closing" | "live"; dpt_source_label: string; total_dpt: number;
      invites_created: number; invites_cancelled: number; invites_used: number; invites_unused: number;
      dpt_final: number; votes_used: number; ballot_count: number;
      setuju: number; tidak_setuju: number; abstain: number;
      setuju_pct: number; tidak_setuju_pct: number; abstain_pct: number;
      votes_cast: number; setuju_pct_cast: number | null; tidak_setuju_pct_cast: number | null;
    };
    type RecapPayload = {
      stage: "draft" | "scheduled" | "open" | "closed" | "published";
      single_candidate_mode: boolean;
      recap_done: boolean;
      recap_at: string | null;
      pending_count: number;
      unused_links: number;
      can_run: boolean;
      reason: string | null;
      summary?: Summary;
      korda?: RegionRow[];
      komsat?: KomsatRow[];
      ballots?: BallotRow[];
      abstain?: AbstainRow[];
    };

    const stateBox = document.querySelector<HTMLElement>("#recap-state")!;
    const tabsBox = document.querySelector<HTMLElement>("#recap-tabs")!;
    const tabList = document.querySelector<HTMLElement>("#tab-list")!;
    const tabPanels = document.querySelector<HTMLElement>("#tab-panels")!;
    const error = document.querySelector<HTMLElement>("#recap-error")!;
    const exportButton = document.querySelector<HTMLButtonElement>("#export")!;
    const dialog = document.querySelector<HTMLElement>("#recap-dialog")!;
    const backdrop = document.querySelector<HTMLElement>("#recap-backdrop")!;
    const dialogError = document.querySelector<HTMLElement>("#recap-dialog-error")!;
    const dialogStatus = document.querySelector<HTMLElement>("#recap-dialog-status")!;
    const dialogNumber = document.querySelector<HTMLElement>("#recap-number")!;
    const openDialogButton = document.querySelector<HTMLButtonElement>("#open-recap")!;
    const confirmButton = document.querySelector<HTMLButtonElement>("#recap-confirm")!;

    const num = (n: number) => new Intl.NumberFormat("id-ID").format(n);
    const pct = (n: number) => new Intl.NumberFormat("id-ID", { maximumFractionDigits: 1 }).format(n) + "%";
    const jst = (value: string | null) => {
      if (!value) return "—";
      const date = new Date(value);
      if (Number.isNaN(date.valueOf())) return value;
      return new Intl.DateTimeFormat("id-ID", { timeZone: "Asia/Tokyo", day: "numeric", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit", hourCycle: "h23" }).format(date) + " JST";
    };
    const esc = (s: unknown) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]!));
    const panelClass = "min-w-0 rounded-xl border border-brand-border bg-card p-[22px] max-[700px]:p-[17px]";
    const titleClass = "text-lg leading-snug font-bold tracking-tight text-brand-ink";
    const muted = "text-[13px] text-brand-muted";
    const th = "h-10 px-2 text-left align-middle text-xs font-medium text-brand-muted whitespace-nowrap";
    const tableWrap = (inner: string) => '<div class="mt-3 overflow-x-auto"><table class="w-full caption-bottom text-sm"><thead><tr class="border-b border-brand-border">' + inner + "</tr></thead><tbody>";
    // Label Ringkasan satu sumber untuk tab dan lembar Excel (keputusan owner
    // 2026-11-22: breakdown DPT tiga baris dan dua kolom persentase).
    const LABEL_DPT_ANGGOTA = "DPT anggota (daftar anggota portal)";
    const LABEL_DPT_UNDANGAN = "+ Pemilih undangan (tautan dipakai)";
    const LABEL_DPT_FINAL = "= DPT final (Hak pilih hasil)";
    const LABEL_PCT_DPT = "% dari DPT final";
    const LABEL_PCT_MASUK = "% dari suara masuk";
    const CATATAN_TAUTAN = "Tautan yang belum dipakai dibatalkan otomatis saat Rekapitulasi Suara dan tidak dihitung.";
    const CATATAN_HASIL = "Sistem tidak menetapkan pemenang; ketentuan ambang (DPT atau suara masuk) diputuskan panitia.";
    const GARIS = "—";

    let data: RecapPayload | null = null;

    function showError(message: string) {
      error.textContent = message;
      error.removeAttribute("hidden");
    }

    function renderState() {
      if (!data) return;
      stateBox.replaceChildren();
      if (!data.recap_done) {
        let note: string;
        if (!data.single_candidate_mode) {
          note = "Rekapitulasi Suara hanya berlaku pada pemilihan mode kandidat tunggal.";
        } else if (data.stage === "closed") {
          note = "Pemungutan suara telah ditutup. Jalankan rekapitulasi untuk menyimpan angka Pemilih yang tidak memilih sebagai Abstain.";
        } else {
          note = "Rekapitulasi Suara membuka setelah pemungutan suara ditutup. Saat ini pemilihan masih " + ({ draft: "Draf", scheduled: "Terjadwal", open: "Dibuka", published: "Diumumkan" }[data.stage] ?? data.stage) + ".";
        }
        stateBox.innerHTML =
          '<h2 class="' + titleClass + '">Rekapitulasi suara</h2>' +
          '<p class="mt-2 mb-0 ' + muted + '">' + esc(note) + "</p>";
        if (data.stage === "closed" && data.single_candidate_mode && data.can_run) {
          stateBox.innerHTML +=
            '<div class="mt-4 flex flex-wrap items-center gap-3"><button id="open-recap" type="button" class="inline-flex min-h-11 shrink-0 items-center justify-center gap-2 rounded-md bg-primary px-4 py-2 font-semibold text-primary-foreground transition-colors hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring min-[600px]:h-8 min-[600px]:min-h-8 min-[600px]:px-3 min-[600px]:py-0 min-[600px]:text-sm">Rekapitulasi Suara</button>' +
            '<span class="' + muted + '">Satu kali, tidak dapat dibatalkan.</span></div>';
          document.querySelector<HTMLButtonElement>("#open-recap")?.addEventListener("click", openDialog);
        }
        exportButton.hidden = true;
        tabsBox.hidden = true;
        return;
      }
      stateBox.hidden = true;
      tabsBox.hidden = false;
      exportButton.hidden = false;
      renderTabs();
    }

    type TabDef = { id: string; label: string; render: () => string };
    function tabs(): TabDef[] {
      const s = data!.summary!;
      return [
        {
          id: "ringkasan",
          label: "Ringkasan",
          render: () => {
            // Baris penuh (span dua kolom) untuk cerita hitungan DPT supaya
            // tiga barisnya terbaca berurutan sebagai satu uraian.
            const row = (label: string, value: string, full = false) => '<div class="grid min-w-0 gap-0.5 border-t border-brand-border py-2.5 first:border-t-0' + (full ? " min-[601px]:col-span-2" : "") + '"><dt class="text-xs text-brand-muted">' + esc(label) + '</dt><dd class="m-0 text-[15px] font-semibold text-brand-ink tabular-nums">' + value + "</dd></div>";
            const note = (text: string) => ' <span class="text-[13px] font-normal text-brand-muted">' + esc(text) + "</span>";
            const castPct = (share: number | null) => (share === null ? GARIS : pct(share));
            const hasilRow = (label: string, count: number, shareDpt: number, shareMasuk: number | null) => '<tr class="border-b border-brand-border last:border-b-0"><th scope="row" class="px-2 py-2.5 text-left align-middle text-[13px] font-semibold text-brand-ink">' + esc(label) + '</th><td class="px-2 py-2.5 align-middle text-[13px] tabular-nums">' + num(count) + '</td><td class="px-2 py-2.5 align-middle text-[13px] tabular-nums">' + pct(shareDpt) + '</td><td class="px-2 py-2.5 align-middle text-[13px] tabular-nums">' + castPct(shareMasuk) + "</td></tr>";
            return '<section class="' + panelClass + '"><h2 class="' + titleClass + '">Ringkasan</h2><dl class="m-0 grid grid-cols-1 gap-0 pt-1 min-[601px]:grid-cols-2 min-[601px]:gap-x-6">' +
              row("Judul pemilihan", esc(s.title || "Pemilihan")) +
              row("Jadwal", esc(jst(s.opens_at)) + " – " + esc(jst(s.closes_at))) +
              row("Waktu rekapitulasi", esc(jst(s.recap_at))) +
              row("Waktu ekspor", esc(jst(s.exported_at))) +
              row(LABEL_DPT_ANGGOTA, num(s.total_dpt) + note(s.dpt_source_label), true) +
              row(LABEL_DPT_UNDANGAN, num(s.invites_used), true) +
              row(LABEL_DPT_FINAL, num(s.dpt_final), true) +
              row("Tautan undangan", num(s.invites_created) + " dibuat · " + num(s.invites_used) + " dipakai · " + num(s.invites_cancelled) + " dibatalkan" + note(CATATAN_TAUTAN), true) +
              row("Total suara digunakan", num(s.votes_used) + note("surat suara " + num(s.ballot_count)), true) +
              "</dl>" +
              '<div class="mt-4 overflow-x-auto"><table class="w-full text-sm"><caption class="sr-only">Hasil pilihan</caption><thead><tr class="border-b border-brand-border"><th class="' + th + '">Pilihan</th><th class="' + th + '">Suara</th><th class="' + th + '">' + esc(LABEL_PCT_DPT) + '</th><th class="' + th + '">' + esc(LABEL_PCT_MASUK) + "</th></tr></thead><tbody>" +
              hasilRow("Setuju", s.setuju, s.setuju_pct, s.setuju_pct_cast) +
              hasilRow("Tidak Setuju", s.tidak_setuju, s.tidak_setuju_pct, s.tidak_setuju_pct_cast) +
              // Abstain bukan suara masuk: sel suara masuknya selalu "—".
              hasilRow("Abstain", s.abstain, s.abstain_pct, null) +
              "</tbody></table></div>" +
              '<p class="mt-3 mb-0 ' + muted + '">' + esc(CATATAN_HASIL) + "</p></section>";
          },
        },
        {
          id: "korda",
          label: "Korda",
          render: () => {
            const rows = data!.korda!;
            const body = rows.map((r) => '<tr class="border-b border-brand-border last:border-b-0"><th scope="row" class="p-2 text-left align-middle text-[13px] font-semibold text-brand-ink">' + esc(r.name) + (r.remainder ? ' <span class="font-normal text-brand-muted">(di luar daftar korda)</span>' : "") + '</th><td class="p-2 align-middle text-[13px] tabular-nums">' + num(r.hak_pilih) + '</td><td class="p-2 align-middle text-[13px] tabular-nums">' + num(r.used) + '</td><td class="p-2 align-middle text-[13px] tabular-nums">' + (r.participation_pct === null ? "—" : pct(r.participation_pct)) + "</td></tr>").join("");
            return '<section class="' + panelClass + '"><h2 class="' + titleClass + '">Korda</h2><p class="mt-1 mb-0 ' + muted + '">Partisipasi saja: angka pilihan tidak dirinci per korda.</p>' +
              tableWrap('<th class="' + th + '">Korda</th><th class="' + th + '">Hak pilih</th><th class="' + th + '">Suara digunakan</th><th class="' + th + '">Partisipasi</th>') + body + "</tbody></table></div>" +
              '<p class="mt-3 mb-0 ' + muted + '">' + rows.length + " baris · jumlah Hak pilih " + num(rows.reduce((a, r) => a + r.hak_pilih, 0)) + " · jumlah suara " + num(rows.reduce((a, r) => a + r.used, 0)) + "</p></section>";
          },
        },
        {
          id: "komsat",
          label: "Komsat",
          render: () => {
            const rows = data!.komsat!;
            const body = rows.map((r) => '<tr class="border-b border-brand-border last:border-b-0"><td class="p-2 align-middle text-[13px] text-brand-ink">' + esc(r.korda) + '</td><th scope="row" class="p-2 text-left align-middle text-[13px] font-semibold text-brand-ink">' + esc(r.name) + (r.remainder ? ' <span class="font-normal text-brand-muted">(di luar daftar komsat)</span>' : "") + '</th><td class="p-2 align-middle text-[13px] tabular-nums">' + num(r.hak_pilih) + '</td><td class="p-2 align-middle text-[13px] tabular-nums">' + num(r.used) + '</td><td class="p-2 align-middle text-[13px] tabular-nums">' + (r.participation_pct === null ? "—" : pct(r.participation_pct)) + "</td></tr>").join("");
            return '<section class="' + panelClass + '"><h2 class="' + titleClass + '">Komsat</h2><p class="mt-1 mb-0 ' + muted + '">Partisipasi saja, lengkap dengan kordanya.</p>' +
              tableWrap('<th class="' + th + '">Korda</th><th class="' + th + '">Komsat</th><th class="' + th + '">Hak pilih</th><th class="' + th + '">Suara digunakan</th><th class="' + th + '">Partisipasi</th>') + body + "</tbody></table></div>" +
              '<p class="mt-3 mb-0 ' + muted + '">' + rows.length + " baris · jumlah Hak pilih " + num(rows.reduce((a, r) => a + r.hak_pilih, 0)) + " · jumlah suara " + num(rows.reduce((a, r) => a + r.used, 0)) + "</p></section>";
          },
        },
        {
          id: "kotak-suara",
          label: "Kotak suara",
          render: () => {
            const rows = data!.ballots!;
            const body = rows.map((r) => '<tr class="border-b border-brand-border last:border-b-0"><td class="p-2 align-middle font-mono text-xs break-all text-brand-ink">' + esc(r.receipt_hash) + '</td><td class="p-2 align-middle text-[13px] whitespace-nowrap">' + esc(r.choice) + "</td></tr>").join("");
            return '<section class="' + panelClass + '"><h2 class="' + titleClass + '">Kotak suara</h2><p class="mt-1 mb-0 ' + muted + '">Satu baris per surat suara: hash kuitansi dan pilihan saja, tanpa identitas, tanpa komsat, tanpa waktu. Urutan diacak berdasarkan hash.</p>' +
              tableWrap('<th class="' + th + '">Hash kuitansi</th><th class="' + th + '">Pilihan</th>') + body + "</tbody></table></div>" +
              '<p class="mt-3 mb-0 ' + muted + '">' + num(rows.length) + " surat suara</p></section>";
          },
        },
        {
          id: "abstain",
          label: "Abstain",
          render: () => {
            // Dianonimkan (putusan 2026-11-22): hitungan per komsat saja, tanpa
            // nama dan tanpa nomor kartu; server tidak pernah mengirim per anggota.
            const rows = data!.abstain!;
            const total = rows.reduce((sum, r) => sum + r.abstain, 0);
            const body = rows.map((r) => '<tr class="border-b border-brand-border last:border-b-0"><td class="p-2 align-middle text-[13px] text-brand-ink">' + esc(r.korda) + '</td><th scope="row" class="p-2 text-left align-middle text-[13px] font-semibold text-brand-ink">' + esc(r.name) + (r.remainder ? ' <span class="font-normal text-brand-muted">(di luar daftar komsat)</span>' : "") + '</th><td class="p-2 align-middle text-[13px] tabular-nums">' + num(r.abstain) + '</td><td class="p-2 align-middle text-[13px] tabular-nums">' + (r.share === null ? "—" : pct(r.share)) + "</td></tr>").join("");
            const totalRow = '<tr><th scope="row" colspan="2" class="p-2 text-left align-middle text-[13px] font-bold text-brand-ink">Jumlah</th><td class="p-2 align-middle text-[13px] font-bold tabular-nums">' + num(total) + '</td><td class="p-2 align-middle"></td></tr>';
            return '<section class="' + panelClass + '"><h2 class="' + titleClass + '">Abstain</h2><p class="mt-1 mb-0 ' + muted + '">Dianonimkan: hitungan Pemilih yang tidak memilih per komsat, tanpa nama dan tanpa nomor kartu. Tautan undangan tidak dihitung Abstain — yang belum dipakai dibatalkan saat Rekapitulasi.</p>' +
              tableWrap('<th class="' + th + '">Korda</th><th class="' + th + '">Komsat</th><th class="' + th + '">Abstain</th><th class="' + th + '">Bagian Hak pilih komsat</th>') + body + totalRow + "</tbody></table></div>" +
              '<p class="mt-3 mb-0 ' + muted + '">' + num(rows.length) + " komsat · jumlah Abstain sama dengan angka di Ringkasan.</p></section>";
          },
        },
      ];
    }

    let activeTab = "ringkasan";
    function renderTabs() {
      const defs = tabs();
      tabList.innerHTML = "";
      tabPanels.replaceChildren();
      for (const def of defs) {
        const button = document.createElement("button");
        button.type = "button";
        button.id = "tab-" + def.id;
        button.setAttribute("role", "tab");
        button.setAttribute("aria-selected", String(def.id === activeTab));
        button.setAttribute("aria-controls", "panel-" + def.id);
        button.textContent = def.label;
        button.className = "min-h-11 rounded-md px-3 py-1.5 text-sm font-semibold transition-colors min-[600px]:min-h-8 " + (def.id === activeTab ? "bg-brand-red/10 text-brand-red" : "text-[#555d66] hover:bg-accent hover:text-brand-ink");
        button.addEventListener("click", () => { activeTab = def.id; renderTabs(); });
        tabList.append(button);
        if (def.id === activeTab) {
          const holder = document.createElement("div");
          holder.id = "panel-" + def.id;
          holder.setAttribute("role", "tabpanel");
          holder.setAttribute("aria-labelledby", "tab-" + def.id);
          holder.innerHTML = def.render();
          tabPanels.append(holder);
        }
      }
    }

    async function load() {
      error.setAttribute("hidden", "");
      try {
        const response = await fetch("/api/admin/recap", { credentials: "same-origin" });
        const payload = (await response.json()) as RecapPayload & { error?: string };
        if (!response.ok) throw new Error(payload.error || "Data rekapitulasi gagal dimuat.");
        data = payload;
        renderState();
      } catch (problem) {
        stateBox.replaceChildren();
        showError((problem as Error).message + " Coba muat ulang.");
      }
    }

    function closeDialog() {
      dialog.hidden = true;
      backdrop.hidden = true;
      document.body.style.overflow = "";
      openDialogButton?.focus();
    }
    function openDialog() {
      if (!data) return;
      dialogError.setAttribute("hidden", "");
      dialogStatus.textContent = "";
      confirmButton.disabled = false;
      dialogNumber.textContent = num(data.pending_count);
      const linksNote = document.querySelector<HTMLElement>("#recap-links")!;
      if (data.unused_links > 0) {
        linksNote.textContent = `Selain itu, ${num(data.unused_links)} tautan undangan yang belum dipakai akan dibatalkan otomatis dan tidak lagi menambah Hak pilih.`;
        linksNote.removeAttribute("hidden");
      } else {
        linksNote.setAttribute("hidden", "");
      }
      dialog.hidden = false;
      backdrop.hidden = false;
      document.body.style.overflow = "hidden";
      confirmButton.focus();
    }
    backdrop.addEventListener("click", closeDialog);
    document.querySelector<HTMLButtonElement>("#recap-cancel")!.addEventListener("click", closeDialog);
    dialog.addEventListener("keydown", (e) => { if (e.key === "Escape") { e.preventDefault(); closeDialog(); } });
    confirmButton.addEventListener("click", async () => {
      dialogError.setAttribute("hidden", "");
      dialogStatus.textContent = "Menjalankan rekapitulasi...";
      await window.withBusy(confirmButton, "Merekap…", async () => {
        try {
          const response = await fetch("/api/election/recap", { method: "POST", credentials: "same-origin", headers: { "content-type": "application/json" }, body: "{}" });
          const payload = (await response.json().catch(() => ({}))) as { error?: string };
          if (!response.ok) {
            dialogError.textContent = payload.error || "Rekapitulasi belum dapat dijalankan.";
            dialogError.removeAttribute("hidden");
            dialogStatus.textContent = "";
            window.toast(payload.error || "Rekapitulasi belum dapat dijalankan.", { variant: "error" });
            return;
          }
          closeDialog();
          window.toast("Rekapitulasi Suara dijalankan: angka tidak memilih disimpan sebagai Abstain.", { variant: "success", duration: 8000 });
          activeTab = "ringkasan";
          await load();
        } catch {
          dialogError.textContent = "Koneksi bermasalah. Periksa jaringan lalu coba kembali.";
          dialogError.removeAttribute("hidden");
          dialogStatus.textContent = "";
        }
      });
    });

    exportButton.addEventListener("click", async () => {
      error.setAttribute("hidden", "");
      if (!data?.recap_done || !data.summary) return;
      await window.withBusy(exportButton, "Menyiapkan berkas…", async () => {
        try {
          // Tandai unduhan di audit lebih dulu: berkasnya dibangun lokal di peramban.
          const marker = await fetch("/api/admin/recap/download", { method: "POST", credentials: "same-origin", headers: { "content-type": "application/json" }, body: "{}" });
          if (!marker.ok) throw new Error("penanda-unduhan");
          const s = data.summary;
          const kv = (label: string, value: string | number) => [label, value];
          // Label dan baris yang sama dengan tab Ringkasan (satu sumber label);
          // persentase suara masuk kosong tampil "—" tanpa pembagian nol.
          const pctMasuk = (share: number | null) => (share === null ? GARIS : share);
          const ringkasan: (string | number)[][] = [
            ["Keterangan", "Nilai"],
            kv("Judul pemilihan", s.title || "Pemilihan"),
            kv("Mulai (JST)", jst(s.opens_at)),
            kv("Selesai (JST)", jst(s.closes_at)),
            kv("Waktu rekapitulasi (JST)", jst(s.recap_at)),
            kv("Waktu ekspor (JST)", jst(s.exported_at)),
            kv("Sumber DPT anggota", s.dpt_source_label),
            kv(LABEL_DPT_ANGGOTA, s.total_dpt),
            kv(LABEL_DPT_UNDANGAN, s.invites_used),
            kv(LABEL_DPT_FINAL, s.dpt_final),
            kv("Tautan undangan dibuat", s.invites_created),
            kv("Tautan undangan dipakai", s.invites_used),
            kv("Tautan undangan dibatalkan", s.invites_cancelled),
            kv("Catatan tautan", CATATAN_TAUTAN),
            kv("Total suara digunakan", s.votes_used),
            kv("Surat suara di kotak", s.ballot_count),
            kv("Setuju", s.setuju),
            kv("Setuju (" + LABEL_PCT_DPT + ")", s.setuju_pct),
            kv("Setuju (" + LABEL_PCT_MASUK + ")", pctMasuk(s.setuju_pct_cast)),
            kv("Tidak Setuju", s.tidak_setuju),
            kv("Tidak Setuju (" + LABEL_PCT_DPT + ")", s.tidak_setuju_pct),
            kv("Tidak Setuju (" + LABEL_PCT_MASUK + ")", pctMasuk(s.tidak_setuju_pct_cast)),
            kv("Abstain", s.abstain),
            kv("Abstain (" + LABEL_PCT_DPT + ")", s.abstain_pct),
            kv("Abstain (" + LABEL_PCT_MASUK + ")", GARIS),
            kv("Catatan hasil", CATATAN_HASIL),
          ];
          const sheets = [
            { sheet: "Ringkasan", data: ringkasan, columns: [{ width: 34 }, { width: 34 }] },
            {
              sheet: "Korda",
              data: [["Korda", "Hak pilih", "Suara digunakan", "Partisipasi (%)"], ...data.korda!.map((r) => [r.name, r.hak_pilih, r.used, r.participation_pct ?? "" ] as (string | number)[])],
              columns: [{ width: 30 }, { width: 12 }, { width: 16 }, { width: 15 }],
            },
            {
              sheet: "Komsat",
              data: [["Korda", "Komsat", "Hak pilih", "Suara digunakan", "Partisipasi (%)"], ...data.komsat!.map((r) => [r.korda, r.name, r.hak_pilih, r.used, r.participation_pct ?? "" ] as (string | number)[])],
              columns: [{ width: 26 }, { width: 30 }, { width: 12 }, { width: 16 }, { width: 15 }],
            },
            {
              sheet: "Kotak suara",
              data: [["Hash kuitansi", "Pilihan"], ...data.ballots!.map((r) => [r.receipt_hash, r.choice] as (string | number)[])],
              columns: [{ width: 68 }, { width: 14 }],
            },
            {
              sheet: "Abstain",
              data: [
                ["Korda", "Komsat", "Abstain", "Bagian Hak pilih komsat (%)"],
                ...data.abstain!.map((r) => [r.korda, r.name, r.abstain, r.share ?? ""] as (string | number)[]),
                ["Jumlah", "", data.summary!.abstain, ""],
              ],
              columns: [{ width: 24 }, { width: 32 }, { width: 10 }, { width: 26 }],
            },
          ];
          await writeExcelFile(sheets).toFile("rekapitulasi-suara.xlsx");
          window.toast("Berkas Excel diunduh.", { variant: "success" });
        } catch {
          window.toast("Berkas Excel gagal dibuat. Coba lagi.", { variant: "error" });
        }
      });
    });

    load();
  </script>
</>}
