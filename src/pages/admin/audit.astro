---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { env } from "cloudflare:workers";
import { IconClipboardList, IconFileText, IconHash, IconShieldCheck } from "@tabler/icons-astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import PanelCard from "../../components/ui/PanelCard.astro";
import Callout from "../../components/ui/Callout.astro";
import Button from "../../components/ui/Button.astro";
import Empty from "../../components/ui/Empty.astro";
import { isAdminPageAuthorized, SESSION_COOKIE, type AdminBindings } from "./admin-auth";
const bindings = env as unknown as AdminBindings;
const authorized = await isAdminPageAuthorized(Astro.cookies.get(SESSION_COOKIE)?.value, bindings);
---
<AdminLayout title="Audit">
  <PageHeader title="Audit" eyebrow="Admin Voting" description="Periksa integritas catatan tindakan dan snapshot penutupan." />
  {authorized && <>
    <div class="mt-5 grid gap-[17px]">
      <PanelCard title="Integritas rantai" description="Setiap tindakan Admin Voting tercatat dan dirangkai dengan hash." icon={IconShieldCheck}>
        <div id="integrity-status" data-integrity-banner role="status" aria-live="polite" class="text-[13px] text-brand-muted">Memeriksa integritas rantai...</div>
        <p id="integrity-error" role="alert" class="mt-2 mb-0 text-[13px] font-semibold text-destructive"></p>
        <Button id="integrity-check" type="button" variant="secondary" size="sm" class="mt-3">Periksa ulang</Button>
      </PanelCard>
      <section id="snapshot" hidden class="min-w-0 rounded-xl border border-brand-border bg-card p-[22px] text-brand-ink max-[700px]:p-[17px]">
        <div class="mb-4 flex flex-wrap items-start justify-between gap-x-4 gap-y-3">
          <div class="flex min-w-0 items-start gap-2.5">
            <span aria-hidden="true" class="mt-0.5 shrink-0 text-brand-red [&_svg]:size-5"><IconHash size={20} stroke={1.8} /></span>
            <div class="min-w-0">
              <h2 class="text-lg leading-snug font-bold tracking-tight">Snapshot penutupan</h2>
              <p class="mt-1 text-[13px] text-brand-muted">Hash penutupan membuktikan jumlah suara saat pemungutan berhenti.</p>
            </div>
          </div>
        </div>
        <p id="snapshot-value" class="mt-0 mb-0 font-mono text-[13px] break-all text-brand-ink"></p>
        <p id="snapshot-time" class="mt-1 mb-0 text-xs text-brand-muted"></p>
        <Button id="snapshot-copy" type="button" variant="secondary" size="sm" class="mt-3">Salin hash</Button>
        <p id="snapshot-error" role="alert" class="mt-2 mb-0 text-[13px] font-semibold text-destructive"></p>
      </section>
    </div>
    <p id="entries-error" role="alert" class="mt-4 mb-0 text-[13px] font-semibold text-destructive"></p>
    <section id="entries" aria-label="Entri audit" class="mt-4 grid gap-[17px]"></section>
    <section id="empty-state" data-empty-state hidden class="mt-4">
      <Empty icon={IconFileText} title="Belum ada entri audit" description="Setiap tindakan Admin Voting akan muncul di sini setelah tercatat." />
    </section>
    <div class="mt-4 flex flex-wrap items-center gap-2">
      <Button id="load-more" type="button" variant="secondary" size="sm" hidden><IconClipboardList size={16} stroke={1.8} aria-hidden="true" /> Muat lainnya</Button>
      <p id="more-error" role="alert" class="m-0 text-[13px] font-semibold text-destructive"></p>
    </div>
  </>}
</AdminLayout>
{authorized && <script>
 type Entry={seq:number;at:string;actor_type:string;actor_name:string|null;action:string;target:string|null;komsat_path:string|null;detail_json:Record<string,unknown>|null};
 const entries=document.querySelector<HTMLElement>('#entries')!, empty=document.querySelector<HTMLElement>('#empty-state')!, more=document.querySelector<HTMLButtonElement>('#load-more')!;
 const messages={integrity:document.querySelector<HTMLElement>('#integrity-error')!,entries:document.querySelector<HTMLElement>('#entries-error')!,more:document.querySelector<HTMLElement>('#more-error')!,snapshot:document.querySelector<HTMLElement>('#snapshot-error')!}; let before:number|null=null, hasMore=false;
 async function json(url:string){const response=await fetch(url);if(!response.ok)throw new Error(`Permintaan gagal (${response.status}).`);return response.json()}
 const panel='rounded-xl border border-brand-border bg-card p-[22px] max-[700px]:p-[17px]';
 async function checkIntegrity(){const box=document.querySelector<HTMLElement>('#integrity-status')!;messages.integrity.textContent='';box.textContent='Memeriksa integritas rantai...';box.className='text-[13px] text-brand-muted';try{const d=await json('/api/audit/integrity');box.textContent=d.intact?`Rantai log utuh (diperiksa ${d.checked_at})`:`Rantai log terputus pada seq ${d.broken_at}`;box.className=d.intact?'block rounded-lg bg-[#f1f5f3] px-3.5 py-3 text-[13px] font-semibold leading-5 text-[#35604a]':'block rounded-lg border border-[#f0ccd4] bg-[#fdf2f4] px-3.5 py-3 text-[13px] font-semibold leading-5 text-[#8f1730]'}catch(e){box.textContent='Status integritas tidak tersedia.';box.className='text-[13px] text-brand-muted';messages.integrity.textContent=`Gagal memeriksa integritas: ${(e as Error).message}`}}
 function detailRows(detail:Record<string,unknown>){const dl=document.createElement('dl');dl.className='m-0 mt-3 grid gap-2 text-[13px] min-[600px]:grid-cols-[96px_minmax(0,1fr)] min-[600px]:gap-x-3';for(const [key,value] of Object.entries(detail)){const dt=document.createElement('dt');dt.className='text-xs text-brand-muted';dt.textContent=key;const dd=document.createElement('dd');dd.className='m-0 min-w-0 break-all font-semibold text-brand-ink';dd.textContent=typeof value==='string'?value:JSON.stringify(value);dl.append(dt,dd)}return dl}
 function render(row:Entry){
   const article=document.createElement('article');article.className=panel+' grid gap-2';
   const head=document.createElement('div');head.className='flex flex-wrap items-center gap-2';
   const seq=document.createElement('span');seq.className='inline-flex w-fit shrink-0 items-center justify-center rounded-full border border-border bg-card px-2 py-0.5 text-xs font-medium tabular-nums text-brand-muted';seq.textContent='#'+row.seq;
   const time=document.createElement('time');time.className='text-xs text-brand-muted';time.textContent=row.at;
   const actor=document.createElement('span');actor.className='inline-flex w-fit shrink-0 items-center justify-center rounded-full bg-secondary px-2 py-0.5 text-xs font-medium text-foreground';actor.textContent=({admin:'Admin Voting',voter:'Pemilih',system:'Sistem'} as Record<string,string>)[row.actor_type]||row.actor_type;
   head.append(seq,time,actor);article.append(head);
   const action=document.createElement('p');action.className='m-0 text-sm leading-snug font-semibold text-brand-ink';action.textContent=row.action;article.append(action);
   if(row.target||row.komsat_path){const target=document.createElement('p');target.className='m-0 text-xs text-brand-muted';target.textContent=[row.target,row.komsat_path].filter(Boolean).join(' · ');article.append(target)}
   if(row.detail_json&&Object.keys(row.detail_json).length){const details=document.createElement('details');details.className='mt-1 border-t border-brand-border pt-2';const summary=document.createElement('summary');summary.className='min-h-11 cursor-pointer text-[13px] font-bold text-brand-red underline-offset-2 hover:underline min-[600px]:min-h-8';summary.textContent='Detail';details.append(summary,detailRows(row.detail_json));article.append(details)}
   entries.append(article)
 }
 async function load(initial=false){
   messages.entries.textContent='';messages.more.textContent='';more.disabled=true;
   try{
     const url=initial?'/api/audit':`/api/audit?before_seq=${before}`;
     const data=await json(url);
     const rows:Entry[]=Array.isArray(data.entries)?data.entries:Array.isArray(data.results)?data.results:[];
     for(const row of rows)render(row);
     if(rows.length){before=Math.min(...rows.map(r=>r.seq));hasMore=typeof data.next_before_seq==='number'?data.next_before_seq!==null:rows.length===50}else hasMore=false;
     empty.hidden=entries.childElementCount!==0;
     more.hidden=!hasMore;
   }catch(e){messages.entries.textContent=`Gagal memuat entri audit: ${(e as Error).message}. Periksa koneksi lalu muat ulang halaman.`}
   finally{more.disabled=false}
 }
 document.querySelector('#integrity-check')!.addEventListener('click',checkIntegrity);
 more.addEventListener('click',()=>load());
 async function loadSnapshot(){const block=document.querySelector<HTMLElement>('#snapshot')!;try{const d=await json('/api/audit/snapshot');if(!d.closing_snapshot_hash)return;block.hidden=false;const value=document.querySelector<HTMLElement>('#snapshot-value')!;value.textContent=d.closing_snapshot_hash.length>32?`${d.closing_snapshot_hash.slice(0,16)}...${d.closing_snapshot_hash.slice(-16)}`:d.closing_snapshot_hash;value.title=d.closing_snapshot_hash;document.querySelector<HTMLElement>('#snapshot-time')!.textContent=d.closing_snapshot_at||'';document.querySelector('#snapshot-copy')!.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(d.closing_snapshot_hash)}catch{messages.snapshot.textContent='Gagal menyalin hash snapshot.'}})}catch(e){messages.snapshot.textContent=`Gagal memuat snapshot: ${(e as Error).message}`}}
 void checkIntegrity();void loadSnapshot();void load(true);
</script>}