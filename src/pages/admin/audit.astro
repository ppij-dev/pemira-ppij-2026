---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { env } from "cloudflare:workers";
import { isAdminPageAuthorized, SESSION_COOKIE, type AdminBindings } from "./admin-auth";
const bindings = env as unknown as AdminBindings;
const authorized = await isAdminPageAuthorized(Astro.cookies.get(SESSION_COOKIE)?.value, bindings);
---
<AdminLayout title="Audit"><div data-audit-page><div class="mb-6"><p class="text-sm font-semibold text-primary">ADMIN VOTING</p><h1 class="mt-1 text-3xl font-bold tracking-tight">Audit</h1><p class="mt-2 text-muted-foreground">Periksa integritas catatan tindakan dan snapshot penutupan.</p></div>
{authorized && <>
<section class="mb-5 rounded-xl border border-border bg-card p-5" aria-labelledby="integrity-heading"><h2 id="integrity-heading" class="text-lg font-semibold">Integritas rantai</h2><div id="integrity-status" data-integrity-banner role="status" class="mt-2" aria-live="polite">Memeriksa integritas rantai…</div><p id="integrity-error" class="mt-2 text-sm text-red-700" role="alert"></p><button id="integrity-check" class="mt-3 min-h-11 rounded-md border border-input px-4 font-medium hover:bg-background">Periksa ulang</button></section>
<section id="snapshot" class="mb-5 hidden rounded-xl border border-border bg-card p-5"><h2 class="text-lg font-semibold">Snapshot penutupan</h2><p id="snapshot-value" class="mt-2 break-all font-mono text-sm"></p><p id="snapshot-time" class="mt-1 text-sm text-muted-foreground"></p><button id="snapshot-copy" class="mt-2 min-h-11 rounded-md border border-input px-4">Salin hash</button><p id="snapshot-error" class="mt-2 text-sm text-red-700" role="alert"></p></section>
<p id="entries-error" class="mb-3 text-sm text-red-700" role="alert"></p><section id="entries" class="space-y-3" aria-label="Entri audit"></section><section id="empty-state" data-empty-state class="hidden rounded-xl border border-border bg-card p-6 text-muted-foreground">Belum ada entri audit.</section><button id="load-more" class="mt-4 hidden min-h-11 rounded-md border border-input bg-card px-4 font-medium hover:bg-background">Muat lainnya</button><p id="more-error" class="mt-2 text-sm text-red-700" role="alert"></p>
</>}
</div></AdminLayout>
{authorized && <script>
 type Entry={seq:number;at:string;actor_type:string;actor_name:string|null;action:string;target:string|null;komsat_path:string|null;detail_json:Record<string,unknown>|null};
 const entries=document.querySelector<HTMLElement>('#entries')!, empty=document.querySelector<HTMLElement>('#empty-state')!, more=document.querySelector<HTMLButtonElement>('#load-more')!;
 const messages={integrity:document.querySelector<HTMLElement>('#integrity-error')!,entries:document.querySelector<HTMLElement>('#entries-error')!,more:document.querySelector<HTMLElement>('#more-error')!,snapshot:document.querySelector<HTMLElement>('#snapshot-error')!}; let before:number|null=null, hasMore=false;
 async function json(url:string){const response=await fetch(url);if(!response.ok)throw new Error(`Permintaan gagal (${response.status}).`);return response.json()}
 async function checkIntegrity(){const box=document.querySelector<HTMLElement>('#integrity-status')!;messages.integrity.textContent='';box.textContent='Memeriksa integritas rantai…';try{const d=await json('/api/audit/integrity');box.textContent=d.intact?`Rantai log utuh (diperiksa ${d.checked_at})`:`Rantai log terputus pada seq ${d.broken_at}`;box.className=`mt-2 font-semibold ${d.intact?'text-emerald-700':'text-red-700'}`}catch(e){box.textContent='Status integritas tidak tersedia.';messages.integrity.textContent=`Gagal memeriksa integritas: ${(e as Error).message}`}}
 function detailRows(detail:Record<string,unknown>){const dl=document.createElement('dl');dl.className='mt-3 grid gap-1 text-sm sm:grid-cols-[max-content_1fr]';for(const [key,value] of Object.entries(detail)){const dt=document.createElement('dt');dt.className='font-medium';dt.textContent=key;const dd=document.createElement('dd');dd.className='break-all';dd.textContent=typeof value==='string'?value:JSON.stringify(value);dl.append(dt,dd)}return dl}
 function render(row:Entry){const article=document.createElement('article');article.className='rounded-xl border border-border bg-card p-4';const head=document.createElement('div');head.className='flex flex-wrap items-center gap-2';const time=document.createElement('time');time.textContent=row.at;const actor=document.createElement('span');actor.className='rounded-full bg-muted px-3 py-1 text-sm';actor.textContent=({admin:'Admin Voting',voter:'Pemilih',system:'Sistem'} as Record<string,string>)[row.actor_type]||row.actor_type;head.append(time,actor);article.append(head);const action=document.createElement('p');action.className='mt-2 font-semibold';action.textContent=row.action;article.append(action);if(row.target||row.komsat_path){const target=document.createElement('p');target.className='mt-1 text-sm text-muted-foreground';target.textContent=[row.target,row.komsat_path].filter(Boolean).join(' · ');article.append(target)}if(row.detail_json&&Object.keys(row.detail_json).length){const details=document.createElement('details');details.className='mt-2';const summary=document.createElement('summary');summary.className='cursor-pointer font-medium';summary.textContent='Detail';details.append(summary,detailRows(row.detail_json));article.append(details)}entries.append(article)}
 async function load(initial=false){messages.entries.textContent='';messages.more.textContent='';more.disabled=true;try{const url=initial?'/api/audit':`/api/audit?before_seq=${before}`;const data=await json(url);const rows:Entry[]=Array.isArray(data.entries)?data.entries:Array.isArray(data.results)?data.results:[];for(const row of rows)render(row);if(rows.length){before=Math.min(...rows.map(r=>r.seq));hasMore=typeof data.next_before_seq==='number'?data.next_before_seq!==null:rows.length===50}else hasMore=false;empty.classList.toggle('hidden',entries.childElementCount!==0);more.classList.toggle('hidden',!hasMore)}catch(e){messages.entries.textContent=`Gagal memuat entri audit: ${(e as Error).message}`}finally{more.disabled=false}}
 document.querySelector('#integrity-check')!.addEventListener('click',checkIntegrity);more.addEventListener('click',()=>load());
 async function loadSnapshot(){const block=document.querySelector<HTMLElement>('#snapshot')!;try{const d=await json('/api/audit/snapshot');if(!d.closing_snapshot_hash)return;block.classList.remove('hidden');const value=document.querySelector<HTMLElement>('#snapshot-value')!;value.textContent=d.closing_snapshot_hash.length>32?`${d.closing_snapshot_hash.slice(0,16)}…${d.closing_snapshot_hash.slice(-16)}`:d.closing_snapshot_hash;value.title=d.closing_snapshot_hash;document.querySelector<HTMLElement>('#snapshot-time')!.textContent=d.closing_snapshot_at||'';document.querySelector('#snapshot-copy')!.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(d.closing_snapshot_hash)}catch{messages.snapshot.textContent='Gagal menyalin hash snapshot.'}})}catch(e){messages.snapshot.textContent=`Gagal memuat snapshot: ${(e as Error).message}`}}
 void checkIntegrity();void loadSnapshot();void load(true);
</script>}
