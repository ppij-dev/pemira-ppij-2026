---
import Base from "../layouts/Base.astro";
import { env } from "cloudflare:workers";
const db=(env as unknown as {DB?:D1Database}).DB;
const config=await db?.prepare("SELECT value FROM system_config WHERE key='site_name'").first<{value:string}>();
const row=await db?.prepare("SELECT status_lock,opens_at,closes_at,closed_early_at FROM elections ORDER BY id LIMIT 1").first<{status_lock:"draft"|"locked"|"published";opens_at:string|null;closes_at:string|null;closed_early_at:string|null}>();
const published=row?.status_lock==="published";
const siteName=config?.value||"PPIJ Pemilu";
---
<Base title={`Hasil · ${siteName}`} siteName={siteName} showHasil={published}>
  <h1 class="text-3xl font-bold tracking-tight">Hasil pemilihan</h1>
  {!published ? <section class="mt-5 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><p class="font-medium text-slate-700">Hasil akan diumumkan panitia.</p><a href="/" class="mt-4 inline-flex font-semibold text-brand-700 underline">Kembali ke beranda</a></section> : <div id="results" class="mt-5 space-y-5"><p class="rounded-xl border border-slate-200 bg-white p-5 text-slate-600">Memuat hasil resmi…</p></div>}
  {published && <script is:inline>{`const root=document.querySelector('#results');const number=(n)=>new Intl.NumberFormat('id-ID').format(n);const esc=(s)=>String(s??'').replace(/[&<>"']/g,(c)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));fetch('/api/results').then(async r=>({r,data:await r.json()})).then(({r,data})=>{if(r.status===409){root.innerHTML='<section class="rounded-2xl border border-slate-200 bg-white p-6"><p>Hasil akan diumumkan panitia.</p><a class="mt-4 inline-block text-brand-700 underline" href="/">Kembali ke beranda</a></section>';return}if(!r.ok)throw new Error(data.error||'Gagal memuat hasil.');root.innerHTML='<section class="grid gap-3 sm:grid-cols-4">'+[['Hak pilih',data.eligible_count],['Sudah digunakan',data.used_count],['Belum digunakan',data.unused_count],['Partisipasi',data.turnout_percentage+'%']].map(([k,v])=>'<div class="rounded-xl border border-slate-200 bg-white p-4"><p class="text-sm text-slate-600">'+k+'</p><p class="mt-1 text-2xl font-bold">'+number(v)+'</p></div>').join('')+'</section><section class="rounded-2xl border border-slate-200 bg-white p-5"><h2 class="text-xl font-bold">Perolehan suara</h2><div class="mt-4 grid gap-3 sm:grid-cols-2">'+data.candidates.map(c=>'<article class="flex items-center gap-3 rounded-xl border border-slate-100 p-4"><span class="flex size-10 items-center justify-center rounded-full font-bold text-white" style="background-color:'+esc(c.color||'#334155')+'">'+esc(c.number)+'</span><strong class="flex-1">'+esc(c.nickname)+'</strong><span class="font-bold">'+number(c.votes)+' suara</span></article>').join('')+'</div></section><section class="overflow-x-auto rounded-2xl border border-slate-200 bg-white p-5"><h2 class="text-xl font-bold">Hasil per korda</h2><table class="mt-4 w-full text-left text-sm"><thead><tr class="border-b"><th class="p-2">Korda</th><th class="p-2">Hak pilih</th><th class="p-2">Partisipasi</th><th class="p-2">Suara kandidat</th></tr></thead><tbody>'+data.korda.map(k=>'<tr class="border-b"><th class="p-2">'+esc(k.name)+'</th><td class="p-2">'+number(k.eligible_count)+'</td><td class="p-2">'+(k.turnout_percentage===null?'—':k.turnout_percentage+'%')+'</td><td class="p-2">'+(k.suppressed?'Data terlalu sedikit':k.candidates.map(c=>esc(c.nickname)+': '+number(c.votes)).join(' · '))+'</td></tr>').join('')+'</tbody></table></section>'}).catch(()=>{root.innerHTML='<p role="alert" class="rounded-xl bg-red-50 p-4 text-red-800">Hasil belum dapat dimuat. Muat ulang halaman.</p>'});`}</script>}
</Base>
