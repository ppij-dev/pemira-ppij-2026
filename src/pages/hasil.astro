---
import Base from "../layouts/Base.astro";
import { env } from "cloudflare:workers";
const db=(env as unknown as {DB?:D1Database}).DB;
const config=await db?.prepare("SELECT value FROM system_config WHERE key='site_name'").first<{value:string}>();
const row=await db?.prepare("SELECT status_lock,opens_at,closes_at,closed_early_at FROM elections ORDER BY id LIMIT 1").first<{status_lock:"draft"|"locked"|"published";opens_at:string|null;closes_at:string|null;closed_early_at:string|null}>();
const published=row?.status_lock==="published";
const siteName=config?.value||"PPIJ Pemilu";
---
<Base title={`Hasil · ${siteName}`} siteName={siteName} showHasil={published}>
  <div class="mb-6"><p class="text-sm font-semibold text-primary">PEMILIHAN</p><h1 class="mt-1 text-3xl font-bold tracking-tight">Hasil pemilihan</h1><p class="mt-2 text-muted-foreground">Ringkasan suara dan partisipasi setelah hasil resmi diumumkan.</p></div>
  {!published ? <section class="rounded-xl border border-border bg-card p-5 shadow-sm sm:p-6"><h2 class="text-lg font-semibold">Hasil belum diumumkan</h2><p class="mt-2 text-muted-foreground">Hasil akan diumumkan panitia.</p><a href="/" class="mt-4 inline-flex min-h-11 items-center font-semibold text-primary underline">Kembali ke beranda</a></section> : <div id="results" class="space-y-5"><p class="rounded-xl border border-border bg-card p-5 text-muted-foreground">Memuat hasil resmi…</p></div>}
  {published && <script is:inline>
    const root=document.querySelector('#results');
    const number=n=>new Intl.NumberFormat('id-ID').format(n);
    const percent=n=>new Intl.NumberFormat('id-ID',{maximumFractionDigits:1}).format(n)+'%';
    const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    fetch('/api/results').then(async r=>({r,data:await r.json()})).then(({r,data})=>{
      if(r.status===409){root.innerHTML='<section class="rounded-xl border border-border bg-card p-6"><p>Hasil akan diumumkan panitia.</p><a class="mt-4 inline-block text-primary underline" href="/">Kembali ke beranda</a></section>';return}
      if(!r.ok)throw new Error(data.error||'Gagal memuat hasil.');
      root.innerHTML='<section class="grid gap-3 sm:grid-cols-4">'+[['Hak pilih',data.eligible_count],['Sudah digunakan',data.used_count],['Belum digunakan',data.unused_count],['Partisipasi',data.turnout_percentage,percent(data.turnout_percentage)]].map(([k,v,shown])=>'<div class="rounded-xl border border-border bg-card p-4"><p class="text-sm text-muted-foreground">'+k+'</p><p class="mt-1 text-2xl font-bold">'+(shown??number(v))+'</p></div>').join('')+'</section><section class="rounded-xl border border-border bg-card p-5"><h2 class="text-xl font-bold">Perolehan suara</h2><div class="mt-4 grid gap-3 sm:grid-cols-2">'+data.candidates.map(c=>'<article class="flex items-center gap-3 rounded-xl border border-border p-4"><span class="flex size-10 items-center justify-center rounded-full font-bold text-white" style="background-color:'+esc(c.color||'#334155')+'">'+esc(c.number)+'</span><strong class="flex-1">'+esc(c.nickname)+'</strong><span class="font-bold">'+number(c.votes)+' suara</span></article>').join('')+'</div></section><section class="overflow-x-auto rounded-xl border border-border bg-card p-5"><h2 class="text-xl font-bold">Hasil per korda</h2><table class="mt-4 w-full text-left text-sm"><thead><tr class="border-b"><th class="p-2">Korda</th><th class="p-2">Hak pilih</th><th class="p-2">Partisipasi</th><th class="p-2">Suara kandidat</th></tr></thead><tbody>'+data.korda.map(k=>'<tr class="border-b"><th class="p-2">'+esc(k.name)+'</th><td class="p-2">'+number(k.eligible_count)+'</td><td class="p-2">'+(k.turnout_percentage===null?'—':percent(k.turnout_percentage))+'</td><td class="p-2">'+(k.suppressed?'Data terlalu sedikit':k.candidates.map(c=>esc(c.nickname)+': '+number(c.votes)).join(' · '))+'</td></tr>').join('')+'</tbody></table></section>';
    }).catch(()=>{root.innerHTML='<p role="alert" class="rounded-xl bg-red-50 p-4 text-red-800">Hasil belum dapat dimuat. Muat ulang halaman.</p>'});
  </script>}
</Base>
