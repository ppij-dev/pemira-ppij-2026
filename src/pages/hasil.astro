---
import { env } from "cloudflare:workers";
import { IconChartBar } from "@tabler/icons-astro";
import Base from "../layouts/Base.astro";
import Button from "../components/ui/Button.astro";
import Callout from "../components/ui/Callout.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import PanelCard from "../components/ui/PanelCard.astro";
const db=(env as unknown as {DB?:D1Database}).DB;
const config=await db?.prepare("SELECT value FROM system_config WHERE key='site_name'").first<{value:string}>();
const row=await db?.prepare("SELECT status_lock,opens_at,closes_at,closed_early_at FROM elections ORDER BY id LIMIT 1").first<{status_lock:"draft"|"locked"|"published";opens_at:string|null;closes_at:string|null;closed_early_at:string|null}>();
const published=row?.status_lock==="published";
const siteName=config?.value||"PPIJ Pemilu";
---
<Base title={`Hasil · ${siteName}`} siteName={siteName} showHasil={published}>
  <PageHeader eyebrow="Pemilihan" title="Hasil pemilihan" description="Ringkasan suara dan partisipasi setelah hasil resmi diumumkan panitia." />

  {!published
    ? <div class="mt-5"><PanelCard title="Hasil belum diumumkan" description="Panitia menerbitkan hasil setelah pemungutan suara ditutup dan diperiksa." icon={IconChartBar}>
      <Callout tone="neutral" title="Masih menunggu pengumuman">Halaman ini akan menampilkan perolehan suara dan partisipasi begitu hasil resmi diterbitkan.</Callout>
      <Button href="/" variant="secondary" class="mt-4">Kembali ke beranda</Button>
    </PanelCard></div>
    : <div id="results" class="mt-5"><PanelCard><p class="text-sm text-brand-muted" role="status">Memuat hasil resmi…</p></PanelCard></div>}
  {published && <script is:inline>
    const root=document.querySelector('#results');
    const number=n=>new Intl.NumberFormat('id-ID').format(n);
    const percent=n=>new Intl.NumberFormat('id-ID',{maximumFractionDigits:1}).format(n)+'%';
    const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const card='rounded-xl border border-brand-border bg-card';
    // Kartu jumlah (Hak pilih, Sudah digunakan) tidak ditampilkan saat Diumumkan (owner 2026-11-26).
    const stat=(label,value)=>'<article class="grid min-w-0 gap-1.5 '+card+' p-4 sm:p-5"><span class="text-sm font-medium text-brand-muted">'+label+'</span><span class="text-3xl font-bold tracking-tight text-brand-ink tabular-nums max-[600px]:text-[26px]">'+value+'</span></article>';
    // Mode kandidat tunggal (revise-public-results-view, owner 2026-11-26): tanpa
    // pilihan ketiga dan tanpa ambang minimum. Dua penyebut: Partisipasi = suara masuk /
    // Hak pilih; Setuju dan Tidak Setuju = bagian dari suara masuk (jumlahnya 100%).
    // Warna hanya lewat token (--status-green, --primary, --foreground, --muted).
    const round1=n=>Math.round(n*10)/10;
    const pct=n=>new Intl.NumberFormat('id-ID',{maximumFractionDigits:1}).format(round1(n))+'%';
    const voteBar=(sp,tp,tidak,height)=>'<div class="flex '+height+' w-full overflow-hidden rounded-full bg-[var(--muted)]" aria-hidden="true">'+(sp>0?'<span class="block h-full bg-[var(--status-green)]" style="width:'+sp+'%"></span>':'')+(tidak>0?'<span class="block h-full shrink-0 bg-[var(--primary)]" style="width:'+tp+'%;min-width:4px"></span>':'')+'</div>';
    const legend='<div class="flex shrink-0 flex-wrap items-center gap-x-4 gap-y-1 text-xs text-[var(--muted-foreground)]"><span class="inline-flex items-center gap-1.5"><span class="size-2.5 rounded-sm bg-[var(--status-green)]" aria-hidden="true"></span>Setuju</span><span class="inline-flex items-center gap-1.5"><span class="size-2.5 rounded-sm bg-[var(--primary)]" aria-hidden="true"></span>Tidak Setuju</span></div>';
    fetch('/api/results').then(async r=>({r,data:await r.json()})).then(({r,data})=>{
      if(r.status===409){root.innerHTML='<section class="'+card+' p-5"><p class="text-sm text-brand-muted">Hasil akan diumumkan panitia.</p><a class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-brand-red underline underline-offset-4" href="/">Kembali ke beranda</a></section>';return}
      if(!r.ok)throw new Error(data.error||'Gagal memuat hasil.');
      const single=Boolean(data.single_candidate_mode);
      // API publik hanya mengirim persentase (owner 2026-11-26).
      const overall={used:data.has_votes,sp:data.setuju_percentage??0,tp:data.tidak_setuju_percentage??0};
      // Pemangku kepentingan hanya ingin persentase (owner 2026-11-26): tanpa jumlah suara.
      const choiceBlock=(label,share,color)=>'<div class="min-w-0 rounded-lg border border-[var(--border)] p-3"><p class="m-0 text-sm text-[var(--muted-foreground)]">'+label+'</p><p class="m-0 mt-1 text-3xl font-bold tracking-tight tabular-nums '+color+'">'+pct(share)+'</p></div>';
      const tally= single
        ? '<section class="'+card+' min-w-0 p-5"><div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2"><h2 class="text-lg font-bold tracking-tight text-[var(--foreground)]">Perolehan suara</h2>'+legend+'</div><p class="mt-1 text-xs leading-5 text-[var(--muted-foreground)]">Persentase dihitung dari suara masuk (Setuju + Tidak Setuju).</p>'+(overall.used?'<div class="mt-4 grid grid-cols-2 gap-3">'+choiceBlock('Setuju',overall.sp,'text-[var(--status-green)]')+choiceBlock('Tidak Setuju',overall.tp,overall.tp>0?'text-[var(--primary)]':'text-[var(--muted-foreground)]')+'</div><div class="mt-4">'+voteBar(overall.sp,overall.tp,overall.tp,'h-3')+'</div>':'<p class="mt-4 text-sm text-[var(--muted-foreground)]">Belum ada suara masuk.</p>')+'</section>'
        : '<section class="'+card+' min-w-0 p-5"><h2 class="text-lg font-bold tracking-tight text-brand-ink">Perolehan suara</h2><div class="mt-3 grid gap-2">'+data.candidates.map(c=>'<article class="flex items-center gap-3 rounded-lg border border-brand-border p-3"><span class="flex size-9 shrink-0 items-center justify-center rounded-full text-sm font-bold text-white" style="background-color:'+esc(c.color||'#334155')+'">'+esc(c.number)+'</span><strong class="min-w-0 flex-1 break-words text-sm text-brand-ink">'+esc(c.nickname)+'</strong><span class="shrink-0 text-sm font-bold text-brand-ink tabular-nums">'+number(c.votes)+' suara</span></article>').join('')+'</div></section>';
      const th='py-2 font-semibold';
      const kordaHead= single
        ? '<th class="'+th+' w-full">Perbandingan Suara</th>'
        : '<th class="'+th+' pr-3">Hak pilih</th><th class="'+th+' pr-3">Partisipasi</th><th class="'+th+'">Suara kandidat</th>';
      const kordaCells=(k)=>{
        if(!single) return '<td class="py-2 pr-3 tabular-nums">'+number(k.eligible_count)+'</td><td class="py-2 pr-3 tabular-nums">'+(k.turnout_percentage===null?'—':percent(k.turnout_percentage))+'</td><td class="py-2">'+(k.candidates||[]).map(c=>esc(c.nickname)+': '+number(c.votes??0)).join(' · ')+'</td>';
        const used=k.has_votes, sp=k.setuju_percentage??0, tp=k.tidak_setuju_percentage??0, tidak=tp;
        if(!used) return '<td class="py-3 align-middle"><div class="flex h-8 items-center rounded-lg bg-[var(--muted)] px-3 text-xs text-[var(--muted-foreground)]">Belum ada suara masuk</div></td>';
        const tip='<div role="tooltip" class="pointer-events-none absolute right-0 bottom-full z-10 mb-2 hidden w-64 rounded-lg border border-[var(--border)] bg-[var(--card)] p-3 text-xs text-[var(--foreground)] shadow-md group-hover:block group-focus:block"><p class="m-0 font-semibold">'+esc(k.name)+'</p><div class="mt-2 grid gap-1 tabular-nums"><div class="flex justify-between gap-3"><span>Setuju</span><span>'+pct(sp)+'</span></div><div class="flex justify-between gap-3"><span>Tidak Setuju</span><span>'+pct(tp)+'</span></div></div></div>';
        const label=esc(k.name)+': Setuju '+pct(sp)+', Tidak Setuju '+pct(tp);
        return '<td class="py-3 align-middle"><div class="group relative grid gap-1.5 rounded-sm outline-none focus-visible:outline-2 focus-visible:outline-[var(--ring)]" tabindex="0" aria-label="'+label+'"><div class="flex items-baseline justify-between gap-3 text-xs tabular-nums whitespace-nowrap"><span><strong class="text-sm font-semibold text-[var(--status-green)]">'+pct(sp)+'</strong></span><span><strong class="text-sm font-semibold '+(tidak>0?'text-[var(--primary)]':'text-[var(--muted-foreground)]')+'">'+pct(tp)+'</strong></span></div>'+voteBar(sp,tp,tidak,'h-3.5')+tip+'</div></td>';
      };
      const kordaIntro= single
        ? '<div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2"><h2 class="text-lg font-bold tracking-tight text-[var(--foreground)]">Hasil per korda</h2>'+legend+'</div><p class="mt-1 text-xs leading-5 text-[var(--muted-foreground)]">Persentase suara dihitung dari hak pilih yang digunakan (Setuju + Tidak Setuju).</p>'
        : '<h2 class="text-lg font-bold tracking-tight text-brand-ink">Hasil per korda</h2>';
      root.innerHTML='<div class="grid min-w-0 gap-4">'+tally+'<section class="'+card+' min-w-0 p-5">'+kordaIntro+'<div class="mt-3 min-w-0 overflow-x-auto"><table class="w-full '+(single?'':'min-w-[34rem]')+' text-left text-sm"><thead><tr class="border-b border-[var(--border)] text-xs text-[var(--muted-foreground)]"><th class="py-2 pr-3 font-semibold">Korda</th>'+kordaHead+'</tr></thead><tbody>'+data.korda.map(k=>'<tr class="border-b border-[var(--border)] text-[var(--foreground)] hover:bg-[var(--muted)]/40"><th class="py-3 pr-3 align-middle font-semibold whitespace-nowrap">'+esc(k.name)+'</th>'+kordaCells(k)+'</tr>').join('')+'</tbody></table></div></section></div>';
    }).catch(()=>{root.innerHTML='<div class="rounded-xl border border-[#f0ccd4] bg-[#fdf2f4] p-4 text-sm font-medium text-[#8f1730]" role="alert">Hasil belum dapat dimuat. Periksa koneksi lalu muat ulang halaman.</div>'});
  </script>}
</Base>
