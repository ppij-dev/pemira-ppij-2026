---
import { env } from "cloudflare:workers";
import { IconArrowRight, IconListCheck, IconRosetteDiscountCheck, IconSpeakerphone, IconUsers } from "@tabler/icons-astro";
import Base from "../layouts/Base.astro";
import CandidateCard from "../components/CandidateCard.astro";
import { unitPathLabel } from "../lib/formatKomsat";
import { loadUnitNames } from "../server/lib/units";
import Badge from "../components/ui/Badge.astro";
import Button from "../components/ui/Button.astro";
import Callout from "../components/ui/Callout.astro";
import FactList from "../components/ui/FactList.astro";
import ListRow from "../components/ui/ListRow.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import PanelCard from "../components/ui/PanelCard.astro";
import { SESSION_COOKIE, openSession } from "../server/auth/session";
import type { SessionData } from "../server/auth/session";
import type { Bindings } from "../server/app";
import { stage as getStage } from "../server/lib/stage";
import { isSingleCandidateMode } from "../server/election/mode";
import { getPublicResults } from "../server/results/queries";
import { getSiteLogo } from "../server/lib/logo";
const bindings = env as unknown as Bindings;
const db = bindings.DB;
const rawCookie = Astro.request.headers.get("cookie") ?? Astro.cookies.get(SESSION_COOKIE)?.value;
const masterKey = bindings.APP_MASTER_KEY;
const session: SessionData | null = rawCookie && masterKey ? await openSession(rawCookie, masterKey) : null;
const config = await db?.prepare("SELECT key,value FROM system_config WHERE key IN ('site_name','site_logo_path')").all<{key:string;value:string}>();
const values = Object.fromEntries((config?.results ?? []).map((row) => [row.key,row.value]));
const siteName = values.site_name || "PPIJ Pemilu";
const logo = getSiteLogo(values.site_logo_path);
const election = await db?.prepare("SELECT title,description,opens_at,closes_at,closed_early_at,status_lock,preview_mode FROM elections ORDER BY id LIMIT 1").first<{title:string|null;description:string|null;opens_at:string|null;closes_at:string|null;closed_early_at:string|null;status_lock:"draft"|"locked"|"published";preview_mode:number}>();
const currentStage = election?.status_lock && election.opens_at && election.closes_at ? getStage(election as {status_lock:"draft"|"locked"|"published";opens_at:string;closes_at:string;closed_early_at:string|null}, Date.now()) : "draft";
const candidates = (await db?.prepare("SELECT number,name,nickname,komsat_path,short_intro,color,photo_key FROM candidates ORDER BY number").all<{number:number;name:string;nickname:string;komsat_path:string;short_intro:string|null;color:string|null;photo_key:string|null}>())?.results ?? [];
// Nama komsat/korda dari tabel units (sinkronisasi portal), bukan pecahan jalur.
const unitNames = db ? await loadUnitNames(db) : {};
// Mode kandidat tunggal: kartu kandidat tanpa nomor urut dan hasil memakai tiga angka.
let singleCandidateMode = false;
if (db) try { singleCandidateMode = await isSingleCandidateMode(db); } catch { singleCandidateMode = false; }
const showHasil = currentStage === "published";
const publicResults: any = showHasil && singleCandidateMode && db ? await getPublicResults(db, new Date()).catch(() => null) : null;
const singleOutcomeLabels: Record<string, string> = {
  terpilih: "Terpilih",
  tidak_terpilih: "Tidak terpilih",
  seri: "Seri, keputusan diserahkan kepada panitia",
  menunggu_penutupan: "Menunggu penutupan pemungutan suara",
};
const singleOutcome = publicResults ? singleOutcomeLabels[publicResults.outcome as string] ?? "Tidak terpilih" : null;
const singleOutcomeTone = publicResults?.outcome === "terpilih" ? "success" : publicResults?.outcome === "seri" ? "warning" : "neutral";
const eligibleCount: number = publicResults?.eligible_count ?? 0;
const shareText = (count: number) => eligibleCount > 0 ? new Intl.NumberFormat("id-ID", { maximumFractionDigits: 1 }).format(Math.round((count / eligibleCount) * 1000) / 10) + "%" : "—";
// Tidak memilih = Hak pilih beku dikurangi partisipasi; tidak pernah dibaca per orang.
const notVotingCount = Math.max(0, eligibleCount - (publicResults?.participation_count ?? 0));
const singleResultFacts = publicResults ? [
  { label: "Setuju", value: `${publicResults.setuju_count ?? 0} suara · ${shareText(publicResults.setuju_count ?? 0)}` },
  { label: "Tidak Setuju", value: `${publicResults.tidak_setuju_count ?? 0} suara · ${shareText(publicResults.tidak_setuju_count ?? 0)}` },
  { label: "Tidak memilih (dihitung Tidak Setuju)", value: `${notVotingCount} suara · ${shareText(notVotingCount)}` },
] : [];
const boardReady = currentStage === "closed" || currentStage === "published";
let voted = false;
if (session && currentStage === "open") {
  try { const response = await fetch(new URL("/api/votes/me", Astro.url), { headers: { cookie: Astro.request.headers.get("cookie") ?? "" } }); voted = response.ok && Boolean((await response.json() as {voted_at:string|null}).voted_at); } catch { voted = false; }
}
let extensionNotice = false;
if (currentStage === "open" && election?.closed_early_at == null && db) {
  try { extensionNotice = Boolean(await db.prepare("SELECT seq FROM audit_log WHERE action = ? ORDER BY seq DESC LIMIT 1").bind("Waktu penutupan diperpanjang").first()); } catch { extensionNotice = false; }
}
const stageLabel = ({draft:"Draf",scheduled:"Terjadwal",open:"Dibuka",closed:"Ditutup",published:"Diumumkan"} as const)[currentStage];
const formatJst = (value:string) => new Intl.DateTimeFormat("id-ID", { timeZone:"Asia/Tokyo", dateStyle:"medium", timeStyle:"short" }).format(new Date(value)) + " JST";
const scheduleFacts = [
  ...(election?.opens_at ? [{ label: "Dibuka", value: formatJst(election.opens_at) }] : []),
  ...(election?.closes_at ? [{ label: "Ditutup", value: formatJst(election.closes_at) }] : []),
  { label: "Tahap", value: stageLabel },
];
---

<Base title={`${siteName} · Pemilihan`} siteName={siteName} siteLogoPath={logo.src} showHasil={showHasil}>
  <section aria-labelledby="election-title" class="overflow-hidden rounded-xl border border-brand-border bg-card">
    <div class="bg-gradient-to-br from-brand-900 via-brand-700 to-brand-600 p-5 text-white sm:p-7">
      <div class="flex items-start gap-3">
        <img src={logo.src} alt="" class="size-11 shrink-0 rounded-lg bg-white p-1 object-contain" />
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <p class="text-[11px] font-bold tracking-[0.14em] text-white/80 uppercase">Pemilihan</p>
            <span class="inline-flex shrink-0 rounded-full border border-white/30 bg-white/10 px-3 py-1 text-xs font-semibold whitespace-nowrap">{stageLabel}</span>
          </div>
          <h1 id="election-title" class="mt-1 break-words text-2xl leading-tight font-bold tracking-tight sm:text-3xl">{election?.title || "Pemilihan"}</h1>
        </div>
      </div>
      {election?.description && <p class="mt-3 max-w-xl text-sm leading-6 text-white/90">{election.description}</p>}
    </div>

    <div class="grid gap-4 p-5 sm:p-6">
      {currentStage === "draft" && <Callout tone="neutral" title="Persiapan sedang berlangsung">Informasi kandidat dan jadwal akan diperbarui panitia. Anda belum dapat memberikan suara.</Callout>}

      {currentStage === "scheduled" && <>
        <div>
          <p class="text-sm font-medium text-brand-muted">Pemungutan suara dibuka dalam</p>
          <p class="mt-1 break-words font-mono text-2xl font-bold text-brand-ink tabular-nums sm:text-3xl" data-countdown data-target={election?.opens_at}>—</p>
        </div>
        <Callout tone="info" title="Belum dibuka">Tombol Pilih Sekarang aktif saat pemungutan suara dibuka.</Callout>
      </>}

      {currentStage === "open" && <>
        <div>
          <p class="text-sm font-medium text-brand-muted">Pemungutan suara ditutup dalam</p>
          <p class="mt-1 break-words font-mono text-2xl font-bold text-brand-ink tabular-nums sm:text-3xl" data-countdown data-target={election?.closes_at}>—</p>
        </div>
        {extensionNotice && election?.closes_at && <Callout tone="warning" title="Jadwal diperpanjang">Pemungutan suara diperpanjang hingga {formatJst(election.closes_at)}.</Callout>}
        <Button href={voted ? "/surat-suara" : "/pilih-suara"} class="w-full sm:w-auto sm:justify-self-start">
          {voted ? "Lihat Bukti Suara" : "Pilih Sekarang"}<IconArrowRight size={19} stroke={1.8} aria-hidden="true" />
        </Button>
        <p class="text-xs text-brand-muted">Satu suara per anggota. Pilihan Anda rahasia dan tidak ditampilkan di beranda.</p>
      </>}

      {currentStage === "closed" && <Callout tone="neutral" title="Pemungutan suara ditutup">Hasil akan diumumkan panitia. Anda sudah dapat memeriksa papan bukti suara.</Callout>}

      {currentStage === "published" && <>
        <Callout tone="success" title="Hasil sudah diumumkan">Hasil resmi pemilihan dapat Anda lihat beserta ringkasan partisipasi.</Callout>
        <Button href="/hasil" class="w-full sm:w-auto sm:justify-self-start">Lihat Hasil<IconArrowRight size={19} stroke={1.8} aria-hidden="true" /></Button>
      </>}
    </div>
  </section>

  {election?.preview_mode === 1 && <div class="mt-4"><Callout tone="warning" title="Mode uji coba aktif">Semua pilihan hanya untuk tes dan akan dihapus saat pemilihan dikunci.</Callout></div>}

  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    <PanelCard title="Jadwal pemungutan" description="Waktu dalam zona Jepang (JST)." icon={IconListCheck} density="compact" class="self-start">
      <FactList items={scheduleFacts} variant="inline" />
    </PanelCard>
    <PanelCard title="Cara memberi suara" description="Tiga langkah, tanpa perlu aplikasi lain." icon={IconSpeakerphone} density="compact">
      <div class="grid">
        <ListRow title="Masuk dengan PPIJ One Login" subtitle="Gunakan akun portal keanggotaan Anda." />
        <ListRow title={singleCandidateMode ? "Tentukan sikap Anda" : "Pilih satu kandidat"} subtitle={singleCandidateMode ? "Pilih Setuju atau Tidak Setuju, lalu periksa nama sebelum mengirim." : "Periksa nomor dan nama sebelum mengirim."} />
        <ListRow title="Simpan kode bukti" subtitle="Kode hanya muncul sekali setelah suara terkirim." />
      </div>
    </PanelCard>
  </div>

  {currentStage === "closed" && <div class="mt-4"><PanelCard title="Papan bukti" description="Periksa daftar bukti suara setelah pemungutan ditutup." icon={IconRosetteDiscountCheck} density="compact" padding="panel">
    <Button href="/papan-bukti" variant="secondary" size="sm">Buka papan bukti<IconArrowRight size={17} stroke={1.8} aria-hidden="true" /></Button>
  </PanelCard></div>}

  <section class="mt-8" aria-labelledby="candidates-heading">
    <PageHeader title="Kandidat" description={candidates.length ? (singleCandidateMode ? "Kandidat pada pemilihan ini." : "Urut sesuai nomor pada surat suara.") : undefined}>
      {candidates.length > 0 && <Button href="/kandidat" variant="ghost" size="sm">Lihat semua kandidat<IconArrowRight size={17} stroke={1.8} aria-hidden="true" /></Button>}
    </PageHeader>
    {candidates.length
      ? <div class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{candidates.map((candidate) => <CandidateCard candidate={candidate} unitName={unitPathLabel(candidate.komsat_path, unitNames)} singleCandidateMode={singleCandidateMode} />)}</div>
      : <div class="mt-4"><PanelCard density="compact" class="border-dashed"><div class="flex items-center gap-2.5 text-brand-muted"><IconUsers size={20} stroke={1.8} aria-hidden="true" /><p class="text-sm">Informasi kandidat belum tersedia.</p></div></PanelCard></div>}
  </section>

  {showHasil && <section id="hasil" class="mt-8" aria-labelledby="hasil-heading">
    <PanelCard title="Hasil pemilihan" description="Hasil resmi telah diumumkan panitia." icon={IconRosetteDiscountCheck}>
      {singleOutcome && <Callout tone={singleOutcomeTone} title={singleOutcome} class="mb-4">
        <p>{publicResults?.outcome === "seri" ? "Perolehan Setuju dan Tidak Setuju sama. Keputusan diserahkan kepada panitia." : "Setuju menang bila lebih dari separuh Hak pilih. Pemilih yang tidak memilih dihitung Tidak Setuju."}</p>
        <FactList items={singleResultFacts} variant="inline" class="mt-2" />
      </Callout>}
      <div class="flex flex-wrap items-center gap-3">
        <Button href="/hasil" size="sm">Lihat hasil dan statistik<IconArrowRight size={17} stroke={1.8} aria-hidden="true" /></Button>
        {boardReady && <a href="/papan-bukti" class="inline-flex min-h-11 items-center text-sm font-semibold text-brand-red underline underline-offset-4 hover:text-primary-hover focus-visible:outline-2 focus-visible:outline-ring">Papan bukti</a>}
      </div>
    </PanelCard>
  </section>}

  <p class="mt-8 flex items-center justify-center gap-2 text-xs text-brand-muted"><Badge tone="outline" size="sm">Rahasia</Badge><span>Partisipasi dan surat suara tercatat terpisah agar pilihan Anda tidak dapat ditelusuri.</span></p>

  <script is:inline>document.querySelectorAll('[data-countdown]').forEach((el)=>{const tick=()=>{const seconds=Math.max(0,Math.floor((Date.parse(el.dataset.target)-Date.now())/1000));const d=Math.floor(seconds/86400),h=Math.floor(seconds%86400/3600),m=Math.floor(seconds%3600/60),s=seconds%60;const clock=[h,m,s].map((v)=>String(v).padStart(2,'0')).join(':');el.textContent=d>0?`${d} hari ${clock}`:clock};tick();setInterval(tick,1000)});</script>
</Base>
