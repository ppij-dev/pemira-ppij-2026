---
import { IconArrowRight } from "@tabler/icons-astro";
import Base from "../layouts/Base.astro";
import CandidateCard from "../components/CandidateCard.astro";
import Card from "../components/ui/Card.astro";
import Badge from "../components/ui/Badge.astro";
import Alert from "../components/ui/Alert.astro";
import { SESSION_COOKIE, openSession } from "../server/auth/session";
import type { SessionData } from "../server/auth/session";
import { env } from "cloudflare:workers";
import type { Bindings } from "../server/app";
import { stage as getStage } from "../server/lib/stage";
import { getSiteLogo } from "../server/lib/logo";
const bindings = env as unknown as Bindings;
const db = bindings.DB;
const rawCookie = Astro.cookies.get(SESSION_COOKIE)?.value;
const masterKey = bindings.APP_MASTER_KEY;
const session: SessionData | null = rawCookie && masterKey ? await openSession(rawCookie, masterKey) : null;
const config = await db?.prepare("SELECT key,value FROM system_config WHERE key IN ('site_name','site_logo_path')").all<{key:string;value:string}>();
const values = Object.fromEntries((config?.results ?? []).map((row) => [row.key,row.value]));
const siteName = values.site_name || "PPIJ Pemilu";
const logo = getSiteLogo(values.site_logo_path);
const election = await db?.prepare("SELECT title,description,opens_at,closes_at,closed_early_at,status_lock,preview_mode FROM elections ORDER BY id LIMIT 1").first<{title:string|null;description:string|null;opens_at:string|null;closes_at:string|null;closed_early_at:string|null;status_lock:"draft"|"locked"|"published";preview_mode:number}>();
const currentStage = election?.status_lock && election.opens_at && election.closes_at ? getStage(election as {status_lock:"draft"|"locked"|"published";opens_at:string;closes_at:string;closed_early_at:string|null}, Date.now()) : "draft";
const candidates = (await db?.prepare("SELECT number,name,nickname,komsat_path,short_intro,color,photo_key FROM candidates ORDER BY number").all<{number:number;name:string;nickname:string;komsat_path:string;short_intro:string|null;color:string|null;photo_key:string|null}>())?.results ?? [];
const showHasil = currentStage === "published";
const boardReady = currentStage === "closed" || currentStage === "published";
let voted = false;
if (session && currentStage === "open") {
  try { const response = await fetch(new URL("/api/votes/me", Astro.url), { headers: { cookie: Astro.request.headers.get("cookie") ?? "" } }); voted = response.ok && Boolean((await response.json() as {voted_at:string|null}).voted_at); } catch { voted = false; }
}
let extensionNotice = false;
if (currentStage === "open" && election?.closed_early_at == null && db) {
  try { extensionNotice = Boolean(await db.prepare("SELECT seq FROM audit_log WHERE action = ? ORDER BY seq DESC LIMIT 1").bind("Waktu penutupan diperpanjang").first()); } catch { extensionNotice = false; }
}
const formatJst = (value:string) => new Intl.DateTimeFormat("id-ID", { timeZone:"Asia/Tokyo", dateStyle:"medium", timeStyle:"short" }).format(new Date(value)) + " JST";
---
<Base title={`${siteName} · Pemilihan`} siteName={siteName} siteLogoPath={logo.src} showHasil={showHasil}>
  <Card><div class="p-4 sm:p-6">
    <div class="flex flex-wrap items-center gap-3">
      <img src={logo.src} alt="" class="size-11 shrink-0 object-contain" />
      <h1 class="min-w-0 flex-1 text-xl font-semibold leading-tight tracking-tight">{election?.title || "Pemilihan"}</h1>
      <Badge tone="brand">{({draft:"Draf",scheduled:"Terjadwal",open:"Dibuka",closed:"Ditutup",published:"Diumumkan"} as const)[currentStage]}</Badge>
    </div>
    <div class="mt-5 space-y-4 border-t border-border pt-4">
      {currentStage === "draft" && <p class="rounded-md bg-muted p-4 font-medium">Persiapan sedang berlangsung. Informasi kandidat dan jadwal akan diperbarui panitia.</p>}
      {currentStage === "scheduled" && <><div><p class="text-sm font-semibold text-muted-foreground">Pemungutan suara dibuka dalam</p><p class="mt-1 break-words font-mono text-2xl font-bold text-brand-800 sm:text-3xl" data-countdown data-target={election?.opens_at}>—</p></div><p class="text-sm text-muted-foreground">Pilih Sekarang tersedia saat pemungutan suara dibuka.</p></>}
      {currentStage === "open" && <><div><p class="text-sm font-semibold text-muted-foreground">Pemungutan suara ditutup dalam</p><p class="mt-1 break-words font-mono text-2xl font-bold text-brand-800 sm:text-3xl" data-countdown data-target={election?.closes_at}>—</p></div>{extensionNotice && election?.closes_at && <p class="text-sm font-semibold text-amber-800">Diperpanjang hingga {formatJst(election.closes_at)}</p>}<a class="inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-md bg-primary px-5 py-3 font-semibold text-primary-foreground hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-ring sm:w-auto" href={voted?"/surat-suara":"/pilih-suara"}>{voted?"Lihat Bukti Suara":"Pilih Sekarang"}<IconArrowRight size={19} aria-hidden="true" /></a></>}
      {currentStage === "closed" && <p class="rounded-md bg-muted p-4 font-medium">Pemungutan suara sudah ditutup. Hasil akan diumumkan panitia.</p>}
      {currentStage === "published" && <a href="/hasil" class="inline-flex min-h-11 items-center gap-2 rounded-md bg-primary px-5 py-3 font-semibold text-primary-foreground hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-ring">Lihat Hasil<IconArrowRight size={19} aria-hidden="true" /></a>}
    </div>
  </div></Card>
  {election?.preview_mode === 1 && <div class="mt-5"><Alert tone="warning" title="Mode uji coba aktif">Semua pilihan hanya untuk tes.</Alert></div>}
  {boardReady && <a href="/papan-bukti" class="mt-5 flex min-h-20 items-center justify-between gap-4 rounded-xl border border-border bg-card p-5 transition hover:border-brand-400 focus-visible:outline-2 focus-visible:outline-ring"><span><strong class="block font-semibold">Papan bukti</strong><span class="mt-1 block text-sm text-muted-foreground">Periksa daftar bukti suara setelah pemungutan ditutup.</span></span><IconArrowRight size={20} class="shrink-0 text-primary" aria-hidden="true" /></a>}
  <section class="mt-8" aria-labelledby="candidates-heading">
    <h2 id="candidates-heading" class="mb-4 text-xl font-semibold">Kandidat</h2>
    {candidates.length
      ? <div class="grid gap-5 sm:grid-cols-2">{candidates.map((candidate) => <CandidateCard candidate={candidate} />)}</div>
      : <p class="rounded-xl border border-border bg-card p-6 text-muted-foreground">Informasi kandidat belum tersedia.</p>}
  </section>
  {showHasil && <section id="hasil" class="mt-8 rounded-xl border border-border bg-card p-4 shadow-sm sm:p-6"><h2 class="text-xl font-semibold">Hasil pemilihan</h2><p class="mt-2 text-muted-foreground">Hasil resmi telah diumumkan.</p><a href="/hasil" class="mt-4 inline-flex min-h-11 items-center font-semibold text-primary underline">Lihat hasil dan statistik</a></section>}
  <script is:inline>document.querySelectorAll('[data-countdown]').forEach((el)=>{const tick=()=>{const seconds=Math.max(0,Math.floor((Date.parse(el.dataset.target)-Date.now())/1000));const d=Math.floor(seconds/86400),h=Math.floor(seconds%86400/3600),m=Math.floor(seconds%3600/60),s=seconds%60;const clock=[h,m,s].map((v)=>String(v).padStart(2,'0')).join(':');el.textContent=d>0?`${d} hari ${clock}`:clock};tick();setInterval(tick,1000)});</script>
</Base>
