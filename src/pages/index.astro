---
import { IconArrowRight, IconLogout } from "@tabler/icons-astro";
import Base from "../layouts/Base.astro";
import { SESSION_COOKIE, openSession } from "../server/auth/session";
import type { SessionData } from "../server/auth/session";
import { env } from "cloudflare:workers";
import type { Bindings } from "../server/app";
import { affiliationInScope } from "../server/admin/routes";
import { stage as getStage } from "../server/lib/stage";
import { getSiteLogo } from "../server/lib/logo";
import { formatKomsatPath } from "../lib/formatKomsat";
const bindings = env as unknown as Bindings;
const db = bindings.DB;
const rawCookie = Astro.cookies.get(SESSION_COOKIE)?.value;
const masterKey = bindings.APP_MASTER_KEY;
const session: SessionData | null = rawCookie && masterKey ? await openSession(rawCookie, masterKey) : null;
let isAdmin = false;
if (session && db) {
  const admin = await db.prepare("SELECT member_id FROM admin_voting WHERE member_id = ?").bind(session.member_id).first();
  const scope = await db.prepare("SELECT value FROM system_config WHERE key='site_scope'").first<{value:string}>();
  isAdmin = Boolean(admin && scope && affiliationInScope(session.affiliation, scope.value));
}
const config = await db?.prepare("SELECT key,value FROM system_config WHERE key IN ('site_name','site_logo_path')").all<{key:string;value:string}>();
const values = Object.fromEntries((config?.results ?? []).map((row) => [row.key,row.value]));
const siteName = values.site_name || "PPIJ Pemilu";
const logo = getSiteLogo(values.site_logo_path);
const election = await db?.prepare("SELECT title,description,opens_at,closes_at,closed_early_at,status_lock FROM elections ORDER BY id LIMIT 1").first<{title:string|null;description:string|null;opens_at:string|null;closes_at:string|null;closed_early_at:string|null;status_lock:"draft"|"locked"|"published"}>();
const currentStage = election?.status_lock && election.opens_at && election.closes_at ? getStage(election as {status_lock:"draft"|"locked"|"published";opens_at:string;closes_at:string;closed_early_at:string|null}, Date.now()) : "draft";
const candidates = (await db?.prepare("SELECT number,name,nickname,komsat_path,description,color FROM candidates ORDER BY number").all<{number:number;name:string;nickname:string;komsat_path:string;description:string|null;color:string|null}>())?.results ?? [];
const showHasil = currentStage === "published";
let voted = false;
if (session && currentStage === "open") {
  try { const response = await fetch(new URL("/api/votes/me", Astro.url), { headers: { cookie: Astro.request.headers.get("cookie") ?? "" } }); voted = response.ok && Boolean((await response.json() as {voted_at:string|null}).voted_at); } catch { voted = false; }
}
let extensionNotice = false;
if (currentStage === "open" && election?.closed_early_at == null && db) {
  try { extensionNotice = Boolean(await db.prepare("SELECT seq FROM audit_log WHERE action = ? ORDER BY seq DESC LIMIT 1").bind("Waktu penutupan diperpanjang").first()); } catch { extensionNotice = false; }
}
const formatJst = (value:string) => new Intl.DateTimeFormat("id-ID", { timeZone:"Asia/Tokyo", dateStyle:"medium", timeStyle:"short" }).format(new Date(value)) + " JST";
---
<Base title={`${siteName} · Pemilihan`} siteName={siteName} siteLogoPath={logo.src} showHasil={showHasil}>
  <section class="overflow-hidden rounded-xl border border-border bg-card shadow-sm">
    <div class="bg-gradient-to-br from-brand-900 via-brand-700 to-brand-600 p-6 text-white sm:p-8">
      <div class="flex items-start gap-4"><img src={logo.src} alt="" class="h-14 w-auto max-w-20 shrink-0 rounded-md bg-card p-1 object-contain" /><div class="min-w-0"><p class="text-sm font-semibold text-white/85">{siteName}</p><h1 class="mt-1 text-2xl font-bold tracking-tight sm:text-3xl">{election?.title || "Pemilihan"}</h1></div></div>
      {election?.description && <p class="mt-5 max-w-prose leading-7 text-white/90">{election.description}</p>}
      <span class="mt-5 inline-flex rounded-full border border-white/30 bg-card/10 px-3 py-1 text-sm font-semibold">{({draft:"Draf",scheduled:"Terjadwal",open:"Dibuka",closed:"Ditutup",published:"Diumumkan"} as const)[currentStage]}</span>
    </div>
    <div class="space-y-5 p-4 sm:p-6">
      {currentStage === "draft" && <p class="rounded-md bg-muted p-4 font-medium">Persiapan sedang berlangsung. Informasi kandidat dan jadwal akan diperbarui panitia.</p>}
      {currentStage === "scheduled" && <><div class="rounded-md bg-brand-50 p-5"><p class="font-semibold text-brand-900">Pemungutan suara dibuka dalam</p><p class="mt-2 break-words font-mono text-2xl font-bold text-brand-800 sm:text-3xl" data-countdown data-target={election?.opens_at}>—</p></div><p class="text-sm text-muted-foreground">Pilih Sekarang tersedia saat pemungutan suara dibuka.</p></>}
      {currentStage === "open" && <><div class="rounded-md bg-brand-50 p-5"><p class="font-semibold text-brand-900">Pemungutan suara ditutup dalam</p><p class="mt-2 break-words font-mono text-2xl font-bold text-brand-800 sm:text-3xl" data-countdown data-target={election?.closes_at}>—</p></div>{extensionNotice && election?.closes_at && <p class="text-sm font-semibold text-amber-800">Diperpanjang hingga {formatJst(election.closes_at)}</p>}<a class="inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-md bg-primary px-5 py-3 font-semibold text-primary-foreground hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-ring sm:w-auto" href={voted?"/surat-suara":"/pilih-suara"}>{voted?"Lihat Bukti Suara":"Pilih Sekarang"}<IconArrowRight size={19} aria-hidden="true" /></a></>}
      {currentStage === "closed" && <p class="rounded-md bg-muted p-4 font-medium">Pemungutan suara sudah ditutup. Hasil akan diumumkan panitia.</p>}
      {currentStage === "published" && <a href="/hasil" class="inline-flex min-h-11 items-center gap-2 rounded-md bg-primary px-5 py-3 font-semibold text-primary-foreground hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-ring">Lihat Hasil<IconArrowRight size={19} aria-hidden="true" /></a>}
      {session && <div class="flex flex-wrap items-center gap-3 border-t border-border pt-5"><span class="text-sm text-muted-foreground">Masuk sebagai <strong class="font-semibold text-foreground">{session.name}</strong></span>{isAdmin && <a class="min-h-11 py-2 font-semibold text-primary underline" href="/admin">Mode Admin</a>}<form id="logout-form" action="/api/auth/logout" method="post"><button class="inline-flex min-h-11 items-center gap-2 rounded-md border border-border px-3 font-semibold hover:bg-accent" type="submit"><IconLogout size={18} aria-hidden="true" />Keluar</button></form></div>}
    </div>
  </section>
  <section class="mt-8"><div class="mb-4"><h2 class="text-xl font-semibold">Kandidat</h2><p class="mt-1 text-sm text-muted-foreground">Kenali para kandidat sebelum memberikan suara.</p></div>{candidates.length ? <div class="grid gap-4 sm:grid-cols-2">{candidates.map((candidate)=><a href={`/kandidat/${candidate.number}-${encodeURIComponent(candidate.nickname)}`} class="group overflow-hidden rounded-xl border border-border bg-card shadow-sm transition hover:border-brand-400 hover:shadow-md focus-visible:outline-2 focus-visible:outline-ring"><div class="flex gap-4 p-4 sm:p-5"><img src="/placeholder-candidate.png" alt="" class="h-20 w-15 shrink-0 rounded-md bg-background object-cover" /><div class="min-w-0"><span class="inline-flex size-9 items-center justify-center rounded-full font-bold text-white" style={`background-color:${candidate.color||'#334155'}`}>{candidate.number}</span><h3 class="mt-2 text-lg font-semibold group-hover:text-primary">{candidate.nickname}</h3><p class="text-sm text-muted-foreground">{candidate.name}</p><p class="mt-1 text-xs text-muted-foreground">{`Komsat ${formatKomsatPath(candidate.komsat_path)}`}</p></div></div>{candidate.description && <p class="border-t border-border px-4 py-3 text-sm leading-6 text-muted-foreground sm:px-5">{candidate.description}</p>}</a>)}</div> : <p class="rounded-xl border border-border bg-card p-6 text-muted-foreground">Informasi kandidat belum tersedia.</p>}</section>
  {showHasil && <section id="hasil" class="mt-8 rounded-xl border border-border bg-card p-4 shadow-sm sm:p-6"><h2 class="text-xl font-semibold">Hasil pemilihan</h2><p class="mt-2 text-muted-foreground">Hasil resmi telah diumumkan.</p><a href="/hasil" class="mt-4 inline-flex min-h-11 items-center font-semibold text-primary underline">Lihat hasil dan statistik</a></section>}
  <script is:inline>document.querySelectorAll('[data-countdown]').forEach((el)=>{const tick=()=>{const seconds=Math.max(0,Math.floor((Date.parse(el.dataset.target)-Date.now())/1000));const d=Math.floor(seconds/86400),h=Math.floor(seconds%86400/3600),m=Math.floor(seconds%3600/60),s=seconds%60;const clock=[h,m,s].map((v)=>String(v).padStart(2,'0')).join(':');el.textContent=d>0?`${d} hari ${clock}`:clock};tick();setInterval(tick,1000)});</script>
  <script is:inline>const form=document.querySelector('#logout-form');form?.addEventListener('submit',async event=>{event.preventDefault();await fetch('/api/auth/logout',{method:'POST'});window.location.assign('/')});</script>
</Base>
