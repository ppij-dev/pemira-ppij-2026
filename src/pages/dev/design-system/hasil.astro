---
import DesignPreviewLayout from "../../../layouts/DesignPreviewLayout.astro";
import Alert from "../../../components/ui/Alert.astro";
import Badge from "../../../components/ui/Badge.astro";
import Button from "../../../components/ui/Button.astro";
import Card from "../../../components/ui/Card.astro";
import { IconCircleCheck, IconLock, IconRosetteDiscountCheck } from "@tabler/icons-astro";
const tally = [
  { number: 1, nickname: "Nadia", votes: "421", color: "#99531f" },
  { number: 2, nickname: "Rizky", votes: "321", color: "#315f88" },
];
---
<DesignPreviewLayout title="Hasil dan bukti" description="Contoh Bukti Suara, Papan Bukti, Hasil, penyembunyian angka kecil, dan keadaan sebelum publikasi. Angka serta hash di bawah adalah ilustrasi.">
  <div class="space-y-10">
    <section aria-labelledby="receipt-title"><div class="mb-4"><h2 id="receipt-title" class="text-xl font-bold">Bukti Suara</h2><p class="text-sm text-muted-foreground">Pemilih memasukkan kode di perangkatnya; pilihan kandidat tidak ditampilkan kembali.</p></div><div class="grid gap-4 lg:grid-cols-2"><Card><div class="p-5 sm:p-6"><div class="flex items-center gap-3"><IconRosetteDiscountCheck size={28} class="text-primary" aria-hidden="true" /><h3 class="text-lg font-semibold">Periksa kode bukti</h3></div><p class="mt-3 text-sm text-muted-foreground">Kode dari layar sukses dapat diperiksa setelah memilih. Jangan masukkan kode asli pada pratinjau ini.</p><label for="receipt-sample" class="mt-5 block text-sm font-semibold">Kode bukti</label><input id="receipt-sample" autocomplete="off" placeholder="26 karakter Crockford Base32" class="mt-1 min-h-12 w-full rounded-md border border-input bg-card px-3 font-mono" /><div class="mt-4"><Button type="button">Periksa</Button></div></div></Card><div class="space-y-4"><Alert tone="success" title="Surat suara tercatat">Contoh jawaban saat hash kode ditemukan. Tidak menampilkan kandidat yang dipilih.</Alert><Alert tone="warning" title="Kode tidak ditemukan">Periksa ketikan ulang kode. Kode yang salah tidak mengungkap pilihan suara.</Alert><Alert tone="danger" title="Pemeriksaan belum berhasil">Periksa koneksi dan coba kembali. Jangan menyatakan kode valid sebelum hasil tersedia.</Alert></div></div></section>

    <section aria-labelledby="board-title"><div class="mb-4"><h2 id="board-title" class="text-xl font-bold">Papan Bukti</h2><p class="text-sm text-muted-foreground">Papan tersedia setelah penutupan. Peramban menghitung hash kode secara lokal sebelum pencarian.</p></div><Alert tone="info" title="Belum tersedia saat pemungutan suara berlangsung">Papan bukti dibuka setelah pemungutan suara ditutup.</Alert><Card><div class="mt-4 p-5 sm:p-6"><div class="grid gap-3 sm:grid-cols-3"><div class="rounded-lg bg-background p-4"><p class="text-sm text-muted-foreground">Partisipasi</p><p class="mt-1 text-2xl font-bold">742</p></div><div class="rounded-lg bg-background p-4"><p class="text-sm text-muted-foreground">Surat suara</p><p class="mt-1 text-2xl font-bold">742</p></div><div class="rounded-lg bg-emerald-50 p-4"><p class="text-sm text-emerald-800">Pemeriksaan jumlah</p><p class="mt-1 flex items-center gap-2 font-bold text-emerald-800"><IconCircleCheck size={20} aria-hidden="true" /> Sesuai</p></div></div><div class="mt-5"><p class="text-sm font-semibold">Hash snapshot penutupan</p><code class="mt-2 block overflow-x-auto rounded-md bg-muted p-3 font-mono text-xs">a83e54b2…7d16f091 · contoh, bukan hash nyata</code></div><div class="mt-5 border-t border-border pt-5"><h3 class="font-semibold">Cari kode di papan ini</h3><p class="mt-1 text-sm text-muted-foreground">Pada halaman asli, kode tetap di peramban; hanya hash yang dibandingkan.</p><div class="mt-3 flex flex-wrap gap-3"><input aria-label="Kode bukti untuk pencarian lokal" placeholder="Kode bukti" class="min-h-11 min-w-48 flex-1 rounded-md border border-input bg-card px-3 font-mono" /><Button type="button" variant="secondary">Cari di papan</Button></div></div><h3 class="mt-6 font-semibold">Hash bukti suara</h3><ul class="mt-3 space-y-2 font-mono text-xs"><li class="break-all rounded-md bg-background p-3">4f8a28e5…2c38ab74 · contoh</li><li class="break-all rounded-md bg-background p-3">9b28cd7e…7e46d180 · contoh</li></ul></div></Card></section>

    <section aria-labelledby="results-title"><div class="mb-4"><h2 id="results-title" class="text-xl font-bold">Hasil pemilihan</h2><p class="text-sm text-muted-foreground">Hasil keseluruhan dan tabel per korda baru muncul setelah diumumkan.</p></div><div class="grid gap-3 md:grid-cols-2"><Alert tone="warning" title="Hasil belum diumumkan"><IconLock size={16} class="mr-1 inline" aria-hidden="true" /> Hasil akan diumumkan panitia setelah penutupan dan pemeriksaan.</Alert><Alert tone="success" title="Diumumkan">Halaman Hasil dan tab navigasi publik kini tersedia.</Alert></div><div class="mt-4 grid grid-cols-2 gap-3 md:grid-cols-4">{[["Hak pilih", "1.280"], ["Sudah digunakan", "742"], ["Belum digunakan", "538"], ["Partisipasi", "58%"]].map(([label, value]) => <Card><div class="p-4"><p class="text-sm text-muted-foreground">{label}</p><p class="mt-1 text-2xl font-bold">{value}</p></div></Card>)}</div><div class="mt-4 grid gap-4 lg:grid-cols-2"><Card><div class="p-5 sm:p-6"><div class="flex items-center justify-between gap-2"><h3 class="text-lg font-semibold">Perolehan suara</h3><Badge tone="success">Resmi</Badge></div><div class="mt-4 space-y-3">{tally.map((candidate) => <div class="flex items-center gap-3 rounded-lg border border-border p-3"><span class="flex size-10 shrink-0 items-center justify-center rounded-full font-bold text-white" style={`background-color: ${candidate.color}`}>{candidate.number}</span><strong class="flex-1">{candidate.nickname}</strong><span class="font-semibold">{candidate.votes} suara</span></div>)}</div></div></Card><Card><div class="p-5 sm:p-6"><h3 class="text-lg font-semibold">Hasil per korda</h3><div class="mt-4 overflow-x-auto"><table class="w-full min-w-80 text-left text-sm"><thead><tr class="border-b border-border text-muted-foreground"><th class="py-2">Korda</th><th>Hak pilih</th><th>Partisipasi</th><th>Suara kandidat</th></tr></thead><tbody><tr class="border-b border-border"><th class="py-3 font-semibold">Chugoku</th><td>420</td><td>61%</td><td>Nadia: 143 · Rizky: 113</td></tr><tr><th class="py-3 font-semibold">Korda kecil</th><td>8</td><td>—</td><td><Badge>Data terlalu sedikit</Badge></td></tr></tbody></table></div><p class="mt-3 text-xs text-muted-foreground">Perolehan wilayah dengan kurang dari 10 surat suara disembunyikan untuk melindungi kerahasiaan.</p></div></Card></div></section>
  </div>
</DesignPreviewLayout>
