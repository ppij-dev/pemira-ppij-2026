---
import DesignPreviewLayout from "../../../layouts/DesignPreviewLayout.astro";
import Alert from "../../../components/ui/Alert.astro";
import Badge from "../../../components/ui/Badge.astro";
import Button from "../../../components/ui/Button.astro";
import Card from "../../../components/ui/Card.astro";
const swatches = [
  { name: "Primary", value: "#C8102E", className: "bg-primary text-primary-foreground" },
  { name: "Primary hover", value: "#A50D26", className: "bg-primary-hover text-white" },
  { name: "Background", value: "#F6F6F4", className: "bg-background text-foreground" },
  { name: "Card", value: "#FFFFFF", className: "bg-card text-card-foreground" },
  { name: "Foreground", value: "#1C1F23", className: "bg-foreground text-white" },
  { name: "Accent", value: "#ECEEF0", className: "bg-accent text-accent-foreground" },
];
---
<DesignPreviewLayout title="Kitchen sink" description="Fondasi, komponen, dan keadaan antarmuka yang dipakai pada halaman pemilih dan Admin Voting.">
  <div class="space-y-10">
    <section aria-labelledby="foundations-title"><div class="mb-4"><h2 id="foundations-title" class="text-xl font-bold">Fondasi</h2><p class="text-sm text-muted-foreground">Warna semantik PPIJ, tipografi Plus Jakarta Sans, dan ruang permukaan.</p></div>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">{swatches.map((swatch) => <div class="overflow-hidden rounded-xl border border-border bg-card"><div class:list={["flex h-24 items-end p-4 font-semibold", swatch.className]}>{swatch.name}</div><div class="flex justify-between gap-2 p-3 text-sm"><span>{swatch.name}</span><code class="font-mono text-muted-foreground">{swatch.value}</code></div></div>)}</div>
      <Card><div class="grid gap-6 p-5 sm:grid-cols-2 sm:p-6"><div><p class="text-xs font-semibold uppercase tracking-wider text-primary">Judul halaman</p><h3 class="mt-2 text-3xl font-bold tracking-tight">Pemilihan PPI Jepang</h3><p class="mt-3 text-muted-foreground">Teks pendukung menjelaskan langkah selanjutnya dengan bahasa yang ringkas dan aman.</p></div><div class="space-y-2"><p class="text-xl font-semibold">Judul bagian</p><p class="font-medium">Label dan aksi menengah</p><p class="text-sm text-muted-foreground">Bantuan, cap waktu JST, dan metadata.</p><p class="font-mono text-sm">HASH · 4F8A 8CB9 A12E</p></div></div></Card>
    </section>

    <section aria-labelledby="actions-title"><div class="mb-4"><h2 id="actions-title" class="text-xl font-bold">Aksi dan status</h2><p class="text-sm text-muted-foreground">Satu aksi utama per panel; keadaan terlihat melalui teks dan warna.</p></div>
      <div class="grid gap-4 lg:grid-cols-2"><Card><div class="space-y-5 p-5 sm:p-6"><h3 class="font-semibold">Tombol</h3><div class="flex flex-wrap items-center gap-3"><Button type="button">Simpan Jadwal</Button><Button type="button" variant="secondary">Batal</Button><button type="button" disabled class="inline-flex min-h-11 items-center rounded-md bg-primary px-4 font-semibold text-white opacity-50">Menyimpan…</button></div><p class="text-sm text-muted-foreground">Target sentuh minimal 44 px. Tombol pratinjau tidak menyimpan data.</p></div></Card>
        <Card><div class="space-y-5 p-5 sm:p-6"><h3 class="font-semibold">Badge tahap dan keadaan</h3><div class="flex flex-wrap gap-2"><Badge>Draf</Badge><Badge tone="brand">Dibuka</Badge><Badge tone="success">Diumumkan</Badge><Badge tone="warning">Menunggu</Badge><Badge tone="danger">Gagal</Badge></div><p class="text-sm text-muted-foreground">Label tahap selalu menyertai warna; bukan warna saja.</p></div></Card></div>
      <div class="mt-4 grid gap-3 md:grid-cols-2"><Alert title="Informasi pemilihan" tone="info">Jadwal mengikuti zona waktu Jepang (JST).</Alert><Alert title="Perubahan tersimpan" tone="success">Jadwal terbaru sudah tersedia untuk Admin Voting.</Alert><Alert title="Masuk ulang diperlukan" tone="warning">Untuk memilih, masuk melalui One Login dalam 10 menit terakhir.</Alert><Alert title="Data belum dapat dimuat" tone="danger">Periksa koneksi dan coba kembali dengan tombol Muat Ulang.</Alert></div>
    </section>

    <section aria-labelledby="forms-title"><div class="mb-4"><h2 id="forms-title" class="text-xl font-bold">Formulir</h2><p class="text-sm text-muted-foreground">Label, bantuan, kesalahan, dan aksi tetap berada dalam satu panel.</p></div>
      <div class="grid gap-4 lg:grid-cols-2"><Card><div class="p-5 sm:p-6"><h3 class="text-lg font-semibold">Jadwal dan informasi</h3><p class="mt-1 text-sm text-muted-foreground">Contoh bidang pada Persiapan Pemilihan.</p><div class="mt-5 grid gap-4"><div><label for="sample-title" class="text-sm font-semibold">Judul pemilihan</label><input id="sample-title" value="Pemilihan Ketua PPIJ 2026" class="mt-1 min-h-11 w-full rounded-md border border-input bg-card px-3 focus-visible:outline-2 focus-visible:outline-ring" /></div><div><label for="sample-date" class="text-sm font-semibold">Mulai</label><input id="sample-date" type="datetime-local" value="2026-11-02T09:00" class="mt-1 min-h-11 w-full rounded-md border border-input bg-card px-3 focus-visible:outline-2 focus-visible:outline-ring" /><p class="mt-1 text-xs text-muted-foreground">Waktu Jepang (JST).</p></div><div><label for="sample-description" class="text-sm font-semibold">Deskripsi</label><textarea id="sample-description" rows="3" class="mt-1 w-full rounded-md border border-input bg-card p-3 focus-visible:outline-2 focus-visible:outline-ring">Kenali kandidat sebelum memberikan suara.</textarea></div><div class="flex flex-wrap gap-3 border-t border-border pt-4"><Button type="button">Simpan Jadwal</Button><Button type="button" variant="secondary">Batal</Button></div></div></div></Card>
        <div class="space-y-4"><Card><div class="p-5 sm:p-6"><h3 class="text-lg font-semibold">Validasi bidang</h3><label for="sample-error" class="mt-4 block text-sm font-semibold">Nickname kandidat</label><input id="sample-error" aria-invalid="true" aria-describedby="sample-error-text" value="Nama berbeda" class="mt-1 min-h-11 w-full rounded-md border border-red-600 bg-card px-3 focus-visible:outline-2 focus-visible:outline-ring" /><p id="sample-error-text" class="mt-2 text-sm text-red-700">Ketik nickname kandidat yang dipilih untuk melanjutkan.</p></div></Card><Card><div class="p-5 sm:p-6"><h3 class="text-lg font-semibold">Pencarian dan pilihan</h3><label for="sample-search" class="mt-4 block text-sm font-semibold">Cari pemilih</label><input id="sample-search" type="search" placeholder="Nama atau ID anggota" class="mt-1 min-h-11 w-full rounded-md border border-input bg-card px-3 focus-visible:outline-2 focus-visible:outline-ring" /><div class="mt-4 flex flex-wrap gap-2"><Badge tone="brand">Aktif</Badge><Badge>Terpilih</Badge></div></div></Card></div></div>
    </section>

    <section aria-labelledby="data-title"><div class="mb-4"><h2 id="data-title" class="text-xl font-bold">Data, kosong, dan memuat</h2><p class="text-sm text-muted-foreground">Tabel bisa digulir pada layar kecil; shell tetap tersedia saat data dimuat.</p></div><div class="grid gap-4 lg:grid-cols-2"><Card><div class="p-5 sm:p-6"><h3 class="font-semibold">Ringkasan partisipasi</h3><div class="mt-4 grid grid-cols-2 gap-3"><div class="rounded-lg bg-background p-4"><p class="text-sm text-muted-foreground">Hak pilih</p><p class="mt-1 text-2xl font-bold">1.280</p></div><div class="rounded-lg bg-background p-4"><p class="text-sm text-muted-foreground">Sudah digunakan</p><p class="mt-1 text-2xl font-bold">742</p></div></div><div class="mt-4 overflow-x-auto"><table class="w-full min-w-80 text-left text-sm"><thead><tr class="border-b border-border text-muted-foreground"><th class="py-2">Korda</th><th class="py-2">Hak pilih</th><th class="py-2">Partisipasi</th></tr></thead><tbody><tr class="border-b border-border"><th class="py-3 font-semibold">Chugoku</th><td>420</td><td>61%</td></tr><tr><th class="py-3 font-semibold">Kansai</th><td>360</td><td>58%</td></tr></tbody></table></div></div></Card><div class="space-y-4"><Card><div class="p-5 sm:p-6"><h3 class="font-semibold">Belum ada kandidat</h3><p class="mt-2 text-sm text-muted-foreground">Tambahkan kandidat dari daftar pemilih aktif sebelum menjadwalkan pemilihan.</p></div></Card><Card><div class="p-5 sm:p-6" aria-busy="true"><h3 class="font-semibold">Memuat daftar pemilih…</h3><div class="mt-4 space-y-3" aria-hidden="true"><div class="h-10 animate-pulse rounded-md bg-muted"></div><div class="h-10 animate-pulse rounded-md bg-muted"></div></div></div></Card></div></div>
    </section>
  </div>
</DesignPreviewLayout>
