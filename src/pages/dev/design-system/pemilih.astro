---
import DesignPreviewLayout from "../../../layouts/DesignPreviewLayout.astro";
import Alert from "../../../components/ui/Alert.astro";
import Badge from "../../../components/ui/Badge.astro";
import Button from "../../../components/ui/Button.astro";
import Card from "../../../components/ui/Card.astro";
import CandidateCard from "../../../components/CandidateCard.astro";
import { IconArrowRight, IconCheck, IconLock, IconUser } from "@tabler/icons-astro";
const candidates = [
  { number: 1, name: "Nadia Putri", nickname: "Nadia", region: "Komsat Okayama", color: "#99531f" },
  { number: 2, name: "Rizky Pratama", nickname: "Rizky", region: "Komsat Hiroshima", color: "#315f88" },
];
---
<DesignPreviewLayout title="Alur pemilih" description="Contoh beranda, daftar dan detail kandidat, kelayakan, konfirmasi suara, dan layar sukses. Seluruh data di halaman ini fiktif.">
  <div class="space-y-10">
    <section aria-labelledby="home-title"><div class="mb-4 flex flex-wrap items-end justify-between gap-2"><div><h2 id="home-title" class="text-xl font-bold">Beranda pemilihan</h2><p class="text-sm text-muted-foreground">Status tahap, konteks pemilihan, dan satu aksi utama.</p></div><span class="text-xs font-medium text-muted-foreground">Rujukan: `/`</span></div>
      <Card><div class="overflow-hidden rounded-xl"><div class="bg-gradient-to-br from-brand-900 via-brand-700 to-brand-600 p-6 text-white sm:p-8"><div class="flex items-center gap-4"><img src="/pemira-2026-logo.png" alt="" class="h-14 w-auto rounded-md bg-white p-1" /><div><p class="text-sm text-white/85">PPI Jepang</p><h3 class="text-2xl font-bold">Pemilihan Ketua PPIJ 2026</h3></div></div><p class="mt-4 max-w-xl text-sm text-white/90">Kenali kandidat dan gunakan satu suara Anda secara rahasia.</p><span class="mt-4 inline-flex rounded-full border border-white/30 bg-white/10 px-3 py-1 text-sm font-semibold">Dibuka</span></div><div class="flex flex-wrap items-center justify-between gap-4 p-6"><div><p class="text-sm text-muted-foreground">Pemungutan suara ditutup dalam</p><p class="mt-1 font-mono text-2xl font-bold">02 : 13 : 48 : 06</p></div><Button type="button">Pilih Sekarang <IconArrowRight size={18} stroke={1.8} aria-hidden="true" /></Button></div></div></Card>
      <div class="mt-3 grid gap-3 sm:grid-cols-3"><Alert tone="info" title="Draf">Persiapan sedang berlangsung. Pemilih belum dapat memberikan suara.</Alert><Alert tone="warning" title="Terjadwal">Pemungutan suara belum dibuka; tampilkan hitung mundur mulai.</Alert><Alert tone="success" title="Diumumkan">Tautan Hasil tampil setelah panitia menerbitkan hasil.</Alert></div>
    </section>

    <section aria-labelledby="candidate-title">
      <div class="mb-4"><h2 id="candidate-title" class="text-xl font-bold">Kandidat</h2><p class="text-sm text-muted-foreground">Potret 3:4, nomor urut, identitas, dan perkenalan singkat.</p></div>
      <div class="grid max-w-3xl gap-5 sm:grid-cols-2">{candidates.map((candidate) => <CandidateCard candidate={{...candidate,komsat_path:"/ppij/chugoku/okayama",short_intro:"Saya ingin memperkuat layanan anggota dan keterbukaan kerja organisasi."}} />)}</div>
      <article class="mt-6 border-t border-border pt-6"><div class="grid grid-cols-[6.5rem_minmax(0,1fr)] items-start gap-5 sm:grid-cols-[minmax(0,1fr)_12rem] sm:gap-8"><figure class="sm:order-2"><img src="/placeholder-candidate.png" alt="" width="600" height="800" class="aspect-[3/4] w-full rounded-md object-cover"/><figcaption class="mt-2 text-xs text-muted-foreground">Foto belum tersedia</figcaption></figure><div class="sm:order-1"><Badge tone="brand">Nomor 1</Badge><h3 class="mt-4 text-3xl font-bold">Nadia Putri</h3><p class="mt-2 text-muted-foreground">Nadia · Komsat Okayama</p><p class="mt-3 text-xs text-muted-foreground">Contoh artikel dengan data fiktif.</p></div></div><div class="mt-8 space-y-7 border-t border-border pt-7"><section><h4 class="text-2xl font-semibold">Visi</h4><p class="mt-3 leading-7">Menjadikan organisasi lebih terbuka dan dekat dengan setiap anggota.</p></section><section><h4 class="text-2xl font-semibold">Misi</h4><p class="mt-3 leading-7">Menyediakan informasi kerja yang jelas, memperluas ruang partisipasi, dan menindaklanjuti masukan anggota.</p></section></div></article>
    </section>

    <section aria-labelledby="eligibility-title"><div class="mb-4"><h2 id="eligibility-title" class="text-xl font-bold">Kelayakan dan keamanan</h2><p class="text-sm text-muted-foreground">Keadaan nyata yang harus jelas sebelum pemilih mencapai surat suara.</p></div><div class="grid gap-3 md:grid-cols-2"><Alert tone="info" title="Masuk untuk memilih"><IconUser class="mr-1 inline" size={16} aria-hidden="true" /> Gunakan PPIJ One Login untuk melanjutkan.</Alert><Alert tone="warning" title="Masuk ulang"><IconLock class="mr-1 inline" size={16} aria-hidden="true" /> Sesi masuk untuk memilih harus berusia paling lama 10 menit.</Alert><Alert tone="danger" title="Belum dapat memilih">Nama Anda tidak tercantum dalam daftar pemilih yang telah dibekukan.</Alert><Alert tone="success" title="Anda sudah memilih">Satu suara per anggota. Buka Bukti Suara untuk memeriksa catatan Anda.</Alert></div></section>

    <section aria-labelledby="vote-title"><div class="mb-4"><h2 id="vote-title" class="text-xl font-bold">Pilih dan konfirmasi</h2><p class="text-sm text-muted-foreground">Pilihan ditunjukkan dengan teks dan warna; nickname harus diketik sebelum pengiriman.</p></div><div class="grid gap-4 lg:grid-cols-2"><Card><div class="p-5 sm:p-6"><h3 class="font-semibold">Pilih kandidat</h3><div class="mt-4 space-y-3">{candidates.map((candidate, i) => <div class:list={["flex min-h-20 items-center gap-4 rounded-xl border p-4", i === 0 ? "border-primary bg-brand-50" : "border-border"]}><span class="flex size-10 shrink-0 items-center justify-center rounded-full font-bold text-white" style={`background-color: ${candidate.color}`}>{candidate.number}</span><div class="flex-1"><p class="font-semibold">{candidate.nickname}</p><p class="text-sm text-muted-foreground">{candidate.name}</p></div>{i === 0 && <IconCheck size={20} class="text-primary" aria-label="Dipilih" />}</div>)}</div></div></Card>
        <Card><div class="p-5 sm:p-6"><h3 class="text-lg font-semibold">Konfirmasi pilihan</h3><p class="mt-2 text-sm text-muted-foreground">Ketik nickname kandidat yang Anda pilih: <strong class="text-foreground">Nadia</strong></p><label for="sample-nickname" class="mt-5 block text-sm font-semibold">Nickname kandidat</label><input id="sample-nickname" autocomplete="off" placeholder="Ketik Nadia" class="mt-1 min-h-12 w-full rounded-md border border-input bg-card px-3 focus-visible:outline-2 focus-visible:outline-ring" /><p class="mt-2 text-xs text-muted-foreground">Contoh visual. Tombol di bawah tidak mengirim suara.</p><div class="mt-5 flex flex-wrap gap-3"><Button type="button">Kirim Suara</Button><Button type="button" variant="secondary">Batal</Button></div></div></Card></div>
    </section>

    <section aria-labelledby="receipt-title"><div class="mb-4"><h2 id="receipt-title" class="text-xl font-bold">Setelah suara diterima</h2><p class="text-sm text-muted-foreground">Kode bukti hanya muncul pada layar sukses asli; contoh tidak membuat atau menyimpan kode.</p></div><Card><div class="p-5 sm:p-6"><div class="flex items-center gap-3 text-emerald-800"><IconCheck size={28} stroke={2} aria-hidden="true" /><h3 class="text-xl font-bold">Suara berhasil dikirim</h3></div><p class="mt-3 text-muted-foreground">Simpan kode bukti dari layar sukses. Pilihan kandidat hanya dapat ditampilkan dari perangkat tempat pemilih memilih.</p><div class="mt-4 rounded-md bg-muted p-4 font-mono text-lg tracking-wider text-muted-foreground">••••-••••-••••-••••</div><div class="mt-4 flex flex-wrap gap-3"><Button type="button" variant="secondary">Salin kode</Button><Button type="button">Buka Bukti Suara</Button></div></div></Card></section>
  </div>
</DesignPreviewLayout>
