---
import DesignPreviewLayout from "../../../layouts/DesignPreviewLayout.astro";
import Alert from "../../../components/ui/Alert.astro";
import Badge from "../../../components/ui/Badge.astro";
import Button from "../../../components/ui/Button.astro";
import Card from "../../../components/ui/Card.astro";
import { IconCheck, IconRefresh } from "@tabler/icons-astro";
const readiness = [
  "Jadwal pemilihan valid",
  "Jumlah kandidat memenuhi ketentuan",
  "Daftar pemilih telah disinkronkan",
  "Admin Voting bukan kandidat",
];
const voters = [
  { name: "Ayu Permata", id: "M-1024", komsat: "Okayama", state: "Aktif" },
  { name: "Bima Saputra", id: "M-1078", komsat: "Hiroshima", state: "Aktif" },
  { name: "Citra Rahma", id: "M-1116", komsat: "Okayama", state: "Aktif" },
];
---
<DesignPreviewLayout title="Admin Voting" description="Contoh Dasbor, daftar Pemilih, Kandidat, persiapan Pemilihan, Panitia, dan Audit dengan data fiktif.">
  <div class="space-y-10">
    <section aria-labelledby="dashboard-title"><div class="mb-4"><h2 id="dashboard-title" class="text-xl font-bold">Dasbor</h2><p class="text-sm text-muted-foreground">Ringkasan tahap, hitung mundur, partisipasi, dan pemeriksaan jumlah suara. Data diperbarui hanya lewat aksi manual.</p></div><Card><div class="flex flex-wrap items-start justify-between gap-4 p-5 sm:p-6"><div><Badge tone="brand">Dibuka</Badge><h3 class="mt-3 text-lg font-semibold">Pemungutan suara ditutup dalam</h3><p class="mt-1 font-mono text-3xl font-bold">02 : 13 : 48 : 06</p></div><Button type="button" variant="secondary"><IconRefresh size={18} aria-hidden="true" /> Muat Ulang Data</Button></div></Card><div class="mt-4 grid grid-cols-2 gap-3 lg:grid-cols-4">{[["Hak pilih", "1.280"], ["Sudah digunakan", "742"], ["Belum digunakan", "538"], ["Partisipasi", "58%"]].map(([label, value]) => <Card><div class="p-4"><p class="text-sm text-muted-foreground">{label}</p><p class="mt-1 text-2xl font-bold">{value}</p></div></Card>)}</div><div class="mt-3"><Alert tone="success" title="Jumlah sesuai">Surat suara terkirim: 742 · Jumlah suara di kotak: 742. Diperbarui 24 Oktober 2026, 15.20 JST.</Alert></div></section>

    <section aria-labelledby="roll-title"><div class="mb-4"><h2 id="roll-title" class="text-xl font-bold">Daftar Pemilih</h2><p class="text-sm text-muted-foreground">Pencarian, sinkronisasi manual, status, dan pemilihan anggota dari roll.</p></div><Card><div class="p-5 sm:p-6"><div class="flex flex-wrap items-end justify-between gap-3"><div><h3 class="text-lg font-semibold">Pemilih aktif</h3><p class="mt-1 text-sm text-muted-foreground">Sinkron terakhir: 24 Oktober 2026, 14.35 JST</p></div><Button type="button" variant="secondary"><IconRefresh size={18} aria-hidden="true" /> Sinkronkan</Button></div><div class="mt-5 flex flex-wrap gap-3"><div class="min-w-52 flex-1"><label for="roll-search" class="text-sm font-semibold">Cari anggota</label><input id="roll-search" type="search" placeholder="Nama atau ID anggota" class="mt-1 min-h-11 w-full rounded-md border border-input bg-card px-3" /></div><div><label for="roll-region" class="text-sm font-semibold">Komsat</label><select id="roll-region" class="mt-1 min-h-11 w-full rounded-md border border-input bg-card px-3"><option>Semua Komsat</option><option>Okayama</option><option>Hiroshima</option></select></div></div><div class="mt-4 overflow-x-auto"><table class="w-full min-w-[34rem] text-left text-sm"><thead><tr class="border-b border-border text-muted-foreground"><th class="py-3">Anggota</th><th>Komsat</th><th>Status</th><th>Aksi</th></tr></thead><tbody>{voters.map((voter) => <tr class="border-b border-border last:border-b-0"><td class="py-3"><p class="font-semibold">{voter.name}</p><p class="text-xs text-muted-foreground">{voter.id}</p></td><td>{voter.komsat}</td><td><Badge tone="success">{voter.state}</Badge></td><td><button type="button" class="min-h-11 font-semibold text-primary">Pilih anggota</button></td></tr>)}</tbody></table></div></div></Card></section>

    <section aria-labelledby="committee-title"><div class="mb-4"><h2 id="committee-title" class="text-xl font-bold">Panitia dan undangan</h2><p class="text-sm text-muted-foreground">Peran Admin Voting setara; label Technical Admin menandai pemasang pertama.</p></div><div class="grid gap-4 lg:grid-cols-2"><Card><div class="p-5 sm:p-6"><h3 class="text-lg font-semibold">Admin Voting</h3><div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-b border-border pb-4"><div><p class="font-semibold">Dewi Lestari</p><p class="text-sm text-muted-foreground">M-1001</p></div><Badge tone="brand">Technical Admin</Badge></div><div class="flex flex-wrap items-center justify-between gap-3 pt-4"><div><p class="font-semibold">Farhan Hakim</p><p class="text-sm text-muted-foreground">M-1033</p></div><button type="button" class="min-h-11 font-semibold text-destructive">Hapus</button></div></div></Card><Card><div class="p-5 sm:p-6"><h3 class="text-lg font-semibold">Undang Admin</h3><label for="admin-id" class="mt-4 block text-sm font-semibold">ID anggota</label><input id="admin-id" placeholder="M-1042" class="mt-1 min-h-11 w-full rounded-md border border-input bg-card px-3" /><div class="mt-4"><Button type="button">Buat undangan</Button></div><div class="mt-5 flex flex-wrap justify-between gap-2 border-t border-border pt-4 text-sm"><span>Undangan untuk M-1042</span><Badge tone="warning">Menunggu</Badge></div></div></Card></div></section>

    <section aria-labelledby="candidate-title"><div class="mb-4"><h2 id="candidate-title" class="text-xl font-bold">Kelola kandidat</h2><p class="text-sm text-muted-foreground">Nomor dan nickname unik, anggota dari roll, deskripsi teks biasa, warna dari palet kandidat.</p></div><Card><div class="p-5 sm:p-6"><h3 class="text-lg font-semibold">Tambah / Ubah Kandidat</h3><div class="mt-5 grid gap-4 sm:grid-cols-2"><div><label for="candidate-member" class="text-sm font-semibold">Anggota</label><select id="candidate-member" class="mt-1 min-h-11 w-full rounded-md border border-input bg-card px-3"><option>Ayu Permata · M-1024</option><option>Bima Saputra · M-1078</option></select></div><div><label for="candidate-number" class="text-sm font-semibold">Nomor urut</label><input id="candidate-number" type="number" min="1" max="10" value="1" class="mt-1 min-h-11 w-full rounded-md border border-input bg-card px-3" /></div><div><label for="candidate-name" class="text-sm font-semibold">Nama</label><input id="candidate-name" value="Ayu Permata" class="mt-1 min-h-11 w-full rounded-md border border-input bg-card px-3" /></div><div><label for="candidate-nickname" class="text-sm font-semibold">Nickname</label><input id="candidate-nickname" value="Ayu" class="mt-1 min-h-11 w-full rounded-md border border-input bg-card px-3" /></div><div class="sm:col-span-2"><label for="candidate-description" class="text-sm font-semibold">Deskripsi</label><textarea id="candidate-description" rows="3" class="mt-1 w-full rounded-md border border-input bg-card p-3">Pengalaman organisasi dan rencana kerja singkat.</textarea></div></div><div class="mt-5 flex flex-wrap gap-3 border-t border-border pt-4"><Button type="button">Simpan Kandidat</Button><Button type="button" variant="secondary">Kosongkan</Button></div></div></Card></section>

    <section aria-labelledby="election-title"><div class="mb-4"><h2 id="election-title" class="text-xl font-bold">Persiapan dan tahap pemilihan</h2><p class="text-sm text-muted-foreground">Jadwal, pemeriksaan kesiapan, kunci, perpanjangan, penutupan, dan publikasi hasil.</p></div><div class="grid gap-4 lg:grid-cols-2"><Card><div class="p-5 sm:p-6"><h3 class="text-lg font-semibold">Jadwal dan informasi</h3><div class="mt-4 grid gap-4"><div><label for="election-name" class="text-sm font-semibold">Judul pemilihan</label><input id="election-name" value="Pemilihan Ketua PPIJ 2026" class="mt-1 min-h-11 w-full rounded-md border border-input bg-card px-3" /></div><div class="grid gap-4 sm:grid-cols-2"><div><label for="election-start" class="text-sm font-semibold">Mulai · JST</label><input id="election-start" type="datetime-local" value="2026-11-02T09:00" class="mt-1 min-h-11 w-full rounded-md border border-input bg-card px-3" /></div><div><label for="election-end" class="text-sm font-semibold">Selesai · JST</label><input id="election-end" type="datetime-local" value="2026-11-04T21:00" class="mt-1 min-h-11 w-full rounded-md border border-input bg-card px-3" /></div></div><div><Button type="button">Simpan Jadwal</Button></div></div></div></Card><Card><div class="p-5 sm:p-6"><h3 class="text-lg font-semibold">Kesiapan</h3><ul class="mt-4 space-y-3">{readiness.map((item) => <li class="flex items-center gap-2 text-sm"><IconCheck size={18} class="shrink-0 text-emerald-700" aria-hidden="true" />{item}</li>)}</ul><p class="mt-5 text-sm text-muted-foreground">Daftar Pemilih dibekukan saat Kunci &amp; Jadwalkan.</p><div class="mt-4 flex flex-wrap gap-3"><Button type="button">Kunci &amp; Jadwalkan</Button><Button type="button" variant="secondary">Periksa ulang</Button></div></div></Card></div><div class="mt-4 grid gap-4 md:grid-cols-3"><Card><div class="p-5"><h3 class="font-semibold">Perpanjang waktu</h3><p class="mt-2 text-sm text-muted-foreground">Catat waktu baru dan alasan sebelum menyimpan.</p><button type="button" class="mt-4 min-h-11 font-semibold text-primary">Perpanjang</button></div></Card><Card><div class="p-5"><h3 class="font-semibold">Tutup sekarang</h3><p class="mt-2 text-sm text-muted-foreground">Tindakan konsekuensial memerlukan alasan dan konfirmasi.</p><button type="button" class="mt-4 min-h-11 font-semibold text-destructive">Tutup Sekarang</button></div></Card><Card><div class="p-5"><h3 class="font-semibold">Umumkan hasil</h3><p class="mt-2 text-sm text-muted-foreground">Hasil publik hanya tampil setelah diumumkan.</p><button type="button" class="mt-4 min-h-11 font-semibold text-primary">Umumkan Hasil</button></div></Card></div></section>

    <section aria-labelledby="audit-title"><div class="mb-4"><h2 id="audit-title" class="text-xl font-bold">Audit</h2><p class="text-sm text-muted-foreground">Status integritas, snapshot penutupan, dan entri tindakan Admin Voting.</p></div><div class="grid gap-4 lg:grid-cols-2"><Alert tone="success" title="Rantai log utuh">Integritas diperiksa 24 Oktober 2026, 15.20 JST. Setiap tindakan Admin Voting dicatat.</Alert><Alert tone="danger" title="Contoh keadaan gagal">Jika integritas gagal, tampilkan urutan entri yang bermasalah dan langkah pemeriksaan.</Alert></div><Card><div class="mt-4 p-5 sm:p-6"><div class="flex flex-wrap items-center justify-between gap-3"><div><p class="text-sm text-muted-foreground">24 Oktober 2026 · 14.35 JST</p><h3 class="mt-1 font-semibold">Daftar Pemilih disinkronkan</h3></div><Badge>Admin Voting</Badge></div><p class="mt-2 text-sm text-muted-foreground">Dewi Lestari · Korda Chugoku</p><details class="mt-4 text-sm"><summary class="cursor-pointer font-semibold">Detail</summary><p class="mt-2 text-muted-foreground">1.280 anggota aktif dalam cakupan.</p></details></div></Card></section>
  </div>
</DesignPreviewLayout>
