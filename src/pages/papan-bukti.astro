---
import { env } from "cloudflare:workers";
import { IconClipboardList, IconHash } from "@tabler/icons-astro";
import Base from "../layouts/Base.astro";
import Button from "../components/ui/Button.astro";
import Callout from "../components/ui/Callout.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import PanelCard from "../components/ui/PanelCard.astro";
import { stage } from "../server/lib/stage";
const db=(env as unknown as {DB?:D1Database}).DB;let election:any=null;try{election=await db?.prepare("SELECT status_lock,opens_at,closes_at,closed_early_at FROM elections ORDER BY id LIMIT 1").first()}catch{}let currentStage="draft";try{if(election)currentStage=stage(election,new Date().toISOString())}catch{}
const available=currentStage==="closed"||currentStage==="published";
---
<Base title="Papan Bukti · PPIJ Pemilu">
  <PageHeader eyebrow="Pemilih" title="Papan Bukti" description="Periksa jumlah surat suara dan cocokkan kode bukti Anda setelah pemungutan suara ditutup." />

  <div class="mt-5 grid gap-4">
    {!available ? <PanelCard title="Papan bukti belum dibuka" description="Papan bukti diterbitkan setelah pemungutan suara ditutup." icon={IconClipboardList}>
      <Callout tone="neutral" title="Pemilihan belum selesai">Pemungutan suara masih berlangsung atau belum dimulai. Simpan kode bukti Anda agar siap diperiksa di halaman ini nanti.</Callout>
      <div class="mt-4 flex flex-wrap gap-3">
        <Button href="/surat-suara" variant="secondary">Buka Bukti Suara</Button>
        <Button href="/" variant="ghost">Kembali ke beranda</Button>
      </div>
    </PanelCard>
    : <PanelCard title="Pemeriksaan mandiri" description="Angka di bawah dihitung sistem setelah pemungutan ditutup." icon={IconClipboardList}>
      <p id="board-error" class="text-sm text-brand-muted" role="status">Memuat papan bukti…</p>
      <div id="board-data" hidden class="grid gap-4">
        <div class="grid grid-cols-2 gap-3">
          <article class="grid gap-1.5 rounded-lg border border-brand-border bg-background p-4"><span class="text-sm font-medium text-brand-muted">Partisipasi</span><span id="participation" class="text-2xl font-bold text-brand-ink tabular-nums"></span></article>
          <article class="grid gap-1.5 rounded-lg border border-brand-border bg-background p-4"><span class="text-sm font-medium text-brand-muted">Surat suara</span><span id="ballots" class="text-2xl font-bold text-brand-ink tabular-nums"></span></article>
        </div>
        <p id="consistency" class="text-sm font-semibold"></p>

        <div class="border-t border-brand-border pt-4">
          <h2 class="text-xs font-bold tracking-[0.14em] text-brand-muted uppercase">Hash snapshot penutupan</h2>
          <div class="mt-2 flex flex-wrap items-center gap-2">
            <code id="snapshot" class="min-w-0 flex-1 rounded-lg bg-muted p-3 font-mono text-xs break-all text-brand-ink"></code>
            <Button id="copy-snapshot" type="button" variant="secondary" size="sm">Salin</Button>
          </div>
        </div>

        <div class="border-t border-brand-border pt-4">
          <h2 class="text-base font-bold tracking-tight text-brand-ink">Periksa kode di perangkat ini</h2>
          <p class="mt-1 text-[13px] leading-5 text-brand-muted">Kode tetap di perangkat ini. Peramban mencocokkannya dengan daftar bukti suara, tanpa mengirim kode ke server.</p>
          <label for="board-code" class="mt-3 block text-xs font-semibold text-brand-muted">Kode bukti</label>
          <input id="board-code" autocomplete="off" class="mt-1.5 min-h-12 w-full rounded-lg border border-input bg-card px-3 font-mono text-sm uppercase focus-visible:outline-2 focus-visible:outline-ring" />
          <Button id="find-code" type="button" class="mt-3">Cari di papan</Button>
          <p id="find-status" class="mt-2 min-h-5 text-sm text-brand-muted" role="status" aria-live="polite"></p>
        </div>

        <div class="border-t border-brand-border pt-4">
          <h2 class="text-base font-bold tracking-tight text-brand-ink">Hash bukti suara</h2>
          <p class="mt-1 text-[13px] leading-5 text-brand-muted">Daftar ini memuat hash kode bukti, bukan kode atau pilihan kandidat.</p>
          <ul id="hash-list" class="mt-3 grid gap-1.5"></ul>
        </div>
      </div>
    </PanelCard>}
  </div>
  <script is:inline>
(()=>{const container=document.querySelector('#board-data');if(!container)return;const error=document.querySelector('#board-error'),list=document.querySelector('#hash-list'),alphabet='0123456789ABCDEFGHJKMNPQRSTVWXYZ';let hashes=[];function normalize(s){const v=s.toUpperCase().replace(/[ -]/g,'').replace(/O/g,'0').replace(/[IL]/g,'1');return (v.length===26||v.length===16)&&[...v].every(c=>alphabet.includes(c))?v:null}(async()=>{try{const r=await fetch('/api/votes/board');const d=await r.json();if(!r.ok)throw new Error();hashes=d.hashes||d.receipt_hashes||[];document.querySelector('#participation').textContent=d.participation_count;document.querySelector('#ballots').textContent=d.ballot_count;const matches=d.participation_count===d.ballot_count,consistency=document.querySelector('#consistency');consistency.textContent=matches?'Jumlah partisipasi dan surat suara sesuai.':'Jumlah partisipasi dan surat suara tidak sesuai. Hubungi panitia.';consistency.className=`text-sm font-semibold ${matches?'text-emerald-700':'text-destructive'}`;document.querySelector('#snapshot').textContent=d.closing_snapshot_hash||'Belum tersedia';list.replaceChildren(...hashes.map((h,i)=>{const li=document.createElement('li');li.id=`hash-${i}`;li.className='rounded-lg bg-muted p-3 font-mono text-xs break-all text-brand-ink transition';li.textContent=h;return li}));error.hidden=true;container.hidden=false}catch{error.textContent='Papan bukti belum dapat dimuat. Periksa koneksi lalu muat ulang halaman ini.'}})();document.querySelector('#copy-snapshot').addEventListener('click',async()=>{try{await navigator.clipboard.writeText(document.querySelector('#snapshot').textContent)}catch{}});document.querySelector('#find-code').addEventListener('click',async()=>{const status=document.querySelector('#find-status'),code=normalize(document.querySelector('#board-code').value);if(!code){status.textContent='Masukkan seluruh huruf dan angka dari kode bukti Anda.';status.className='mt-2 min-h-5 text-sm font-medium text-destructive';return}try{const digest=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(code)),hex=[...new Uint8Array(digest)].map(b=>b.toString(16).padStart(2,'0')).join(''),index=hashes.findIndex(h=>h.toLowerCase()===hex);document.querySelectorAll('#hash-list li').forEach(x=>x.classList.remove('ring-2','ring-emerald-500'));if(index<0){status.textContent='Kode tidak ditemukan di papan.';status.className='mt-2 min-h-5 text-sm font-medium text-destructive';return}const row=document.querySelector(`#hash-${index}`);row.classList.add('ring-2','ring-emerald-500');row.scrollIntoView({behavior:'smooth',block:'center'});status.textContent='Kode ditemukan di papan bukti.';status.className='mt-2 min-h-5 text-sm font-semibold text-emerald-700'}catch{status.textContent='Pemeriksaan lokal gagal pada peramban ini.';status.className='mt-2 min-h-5 text-sm font-medium text-destructive'}})})();
</script></Base>
