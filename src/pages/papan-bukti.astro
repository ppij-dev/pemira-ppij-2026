---
/**
 * Papan Bukti: ringkasan penutupan pemilihan dan pemeriksaan mandiri kode
 * bukti (keputusan owner 2026-11-22). Statistik dirender server dari sumber
 * data yang sama dengan API papan (getPublicBoard); daftar hash lengkap pindah
 * ke /papan-bukti/daftar. Pemeriksaan kode tetap berjalan di peramban: kode
 * mentah tidak pernah dikirim ke server (aturan keras 3), dan tidak ada angka
 * pilihan kandidat di papan sebelum Diumumkan (segel hasil).
 */
import { env } from "cloudflare:workers";
import { IconArrowRight, IconChartBar, IconClipboardList, IconRosetteDiscountCheck, IconShieldCheck } from "@tabler/icons-astro";
import Base from "../layouts/Base.astro";
import Badge from "../components/ui/Badge.astro";
import Button from "../components/ui/Button.astro";
import Callout from "../components/ui/Callout.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import PanelCard from "../components/ui/PanelCard.astro";
import StatCard from "../components/ui/StatCard.astro";
import { stage } from "../server/lib/stage";
import { getPublicBoard, type PublicBoard } from "../server/voting/board";

const db = (env as unknown as { DB?: D1Database }).DB;
let board: PublicBoard | null = null;
try {
  board = db ? await getPublicBoard(db, new Date()) : null;
} catch {}
const available = board !== null;
let published = false;
try {
  const row = await db?.prepare("SELECT status_lock,opens_at,closes_at,closed_early_at FROM elections ORDER BY id LIMIT 1").first<{ status_lock: "draft" | "locked" | "published"; opens_at: string; closes_at: string; closed_early_at: string | null }>();
  published = row ? stage(row, new Date().toISOString()) === "published" : false;
} catch {}
const number = (value: number) => new Intl.NumberFormat("id-ID").format(value);
const closedAtJst = (value: string | null) =>
  value ? new Intl.DateTimeFormat("id-ID", { timeZone: "Asia/Tokyo", day: "numeric", month: "long", year: "numeric", hour: "2-digit", minute: "2-digit", hourCycle: "h23" }).format(new Date(value)) + " JST" : null;
const matches = board ? board.participation_count === board.ballot_count : false;
const snapshotHash = board?.closing_snapshot_hash ?? null;
---
<Base title="Papan Bukti · PPIJ Pemilu">
  <PageHeader eyebrow="Pemilih" title="Papan Bukti" description="Ringkasan penutupan pemilihan dan pemeriksaan kode bukti Anda. Semua pemeriksaan berjalan di perangkat ini." />

  <div class="mt-5 grid gap-4">
    {!available || !board ? <PanelCard title="Papan bukti belum dibuka" description="Papan bukti diterbitkan setelah pemungutan suara ditutup." icon={IconClipboardList}>
      <Callout tone="neutral" title="Pemilihan belum selesai">Pemungutan suara masih berlangsung atau belum dimulai. Simpan kode bukti Anda agar siap diperiksa di halaman ini nanti.</Callout>
      <div class="mt-4 flex flex-wrap gap-3">
        <Button href="/surat-suara" variant="secondary">Buka Bukti Suara</Button>
        <Button href="/" variant="ghost">Kembali ke beranda</Button>
      </div>
    </PanelCard>
    : <>
      <PanelCard title={published ? "Penutupan" : "Angka penutupan"} description={published ? "Keadaan kotak suara saat pemungutan suara ditutup." : "Angka ini dihitung sistem saat pemungutan suara ditutup dan menjadi acuan hasil."} icon={IconChartBar}>
        {/* Setelah Diumumkan tanpa jumlah apa pun (owner 2026-11-26); di tahap Ditutup tetap tampil. */}
        {published
          ? (matches
            ? <p class="text-sm font-semibold text-emerald-700">Surat suara di kotak dan Suara masuk sesuai.</p>
            : <Callout tone="danger" title="Angka tidak sesuai">Surat suara di kotak berbeda dengan Suara masuk. Hubungi panitia untuk pemeriksaan lebih lanjut.</Callout>)
          : <>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
            <StatCard label="Hak pilih" value={number(board.hak_pilih)} hint="Daftar Pemilih final saat penutupan." />
            <StatCard label="Suara masuk" value={number(board.participation_count)} hint="Banyaknya Pemilih yang memberi suara." />
            <StatCard label="Partisipasi" value={`${number(board.turnout_percentage)}%`} hint="Suara masuk dibanding Hak pilih." />
            <StatCard label="Surat suara di kotak" value={number(board.ballot_count)} hint={`Partisipasi: ${number(board.participation_count)}.`} />
          </div>
          {matches
            ? <p class="mt-4 text-sm font-semibold text-emerald-700">Surat suara di kotak dan Suara masuk sesuai ({number(board.ballot_count)} = {number(board.participation_count)}).</p>
            : <div class="mt-4"><Callout tone="danger" title="Angka tidak sesuai">Surat suara di kotak ({number(board.ballot_count)}) berbeda dengan Suara masuk ({number(board.participation_count)}). Hubungi panitia untuk pemeriksaan lebih lanjut.</Callout></div>}
          </>}
        <div class="mt-4 grid gap-3 border-t border-brand-border pt-4 sm:grid-cols-2">
          <div class="min-w-0">
            <h3 class="text-xs font-bold tracking-[0.14em] text-brand-muted uppercase">Waktu penutupan</h3>
            <p class="mt-1.5 text-sm font-semibold text-brand-ink tabular-nums">{closedAtJst(board.closed_at) ?? "Belum tersedia"}</p>
            <p class="mt-1 text-[13px] leading-5 text-brand-muted">Waktu resmi pemungutan suara berakhir, baik dari jadwal maupun Tutup Sekarang.</p>
          </div>
          <div class="min-w-0">
            <h3 class="text-xs font-bold tracking-[0.14em] text-brand-muted uppercase">Hash snapshot penutupan</h3>
            <div class="mt-1.5 flex flex-wrap items-center gap-2">
              <code id="snapshot" data-hash={snapshotHash ?? ""} title={snapshotHash ?? undefined} class="min-w-0 flex-1 rounded-lg bg-muted px-3 py-2.5 font-mono text-xs text-brand-ink">{snapshotHash ? `${snapshotHash.slice(0, 12)}…` : "Belum tersedia"}</code>
              {snapshotHash && <Button id="copy-snapshot" type="button" variant="secondary" size="sm">Salin</Button>}
            </div>
            <p class="mt-1 text-[13px] leading-5 text-brand-muted">Penanda digital keadaan penutupan. Angka papan hari ini sama dengan angka saat kotak ditutup.</p>
          </div>
        </div>
        <div class="mt-4 flex flex-col items-start gap-2 border-t border-brand-border pt-4 sm:flex-row sm:items-center sm:gap-3">
          <Button href="/papan-bukti/daftar" variant="secondary" class="shrink-0">
            {published ? "Lihat semua kode bukti" : `Lihat semua kode bukti (${number(board.ballot_count)})`}
            <IconArrowRight size={17} stroke={1.8} aria-hidden="true" />
          </Button>
          <p class="min-w-0 text-[13px] leading-5 text-brand-muted">Daftar lengkap hash kode bukti, bisa dicari dan dibuka per halaman.</p>
        </div>
      </PanelCard>

      <PanelCard title="Cek kode bukti Anda" description="Masukkan kode bukti dari Bukti Suara Anda; pemeriksaan berjalan di peramban ini." icon={IconRosetteDiscountCheck}>
        <p class="text-[13px] leading-5 text-brand-muted">Kode tetap di perangkat ini. Peramban menghitung hash-nya secara lokal, lalu mencocokkannya dengan daftar bukti suara — tanpa mengirim kode ke server.</p>
        <label for="board-code" class="mt-3 block text-xs font-semibold text-brand-muted">Kode bukti</label>
        <input id="board-code" autocomplete="off" spellcheck="false" placeholder="XXXX-XXXX-XXXX-XXXX" class="mt-1.5 min-h-12 w-full rounded-lg border border-input bg-card px-3 font-mono text-sm uppercase focus-visible:outline-2 focus-visible:outline-ring" />
        <Button id="find-code" type="button" class="mt-3">Cek kode</Button>
        <p id="find-status" class="mt-2 min-h-5 text-sm text-brand-muted" role="status" aria-live="polite"></p>
      </PanelCard>

      <PanelCard title="Kenapa papan ini bisa dipercaya" description="Tiga hal yang membuat angka dan daftar ini layak dipercaya." icon={IconShieldCheck}>
        <ul class="grid gap-3 text-[13px] leading-5 text-brand-muted">
          <li class="flex flex-col items-start gap-1.5 sm:flex-row sm:gap-2.5"><Badge tone="success" size="sm" class="shrink-0">Satu orang, satu suara</Badge><span class="min-w-0">Setiap Pemilih hanya dapat memberi satu suara, dan setiap surat suara yang masuk tercatat di kotak.</span></li>
          <li class="flex flex-col items-start gap-1.5 sm:flex-row sm:gap-2.5"><Badge tone="info" size="sm" class="shrink-0">Kode hanya Anda yang tahu</Badge><span class="min-w-0">Papan hanya menampilkan hash kode bukti, bukan kodenya dan bukan pilihan kandidat. Privasi suara tetap terjaga.</span></li>
          <li class="flex flex-col items-start gap-1.5 sm:flex-row sm:gap-2.5"><Badge tone="brand" size="sm" class="shrink-0">Dikunci saat penutupan</Badge><span class="min-w-0">Hash snapshot menandai keadaan saat kotak ditutup, jadi angka tidak bisa berubah diam-diam setelahnya.</span></li>
        </ul>
        {published && <div class="mt-4 border-t border-brand-border pt-4">
          <p class="text-[13px] leading-5 text-brand-muted">Hasil resmi sudah diumumkan panitia.</p>
          <Button href="/hasil" variant="ghost" class="mt-2 -ml-2">Lihat halaman Hasil<IconArrowRight size={17} stroke={1.8} aria-hidden="true" /></Button>
        </div>}
      </PanelCard>
    </>}
  </div>
  {available && board && <script>
    import { findHashIndex, hashBoardCode, normalizeBoardCodeInput } from "../lib/receiptBoard";

    const input = document.querySelector<HTMLInputElement>("#board-code")!;
    const button = document.querySelector<HTMLButtonElement>("#find-code")!;
    const status = document.querySelector<HTMLElement>("#find-status")!;
    const copyButton = document.querySelector<HTMLButtonElement>("#copy-snapshot");
    const ok = "mt-2 min-h-5 text-sm font-semibold text-emerald-700";
    const fail = "mt-2 min-h-5 text-sm font-medium text-destructive";
    const idle = "mt-2 min-h-5 text-sm text-brand-muted";
    let hashes: string[] | null = null;

    // Daftar hash dimuat sekali, saat pemeriksaan pertama, lalu dicocokkan di
    // peramban. Kode bukti mentah tidak pernah dikirim ke server.
    async function loadHashes(): Promise<string[]> {
      if (hashes) return hashes;
      const response = await fetch("/api/votes/board");
      if (!response.ok) throw new Error("papan_belum_tersedia");
      const data = (await response.json()) as { receipt_hashes?: string[] };
      hashes = data.receipt_hashes ?? [];
      return hashes;
    }

    async function check() {
      const canonical = normalizeBoardCodeInput(input.value);
      if (!canonical) {
        status.textContent = "Masukkan seluruh huruf dan angka dari kode bukti Anda.";
        status.className = fail;
        return;
      }
      button.disabled = true;
      status.textContent = "Memeriksa kode di perangkat ini…";
      status.className = idle;
      try {
        const list = await loadHashes();
        const digest = await hashBoardCode(canonical);
        if (findHashIndex(list, digest) < 0) {
          status.textContent = "Kode tidak ditemukan di papan.";
          status.className = fail;
          return;
        }
        status.textContent = "Kode ditemukan di papan bukti.";
        status.className = ok;
      } catch {
        status.textContent = "Papan bukti belum dapat dimuat. Periksa koneksi lalu coba lagi.";
        status.className = fail;
      } finally {
        button.disabled = false;
      }
    }

    button.addEventListener("click", () => void check());
    input.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        event.preventDefault();
        void check();
      }
    });

    copyButton?.addEventListener("click", async () => {
      const full = document.querySelector("#snapshot")?.getAttribute("data-hash") ?? "";
      try {
        await navigator.clipboard.writeText(full);
        window.toast("Hash snapshot disalin.", { variant: "success" });
      } catch {
        window.toast("Gagal menyalin hash snapshot. Salin manual dari teks di atas.", { variant: "error" });
      }
    });
  </script>}
</Base>
