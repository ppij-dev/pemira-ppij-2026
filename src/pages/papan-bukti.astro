---
import { env } from "cloudflare:workers";
import Base from "../layouts/Base.astro";
import { stage } from "../server/lib/stage";
const db=(env as unknown as {DB?:D1Database}).DB;let election:any=null;try{election=await db?.prepare("SELECT status_lock,opens_at,closes_at,closed_early_at FROM elections ORDER BY id LIMIT 1").first()}catch{}let currentStage="draft";try{if(election)currentStage=stage(election,new Date().toISOString())}catch{}
---
<Base title="Papan Bukti · PPIJ Pemilu"><h1 class="text-3xl font-bold tracking-tight">Papan Bukti</h1><p class="mt-2 text-slate-600">Daftar sidik bukti suara yang dapat diverifikasi secara lokal.</p>{currentStage!=="closed"&&currentStage!=="published"?<section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-semibold">Papan bukti tersedia setelah pemungutan suara ditutup</h2><p class="mt-2 text-slate-600">Pemilihan masih berlangsung atau belum dimulai. Papan bukti akan dibuka setelah ditutup.</p></section>:<section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6"><p id="board-error" class="text-sm text-red-700" role="status">Memuat papan bukti…</p><div id="board-data" hidden><div class="grid grid-cols-2 gap-3"><div class="rounded-xl bg-slate-50 p-4"><p class="text-sm text-slate-600">Partisipasi</p><p id="participation" class="text-2xl font-bold"></p></div><div class="rounded-xl bg-slate-50 p-4"><p class="text-sm text-slate-600">Surat suara</p><p id="ballots" class="text-2xl font-bold"></p></div></div><p id="consistency" class="mt-3 font-semibold"></p><p class="mt-4 text-sm text-slate-600">Hash snapshot penutupan</p><div class="flex items-center gap-2"><code id="snapshot" class="min-w-0 break-all font-mono"></code><button id="copy-snapshot" class="shrink-0 rounded border px-3 py-2">Salin</button></div><h2 class="mt-6 text-lg font-bold">Periksa kode di perangkat ini</h2><p class="mt-1 text-sm text-slate-600">Kode tidak dikirim ke server. Hash dihitung di peramban Anda.</p><label for="board-code" class="mt-3 block text-sm font-medium">Kode bukti</label><input id="board-code" autocomplete="off" class="mt-1 min-h-12 w-full rounded-lg border px-3 font-mono"/><button id="find-code" class="mt-3 min-h-11 rounded-lg bg-brand-700 px-4 font-semibold text-white">Cari di papan</button><p id="find-status" class="mt-2 text-sm" aria-live="polite"></p><h2 class="mt-6 text-lg font-bold">Hash bukti suara</h2><ul id="hash-list" class="mt-3 space-y-2"></ul></div></section>}<script is:inline>
(()=>{const container=document.querySelector('#board-data');if(!container)return;const error=document.querySelector('#board-error'),list=document.querySelector('#hash-list'),alphabet='0123456789ABCDEFGHJKMNPQRSTVWXYZ';let hashes=[];function normalize(s){const v=s.toUpperCase().replace(/[ -]/g,'');return v.length===26&&[...v].every(c=>alphabet.includes(c))?v:null}(async()=>{try{const r=await fetch('/api/votes/board');const d=await r.json();if(!r.ok)throw new Error();hashes=d.hashes||d.receipt_hashes||[];document.querySelector('#participation').textContent=d.participation_count;document.querySelector('#ballots').textContent=d.ballot_count;const matches=d.participation_count===d.ballot_count,consistency=document.querySelector('#consistency');consistency.textContent=matches?'Sesuai':'Tidak sesuai';consistency.className=`mt-3 font-semibold ${matches?'text-emerald-700':'text-red-700'}`;document.querySelector('#snapshot').textContent=d.closing_snapshot_hash||'Belum tersedia';list.replaceChildren(...hashes.map((h,i)=>{const li=document.createElement('li');li.id=`hash-${i}`;li.className='break-all rounded bg-slate-50 p-3 font-mono text-xs';li.textContent=h;return li}));error.hidden=true;container.hidden=false}catch{error.textContent='Papan bukti belum dapat dimuat. Silakan coba kembali.'}})();document.querySelector('#copy-snapshot').addEventListener('click',async()=>{try{await navigator.clipboard.writeText(document.querySelector('#snapshot').textContent)}catch{}});document.querySelector('#find-code').addEventListener('click',async()=>{const status=document.querySelector('#find-status'),code=normalize(document.querySelector('#board-code').value);if(!code){status.textContent='Masukkan kode valid sepanjang 26 karakter.';return}try{const digest=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(code)),hex=[...new Uint8Array(digest)].map(b=>b.toString(16).padStart(2,'0')).join(''),index=hashes.findIndex(h=>h.toLowerCase()===hex);document.querySelectorAll('#hash-list li').forEach(x=>x.classList.remove('ring-2','ring-emerald-500'));if(index<0){status.textContent='Kode tidak ditemukan di papan.';return}const row=document.querySelector(`#hash-${index}`);row.classList.add('ring-2','ring-emerald-500');row.scrollIntoView({behavior:'smooth',block:'center'});status.textContent='Kode ditemukan di papan bukti.'}catch{status.textContent='Pemeriksaan lokal gagal pada peramban ini.'}})})();
</script></Base>
