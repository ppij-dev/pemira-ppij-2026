---
import { env } from "cloudflare:workers";
import Base from "../layouts/Base.astro";
import { stage } from "../server/lib/stage";
const db=(env as unknown as {DB?:D1Database}).DB;let election:any=null;try{election=await db?.prepare("SELECT status_lock,opens_at,closes_at,closed_early_at FROM elections ORDER BY id LIMIT 1").first()}catch{}let currentStage="draft";try{if(election)currentStage=stage(election,new Date().toISOString())}catch{}
---
<Base title="Papan Bukti · PPIJ Pemilu">
  <div class="mb-6"><p class="text-sm font-semibold text-primary">VERIFIKASI</p><h1 class="mt-1 text-3xl font-bold tracking-tight">Papan Bukti</h1><p class="mt-2 text-muted-foreground">Daftar sidik bukti suara yang dapat diverifikasi secara lokal.</p></div>
  {currentStage!=="closed" && currentStage!=="published" ? <section class="rounded-xl border border-border bg-card p-5 shadow-sm sm:p-6"><h2 class="text-xl font-semibold">Papan bukti tersedia setelah pemungutan suara ditutup</h2><p class="mt-2 text-muted-foreground">Pemilihan masih berlangsung atau belum dimulai. Papan bukti akan dibuka setelah ditutup.</p></section>
  : <section class="rounded-xl border border-border bg-card p-5 shadow-sm sm:p-6"><p id="board-error" class="text-sm text-muted-foreground" role="status">Memuat papan bukti…</p><div id="board-data" hidden><div class="grid grid-cols-2 gap-3"><div class="rounded-md bg-background p-4"><p class="text-sm text-muted-foreground">Partisipasi</p><p id="participation" class="mt-1 text-2xl font-bold"></p></div><div class="rounded-md bg-background p-4"><p class="text-sm text-muted-foreground">Surat suara</p><p id="ballots" class="mt-1 text-2xl font-bold"></p></div></div><p id="consistency" class="mt-4 font-semibold"></p><div class="mt-5 border-t border-border pt-5"><h2 class="text-sm font-semibold">Hash snapshot penutupan</h2><div class="mt-2 flex flex-wrap items-center gap-3"><code id="snapshot" class="min-w-0 flex-1 break-all rounded-md bg-muted p-3 font-mono text-xs"></code><button id="copy-snapshot" type="button" class="min-h-11 rounded-md border border-border px-3 font-semibold hover:bg-accent">Salin</button></div></div><div class="mt-6 border-t border-border pt-5"><h2 class="text-lg font-semibold">Periksa kode di perangkat ini</h2><p class="mt-1 text-sm text-muted-foreground">Kode tidak dikirim ke server. Hash dihitung di peramban Anda.</p><label for="board-code" class="mt-4 block text-sm font-semibold">Kode bukti</label><input id="board-code" autocomplete="off" class="mt-1 min-h-12 w-full rounded-md border border-input bg-card px-3 font-mono focus-visible:outline-2 focus-visible:outline-ring"/><button id="find-code" type="button" class="mt-3 min-h-11 rounded-md bg-primary px-4 font-semibold text-primary-foreground hover:bg-primary-hover">Cari di papan</button><p id="find-status" class="mt-2 text-sm" role="status" aria-live="polite"></p></div><div class="mt-6 border-t border-border pt-5"><h2 class="text-lg font-semibold">Hash bukti suara</h2><ul id="hash-list" class="mt-3 space-y-2"></ul></div></div></section>}
  <script is:inline>
(()=>{const container=document.querySelector('#board-data');if(!container)return;const error=document.querySelector('#board-error'),list=document.querySelector('#hash-list'),alphabet='0123456789ABCDEFGHJKMNPQRSTVWXYZ';let hashes=[];function normalize(s){const v=s.toUpperCase().replace(/[ -]/g,'').replace(/O/g,'0').replace(/[IL]/g,'1');return v.length===16&&[...v].every(c=>alphabet.includes(c))?v:null}(async()=>{try{const r=await fetch('/api/votes/board');const d=await r.json();if(!r.ok)throw new Error();hashes=d.hashes||d.receipt_hashes||[];document.querySelector('#participation').textContent=d.participation_count;document.querySelector('#ballots').textContent=d.ballot_count;const matches=d.participation_count===d.ballot_count,consistency=document.querySelector('#consistency');consistency.textContent=matches?'Sesuai':'Tidak sesuai';consistency.className=`mt-3 font-semibold ${matches?'text-emerald-700':'text-red-700'}`;document.querySelector('#snapshot').textContent=d.closing_snapshot_hash||'Belum tersedia';list.replaceChildren(...hashes.map((h,i)=>{const li=document.createElement('li');li.id=`hash-${i}`;li.className='break-all rounded bg-background p-3 font-mono text-xs';li.textContent=h;return li}));error.hidden=true;container.hidden=false}catch{error.textContent='Papan bukti belum dapat dimuat. Silakan coba kembali.'}})();document.querySelector('#copy-snapshot').addEventListener('click',async()=>{try{await navigator.clipboard.writeText(document.querySelector('#snapshot').textContent)}catch{}});document.querySelector('#find-code').addEventListener('click',async()=>{const status=document.querySelector('#find-status'),code=normalize(document.querySelector('#board-code').value);if(!code){status.textContent='Masukkan kode valid sepanjang 16 karakter.';return}try{const digest=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(code)),hex=[...new Uint8Array(digest)].map(b=>b.toString(16).padStart(2,'0')).join(''),index=hashes.findIndex(h=>h.toLowerCase()===hex);document.querySelectorAll('#hash-list li').forEach(x=>x.classList.remove('ring-2','ring-emerald-500'));if(index<0){status.textContent='Kode tidak ditemukan di papan.';return}const row=document.querySelector(`#hash-${index}`);row.classList.add('ring-2','ring-emerald-500');row.scrollIntoView({behavior:'smooth',block:'center'});status.textContent='Kode ditemukan di papan bukti.'}catch{status.textContent='Pemeriksaan lokal gagal pada peramban ini.'}})})();
</script></Base>
