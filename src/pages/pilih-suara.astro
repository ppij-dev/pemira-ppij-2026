---
import { env } from "cloudflare:workers";
import Base from "../layouts/Base.astro";
import { SESSION_COOKIE,openSession } from "../server/auth/session";
import { getEligibility } from "../server/voting/vote";
import type { Bindings } from "../server/app";
const bindings=env as unknown as Bindings; const raw=Astro.cookies.get(SESSION_COOKIE)?.value; const session=raw&&bindings.APP_MASTER_KEY?await openSession(raw,bindings.APP_MASTER_KEY):null;
let eligibility:any={allowed:false,reason:session?"unavailable":"not_logged_in",fresh_login_needed:!session,stage:null};
try { eligibility=await getEligibility(bindings.DB,session); } catch {}
let candidates:any[]=[];try{candidates=(await bindings.DB.prepare("SELECT id,number,nickname,name,komsat_path,color FROM candidates ORDER BY number").all()).results??[]}catch{}
const reasons:Record<string,string>={out_of_scope:"Keanggotaan Anda berada di luar cakupan pemilihan.",not_in_roll:"Nama Anda tidak tercantum dalam daftar pemilih yang telah dibekukan.",not_active:"Status keanggotaan Anda belum aktif.",admin_voting_not_allowed:"Admin Voting tidak diperbolehkan memberikan suara.",already_voted:"Anda sudah memilih.",auto_register_failed:"Pendaftaran otomatis gagal. Muat ulang halaman dan coba lagi."};
let previewMode=false;try{previewMode=((await bindings.DB.prepare("SELECT preview_mode FROM elections ORDER BY id LIMIT 1").first<{preview_mode:number}>())?.preview_mode===1)}catch{}
---
<Base title="Pilih Suara · PPIJ Pemilu">
  <div class="mb-6"><p class="text-sm font-semibold text-primary">PEMILIHAN</p><h1 class="mt-1 text-3xl font-bold tracking-tight">Pilih Suara</h1><p class="mt-2 text-muted-foreground">Satu suara untuk pemilihan yang rahasia.</p>{previewMode && <p class="mt-3 inline-flex rounded-full border border-amber-200 bg-amber-50 px-3 py-1 text-sm font-semibold text-amber-800">Mode Pratinjau — pemilih terdaftar otomatis saat masuk</p>}</div>
  {!session ? <section class="rounded-xl border border-border bg-card p-5 shadow-sm sm:p-6"><h2 class="text-xl font-semibold">Masuk untuk memilih</h2><p class="mt-2 text-muted-foreground">Silakan masuk menggunakan PPIJ One Login untuk melanjutkan.</p><a href="/api/auth/login?return_to=/pilih-suara" class="mt-5 inline-flex min-h-11 items-center rounded-md bg-primary px-4 font-semibold text-primary-foreground hover:bg-primary-hover">Masuk</a></section>
  : eligibility.fresh_login_needed ? <section class="rounded-xl border border-amber-200 bg-amber-50 p-5 sm:p-6"><h2 class="text-xl font-semibold">Masuk ulang</h2><p class="mt-2">Untuk keamanan, silakan masuk kembali sebelum memilih.</p><a href="/api/auth/login?max_age=600&return_to=/pilih-suara" class="mt-5 inline-flex min-h-11 items-center rounded-md bg-primary px-4 font-semibold text-primary-foreground hover:bg-primary-hover">Masuk ulang</a></section>
  : reasons[eligibility.reason] ? <section class="rounded-xl border border-border bg-card p-5 shadow-sm sm:p-6"><h2 class="text-xl font-semibold">{eligibility.reason==="already_voted" ? "Anda sudah memilih" : "Belum dapat memilih"}</h2><p class="mt-2 text-muted-foreground">{reasons[eligibility.reason]}</p>{eligibility.reason==="already_voted" && <a class="mt-5 inline-flex min-h-11 items-center rounded-md bg-primary px-4 font-semibold text-primary-foreground hover:bg-primary-hover" href="/surat-suara">Buka Bukti Suara</a>}</section>
  : eligibility.stage === "draft" || eligibility.reason === "not_locked" ? <section class="rounded-xl border border-border bg-card p-5 shadow-sm sm:p-6"><h2 class="text-xl font-semibold">Pemilihan masih dalam persiapan.</h2><p class="mt-2 text-muted-foreground">Tunggu pengumuman panitia sebelum memberikan suara.</p></section>
  : !eligibility.stage || eligibility.reason === "unavailable" || eligibility.reason === "no_election" ? <section class="rounded-xl border border-border bg-card p-5 shadow-sm sm:p-6"><h2 class="text-xl font-semibold">Informasi pemilihan belum tersedia</h2><p class="mt-2 text-muted-foreground">Silakan coba kembali nanti.</p></section>
  : eligibility.stage !== "open" ? <section class="rounded-xl border border-border bg-card p-5 shadow-sm sm:p-6"><h2 class="text-xl font-semibold">{eligibility.stage==="scheduled" ? "Pemilihan terjadwal" : "Pemungutan suara sudah ditutup"}</h2><p class="mt-2 text-muted-foreground">{eligibility.stage==="scheduled" ? "Pemungutan suara belum dimulai. Silakan kembali saat jadwal dibuka." : "Saat ini pemungutan suara tidak dibuka."}</p></section>
  : <><section aria-labelledby="choose-candidate"><h2 id="choose-candidate" class="text-lg font-semibold">Pilih satu kandidat</h2><p class="mt-1 text-sm text-muted-foreground">Periksa nomor, nama, dan komsat sebelum mengonfirmasi.</p><div class="mt-4 grid gap-3">{candidates.map((c)=><button type="button" data-candidate={c.id} data-nickname={c.nickname} class="candidate-card flex min-h-20 w-full items-center gap-4 rounded-xl border border-border bg-card p-4 text-left shadow-sm transition hover:border-brand-400 hover:shadow-md focus-visible:outline-2 focus-visible:outline-ring"><span class="flex size-12 shrink-0 items-center justify-center rounded-full font-bold text-white" style={`background-color:${c.color||'#334155'}`}>{c.number}</span><span class="min-w-0 flex-1"><strong class="block text-lg">{c.nickname}</strong><span class="text-sm text-muted-foreground">{c.name} · {c.komsat_path}</span></span><span class="size-5 shrink-0 rounded-full border border-input" aria-hidden="true"></span></button>)}</div></section>
    <div id="confirm-backdrop" hidden class="fixed inset-0 z-20 bg-foreground/40"></div><section id="confirm" hidden role="dialog" aria-modal="true" aria-labelledby="confirm-title" class="fixed inset-x-0 bottom-0 z-30 mx-auto max-h-[85dvh] max-w-3xl overflow-auto rounded-t-xl border border-border bg-card p-5 pb-[max(1.25rem,env(safe-area-inset-bottom))] shadow-2xl sm:bottom-auto sm:top-1/2 sm:-translate-y-1/2 sm:rounded-xl sm:p-6"><h2 id="confirm-title" class="text-xl font-semibold">Konfirmasi pilihan</h2><p class="mt-2 text-muted-foreground">Ketik nickname kandidat untuk mengonfirmasi: <strong id="chosen" class="text-foreground"></strong></p><label class="mt-4 block text-sm font-semibold" for="confirm-name">Nickname kandidat</label><input id="confirm-name" autocomplete="off" class="mt-1 min-h-12 w-full rounded-md border border-input bg-card px-3 focus-visible:outline-2 focus-visible:outline-ring"/><p id="vote-error" class="mt-2 text-sm text-destructive" role="status"></p><div class="mt-4 flex flex-wrap gap-3 border-t border-border pt-4"><button id="send-vote" disabled class="min-h-11 flex-1 rounded-md bg-primary px-4 font-semibold text-primary-foreground disabled:opacity-50">Kirim Suara</button><button id="cancel-vote" type="button" class="min-h-11 rounded-md border border-border bg-card px-4 font-semibold hover:bg-accent">Batal</button></div></section>
    <section id="success" hidden class="mt-6 rounded-xl border border-emerald-200 bg-card p-5 shadow-sm sm:p-6"><h2 class="text-2xl font-semibold text-emerald-800">Suara berhasil dikirim</h2><p class="mt-2 text-muted-foreground">Simpan kode bukti ini. Kode hanya ditampilkan pada halaman ini.</p><p id="receipt-code" class="mt-4 break-all rounded-md bg-muted p-4 font-mono text-lg font-bold tracking-wider"></p><p id="storage-warning" hidden class="mt-2 text-sm text-amber-800">Kode tidak dapat disimpan di perangkat ini — salin sekarang.</p><div class="mt-4 flex flex-wrap gap-3"><button id="copy-code" type="button" class="min-h-11 rounded-md border border-border bg-card px-4 font-semibold hover:bg-accent">Salin</button><a id="receipt-link" class="inline-flex min-h-11 items-center rounded-md bg-primary px-4 font-semibold text-primary-foreground hover:bg-primary-hover">Buka Bukti Suara</a></div></section>
    <script is:inline>
const errors={belum_masuk:'Silakan masuk kembali.',stale_session:'Sesi masuk telah kedaluwarsa. Silakan masuk kembali.',out_of_scope:'Anda berada di luar cakupan pemilihan.',not_in_roll:'Nama Anda tidak tercantum pada daftar pemilih.',not_active:'Status keanggotaan Anda belum aktif.',admin_voting_not_allowed:'Admin Voting tidak diperbolehkan memilih.',origin_tidak_diizinkan:'Permintaan tidak dapat diverifikasi. Muat ulang halaman.',confirmation_mismatch:'Nickname tidak cocok.',invalid_body:'Data pilihan tidak valid.',candidate_not_found:'Kandidat tidak ditemukan.',not_locked:'Pemilihan belum siap dibuka.',not_open:'Pemungutan suara sedang ditutup.',already_voted:'Anda sudah memilih.',rate_limited:'Terlalu banyak percobaan. Coba kembali nanti.'};let selected=null;const panel=document.querySelector('#confirm'),backdrop=document.querySelector('#confirm-backdrop'),input=document.querySelector('#confirm-name'),send=document.querySelector('#send-vote'),msg=document.querySelector('#vote-error');document.querySelectorAll('.candidate-card').forEach(b=>b.addEventListener('click',()=>{selected=b;document.querySelector('#chosen').textContent=b.dataset.nickname;input.value='';msg.textContent='';send.disabled=true;panel.hidden=false;backdrop.hidden=false;input.focus()}));input.addEventListener('input',()=>send.disabled=!selected||input.value.trim().toLocaleLowerCase('id')!==selected.dataset.nickname.trim().toLocaleLowerCase('id'));const closeConfirm=()=>{panel.hidden=true;backdrop.hidden=true;selected?.focus()};document.querySelector('#cancel-vote').addEventListener('click',closeConfirm);panel.addEventListener('keydown',e=>{if(e.key==='Escape'){e.preventDefault();closeConfirm();return}if(e.key!=='Tab')return;const controls=[...panel.querySelectorAll('input:not([disabled]),button:not([disabled])')];const first=controls[0],last=controls.at(-1);if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus()}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}});send.addEventListener('click',async()=>{if(!selected||send.disabled)return;send.disabled=true;msg.textContent='';try{const r=await fetch('/api/votes',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({candidate_id:Number(selected.dataset.candidate),confirmation_text:input.value.trim()})});const d=await r.json();if(r.status===201&&typeof d.receipt_code==='string'){const code=d.receipt_code;document.querySelector('#receipt-code').textContent=code;document.querySelector('#receipt-link').href='/surat-suara#'+encodeURIComponent(code);panel.hidden=true;backdrop.hidden=true;document.querySelectorAll('.candidate-card').forEach(x=>x.hidden=true);document.querySelector('#success').hidden=false;document.querySelector('#copy-code').focus();try{localStorage.setItem('ppij_receipt_code',code)}catch{document.querySelector('#storage-warning').hidden=false}return}if(r.status===409&&d.error==='already_voted'){location.assign('/surat-suara');return}msg.textContent=errors[d.error]||'Suara belum dapat dikirim. Coba kembali.'}catch{msg.textContent='Koneksi bermasalah. Periksa jaringan lalu coba kembali.'}send.disabled=input.value.trim().toLocaleLowerCase('id')!==selected.dataset.nickname.trim().toLocaleLowerCase('id')});document.querySelector('#copy-code').addEventListener('click',async()=>{try{await navigator.clipboard.writeText(document.querySelector('#receipt-code').textContent);document.querySelector('#copy-code').textContent='Tersalin'}catch{document.querySelector('#copy-code').textContent='Salin manual'}});
</script></>}
</Base>
