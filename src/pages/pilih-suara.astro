---
import { env } from "cloudflare:workers";
import { IconBoxMultiple, IconInfoCircle, IconShieldLock } from "@tabler/icons-astro";
import Base from "../layouts/Base.astro";
import Button from "../components/ui/Button.astro";
import Callout from "../components/ui/Callout.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import PanelCard from "../components/ui/PanelCard.astro";
import { SESSION_COOKIE,openSession } from "../server/auth/session";
import { getEligibility } from "../server/voting/vote";
import type { Bindings } from "../server/app";
const bindings=env as unknown as Bindings; const raw=Astro.request.headers.get("cookie")??Astro.cookies.get(SESSION_COOKIE)?.value; const session=raw&&bindings.APP_MASTER_KEY?await openSession(raw,bindings.APP_MASTER_KEY):null;
let eligibility:any={allowed:false,reason:session?"unavailable":"not_logged_in",fresh_login_needed:!session,stage:null};
try { eligibility=await getEligibility(bindings.DB,session); } catch {}
let candidates:any[]=[];try{candidates=(await bindings.DB.prepare("SELECT id,number,nickname,name,komsat_path,color FROM candidates ORDER BY number").all()).results??[]}catch{}
const reasons:Record<string,string>={out_of_scope:"Keanggotaan Anda berada di luar cakupan pemilihan.",not_in_roll:"Nama Anda tidak tercantum dalam daftar pemilih yang telah dibekukan.",not_active:"Status keanggotaan Anda belum aktif.",not_regular_member:"Hanya Anggota Biasa yang berhak memilih pada pemilihan ini. Kategori keanggotaan Anda di portal adalah Anggota Luar Biasa.",category_unknown:"Kategori keanggotaan Anda belum ditentukan portal PPIJ. Hubungi panitia pemilihan untuk melengkapinya.",admin_voting_not_allowed:"Admin Voting tidak diperbolehkan memberikan suara.",already_voted:"Anda sudah memilih.",auto_register_failed:"Pendaftaran otomatis gagal. Muat ulang halaman dan coba lagi."};
let previewMode=false;try{previewMode=((await bindings.DB.prepare("SELECT preview_mode FROM elections ORDER BY id LIMIT 1").first<{preview_mode:number}>())?.preview_mode===1)}catch{}
// Satu keadaan tampil per kunjungan, mengikuti urutan pemeriksaan server.
const reasonText = reasons[eligibility.reason] ?? null;
const view = !session
  ? "login"
  : eligibility.fresh_login_needed
    ? "relogin"
    : reasonText
      ? "blocked"
      : eligibility.stage === "draft" || eligibility.reason === "not_locked"
        ? "preparing"
        : !eligibility.stage || eligibility.reason === "unavailable" || eligibility.reason === "no_election"
          ? "unavailable"
          : eligibility.stage !== "open"
            ? "not_open"
            : "ballot";
const blockedTitle = eligibility.reason === "already_voted" ? "Anda sudah memilih" : "Belum dapat memilih";
const notOpenTitle = eligibility.stage === "scheduled" ? "Pemilihan terjadwal" : "Pemungutan suara sudah ditutup";
const notOpenText = eligibility.stage === "scheduled" ? "Pemungutan suara belum dimulai. Kembali saat jadwal dibuka." : "Saat ini pemungutan suara tidak dibuka.";
---
<Base title="Pilih Suara · PPIJ Pemilu">
  <PageHeader eyebrow="Pemilih" title="Pilih Suara" description="Pilih satu kandidat. Setelah dikirim, suara tidak dapat diubah." />
  {previewMode && <div class="mt-4"><Callout tone="warning" title="Mode uji coba">Suara yang masuk hanya untuk tes dan akan dihapus saat pemilihan dikunci.</Callout></div>}

  <div class="mt-5 grid gap-4">
    {view === "login" && <PanelCard title="Masuk untuk memilih" description="Gunakan PPIJ One Login, akun portal keanggotaan Anda." icon={IconShieldLock}>
      <p class="text-sm leading-6 text-brand-muted">Keanggotaan Anda diperiksa otomatis setelah masuk. Situs ini tidak menyimpan kata sandi Anda.</p>
      <Button href="/api/auth/login?return_to=/pilih-suara" class="mt-4">Masuk</Button>
    </PanelCard>}

    {view === "relogin" && <PanelCard title="Masuk ulang" description="Untuk keamanan, sesi masuk harus berumur paling lama 10 menit sebelum memilih." icon={IconShieldLock}>
      <Callout tone="warning" title="Sesi Anda sudah lama">Masuk kembali, lalu lanjutkan ke surat suara. Suara Anda belum terkirim.</Callout>
      <Button href="/api/auth/login?prompt=login&max_age=600&return_to=/pilih-suara" class="mt-4">Masuk ulang</Button>
    </PanelCard>}

    {view === "blocked" && <PanelCard title={blockedTitle} description="Pemeriksaan keanggotaan dilakukan saat Anda membuka halaman ini." icon={IconInfoCircle}>
      <p class="text-sm leading-6 text-brand-ink">{reasonText}</p>
      {eligibility.reason === "already_voted"
        ? <Button href="/surat-suara" class="mt-4">Buka Bukti Suara</Button>
        : <p class="mt-4 text-sm leading-6 text-brand-muted">Bila data Anda di portal sudah benar, hubungi panitia pemilihan untuk pemeriksaan ulang.</p>}
    </PanelCard>}

    {view === "preparing" && <PanelCard title="Pemilihan masih dalam persiapan" description="Panitia belum membuka masa pemungutan suara." icon={IconInfoCircle}>
      <p class="text-sm leading-6 text-brand-muted">Tunggu pengumuman panitia. Jadwal pemungutan tampil di beranda.</p>
      <Button href="/" variant="secondary" class="mt-4">Kembali ke beranda</Button>
    </PanelCard>}

    {view === "unavailable" && <PanelCard title="Informasi pemilihan belum tersedia" description="Data pemilihan belum dapat dibaca saat ini." icon={IconInfoCircle}>
      <p class="text-sm leading-6 text-brand-muted">Silakan muat ulang halaman ini beberapa saat lagi.</p>
      <Button href="/pilih-suara" variant="secondary" class="mt-4">Muat ulang</Button>
    </PanelCard>}

    {view === "not_open" && <PanelCard title={notOpenTitle} description={notOpenText} icon={IconInfoCircle}>
      <p class="text-sm leading-6 text-brand-muted">Anda tetap dapat melihat daftar kandidat dan profil masing-masing.</p>
      <Button href="/kandidat" variant="secondary" class="mt-4">Lihat kandidat</Button>
    </PanelCard>}

    {view === "ballot" && <>
      <div id="ballot-entry">
        <PanelCard title="Siap memilih?" description="Surat suara berisi semua kandidat. Pilih satu, periksa lagi, lalu kirim." icon={IconBoxMultiple}>
          <div class="flex flex-col items-center gap-4 text-center">
            <img src="/voting-ballot-box.svg" alt="" class="size-20" width="80" height="80" />
            <Button id="open-ballot" type="button"><IconBoxMultiple size={19} stroke={1.8} aria-hidden="true" />Buka surat suara</Button>
            <p class="max-w-sm text-xs leading-5 text-brand-muted">Kode bukti muncul sekali setelah suara terkirim. Simpan kode itu untuk memeriksa surat suara Anda nanti.</p>
          </div>
        </PanelCard>
      </div>

      <div id="sheet-backdrop" hidden class="fixed inset-0 z-20 bg-foreground/40"></div>
      <section id="ballot-sheet" hidden role="dialog" aria-modal="true" aria-labelledby="sheet-title" class="fixed inset-x-0 bottom-0 z-30 mx-auto max-h-[85dvh] w-full max-w-lg overflow-auto rounded-t-xl border border-brand-border bg-card p-5 pb-[max(1.25rem,env(safe-area-inset-bottom))] shadow-2xl">
        <div class="mx-auto mb-4 h-1 w-10 rounded-full bg-border" aria-hidden="true"></div>
        <div id="sheet-list">
          <h2 id="sheet-title" class="text-xl font-bold tracking-tight text-brand-ink">Pilih satu kandidat</h2>
          <p class="mt-1 text-sm text-brand-muted">Periksa nomor dan nama sebelum melanjutkan.</p>
          <div class="mt-4 grid gap-2" role="radiogroup" aria-label="Kandidat">
            {candidates.map((c)=><label class="flex min-h-16 cursor-pointer items-center gap-3 rounded-xl border border-brand-border bg-card p-3 transition has-[:checked]:border-brand-400 has-[:checked]:bg-brand-50/60 hover:bg-accent"><input type="radio" name="candidate" class="peer sr-only" value={c.id} data-nickname={c.nickname} data-number={c.number}/><span class="flex size-10 shrink-0 items-center justify-center rounded-full font-bold text-white" style={`background-color:${c.color||'#334155'}`}>{c.number}</span><span class="min-w-0 flex-1"><strong class="block break-words text-brand-ink">{c.nickname}</strong><span class="block truncate text-sm text-brand-muted">{c.name}</span></span><span class="size-5 shrink-0 rounded-full border-2 border-input peer-checked:border-4 peer-checked:border-primary" aria-hidden="true"></span></label>)}
          </div>
          <div class="mt-5 flex gap-3">
            <Button id="sheet-continue" type="button" disabled class="flex-1">Lanjut</Button>
            <Button id="sheet-cancel" type="button" variant="secondary">Batal</Button>
          </div>
        </div>
        <div id="sheet-confirm" hidden>
          <h2 class="text-xl font-bold tracking-tight text-brand-ink">Konfirmasi pilihan</h2>
          <p class="mt-2 text-sm text-brand-muted">Pilihan Anda: <strong id="confirm-name" class="break-words text-brand-ink"></strong>.</p>
          <p class="mt-1 text-sm text-brand-muted">Pastikan sudah sesuai. Suara tidak dapat diubah setelah dikirim.</p>
          <p id="vote-error" class="mt-3 text-sm font-medium text-destructive" role="status"></p>
          <div class="mt-4 flex flex-wrap gap-3 border-t border-brand-border pt-4">
            <Button id="send-vote" type="button" class="flex-1">Kirim suara</Button>
            <Button id="confirm-back" type="button" variant="secondary">Ubah pilihan</Button>
          </div>
        </div>
      </section>

      <div id="success" hidden class="rounded-xl border border-brand-border bg-card">
        <div class="p-5 sm:p-6">
          <Callout tone="success" title="Suara Anda sudah masuk">Satu suara tercatat untuk akun Anda.</Callout>
          <h2 class="mt-4 text-xl font-bold tracking-tight text-brand-ink">Simpan kode bukti ini</h2>
          <p class="mt-2 text-sm leading-6 text-brand-muted">Kode ini hanya muncul sekali. Simpan salinan pribadi agar Anda dapat memeriksa surat suara nanti. Kode tidak akan muncul lagi jika data peramban dihapus atau Anda masuk dari perangkat lain. <a href="/surat-suara#tentang-kerahasiaan" class="font-semibold text-brand-red underline underline-offset-2 hover:text-primary-hover focus-visible:outline-2 focus-visible:outline-ring">Pahami alasannya</a></p>
          <p id="receipt-code" class="mt-4 rounded-lg bg-muted p-4 font-mono text-base font-bold tracking-wide break-all text-brand-ink"></p>
          <p id="storage-warning" hidden class="mt-2 text-sm font-medium text-destructive">Peramban tidak dapat menyimpan kode ini. Salin sekarang.</p>
          <div class="mt-4 flex flex-wrap gap-3">
            <Button id="copy-code" type="button" variant="secondary">Salin kode</Button>
            <Button id="receipt-link" href="/surat-suara">Periksa kode</Button>
          </div>
        </div>
      </div>
    </>}
  </div>

  {view === "ballot" && <script is:inline>
const errors={belum_masuk:'Silakan masuk kembali.',stale_session:'Sesi masuk tidak valid. Silakan masuk kembali.',out_of_scope:'Anda berada di luar cakupan pemilihan.',not_in_roll:'Nama Anda tidak tercantum pada daftar pemilih.',not_active:'Status keanggotaan Anda belum aktif.',not_regular_member:'Hanya Anggota Biasa yang berhak memilih.',category_unknown:'Kategori keanggotaan Anda belum ditentukan portal. Hubungi panitia pemilihan.',admin_voting_not_allowed:'Admin Voting tidak diperbolehkan memilih.',origin_tidak_diizinkan:'Permintaan tidak dapat diverifikasi. Muat ulang halaman.',confirmation_mismatch:'Konfirmasi tidak cocok. Buka ulang pilihan Anda.',invalid_body:'Data pilihan tidak valid.',candidate_not_found:'Kandidat tidak ditemukan.',not_locked:'Pemilihan belum siap dibuka.',not_open:'Pemungutan suara sedang ditutup.',already_voted:'Anda sudah memilih.',rate_limited:'Terlalu banyak percobaan. Coba kembali nanti.',audit_tip_changed:'Pemilihan sedang menerima suara lain. Coba lagi.',auto_register_failed:'Pendaftaran otomatis gagal. Muat ulang halaman.'};
const sheet=document.querySelector('#ballot-sheet'),backdrop=document.querySelector('#sheet-backdrop'),listStep=document.querySelector('#sheet-list'),confirmStep=document.querySelector('#sheet-confirm'),continueBtn=document.querySelector('#sheet-continue'),sendBtn=document.querySelector('#send-vote'),msg=document.querySelector('#vote-error');
let selected=null;
let sheetSequence=0;
const reducedMotion=window.matchMedia('(prefers-reduced-motion: reduce)');
const stopMotion=()=>{sheet.getAnimations().forEach(animation=>animation.cancel());backdrop.getAnimations().forEach(animation=>animation.cancel())};
const openSheet=()=>{
  sheetSequence++;
  stopMotion();
  sheet.hidden=false;backdrop.hidden=false;
  document.body.style.overflow='hidden';
  showList();
  if(!reducedMotion.matches){
    sheet.animate([{transform:'translateY(100%)'},{transform:'translateY(0)'}],{duration:380,easing:'cubic-bezier(0.16, 1, 0.3, 1)'});
    backdrop.animate([{opacity:0},{opacity:1}],{duration:300,easing:'ease-out'});
  }
  (sheet.querySelector('input[name="candidate"]')??continueBtn).focus();
};
const closeSheet=async(restoreFocus=true)=>{
  if(sheet.hidden)return;
  const sequence=++sheetSequence;
  stopMotion();
  if(!reducedMotion.matches){
    const panel=sheet.animate([{transform:'translateY(0)'},{transform:'translateY(100%)'}],{duration:210,easing:'cubic-bezier(0.4, 0, 1, 1)'});
    const shade=backdrop.animate([{opacity:1},{opacity:0}],{duration:190,easing:'ease-in'});
    await Promise.all([panel.finished.catch(()=>{}),shade.finished.catch(()=>{})]);
  }
  if(sequence!==sheetSequence)return;
  sheet.hidden=true;backdrop.hidden=true;
  document.body.style.overflow='';
  if(restoreFocus)document.querySelector('#open-ballot').focus();
};
const showList=()=>{listStep.hidden=false;confirmStep.hidden=true;msg.textContent=''};
const showConfirm=()=>{listStep.hidden=true;confirmStep.hidden=false;msg.textContent='';sendBtn.focus()};
document.querySelector('#open-ballot').addEventListener('click',openSheet);
document.querySelector('#sheet-cancel').addEventListener('click',()=>closeSheet());
backdrop.addEventListener('click',()=>closeSheet());
continueBtn.addEventListener('click',()=>{if(selected)showConfirm()});
document.querySelector('#confirm-back').addEventListener('click',showList);
sheet.querySelectorAll('input[name="candidate"]').forEach((radio)=>{radio.addEventListener('change',()=>{selected={id:Number(radio.value),nickname:radio.dataset.nickname,number:radio.dataset.number};continueBtn.disabled=false;document.querySelector('#confirm-name').textContent=`${selected.nickname} (no. ${selected.number})`})});
sheet.addEventListener('keydown',e=>{if(e.key==='Escape'){e.preventDefault();closeSheet();return}if(e.key!=='Tab')return;const controls=[...sheet.querySelectorAll('input:not([disabled]),button:not([disabled])')].filter(el=>!el.closest('[hidden]'));if(!controls.length)return;const first=controls[0],last=controls.at(-1);if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus()}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}});
sendBtn.addEventListener('click',async()=>{if(!selected)return;sendBtn.disabled=true;msg.textContent='Mengirim suara…';try{const r=await fetch('/api/votes',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({candidate_id:selected.id,confirmation_text:selected.nickname})});const d=await r.json();if(r.status===201&&typeof d.receipt_code==='string'){const code=d.receipt_code;await closeSheet(false);document.querySelector('#ballot-entry').hidden=true;document.querySelector('#receipt-code').textContent=code;document.querySelector('#receipt-link').href='/surat-suara#'+encodeURIComponent(code);document.querySelector('#success').hidden=false;document.querySelector('#copy-code').focus();try{localStorage.setItem('ppij_receipt_code',code)}catch{document.querySelector('#storage-warning').hidden=false}try{localStorage.setItem('ppij_receipt_choice',JSON.stringify({nickname:selected.nickname,number:Number(selected.number),receiptCode:code}))}catch{}return}if(r.status===409&&d.error==='already_voted'){location.assign('/surat-suara');return}msg.textContent=errors[d.error]||'Suara belum dapat dikirim. Coba kembali.'}catch{msg.textContent='Koneksi bermasalah. Periksa jaringan lalu coba kembali.'}sendBtn.disabled=false});
document.querySelector('#copy-code').addEventListener('click',async()=>{try{await navigator.clipboard.writeText(document.querySelector('#receipt-code').textContent);document.querySelector('#copy-code').textContent='Tersalin'}catch{document.querySelector('#copy-code').textContent='Salin manual'}});
</script>}
</Base>
