---
import { env } from "cloudflare:workers";
import { IconBoxMultiple } from "@tabler/icons-astro";
import Base from "../layouts/Base.astro";
import { SESSION_COOKIE,openSession } from "../server/auth/session";
import { getEligibility } from "../server/voting/vote";
import type { Bindings } from "../server/app";
const bindings=env as unknown as Bindings; const raw=Astro.cookies.get(SESSION_COOKIE)?.value; const session=raw&&bindings.APP_MASTER_KEY?await openSession(raw,bindings.APP_MASTER_KEY):null;
let eligibility:any={allowed:false,reason:session?"unavailable":"not_logged_in",fresh_login_needed:!session,stage:null};
try { eligibility=await getEligibility(bindings.DB,session); } catch {}
let candidates:any[]=[];try{candidates=(await bindings.DB.prepare("SELECT id,number,nickname,name,komsat_path,color FROM candidates ORDER BY number").all()).results??[]}catch{}
const reasons:Record<string,string>={out_of_scope:"Keanggotaan Anda berada di luar cakupan pemilihan.",not_in_roll:"Nama Anda tidak tercantum dalam daftar pemilih yang telah dibekukan.",not_active:"Status keanggotaan Anda belum aktif.",admin_voting_not_allowed:"Admin Voting tidak diperbolehkan memberikan suara.",already_voted:"Anda sudah memilih.",auto_register_failed:"Pendaftaran otomatis gagal. Muat ulang halaman dan coba lagi."};
let previewMode=false;try{previewMode=((await bindings.DB.prepare("SELECT preview_mode FROM elections ORDER BY id LIMIT 1").first<{preview_mode:number}>())?.preview_mode===1)}catch{}
---
<Base title="Pilih Suara · PPIJ Pemilu">
  <div class="mb-6"><h1 class="text-3xl font-bold tracking-tight">Pilih Suara</h1><p class="mt-2 text-muted-foreground">Pilih satu kandidat. Setelah dikirim, suara tidak dapat diubah.</p>{previewMode && <p class="mt-3 inline-flex rounded-full border border-amber-200 bg-amber-50 px-3 py-1 text-sm font-semibold text-amber-800">Mode uji coba — suara akan dihapus saat pemilihan dikunci</p>}</div>
  {!session ? <section class="rounded-xl border border-border bg-card p-5 shadow-sm sm:p-6"><h2 class="text-xl font-semibold">Masuk untuk memilih</h2><p class="mt-2 text-muted-foreground">Silakan masuk menggunakan PPIJ One Login untuk melanjutkan.</p><a href="/api/auth/login?return_to=/pilih-suara" class="mt-5 inline-flex min-h-11 items-center rounded-md bg-primary px-4 font-semibold text-primary-foreground hover:bg-primary-hover">Masuk</a></section>
  : eligibility.fresh_login_needed ? <section class="rounded-xl border border-amber-200 bg-amber-50 p-5 sm:p-6"><h2 class="text-xl font-semibold">Masuk ulang</h2><p class="mt-2">Untuk keamanan, silakan masuk kembali sebelum memilih.</p><a href="/api/auth/login?max_age=600&return_to=/pilih-suara" class="mt-5 inline-flex min-h-11 items-center rounded-md bg-primary px-4 font-semibold text-primary-foreground hover:bg-primary-hover">Masuk ulang</a></section>
  : reasons[eligibility.reason] ? <section class="rounded-xl border border-border bg-card p-5 shadow-sm sm:p-6"><h2 class="text-xl font-semibold">{eligibility.reason==="already_voted" ? "Anda sudah memilih" : "Belum dapat memilih"}</h2><p class="mt-2 text-muted-foreground">{reasons[eligibility.reason]}</p>{eligibility.reason==="already_voted" && <a class="mt-5 inline-flex min-h-11 items-center rounded-md bg-primary px-4 font-semibold text-primary-foreground hover:bg-primary-hover" href="/surat-suara">Buka Bukti Suara</a>}</section>
  : eligibility.stage === "draft" || eligibility.reason === "not_locked" ? <section class="rounded-xl border border-border bg-card p-5 shadow-sm sm:p-6"><h2 class="text-xl font-semibold">Pemilihan masih dalam persiapan.</h2><p class="mt-2 text-muted-foreground">Tunggu pengumuman panitia sebelum memberikan suara.</p></section>
  : !eligibility.stage || eligibility.reason === "unavailable" || eligibility.reason === "no_election" ? <section class="rounded-xl border border-border bg-card p-5 shadow-sm sm:p-6"><h2 class="text-xl font-semibold">Informasi pemilihan belum tersedia</h2><p class="mt-2 text-muted-foreground">Silakan coba kembali nanti.</p></section>
  : eligibility.stage !== "open" ? <section class="rounded-xl border border-border bg-card p-5 shadow-sm sm:p-6"><h2 class="text-xl font-semibold">{eligibility.stage==="scheduled" ? "Pemilihan terjadwal" : "Pemungutan suara sudah ditutup"}</h2><p class="mt-2 text-muted-foreground">{eligibility.stage==="scheduled" ? "Pemungutan suara belum dimulai. Silakan kembali saat jadwal dibuka." : "Saat ini pemungutan suara tidak dibuka."}</p></section>
  : <>
    <section id="ballot-entry" class="rounded-xl border border-border bg-card p-6 text-center shadow-sm sm:p-8">
      <img src="/voting-ballot-box.svg" alt="" class="mx-auto size-20" width="80" height="80" />
      <h2 class="mt-4 text-xl font-semibold">Siap memilih?</h2>
      <button id="open-ballot" type="button" class="mx-auto mt-5 inline-flex min-h-11 items-center gap-2 rounded-md bg-primary px-6 font-semibold text-primary-foreground hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-ring"><IconBoxMultiple size={19} stroke={1.8} aria-hidden="true" />Buka surat suara</button>
    </section>

    <div id="sheet-backdrop" hidden class="fixed inset-0 z-20 bg-foreground/40"></div>
    <section id="ballot-sheet" hidden role="dialog" aria-modal="true" aria-labelledby="sheet-title" class="fixed inset-x-0 bottom-0 z-30 mx-auto max-h-[85dvh] w-full max-w-lg overflow-auto rounded-t-xl border border-border bg-card p-5 pb-[max(1.25rem,env(safe-area-inset-bottom))] shadow-2xl">
      <div class="mx-auto mb-4 h-1 w-10 rounded-full bg-border" aria-hidden="true"></div>
      <div id="sheet-list">
        <h2 id="sheet-title" class="text-xl font-semibold">Pilih satu kandidat</h2>
        <p class="mt-1 text-sm text-muted-foreground">Periksa nomor dan nama sebelum melanjutkan.</p>
        <div class="mt-4 grid gap-2" role="radiogroup" aria-label="Kandidat">
          {candidates.map((c)=><label class="flex min-h-16 cursor-pointer items-center gap-3 rounded-xl border border-border bg-card p-3 transition has-[:checked]:border-brand-400 has-[:checked]:bg-brand-50/60 hover:bg-accent"><input type="radio" name="candidate" class="peer sr-only" value={c.id} data-nickname={c.nickname} data-number={c.number}/><span class="flex size-10 shrink-0 items-center justify-center rounded-full font-bold text-white" style={`background-color:${c.color||'#334155'}`}>{c.number}</span><span class="min-w-0 flex-1"><strong class="block">{c.nickname}</strong><span class="block truncate text-sm text-muted-foreground">{c.name}</span></span><span class="size-5 shrink-0 rounded-full border-2 border-input peer-checked:border-primary peer-checked:border-4" aria-hidden="true"></span></label>)}
        </div>
        <div class="mt-5 flex gap-3"><button id="sheet-continue" type="button" disabled class="min-h-11 flex-1 rounded-md bg-primary px-4 font-semibold text-primary-foreground hover:bg-primary-hover disabled:opacity-50 focus-visible:outline-2 focus-visible:outline-ring">Lanjut</button><button id="sheet-cancel" type="button" class="min-h-11 rounded-md border border-border bg-card px-4 font-semibold hover:bg-accent focus-visible:outline-2 focus-visible:outline-ring">Batal</button></div>
      </div>
      <div id="sheet-confirm" hidden>
        <h2 class="text-xl font-semibold">Konfirmasi pilihan</h2>
        <p class="mt-2 text-muted-foreground">Pilihan Anda: <strong id="confirm-name" class="text-foreground"></strong>.</p>
        <p class="mt-1 text-sm text-muted-foreground">Pastikan sudah sesuai. Suara tidak dapat diubah setelah dikirim.</p>
        <p id="vote-error" class="mt-3 text-sm text-destructive" role="status"></p>
        <div class="mt-4 flex flex-wrap gap-3 border-t border-border pt-4"><button id="send-vote" type="button" class="min-h-11 flex-1 rounded-md bg-primary px-4 font-semibold text-primary-foreground hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-ring">Kirim suara</button><button id="confirm-back" type="button" class="min-h-11 rounded-md border border-border bg-card px-4 font-semibold hover:bg-accent focus-visible:outline-2 focus-visible:outline-ring">Ubah pilihan</button></div>
      </div>
    </section>

    <section id="success" hidden class="mt-6 rounded-xl bg-emerald-50 p-5 sm:p-6"><h2 class="text-2xl font-semibold text-emerald-900">Suara Anda sudah masuk</h2><p class="mt-2 text-sm text-emerald-900">Simpan kode ini agar Anda bisa memeriksa surat suara nanti. Jika data peramban dihapus, kode tidak dapat dipulihkan.</p><p id="receipt-code" class="mt-4 break-all rounded-md bg-card p-4 font-mono text-base font-bold tracking-wide"></p><p id="storage-warning" hidden class="mt-2 text-sm text-amber-900">Peramban tidak dapat menyimpan kode ini. Salin sekarang.</p><div class="mt-4 flex flex-wrap gap-3"><button id="copy-code" type="button" class="min-h-11 rounded-md border border-emerald-300 bg-card px-4 font-semibold hover:bg-emerald-100 focus-visible:outline-2 focus-visible:outline-ring">Salin kode</button><a id="receipt-link" class="inline-flex min-h-11 items-center rounded-md bg-primary px-4 font-semibold text-primary-foreground hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-ring">Periksa kode</a></div></section>

    <script is:inline>
const errors={belum_masuk:'Silakan masuk kembali.',stale_session:'Sesi masuk tidak valid. Silakan masuk kembali.',out_of_scope:'Anda berada di luar cakupan pemilihan.',not_in_roll:'Nama Anda tidak tercantum pada daftar pemilih.',not_active:'Status keanggotaan Anda belum aktif.',admin_voting_not_allowed:'Admin Voting tidak diperbolehkan memilih.',origin_tidak_diizinkan:'Permintaan tidak dapat diverifikasi. Muat ulang halaman.',confirmation_mismatch:'Konfirmasi tidak cocok. Buka ulang pilihan Anda.',invalid_body:'Data pilihan tidak valid.',candidate_not_found:'Kandidat tidak ditemukan.',not_locked:'Pemilihan belum siap dibuka.',not_open:'Pemungutan suara sedang ditutup.',already_voted:'Anda sudah memilih.',rate_limited:'Terlalu banyak percobaan. Coba kembali nanti.',audit_tip_changed:'Pemilihan sedang menerima suara lain. Coba lagi.',auto_register_failed:'Pendaftaran otomatis gagal. Muat ulang halaman.'};
const sheet=document.querySelector('#ballot-sheet'),backdrop=document.querySelector('#sheet-backdrop'),listStep=document.querySelector('#sheet-list'),confirmStep=document.querySelector('#sheet-confirm'),continueBtn=document.querySelector('#sheet-continue'),sendBtn=document.querySelector('#send-vote'),msg=document.querySelector('#vote-error');
let selected=null;
let sheetSequence=0;
const reducedMotion=window.matchMedia('(prefers-reduced-motion: reduce)');
const stopMotion=()=>{sheet.getAnimations().forEach(animation=>animation.cancel());backdrop.getAnimations().forEach(animation=>animation.cancel())};
const openSheet=()=>{
  sheetSequence++;
  stopMotion();
  sheet.hidden=false;backdrop.hidden=false;
  document.body.style.overflow='hidden';
  showList();
  if(!reducedMotion.matches){
    sheet.animate([{transform:'translateY(100%)'},{transform:'translateY(0)'}],{duration:380,easing:'cubic-bezier(0.16, 1, 0.3, 1)'});
    backdrop.animate([{opacity:0},{opacity:1}],{duration:300,easing:'ease-out'});
  }
  (sheet.querySelector('input[name="candidate"]')??continueBtn).focus();
};
const closeSheet=async(restoreFocus=true)=>{
  if(sheet.hidden)return;
  const sequence=++sheetSequence;
  stopMotion();
  if(!reducedMotion.matches){
    const panel=sheet.animate([{transform:'translateY(0)'},{transform:'translateY(100%)'}],{duration:210,easing:'cubic-bezier(0.4, 0, 1, 1)'});
    const shade=backdrop.animate([{opacity:1},{opacity:0}],{duration:190,easing:'ease-in'});
    await Promise.all([panel.finished.catch(()=>{}),shade.finished.catch(()=>{})]);
  }
  if(sequence!==sheetSequence)return;
  sheet.hidden=true;backdrop.hidden=true;
  document.body.style.overflow='';
  if(restoreFocus)document.querySelector('#open-ballot').focus();
};
const showList=()=>{listStep.hidden=false;confirmStep.hidden=true;msg.textContent=''};
const showConfirm=()=>{listStep.hidden=true;confirmStep.hidden=false;msg.textContent='';sendBtn.focus()};
document.querySelector('#open-ballot').addEventListener('click',openSheet);
document.querySelector('#sheet-cancel').addEventListener('click',()=>closeSheet());
backdrop.addEventListener('click',()=>closeSheet());
continueBtn.addEventListener('click',()=>{if(selected)showConfirm()});
document.querySelector('#confirm-back').addEventListener('click',showList);
sheet.querySelectorAll('input[name="candidate"]').forEach((radio)=>{radio.addEventListener('change',()=>{selected={id:Number(radio.value),nickname:radio.dataset.nickname,number:radio.dataset.number};continueBtn.disabled=false;document.querySelector('#confirm-name').textContent=`${selected.nickname} (no. ${selected.number})`})});
sheet.addEventListener('keydown',e=>{if(e.key==='Escape'){e.preventDefault();closeSheet();return}if(e.key!=='Tab')return;const controls=[...sheet.querySelectorAll('input:not([disabled]),button:not([disabled])')].filter(el=>!el.closest('[hidden]'));if(!controls.length)return;const first=controls[0],last=controls.at(-1);if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus()}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}});
sendBtn.addEventListener('click',async()=>{if(!selected)return;sendBtn.disabled=true;msg.textContent='Mengirim suara…';try{const r=await fetch('/api/votes',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({candidate_id:selected.id,confirmation_text:selected.nickname})});const d=await r.json();if(r.status===201&&typeof d.receipt_code==='string'){const code=d.receipt_code;await closeSheet(false);document.querySelector('#ballot-entry').hidden=true;document.querySelector('#receipt-code').textContent=code;document.querySelector('#receipt-link').href='/surat-suara#'+encodeURIComponent(code);document.querySelector('#success').hidden=false;document.querySelector('#copy-code').focus();try{localStorage.setItem('ppij_receipt_code',code)}catch{document.querySelector('#storage-warning').hidden=false}try{localStorage.setItem('ppij_receipt_choice',JSON.stringify({nickname:selected.nickname,number:Number(selected.number),receiptCode:code}))}catch{}return}if(r.status===409&&d.error==='already_voted'){location.assign('/surat-suara');return}msg.textContent=errors[d.error]||'Suara belum dapat dikirim. Coba kembali.'}catch{msg.textContent='Koneksi bermasalah. Periksa jaringan lalu coba kembali.'}sendBtn.disabled=false});
document.querySelector('#copy-code').addEventListener('click',async()=>{try{await navigator.clipboard.writeText(document.querySelector('#receipt-code').textContent);document.querySelector('#copy-code').textContent='Tersalin'}catch{document.querySelector('#copy-code').textContent='Salin manual'}});
</script></>}
</Base>
