---
import { env } from "cloudflare:workers";
import Base from "../layouts/Base.astro";
import { SESSION_COOKIE,openSession } from "../server/auth/session";
import { getEligibility } from "../server/voting/vote";
import type { Bindings } from "../server/app";
const bindings=env as unknown as Bindings; const raw=Astro.cookies.get(SESSION_COOKIE)?.value; const session=raw&&bindings.APP_MASTER_KEY?await openSession(raw,bindings.APP_MASTER_KEY):null;
let eligibility:any={allowed:false,reason:session?"unavailable":"not_logged_in",fresh_login_needed:!session,stage:null};
try { eligibility=await getEligibility(bindings.DB,session); } catch {}
let candidates:any[]=[];try{candidates=(await bindings.DB.prepare("SELECT id,number,nickname,name,komsat_path,color FROM candidates ORDER BY number").all()).results??[]}catch{}
const reasons:Record<string,string>={out_of_scope:"Keanggotaan Anda berada di luar cakupan pemilihan.",not_in_roll:"Nama Anda tidak tercantum dalam daftar pemilih yang telah dibekukan.",not_active:"Status keanggotaan Anda belum aktif.",admin_voting_not_allowed:"Admin Voting tidak diperbolehkan memberikan suara.",already_voted:"Anda sudah memilih."};
---
<Base title="Pilih Suara · PPIJ Pemilu"><h1 class="text-3xl font-bold tracking-tight">Pilih Suara</h1><p class="mt-2 text-slate-600">Satu suara untuk pemilihan yang rahasia.</p>
{!session?<section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-semibold">Masuk untuk memilih</h2><p class="mt-2 text-slate-600">Silakan masuk menggunakan PPIJ One Login untuk melanjutkan.</p><a href="/api/auth/login" class="mt-5 inline-flex min-h-11 items-center rounded-lg bg-brand-700 px-4 font-semibold text-white">Masuk</a></section>
:eligibility.fresh_login_needed?<section class="mt-6 rounded-2xl border border-amber-200 bg-amber-50 p-6"><h2 class="text-xl font-semibold">Masuk ulang</h2><p class="mt-2">Untuk keamanan, silakan masuk kembali sebelum memilih.</p><a href="/api/auth/login?max_age=600" class="mt-5 inline-flex min-h-11 items-center rounded-lg bg-brand-700 px-4 font-semibold text-white">Masuk ulang</a></section>
:reasons[eligibility.reason]?<section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-semibold">{eligibility.reason==="already_voted"?"Anda sudah memilih":"Belum dapat memilih"}</h2><p class="mt-2 text-slate-600">{reasons[eligibility.reason]}</p>{eligibility.reason==="already_voted"&&<a class="mt-5 inline-flex min-h-11 items-center rounded-lg bg-brand-700 px-4 font-semibold text-white" href="/surat-suara">Buka Bukti Suara</a>}</section>
:eligibility.stage!=="open"?<section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-semibold">{eligibility.stage==="scheduled"?"Pemilihan terjadwal":"Pemungutan suara sudah ditutup"}</h2><p class="mt-2 text-slate-600">{eligibility.stage==="scheduled"?"Pemungutan suara belum dimulai. Silakan kembali saat jadwal dibuka.":"Saat ini pemungutan suara tidak dibuka."}</p></section>
:<><div class="mt-6 grid gap-3">{candidates.map((c)=><button type="button" data-candidate={c.id} data-nickname={c.nickname} class="candidate-card flex min-h-20 w-full items-center gap-4 rounded-2xl border border-slate-200 bg-white p-4 text-left shadow-sm"><span class="flex size-12 shrink-0 items-center justify-center rounded-full font-bold text-white" style={`background-color:${c.color||'#334155'}`}>{c.number}</span><span><strong class="block text-lg">{c.nickname}</strong><span class="text-sm text-slate-600">{c.name} · {c.komsat_path}</span></span><span class="ml-auto size-5 rounded-full border border-slate-400" aria-hidden="true"></span></button>)}</div>
<section id="confirm" hidden class="fixed inset-x-0 bottom-0 z-20 mx-auto max-w-3xl rounded-t-2xl border border-slate-200 bg-white p-5 shadow-2xl"><h2 class="text-xl font-bold">Konfirmasi pilihan</h2><p class="mt-2 text-slate-600">Ketik nickname kandidat untuk mengonfirmasi: <strong id="chosen"></strong></p><label class="mt-4 block text-sm font-medium" for="confirm-name">Nickname kandidat</label><input id="confirm-name" autocomplete="off" class="mt-1 min-h-12 w-full rounded-lg border border-slate-300 px-3"/><p id="vote-error" class="mt-2 text-sm text-red-700" role="status"></p><div class="mt-4 flex gap-3"><button id="send-vote" disabled class="min-h-11 flex-1 rounded-lg bg-brand-700 px-4 font-semibold text-white disabled:opacity-50">Kirim Suara</button><button id="cancel-vote" class="min-h-11 rounded-lg border px-4">Batal</button></div></section><section id="success" hidden class="mt-6 rounded-2xl border border-emerald-200 bg-white p-6"><h2 class="text-2xl font-bold text-emerald-800">Suara berhasil dikirim</h2><p class="mt-2 text-slate-600">Simpan kode bukti ini. Kode hanya ditampilkan pada halaman ini.</p><p id="receipt-code" class="mt-4 break-all rounded-lg bg-slate-100 p-4 font-mono text-lg font-bold tracking-wider"></p><div class="mt-4 flex flex-wrap gap-3"><button id="copy-code" class="min-h-11 rounded-lg border px-4 font-semibold">Salin</button><a id="receipt-link" class="inline-flex min-h-11 items-center rounded-lg bg-brand-700 px-4 font-semibold text-white">Buka Bukti Suara</a></div></section>
<script is:inline>
const errors={belum_masuk:'Silakan masuk kembali.',stale_session:'Sesi masuk telah kedaluwarsa. Silakan masuk kembali.',out_of_scope:'Anda berada di luar cakupan pemilihan.',not_in_roll:'Nama Anda tidak tercantum pada daftar pemilih.',not_active:'Status keanggotaan Anda belum aktif.',admin_voting_not_allowed:'Admin Voting tidak diperbolehkan memilih.',origin_tidak_diizinkan:'Permintaan tidak dapat diverifikasi. Muat ulang halaman.',confirmation_mismatch:'Nickname tidak cocok.',invalid_body:'Data pilihan tidak valid.',candidate_not_found:'Kandidat tidak ditemukan.',not_locked:'Pemilihan belum siap dibuka.',not_open:'Pemungutan suara sedang ditutup.',already_voted:'Anda sudah memilih.',rate_limited:'Terlalu banyak percobaan. Coba kembali nanti.'};let selected=null;const panel=document.querySelector('#confirm'),input=document.querySelector('#confirm-name'),send=document.querySelector('#send-vote'),msg=document.querySelector('#vote-error');document.querySelectorAll('.candidate-card').forEach(b=>b.addEventListener('click',()=>{selected=b;document.querySelector('#chosen').textContent=b.dataset.nickname;input.value='';msg.textContent='';send.disabled=true;panel.hidden=false;input.focus()}));input.addEventListener('input',()=>send.disabled=!selected||input.value.trim().toLocaleLowerCase('id')!==selected.dataset.nickname.trim().toLocaleLowerCase('id'));document.querySelector('#cancel-vote').addEventListener('click',()=>panel.hidden=true);send.addEventListener('click',async()=>{if(!selected||send.disabled)return;send.disabled=true;msg.textContent='';try{const r=await fetch('/api/votes',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({candidate_id:Number(selected.dataset.candidate),confirmation_text:input.value.trim()})});const d=await r.json();if(r.status===201&&typeof d.receipt_code==='string'){localStorage.setItem('ppij_receipt_code',d.receipt_code);document.querySelector('#receipt-code').textContent=d.receipt_code;document.querySelector('#receipt-link').href='/surat-suara#'+encodeURIComponent(d.receipt_code);panel.hidden=true;document.querySelectorAll('.candidate-card').forEach(x=>x.hidden=true);document.querySelector('#success').hidden=false;return}if(r.status===409&&d.error==='already_voted'){location.assign('/surat-suara');return}msg.textContent=errors[d.error]||'Suara belum dapat dikirim. Coba kembali.'}catch{msg.textContent='Koneksi bermasalah. Periksa jaringan lalu coba kembali.'}send.disabled=input.value.trim().toLocaleLowerCase('id')!==selected.dataset.nickname.trim().toLocaleLowerCase('id')});document.querySelector('#copy-code').addEventListener('click',async()=>{try{await navigator.clipboard.writeText(document.querySelector('#receipt-code').textContent);document.querySelector('#copy-code').textContent='Tersalin'}catch{document.querySelector('#copy-code').textContent='Salin manual'}});
</script></>}
</Base>
