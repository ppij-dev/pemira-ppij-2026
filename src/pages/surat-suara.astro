---
import { env } from "cloudflare:workers";
import { IconChevronDown, IconCopy, IconEye, IconEyeOff, IconInfoCircle, IconRosetteDiscountCheck } from "@tabler/icons-astro";
import Base from "../layouts/Base.astro";
import { SESSION_COOKIE, openSession } from "../server/auth/session";
import { getVoteMe } from "../server/voting/vote";
import type { Bindings } from "../server/app";

const bindings = env as unknown as Bindings;
const raw = Astro.cookies.get(SESSION_COOKIE)?.value;
const session = raw && bindings.APP_MASTER_KEY ? await openSession(raw, bindings.APP_MASTER_KEY) : null;
let votedAt: string | null = null;
if (session) try { votedAt = (await getVoteMe(bindings.DB, session)).voted_at; } catch {}
const votedAtJst = votedAt ? new Intl.DateTimeFormat("id-ID", { timeZone: "Asia/Tokyo", dateStyle: "long", timeStyle: "short" }).format(new Date(votedAt)) + " JST" : null;
---
<Base title="Bukti Suara · PPIJ Pemilu">
  <div class="mb-7">
    <h1 class="text-3xl font-bold tracking-tight">Bukti Suara</h1>
    <p class="mt-2 max-w-prose text-muted-foreground">Simpan kode bukti Anda untuk memeriksa surat suara kapan saja.</p>
  </div>

  {votedAtJst && <section class="vote-ticket mx-auto mb-6 max-w-md" aria-label="Bukti suara Anda">
    <div class="bg-brand-800 px-6 pb-7 pt-6 text-white">
      <div class="flex items-center justify-between gap-3">
        <span class="text-xs font-bold tracking-widest">BUKTI SUARA</span>
        <IconRosetteDiscountCheck size={27} stroke={1.7} aria-hidden="true" />
      </div>
      <h2 class="mt-8 text-2xl font-bold tracking-tight">Anda sudah memilih</h2>
      <p class="mt-1 text-sm text-white/90">Tercatat pada {votedAtJst}</p>
    </div>
    <div class="px-6 py-5">
      <div id="choice-summary" hidden class="flex items-center justify-between gap-3">
        <div class="min-w-0"><p class="text-xs font-semibold text-muted-foreground">Pilihan di perangkat ini</p><p id="choice-text" class="mt-1 break-words text-lg font-semibold" aria-live="polite">••••••••</p></div>
        <button id="toggle-choice" type="button" aria-label="Tampilkan pilihan kandidat" aria-pressed="false" class="flex size-11 shrink-0 items-center justify-center rounded-md border border-border bg-card text-foreground hover:bg-accent focus-visible:outline-2 focus-visible:outline-ring">
          <IconEye size={21} stroke={1.8} data-eye-show aria-hidden="true" />
          <IconEyeOff size={21} stroke={1.8} data-eye-hide hidden aria-hidden="true" />
        </button>
      </div>
      <p id="choice-unavailable" hidden class="text-sm text-muted-foreground">Pilihan kandidat tidak tersimpan di perangkat ini.</p>
    </div>
    <div class="vote-ticket__tear" aria-hidden="true"></div>
    <div class="px-6 pb-6 pt-5">
      <h3 class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">Kode bukti</h3>
      <code id="ticket-code" hidden class="mt-2 block break-all font-mono text-base font-bold tracking-wide"></code>
      <p id="ticket-code-missing" class="mt-2 text-sm text-muted-foreground">Kode tidak tersedia di perangkat ini.</p>
      <button id="ticket-copy-code" hidden type="button" data-copy-receipt class="mt-4 inline-flex min-h-11 items-center gap-2 rounded-md border border-border px-4 font-semibold hover:bg-accent focus-visible:outline-2 focus-visible:outline-ring"><IconCopy size={18} aria-hidden="true" />Salin kode</button>
    </div>
  </section>}

  <section id="saved-code-card" hidden class="mb-6 rounded-xl border border-border bg-card p-5 shadow-sm sm:p-6">
    <h2 class="text-lg font-semibold">Kode di perangkat ini</h2>
    <p class="mt-1 text-sm text-muted-foreground">Salin kode untuk menyimpannya di tempat lain. Kode ini tidak dapat dipulihkan jika data peramban dihapus.</p>
    <div class="mt-3 flex flex-wrap items-center gap-3">
      <code id="saved-code" class="min-w-0 break-all rounded-md bg-muted px-4 py-3 font-mono text-base font-semibold tracking-wide"></code>
      <button type="button" data-copy-receipt class="inline-flex min-h-11 items-center gap-2 rounded-md border border-border bg-card px-4 font-semibold hover:bg-accent focus-visible:outline-2 focus-visible:outline-ring"><IconCopy size={18} stroke={1.8} aria-hidden="true" />Salin kode</button>
    </div>
  </section>

  <details id="manual-check" class="group rounded-xl border border-border bg-card p-5 shadow-sm sm:p-6">
    <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 focus-visible:outline-2 focus-visible:outline-ring [&::-webkit-details-marker]:hidden">
      <span><span class="block text-lg font-semibold">Periksa kode yang Anda simpan</span><span class="mt-1 block text-sm text-muted-foreground">Untuk kode Anda dari perangkat lain atau salinan pribadi.</span></span>
      <IconChevronDown size={21} class="shrink-0 transition-transform group-open:rotate-180" aria-hidden="true" />
    </summary>
    <div class="mt-5 border-t border-border pt-4">
      <p class="max-w-prose text-sm leading-6 text-muted-foreground">Pemeriksaan ini hanya menunjukkan apakah surat suara tercatat. Pilihan kandidat tidak ditampilkan.</p>
      <label for="receipt-input" class="mt-4 block text-sm font-semibold">Kode bukti</label>
      <div class="mt-2 flex flex-col gap-3 sm:flex-row sm:items-start">
        <input id="receipt-input" autocomplete="off" autocapitalize="characters" spellcheck="false" inputmode="text" placeholder="XXXX-XXXX-XXXX-XXXX" aria-describedby="receipt-help" class="min-h-12 w-full min-w-0 rounded-md border border-input bg-card px-3 font-mono text-sm uppercase focus-visible:outline-2 focus-visible:outline-ring" />
        <button id="check-receipt" type="button" class="min-h-12 shrink-0 rounded-md bg-primary px-5 font-semibold text-primary-foreground hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-ring disabled:opacity-60">Periksa kode</button>
      </div>
      <p id="receipt-help" class="mt-2 text-xs text-muted-foreground">Tanda hubung dan huruf besar atau kecil boleh diabaikan.</p>
      <div id="receipt-result" hidden class="mt-4 rounded-lg p-4 text-sm font-medium" role="status" aria-live="polite"></div>
    </div>
  </details>

  <section class="mt-6 rounded-xl border border-amber-200 bg-amber-50 p-5 text-amber-900 sm:p-6" aria-labelledby="privacy-title">
    <div class="flex items-start gap-3">
      <IconInfoCircle size={22} stroke={1.8} class="mt-0.5 shrink-0 text-amber-600" aria-hidden="true" />
      <div>
        <h2 id="privacy-title" class="text-base font-semibold">Informasi untuk anda</h2>
        <p class="mt-3 text-sm leading-6">Demi melaksanakan pemilihan yang Langsung Umum Bebas dan Rahasia, Sistem menerapkan mekanisme surat suara tanpa nama pemilih, terenkripsi dan terhitung jelas.</p>
        <p class="mt-3 text-sm leading-6">Namun ada beberapa hal sebagai informasi anda:</p>
        <ul class="mt-2 list-disc space-y-2 pl-5 text-sm leading-6 marker:text-amber-600">
          <li>Server tidak mengetahui anda memilih kandidat apa, nama kandidat yang anda lihat di halaman ini, tersimpan di perangkat anda (Login di perangkat baru akan menunjukkan kandidat kosong).</li>
          <li>Surat suara terenkripsi di database. Pencarian Kode bukti hanya berlaku di halaman ini.</li>
        </ul>
        <p class="mt-3 text-sm font-semibold">Terimakasih sudah berpartisipasi!</p>
      </div>
    </div>
  </section>

  <script is:inline>
    const alphabet = '0123456789ABCDEFGHJKMNPQRSTVWXYZ';
    function normalize(value) {
      const code = value.toUpperCase().replace(/[\s\-_.]+/g, '').replace(/O/g, '0').replace(/[IL]/g, '1');
      return (code.length === 26 || code.length === 16) && [...code].every(char => alphabet.includes(char)) ? code : null;
    }
    const input = document.querySelector('#receipt-input');
    const result = document.querySelector('#receipt-result');
    const checkButton = document.querySelector('#check-receipt');
    function showResult(tone, message) {
      const classes = tone === 'ok' ? 'bg-emerald-50 text-emerald-900' : tone === 'miss' ? 'bg-amber-50 text-amber-900' : tone === 'loading' ? 'bg-muted text-foreground' : 'bg-red-50 text-red-900';
      result.className = 'mt-4 rounded-lg p-4 text-sm font-medium ' + classes;
      result.textContent = message;
      result.hidden = false;
    }
    async function runCheck() {
      const code = normalize(input.value);
      if (!code) { showResult('error', 'Periksa kembali kode. Masukkan seluruh huruf dan angka dari kode bukti Anda.'); return; }
      checkButton.disabled = true;
      showResult('loading', 'Memeriksa kode…');
      try {
        const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(code));
        const receipt_hash = [...new Uint8Array(digest)].map(byte => byte.toString(16).padStart(2, '0')).join('');
        const response = await fetch('/api/votes/receipt-check', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ receipt_hash }) });
        if (response.status === 429) { showResult('error', 'Terlalu banyak pemeriksaan. Coba lagi dalam satu menit.'); return; }
        if (!response.ok) throw new Error('check failed');
        const data = await response.json();
        showResult(data.found ? 'ok' : 'miss', data.found ? 'Surat suara dengan kode ini tercatat.' : 'Kode tidak ditemukan. Periksa lagi setiap karakter pada kode bukti.');
      } catch { showResult('error', 'Kode belum dapat diperiksa. Periksa koneksi, lalu coba lagi.'); }
      finally { checkButton.disabled = false; }
    }
    checkButton.addEventListener('click', runCheck);
    input.addEventListener('keydown', event => { if (event.key === 'Enter') runCheck(); });
    let fragmentCode = '';
    let savedCode = '';
    let savedChoice = null;
    try {
      fragmentCode = decodeURIComponent(location.hash.slice(1));
      if (fragmentCode) history.replaceState(null, '', location.pathname + location.search);
    } catch {}
    try {
      savedCode = localStorage.getItem('ppij_receipt_code') || '';
      savedChoice = JSON.parse(localStorage.getItem('ppij_receipt_choice') || 'null');
    } catch {}
    const displayCode = fragmentCode || savedCode;
    input.value = displayCode;
    const ticketCode = document.querySelector('#ticket-code');
    if (displayCode && ticketCode) {
      ticketCode.textContent = displayCode;
      ticketCode.hidden = false;
      document.querySelector('#ticket-code-missing').hidden = true;
      document.querySelector('#ticket-copy-code').hidden = false;
    } else if (displayCode) {
      document.querySelector('#saved-code').textContent = displayCode;
      document.querySelector('#saved-code-card').hidden = false;
    }
    document.querySelector('#manual-check').open = !displayCode || Boolean(fragmentCode);
    if (document.querySelector('#choice-summary')) {
      const matchingChoice = savedChoice && displayCode && savedChoice.receiptCode === displayCode && typeof savedChoice.nickname === 'string' && Number.isInteger(savedChoice.number);
      if (matchingChoice) {
        const choiceText = document.querySelector('#choice-text');
        const toggle = document.querySelector('#toggle-choice');
        document.querySelector('#choice-summary').hidden = false;
        toggle.addEventListener('click', () => {
          const revealed = toggle.getAttribute('aria-pressed') === 'true';
          toggle.setAttribute('aria-pressed', String(!revealed));
          toggle.setAttribute('aria-label', revealed ? 'Tampilkan pilihan kandidat' : 'Sembunyikan pilihan kandidat');
          choiceText.textContent = revealed ? '••••••••' : savedChoice.nickname + ' · No. ' + savedChoice.number;
          toggle.querySelector('[data-eye-show]').hidden = !revealed;
          toggle.querySelector('[data-eye-hide]').hidden = revealed;
        });
      } else document.querySelector('#choice-unavailable').hidden = false;
    }
    if (fragmentCode) runCheck();
    document.querySelectorAll('[data-copy-receipt]').forEach(button => button.addEventListener('click', async event => {
      try { await navigator.clipboard.writeText(displayCode); event.currentTarget.textContent = 'Kode tersalin'; }
      catch { event.currentTarget.textContent = 'Salin manual'; }
    }));
  </script>
</Base>
