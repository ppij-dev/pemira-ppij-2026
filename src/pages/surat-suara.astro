---
import { env } from "cloudflare:workers";
import { IconChevronDown, IconCopy, IconEye, IconEyeOff, IconRosetteDiscountCheck, IconShieldLock } from "@tabler/icons-astro";
import Base from "../layouts/Base.astro";
import Button from "../components/ui/Button.astro";
import Callout from "../components/ui/Callout.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import PanelCard from "../components/ui/PanelCard.astro";
import { SESSION_COOKIE, openSession } from "../server/auth/session";
import { getVoteMe } from "../server/voting/vote";
import type { Bindings } from "../server/app";

const bindings = env as unknown as Bindings;
const raw = Astro.request.headers.get("cookie") ?? Astro.cookies.get(SESSION_COOKIE)?.value;
const session = raw && bindings.APP_MASTER_KEY ? await openSession(raw, bindings.APP_MASTER_KEY) : null;
let votedAt: string | null = null;
if (session) try { votedAt = (await getVoteMe(bindings.DB, session)).voted_at; } catch {}
const votedAtJst = votedAt ? new Intl.DateTimeFormat("id-ID", { timeZone: "Asia/Tokyo", dateStyle: "long", timeStyle: "short" }).format(new Date(votedAt)) + " JST" : null;
---
<Base title="Bukti Suara · PPIJ Pemilu">
  <PageHeader eyebrow="Pemilih" title="Bukti Suara" description="Simpan kode bukti Anda untuk memeriksa surat suara kapan saja. Pemeriksaan tidak menampilkan pilihan kandidat." />

  <div class="mt-5 grid gap-4">
    {votedAtJst && <section class="vote-ticket mx-auto w-full max-w-md" aria-label="Bukti suara Anda">
      <div class="bg-brand-800 px-6 pt-5 pb-6 text-white">
        <div class="flex items-center justify-between gap-3">
          <span class="text-[11px] font-bold tracking-[0.14em] uppercase">Bukti suara</span>
          <IconRosetteDiscountCheck size={26} stroke={1.7} aria-hidden="true" />
        </div>
        <h2 class="mt-6 text-2xl font-bold tracking-tight">Anda sudah memilih</h2>
        <p class="mt-1 text-sm text-white/90">Tercatat pada {votedAtJst}</p>
      </div>
      <div class="px-6 py-5">
        <div id="choice-summary" hidden class="flex items-center justify-between gap-3">
          <div class="min-w-0"><p class="text-xs font-semibold text-brand-muted">Pilihan di perangkat ini</p><p id="choice-text" class="mt-1 break-words text-lg font-bold text-brand-ink" aria-live="polite">••••••••</p></div>
          <Button id="toggle-choice" type="button" variant="secondary" size="icon" aria-label="Tampilkan pilihan kandidat" aria-pressed="false">
            <IconEye size={20} stroke={1.8} data-eye-show aria-hidden="true" />
            <IconEyeOff size={20} stroke={1.8} data-eye-hide hidden aria-hidden="true" />
          </Button>
        </div>
        <p id="choice-unavailable" hidden class="text-sm text-brand-muted">Pilihan kandidat tidak tersimpan di perangkat ini.</p>
      </div>
      <div class="vote-ticket__tear" aria-hidden="true"></div>
      <div class="px-6 pt-5 pb-6">
        <h3 class="text-[11px] font-bold tracking-[0.14em] text-brand-muted uppercase">Kode bukti</h3>
        <code id="ticket-code" hidden class="mt-2 block font-mono text-base font-bold tracking-wide break-all text-brand-ink"></code>
        <p id="ticket-code-missing" class="mt-2 text-sm text-brand-muted">Kode tidak tersedia di perangkat ini.</p>
        <Button id="ticket-copy-code" type="button" variant="secondary" size="sm" class="mt-4" hidden><IconCopy size={18} stroke={1.8} aria-hidden="true" />Salin kode</Button>
      </div>
    </section>}

    <div id="saved-code-card" hidden>
      <PanelCard title="Kode di perangkat ini" description="Salin kode untuk menyimpannya di tempat lain. Kode ini tidak dapat dipulihkan jika data peramban dihapus.">
        <div class="flex flex-wrap items-center gap-3">
          <code id="saved-code" class="min-w-0 rounded-lg bg-muted px-3.5 py-2.5 font-mono text-sm font-semibold tracking-wide break-all text-brand-ink"></code>
          <Button type="button" variant="secondary" size="sm" data-copy-receipt><IconCopy size={18} stroke={1.8} aria-hidden="true" />Salin kode</Button>
        </div>
      </PanelCard>
    </div>

    <details id="manual-check" class="group rounded-xl border border-brand-border bg-card">
      <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-3 p-[17px] focus-visible:outline-2 focus-visible:outline-ring [&::-webkit-details-marker]:hidden">
        <span class="min-w-0"><span class="block text-sm font-bold text-brand-ink">Periksa kode yang Anda simpan</span><span class="mt-0.5 block text-xs text-brand-muted">Untuk kode Anda dari perangkat lain atau salinan pribadi.</span></span>
        <IconChevronDown size={21} class="shrink-0 text-brand-muted transition-transform group-open:rotate-180" aria-hidden="true" />
      </summary>
      <div class="border-t border-brand-border p-[17px]">
        <p class="max-w-prose text-[13px] leading-5 text-brand-muted">Pemeriksaan ini hanya menunjukkan apakah surat suara tercatat. Pilihan kandidat tidak ditampilkan.</p>
        <label for="receipt-input" class="mt-4 block text-xs font-semibold text-brand-muted">Kode bukti</label>
        <div class="mt-1.5 flex flex-col gap-3 sm:flex-row sm:items-start">
          <input id="receipt-input" autocomplete="off" autocapitalize="characters" spellcheck="false" inputmode="text" placeholder="XXXX-XXXX-XXXX-XXXX" aria-describedby="receipt-help" class="min-h-12 w-full min-w-0 rounded-lg border border-input bg-card px-3 font-mono text-sm uppercase focus-visible:outline-2 focus-visible:outline-ring" />
          <Button id="check-receipt" type="button" class="shrink-0">Periksa kode</Button>
        </div>
        <p id="receipt-help" class="mt-2 text-xs text-brand-muted">Tanda hubung serta huruf besar atau kecil boleh diabaikan.</p>
        <div id="receipt-result" hidden class="mt-4 rounded-lg p-4 text-sm font-medium" role="status" aria-live="polite"></div>
      </div>
    </details>

    <section id="tentang-kerahasiaan" class="scroll-mt-20" aria-label="Tentang kerahasiaan suara Anda">
      <PanelCard title="Tentang kerahasiaan suara Anda" description="Prinsip Langsung, Umum, Bebas, dan Rahasia dijaga oleh rancangan sistem." icon={IconShieldLock} headingLevel={2}>
        <div class="space-y-3 text-[13px] leading-6 text-brand-ink">
          <p>Sistem mencatat partisipasi Anda dan surat suara secara terpisah. Surat suara tidak memuat nama pemilih, sehingga jumlah pemilih yang berpartisipasi dan jumlah surat suara tetap dapat diperiksa.</p>
          <ul class="grid list-disc gap-2 pl-5 marker:text-brand-border">
            <li><strong>Pilihan kandidat dan kode bukti yang tampil di halaman ini disimpan di peramban perangkat Anda.</strong> Jika data peramban dihapus atau Anda masuk dari perangkat lain, keduanya tidak tampil otomatis. Simpan salinan kode bukti Anda.</li>
            <li>Server menyimpan hash kode bukti, bukan kode aslinya. Masukkan kode di halaman ini untuk memeriksa apakah surat suara tercatat; pemeriksaan tidak menampilkan pilihan kandidat.</li>
          </ul>
          <p class="font-semibold text-brand-ink">Terima kasih sudah berpartisipasi.</p>
        </div>
      </PanelCard>
    </section>

    {!votedAtJst && <Callout tone="info" title="Belum ada catatan suara pada akun ini">Setelah Anda mengirim suara, kode bukti muncul sekali di halaman Pilih Suara. Simpan kode itu, lalu periksa di sini.</Callout>}
  </div>

  <script is:inline>
    const alphabet = '0123456789ABCDEFGHJKMNPQRSTVWXYZ';
    function normalize(value) {
      const code = value.toUpperCase().replace(/[\s\-_.]+/g, '').replace(/O/g, '0').replace(/[IL]/g, '1');
      return (code.length === 26 || code.length === 16) && [...code].every(char => alphabet.includes(char)) ? code : null;
    }
    const input = document.querySelector('#receipt-input');
    const result = document.querySelector('#receipt-result');
    const checkButton = document.querySelector('#check-receipt');
    function showResult(tone, message) {
      const classes = tone === 'ok' ? 'bg-emerald-50 text-emerald-900' : tone === 'miss' ? 'bg-amber-50 text-amber-900' : tone === 'loading' ? 'bg-muted text-brand-ink' : 'bg-red-50 text-red-900';
      result.className = 'mt-4 rounded-lg p-4 text-sm font-medium ' + classes;
      result.textContent = message;
      result.hidden = false;
    }
    async function runCheck() {
      const code = normalize(input.value);
      if (!code) { showResult('error', 'Periksa kembali kode. Masukkan seluruh huruf dan angka dari kode bukti Anda.'); return; }
      checkButton.disabled = true;
      showResult('loading', 'Memeriksa kode…');
      try {
        const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(code));
        const receipt_hash = [...new Uint8Array(digest)].map(byte => byte.toString(16).padStart(2, '0')).join('');
        const response = await fetch('/api/votes/receipt-check', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ receipt_hash }) });
        if (response.status === 429) { showResult('error', 'Terlalu banyak pemeriksaan. Coba lagi dalam satu menit.'); return; }
        if (!response.ok) throw new Error('check failed');
        const data = await response.json();
        showResult(data.found ? 'ok' : 'miss', data.found ? 'Surat suara dengan kode ini tercatat.' : 'Kode tidak ditemukan. Periksa lagi setiap karakter pada kode bukti.');
      } catch { showResult('error', 'Kode belum dapat diperiksa. Periksa koneksi, lalu coba lagi.'); }
      finally { checkButton.disabled = false; }
    }
    checkButton.addEventListener('click', runCheck);
    input.addEventListener('keydown', event => { if (event.key === 'Enter') runCheck(); });
    let fragmentCode = '';
    let savedCode = '';
    let savedChoice = null;
    try {
      fragmentCode = decodeURIComponent(location.hash.slice(1));
      if (fragmentCode) history.replaceState(null, '', location.pathname + location.search);
    } catch {}
    try {
      savedCode = localStorage.getItem('ppij_receipt_code') || '';
      savedChoice = JSON.parse(localStorage.getItem('ppij_receipt_choice') || 'null');
    } catch {}
    const displayCode = fragmentCode || savedCode;
    input.value = displayCode;
    const ticketCode = document.querySelector('#ticket-code');
    if (displayCode && ticketCode) {
      ticketCode.textContent = displayCode;
      ticketCode.hidden = false;
      document.querySelector('#ticket-code-missing').hidden = true;
      document.querySelector('#ticket-copy-code').hidden = false;
    } else if (displayCode) {
      document.querySelector('#saved-code').textContent = displayCode;
      document.querySelector('#saved-code-card').hidden = false;
    }
    document.querySelector('#manual-check').open = !displayCode || Boolean(fragmentCode);
    if (document.querySelector('#choice-summary')) {
      const matchingChoice = savedChoice && displayCode && savedChoice.receiptCode === displayCode && typeof savedChoice.nickname === 'string' && Number.isInteger(savedChoice.number);
      if (matchingChoice) {
        const choiceText = document.querySelector('#choice-text');
        const toggle = document.querySelector('#toggle-choice');
        document.querySelector('#choice-summary').hidden = false;
        toggle.addEventListener('click', () => {
          const revealed = toggle.getAttribute('aria-pressed') === 'true';
          toggle.setAttribute('aria-pressed', String(!revealed));
          toggle.setAttribute('aria-label', revealed ? 'Tampilkan pilihan kandidat' : 'Sembunyikan pilihan kandidat');
          choiceText.textContent = revealed ? '••••••••' : savedChoice.nickname + ' · No. ' + savedChoice.number;
          toggle.querySelector('[data-eye-show]').hidden = !revealed;
          toggle.querySelector('[data-eye-hide]').hidden = revealed;
        });
      } else document.querySelector('#choice-unavailable').hidden = false;
    }
    if (fragmentCode) runCheck();
    document.querySelectorAll('[data-copy-receipt]').forEach(button => button.addEventListener('click', async event => {
      try { await navigator.clipboard.writeText(displayCode); event.currentTarget.textContent = 'Kode tersalin'; }
      catch { event.currentTarget.textContent = 'Salin manual'; }
    }));
  </script>
</Base>
