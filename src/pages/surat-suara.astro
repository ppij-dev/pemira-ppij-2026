---
import { env } from "cloudflare:workers";
import Base from "../layouts/Base.astro";
import { SESSION_COOKIE,openSession } from "../server/auth/session";
import { getVoteMe } from "../server/voting/vote";
import type { Bindings } from "../server/app";
const b=env as unknown as Bindings;const raw=Astro.cookies.get(SESSION_COOKIE)?.value;const session=raw&&b.APP_MASTER_KEY?await openSession(raw,b.APP_MASTER_KEY):null;let votedAt:string|null=null;if(session)try{votedAt=(await getVoteMe(b.DB,session)).voted_at}catch{}
---
<Base title="Bukti Suara · PPIJ Pemilu">
  <div class="mb-6"><p class="text-sm font-semibold text-primary">VERIFIKASI</p><h1 class="mt-1 text-3xl font-bold tracking-tight">Bukti Suara</h1><p class="mt-2 text-muted-foreground">Periksa apakah bukti suara tercatat tanpa mengungkap pilihan Anda.</p></div>
  {votedAt && <p class="mb-5 rounded-xl border border-border bg-card p-4 text-sm text-muted-foreground">Anda memilih pada {new Intl.DateTimeFormat("id-ID",{timeZone:"Asia/Tokyo",dateStyle:"long",timeStyle:"short"}).format(new Date(votedAt))} JST.</p>}
  <section class="rounded-xl border border-border bg-card p-5 shadow-sm sm:p-6"><h2 class="text-lg font-semibold">Periksa kode bukti</h2><p class="mt-2 text-sm leading-6 text-muted-foreground">Masukkan kode dari layar sukses atau tempelkan kode yang tersimpan di perangkat Anda. Demi keamanan, kode tidak ditampilkan kembali di sini.</p><label for="receipt-input" class="mt-5 block text-sm font-semibold">Kode bukti</label><input id="receipt-input" autocomplete="off" spellcheck="false" class="mt-1 min-h-12 w-full rounded-md border border-input bg-card px-3 font-mono focus-visible:outline-2 focus-visible:outline-ring"/><div class="mt-4"><button id="check-receipt" type="button" class="min-h-11 rounded-md bg-primary px-5 font-semibold text-primary-foreground hover:bg-primary-hover">Periksa</button></div><p id="receipt-status" class="mt-4 text-sm" role="status" aria-live="polite"></p></section>
  <a class="mt-5 inline-flex min-h-11 items-center font-semibold text-primary underline" href="/papan-bukti">Lihat papan bukti pemilihan</a>
  <script is:inline>
const alphabet='0123456789ABCDEFGHJKMNPQRSTVWXYZ';function normalize(s){const v=s.toUpperCase().replace(/[ -]/g,'');return v.length===26&&[...v].every(c=>alphabet.includes(c))?v:null}const input=document.querySelector('#receipt-input'),status=document.querySelector('#receipt-status');try{const hash=decodeURIComponent(location.hash.slice(1));if(hash)input.value=hash;else{const saved=localStorage.getItem('ppij_receipt_code');if(saved)input.value=saved}}catch{}document.querySelector('#check-receipt').addEventListener('click',async()=>{const code=normalize(input.value);if(!code){status.textContent='Kode harus terdiri dari 26 karakter yang valid.';return}status.textContent='Memeriksa kode…';try{const r=await fetch('/api/votes/receipt-check',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({code})});const d=await r.json();status.textContent=r.ok&&d.found?'Surat suara tercatat di kotak suara pemilihan ini.':r.ok?'Kode tidak ditemukan — periksa ketikan ulang.':'Pemeriksaan belum berhasil. Coba kembali.'}catch{status.textContent='Koneksi bermasalah. Coba kembali.'}});
</script></Base>
