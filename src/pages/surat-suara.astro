---
import { env } from "cloudflare:workers";
import { IconCopy, IconEye, IconEyeOff, IconInfoCircle, IconRosetteDiscountCheck } from "@tabler/icons-astro";
import Base from "../layouts/Base.astro";
import { SESSION_COOKIE, openSession } from "../server/auth/session";
import { getVoteMe } from "../server/voting/vote";
import { stage as getStage, type Stage } from "../server/lib/stage";
import type { Bindings } from "../server/app";

const bindings = env as unknown as Bindings;
const raw = Astro.cookies.get(SESSION_COOKIE)?.value;
const session = raw && bindings.APP_MASTER_KEY ? await openSession(raw, bindings.APP_MASTER_KEY) : null;
let votedAt: string | null = null;
if (session) try { votedAt = (await getVoteMe(bindings.DB, session)).voted_at; } catch {}
let currentStage: Stage | null = null;
try {
  const election = await bindings.DB.prepare("SELECT status_lock,opens_at,closes_at,closed_early_at FROM elections ORDER BY id LIMIT 1").first<any>();
  currentStage = election?.opens_at && election?.closes_at ? getStage(election, Date.now()) : "draft";
} catch {}
const boardReady = currentStage === "closed" || currentStage === "published";
const votedAtJst = votedAt ? new Intl.DateTimeFormat("id-ID", { timeZone: "Asia/Tokyo", dateStyle: "long", timeStyle: "short" }).format(new Date(votedAt)) + " JST" : null;
---
<Base title="Bukti Suara · PPIJ Pemilu">
  <div class="mb-7">
    <h1 class="text-3xl font-bold tracking-tight">Bukti Suara</h1>
    <p class="mt-2 max-w-prose text-muted-foreground">Gunakan kode bukti untuk memastikan surat suara masuk ke kotak suara.</p>
  </div>

  {votedAtJst && <section class="mb-6 rounded-xl bg-emerald-50 p-5 sm:p-6" aria-label="Status suara Anda">
    <div class="flex items-start gap-3">
      <IconRosetteDiscountCheck size={26} stroke={1.7} class="mt-0.5 shrink-0 text-emerald-800" aria-hidden="true" />
      <div><h2 class="text-lg font-semibold text-emerald-950">Anda sudah memilih</h2><p class="mt-0.5 text-sm text-emerald-900">Tercatat pada {votedAtJst}.</p></div>
    </div>
    <div id="choice-summary" hidden class="mt-5 flex items-center justify-between gap-3 border-t border-emerald-200 pt-4">
      <div class="min-w-0"><p class="text-xs font-semibold text-emerald-900">Pilihan di perangkat ini</p><p id="choice-text" class="mt-0.5 break-words text-base font-semibold text-emerald-950" aria-live="polite">••••••••</p></div>
      <button id="toggle-choice" type="button" aria-label="Tampilkan pilihan kandidat" aria-pressed="false" class="flex size-11 shrink-0 items-center justify-center rounded-md border border-emerald-300 bg-white text-emerald-900 hover:bg-emerald-100 focus-visible:outline-2 focus-visible:outline-ring">
        <IconEye size={21} stroke={1.8} data-eye-show aria-hidden="true" />
        <IconEyeOff size={21} stroke={1.8} data-eye-hide hidden aria-hidden="true" />
      </button>
    </div>
    <p id="choice-unavailable" hidden class="mt-4 border-t border-emerald-200 pt-3 text-sm text-emerald-900">Pilihan kandidat tidak tersimpan di perangkat ini.</p>
  </section>}

  <section id="saved-code-card" hidden class="mb-6 rounded-xl border border-border bg-card p-5 shadow-sm sm:p-6">
    <h2 class="text-lg font-semibold">Kode di perangkat ini</h2>
    <p class="mt-1 text-sm text-muted-foreground">Salin kode untuk menyimpannya di tempat lain. Kode ini tidak dapat dipulihkan jika data peramban dihapus.</p>
    <div class="mt-3 flex flex-wrap items-center gap-3">
      <code id="saved-code" class="min-w-0 break-all rounded-md bg-muted px-4 py-3 font-mono text-base font-semibold tracking-wide"></code>
      <button id="copy-code" type="button" class="inline-flex min-h-11 items-center gap-2 rounded-md border border-border bg-card px-4 font-semibold hover:bg-accent focus-visible:outline-2 focus-visible:outline-ring"><IconCopy size={18} stroke={1.8} aria-hidden="true" />Salin kode</button>
    </div>
  </section>

  <section class="rounded-xl border border-border bg-card p-5 shadow-sm sm:p-6">
    <h2 class="text-xl font-semibold">Periksa kode bukti</h2>
    <p class="mt-1 max-w-prose text-sm leading-6 text-muted-foreground">Masukkan 26 karakter dari kode yang Anda terima setelah memilih. Pemeriksaan ini hanya menunjukkan apakah surat suara tercatat.</p>
    <label for="receipt-input" class="mt-5 block text-sm font-semibold">Kode bukti</label>
    <div class="mt-2 flex flex-col gap-3 sm:flex-row sm:items-start">
      <input id="receipt-input" autocomplete="off" autocapitalize="characters" spellcheck="false" inputmode="text" placeholder="XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XX" aria-describedby="receipt-help" class="min-h-12 w-full min-w-0 rounded-md border border-input bg-card px-3 font-mono text-sm uppercase focus-visible:outline-2 focus-visible:outline-ring" />
      <button id="check-receipt" type="button" class="min-h-12 shrink-0 rounded-md bg-primary px-5 font-semibold text-primary-foreground hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-ring disabled:opacity-60">Periksa kode</button>
    </div>
    <p id="receipt-help" class="mt-2 text-xs text-muted-foreground">Tanda hubung dan huruf besar atau kecil boleh diabaikan.</p>
    <div id="receipt-result" hidden class="mt-4 rounded-lg p-4 text-sm font-medium" role="status" aria-live="polite"></div>
  </section>

  <section class="mt-6 rounded-xl bg-brand-50 p-5 text-brand-900 sm:p-6" aria-labelledby="privacy-title">
    <div class="flex items-start gap-3">
      <IconInfoCircle size={22} stroke={1.8} class="mt-0.5 shrink-0" aria-hidden="true" />
      <div>
        <h2 id="privacy-title" class="text-base font-semibold">Privasi pilihan Anda</h2>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 marker:text-brand-600">
          <li>Tampilan ulang pilihan memakai data yang tersimpan di perangkat ini.</li>
          <li>Catatan bahwa Anda memilih disimpan terpisah dari surat suara. Tidak ada catatan nama Anda beserta kandidat pilihan.</li>
          <li>Surat suara menyimpan kandidat dan hash kode bukti, bukan kode aslinya.</li>
        </ul>
      </div>
    </div>
  </section>

  {boardReady
    ? <a class="mt-6 inline-flex min-h-11 items-center font-semibold text-primary underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-ring" href="/papan-bukti">Lihat papan bukti</a>
    : <p class="mt-6 text-sm text-muted-foreground">Papan bukti dibuka setelah pemungutan suara ditutup.</p>}

  <script is:inline>
    const alphabet = '0123456789ABCDEFGHJKMNPQRSTVWXYZ';
    function normalize(value) {
      const code = value.toUpperCase().replace(/[\s\-_.]+/g, '').replace(/O/g, '0').replace(/[IL]/g, '1');
      return (code.length === 26 || code.length === 16) && [...code].every(char => alphabet.includes(char)) ? code : null;
    }
    const input = document.querySelector('#receipt-input');
    const result = document.querySelector('#receipt-result');
    const checkButton = document.querySelector('#check-receipt');
    function showResult(tone, message) {
      const classes = tone === 'ok' ? 'bg-emerald-50 text-emerald-900' : tone === 'miss' ? 'bg-amber-50 text-amber-900' : tone === 'loading' ? 'bg-muted text-foreground' : 'bg-red-50 text-red-900';
      result.className = 'mt-4 rounded-lg p-4 text-sm font-medium ' + classes;
      result.textContent = message;
      result.hidden = false;
    }
    async function runCheck() {
      const code = normalize(input.value);
      if (!code) { showResult('error', 'Periksa kembali kode. Masukkan seluruh huruf dan angka dari kode bukti Anda.'); return; }
      checkButton.disabled = true;
      showResult('loading', 'Memeriksa kode…');
      try {
        const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(code));
        const receipt_hash = [...new Uint8Array(digest)].map(byte => byte.toString(16).padStart(2, '0')).join('');
        const response = await fetch('/api/votes/receipt-check', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ receipt_hash }) });
        if (response.status === 429) { showResult('error', 'Terlalu banyak pemeriksaan. Coba lagi dalam satu menit.'); return; }
        if (!response.ok) throw new Error('check failed');
        const data = await response.json();
        showResult(data.found ? 'ok' : 'miss', data.found ? 'Surat suara dengan kode ini tercatat.' : 'Kode tidak ditemukan. Periksa lagi setiap karakter pada kode bukti.');
      } catch { showResult('error', 'Kode belum dapat diperiksa. Periksa koneksi, lalu coba lagi.'); }
      finally { checkButton.disabled = false; }
    }
    checkButton.addEventListener('click', runCheck);
    input.addEventListener('keydown', event => { if (event.key === 'Enter') runCheck(); });
    let fragmentCode = '';
    let savedCode = '';
    let savedChoice = null;
    try {
      fragmentCode = decodeURIComponent(location.hash.slice(1));
      if (fragmentCode) history.replaceState(null, '', location.pathname + location.search);
    } catch {}
    try {
      savedCode = localStorage.getItem('ppij_receipt_code') || '';
      savedChoice = JSON.parse(localStorage.getItem('ppij_receipt_choice') || 'null');
    } catch {}
    input.value = fragmentCode || savedCode;
    if (savedCode) {
      document.querySelector('#saved-code').textContent = savedCode;
      document.querySelector('#saved-code-card').hidden = false;
    }
    if (document.querySelector('#choice-summary')) {
      const matchingChoice = savedChoice && savedCode && savedChoice.receiptCode === savedCode && typeof savedChoice.nickname === 'string' && Number.isInteger(savedChoice.number);
      if (matchingChoice) {
        const choiceText = document.querySelector('#choice-text');
        const toggle = document.querySelector('#toggle-choice');
        document.querySelector('#choice-summary').hidden = false;
        toggle.addEventListener('click', () => {
          const revealed = toggle.getAttribute('aria-pressed') === 'true';
          toggle.setAttribute('aria-pressed', String(!revealed));
          toggle.setAttribute('aria-label', revealed ? 'Tampilkan pilihan kandidat' : 'Sembunyikan pilihan kandidat');
          choiceText.textContent = revealed ? '••••••••' : savedChoice.nickname + ' · No. ' + savedChoice.number;
          toggle.querySelector('[data-eye-show]').hidden = !revealed;
          toggle.querySelector('[data-eye-hide]').hidden = revealed;
        });
      } else document.querySelector('#choice-unavailable').hidden = false;
    }
    if (input.value) runCheck();
    document.querySelector('#copy-code').addEventListener('click', async event => {
      try { await navigator.clipboard.writeText(document.querySelector('#saved-code').textContent); event.currentTarget.textContent = 'Kode tersalin'; }
      catch { event.currentTarget.textContent = 'Salin manual'; }
    });
  </script>
</Base>
