---
import { env } from "cloudflare:workers";
import { IconCopy, IconRosetteDiscountCheck } from "@tabler/icons-astro";
import Base from "../layouts/Base.astro";
import { SESSION_COOKIE, openSession } from "../server/auth/session";
import { getVoteMe } from "../server/voting/vote";
import { stage as getStage, type Stage } from "../server/lib/stage";
import type { Bindings } from "../server/app";
const b=env as unknown as Bindings;const raw=Astro.cookies.get(SESSION_COOKIE)?.value;const session=raw&&b.APP_MASTER_KEY?await openSession(raw,b.APP_MASTER_KEY):null;
let votedAt:string|null=null;if(session)try{votedAt=(await getVoteMe(b.DB,session)).voted_at}catch{}
let currentStage:Stage|null=null;try{const election=await b.DB.prepare("SELECT status_lock,opens_at,closes_at,closed_early_at FROM elections ORDER BY id LIMIT 1").first<any>();currentStage=election?.opens_at&&election?.closes_at?getStage(election,Date.now()):"draft"}catch{}
const boardReady=currentStage==="closed"||currentStage==="published";
const votedAtJst=votedAt?new Intl.DateTimeFormat("id-ID",{timeZone:"Asia/Tokyo",dateStyle:"long",timeStyle:"short"}).format(new Date(votedAt))+" JST":null;
---
<Base title="Bukti Suara · PPIJ Pemilu">
  <div class="mb-6"><p class="text-sm font-semibold text-primary">VERIFIKASI</p><h1 class="mt-1 text-3xl font-bold tracking-tight">Bukti Suara</h1><p class="mt-2 text-muted-foreground">Periksa bahwa suara Anda tercatat — tanpa mengungkap pilihan Anda.</p></div>

  <section id="recorded-card" hidden class="rounded-xl border border-emerald-200 bg-emerald-50 p-5 sm:p-6">
    <div class="flex items-start gap-4">
      <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-800"><IconRosetteDiscountCheck size={26} stroke={1.7} aria-hidden="true" /></span>
      <div class="min-w-0">
        <h2 class="text-lg font-semibold text-emerald-900">Pilihan Anda sudah terekam</h2>
        <p id="choice-line" class="mt-1 text-sm font-semibold text-emerald-800"></p>
        {votedAtJst && <p class="mt-1 text-sm text-emerald-800/80">Dikirim pada {votedAtJst}.</p>}
        <p class="mt-2 text-xs leading-5 text-emerald-800/70">Catatan pilihan tersimpan hanya di perangkat ini; server tidak pernah menyimpan pilihan Anda.</p>
      </div>
    </div>
  </section>

  <section id="saved-code-card" hidden class="mt-4 rounded-xl border border-border bg-card p-5 shadow-sm sm:p-6">
    <h2 class="text-lg font-semibold">Kode bukti di perangkat ini</h2>
    <div class="mt-3 flex flex-wrap items-center gap-3">
      <p id="saved-code" class="min-w-0 break-all rounded-md bg-muted px-4 py-3 font-mono text-lg font-bold tracking-wider"></p>
      <button id="copy-code" type="button" class="inline-flex min-h-11 items-center gap-2 rounded-md border border-border bg-card px-4 font-semibold hover:bg-accent focus-visible:outline-2 focus-visible:outline-ring"><IconCopy size={18} stroke={1.8} aria-hidden="true" />Salin</button>
    </div>
    <p class="mt-2 text-xs text-muted-foreground">Kode ini tersimpan lokal dan sudah terisi pada pemeriksaan di bawah.</p>
  </section>

  <section class="mt-4 rounded-xl border border-border bg-card p-5 shadow-sm sm:p-6">
    <h2 class="text-lg font-semibold">Periksa kode bukti</h2>
    <p class="mt-1 text-sm leading-6 text-muted-foreground">Masukkan kode 16 karakter (0000-0000-0000-0000) untuk memastikan surat suara Anda tercatat di kotak suara.</p>
    <label for="receipt-input" class="mt-5 block text-sm font-semibold">Kode bukti</label>
    <div class="mt-1 flex flex-wrap gap-3">
      <input id="receipt-input" autocomplete="off" spellcheck="false" placeholder="0000-0000-0000-0000" class="min-h-12 w-full max-w-xs rounded-md border border-input bg-card px-3 font-mono focus-visible:outline-2 focus-visible:outline-ring"/>
      <button id="check-receipt" type="button" class="min-h-11 self-start rounded-md bg-primary px-5 font-semibold text-primary-foreground hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-ring">Periksa</button>
    </div>
    <div id="receipt-result" hidden class="mt-4 flex items-start gap-3 rounded-lg p-4 text-sm font-medium" role="status" aria-live="polite"></div>
  </section>

  {boardReady
    ? <a class="mt-5 inline-flex min-h-11 items-center font-semibold text-primary underline focus-visible:outline-2 focus-visible:outline-ring" href="/papan-bukti">Lihat papan bukti pemilihan</a>
    : <div class="mt-5"><button type="button" disabled class="inline-flex min-h-11 cursor-not-allowed items-center rounded-md border border-border bg-muted px-4 font-semibold text-muted-foreground opacity-70">Lihat papan bukti pemilihan</button><p class="mt-2 text-xs text-muted-foreground">Tersedia setelah pemungutan suara ditutup.</p></div>}

  <script is:inline>
const alphabet='0123456789ABCDEFGHJKMNPQRSTVWXYZ';function normalize(s){const v=s.toUpperCase().replace(/[ -]/g,'').replace(/O/g,'0').replace(/[IL]/g,'1');return v.length===16&&[...v].every(c=>alphabet.includes(c))?v:null}
const input=document.querySelector('#receipt-input'),result=document.querySelector('#receipt-result');
function showResult(tone,text){result.hidden=false;result.className=`mt-4 flex items-start gap-3 rounded-lg p-4 text-sm font-medium ${tone==='ok'?'bg-emerald-50 text-emerald-900':tone==='miss'?'bg-amber-50 text-amber-900':'bg-red-50 text-red-900'}`;result.innerHTML=`<span class="shrink-0">${tone==='ok'?'<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0-18 0"/><path d="M9 12l2 2l4 -4"/></svg>':tone==='miss'?'<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4"/><path d="M12 16v.01"/><path d="M10.24 3.957l-8.022 13.929a1.986 1.986 0 0 0 1.7 2.96h16.164a1.986 1.986 0 0 0 1.7-2.96l-8.022-13.93a1.986 1.986 0 0 0-3.4 0z"/></svg>':'<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0-18 0"/><path d="M15 9l-6 6"/><path d="M9 9l6 6"/></svg>'}</span><span>${text}</span>`}
async function runCheck(){const code=normalize(input.value);if(!code){showResult('err','Kode harus terdiri dari 16 karakter yang valid (tanpa I, L, O, U).');return}result.hidden=false;result.className='mt-4 flex items-start gap-3 rounded-lg p-4 text-sm font-medium bg-muted text-muted-foreground';result.innerHTML='<span>Memeriksa kode…</span>';try{const r=await fetch('/api/votes/receipt-check',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({code})});const d=await r.json();if(r.ok&&d.found)showResult('ok','Surat suara tercatat di kotak suara pemilihan ini.');else if(r.ok)showResult('miss','Kode tidak ditemukan — periksa kembali ketikan Anda. Kode yang salah tidak mengungkap pilihan suara.');else showResult('err','Pemeriksaan belum berhasil. Coba kembali.')}catch{showResult('err','Koneksi bermasalah. Periksa jaringan lalu coba kembali.')}}
document.querySelector('#check-receipt').addEventListener('click',runCheck);
input.addEventListener('keydown',e=>{if(e.key==='Enter')runCheck()});
const savedCodeCard=document.querySelector('#saved-code-card'),recordedCard=document.querySelector('#recorded-card');
let prefilled=false;
try{const hash=decodeURIComponent(location.hash.slice(1));const saved=localStorage.getItem('ppij_receipt_code');
if(hash)input.value=hash;else if(saved)input.value=saved||'';
prefilled=Boolean(input.value);
if(saved){document.querySelector('#saved-code').textContent=saved;savedCodeCard.hidden=false}
const savedChoice=JSON.parse(localStorage.getItem('ppij_receipt_choice')||'null');
if(savedChoice&&typeof savedChoice.nickname==='string'){document.querySelector('#choice-line').textContent=`Pilihan Anda untuk ${savedChoice.nickname} (no. ${savedChoice.number}) sudah terekam.`;recordedCard.hidden=false;savedCodeCard.hidden=false}
}catch{}
if(prefilled)runCheck();
document.querySelector('#copy-code').addEventListener('click',async()=>{try{await navigator.clipboard.writeText(document.querySelector('#saved-code').textContent);document.querySelector('#copy-code').textContent='Tersalin'}catch{document.querySelector('#copy-code').textContent='Salin manual'}});
</script></Base>
