---
import { env } from "cloudflare:workers";
import Base from "../../layouts/Base.astro";
const db=(env as unknown as {DB?:D1Database}).DB;
let candidates:any[]=[];
try { candidates=(await db?.prepare("SELECT number,nickname,name,komsat_path,color FROM candidates ORDER BY number").all()).results??[]; } catch { candidates=[]; }
---
<Base title="Kandidat · PPIJ Pemilu"><h1 class="text-3xl font-bold tracking-tight">Kandidat</h1><p class="mt-2 text-slate-600">Kenali para kandidat sebelum memberikan suara.</p>{candidates.length?<div class="mt-6 grid gap-4 sm:grid-cols-2">{candidates.map((c)=><a href={`/kandidat/${c.number}-${encodeURIComponent(c.nickname)}`} class="block rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-brand-400 focus-visible:outline-2 focus-visible:outline-brand-600"><div class="flex items-start gap-4"><span class="flex size-12 shrink-0 items-center justify-center rounded-full text-lg font-bold text-white" style={`background-color:${c.color||'#334155'}`}>{c.number}</span><div><h2 class="text-xl font-bold">{c.nickname}</h2><p class="mt-1 text-slate-700">{c.name}</p><p class="mt-2 text-sm text-slate-500">{c.komsat_path}</p></div></div></a>)}</div>:<section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6"><h2 class="text-lg font-semibold">Belum ada kandidat</h2><p class="mt-2 text-slate-600">Informasi kandidat akan tersedia di sini.</p></section>}</Base>
