---
import { env } from "cloudflare:workers";
import Base from "../../layouts/Base.astro";
const db=(env as unknown as {DB?:D1Database}).DB;
let candidates:any[]=[];
try { candidates=(await db?.prepare("SELECT number,nickname,name,komsat_path,color FROM candidates ORDER BY number").all()).results??[]; } catch { candidates=[]; }
---
<Base title="Kandidat · PPIJ Pemilu">
  <div class="mb-6"><p class="text-sm font-semibold text-primary">PEMILIHAN</p><h1 class="mt-1 text-3xl font-bold tracking-tight">Kandidat</h1><p class="mt-2 text-muted-foreground">Kenali para kandidat sebelum memberikan suara.</p></div>
  {candidates.length ? <div class="grid gap-4 sm:grid-cols-2">{candidates.map((c)=><a href={`/kandidat/${c.number}-${encodeURIComponent(c.nickname)}`} class="group overflow-hidden rounded-xl border border-border bg-card shadow-sm transition hover:border-brand-400 hover:shadow-md focus-visible:outline-2 focus-visible:outline-ring"><img src="/placeholder-candidate.png" alt="" class="h-40 w-full bg-background object-cover" /><div class="flex items-start gap-3 p-4 sm:p-5"><span class="flex size-11 shrink-0 items-center justify-center rounded-full font-bold text-white" style={`background-color:${c.color||'#334155'}`}>{c.number}</span><div><h2 class="text-xl font-semibold group-hover:text-primary">{c.nickname}</h2><p class="text-sm text-muted-foreground">{c.name}</p><p class="mt-2 text-xs text-muted-foreground">{c.komsat_path}</p></div></div></a>)}</div> : <section class="rounded-xl border border-border bg-card p-6 shadow-sm"><h2 class="text-lg font-semibold">Belum ada kandidat</h2><p class="mt-2 text-muted-foreground">Informasi kandidat akan tersedia di sini.</p></section>}
</Base>
