---
import { IconArrowLeft, IconBoxMultiple, IconUserSearch } from "@tabler/icons-astro";
import { env } from "cloudflare:workers";
import Base from "../../layouts/Base.astro";
import Button from "../../components/ui/Button.astro";
import Empty from "../../components/ui/Empty.astro";
import { stage } from "../../server/lib/stage";
import { unitNameOf, type UnitNames } from "../../lib/formatKomsat";
import { loadUnitNames } from "../../server/lib/units";
import { renderMarkdown } from "../../server/lib/markdown";
import { candidatePhotoSrc, PLACEHOLDER_CANDIDATE_PHOTO } from "../../lib/candidatePhoto";
import { resolveCandidateProfile } from "../../server/election/profile";
import { isSingleCandidateMode } from "../../server/election/mode";

const slug = Astro.params.slug ?? "";
const db = (env as unknown as { DB?: D1Database }).DB;
// Mode kandidat tunggal: profil hidup di /kandidat/<nickname> tanpa nomor urut.
// Mode biasa: /kandidat/<nomor>-<nickname> seperti sebelumnya.
const singleCandidateMode = db ? await isSingleCandidateMode(db) : false;
const candidate = db ? await resolveCandidateProfile(db, slug, singleCandidateMode) : null;
const election = await db?.prepare("SELECT status_lock,opens_at,closes_at,closed_early_at FROM elections ORDER BY id LIMIT 1").first<any>();
let isOpen = false;
if (election?.opens_at && election?.closes_at) {
  try {
    isOpen = stage(election, new Date().toISOString()) === "open";
  } catch {
    isOpen = false;
  }
}
const content = candidate?.description?.trim() ? renderMarkdown(candidate.description) : "";
let unitNames: UnitNames = {};
try { unitNames = db ? await loadUnitNames(db) : {}; } catch { unitNames = {}; }
const photoSrc = candidatePhotoSrc(candidate?.photo_key);
const hasCustomPhoto = photoSrc !== PLACEHOLDER_CANDIDATE_PHOTO;
// Deskripsi pratinjau berbagi: short_intro, atau paragraf teks pertama dari
// deskripsi Markdown tanpa penanda format.
const fallbackIntro = (candidate?.description ?? "")
  .split(/\n\s*\n/)
  .map((part) => part.trim())
  .find((part) => part && !part.startsWith("#") && !part.startsWith("-")) ?? "";
const plainIntro = fallbackIntro.replace(/[*_>`[\]()#-]/g, "").replace(/\s+/g, " ").trim().slice(0, 200);
const ogDescription = candidate?.short_intro?.trim() || plainIntro;
---

<Base title={candidate ? `${candidate.nickname} · Kandidat` : "Kandidat tidak ditemukan"} ogType="profile" ogImage={photoSrc} ogDescription={ogDescription}>
  <a href="/kandidat" class="mb-4 inline-flex min-h-11 items-center gap-2 rounded-lg text-sm font-semibold text-brand-red hover:underline focus-visible:outline-2 focus-visible:outline-ring">
    <IconArrowLeft size={18} stroke={1.8} aria-hidden="true" /> Semua Kandidat
  </a>

  {candidate ? <article class="min-w-0 overflow-hidden rounded-xl border border-brand-border bg-card">
    <div class="p-4 sm:p-6">
      <div class="grid grid-cols-[6.5rem_minmax(0,1fr)] items-start gap-x-5 sm:grid-cols-[minmax(0,1fr)_12rem] sm:gap-x-8">
        <figure class="col-start-1 row-start-1 sm:col-start-2 sm:row-span-2">
          {hasCustomPhoto ? (
            <button type="button" id="photo-zoom" aria-label="Perbesar foto kandidat" class="block w-full cursor-zoom-in overflow-hidden rounded-lg bg-muted focus-visible:outline-2 focus-visible:outline-ring">
              <img src={photoSrc} alt="" width="600" height="800" class="aspect-[3/4] w-full object-cover" />
            </button>
          ) : (
            <img src={photoSrc} alt="" width="600" height="800" class="aspect-[3/4] w-full rounded-lg bg-muted object-cover" />
          )}
          <figcaption class="mt-2 text-xs leading-5 text-brand-muted">{hasCustomPhoto ? "Ketuk untuk memperbesar" : "Foto belum tersedia"}</figcaption>
        </figure>
        <header class="col-start-2 row-start-1 min-w-0 sm:col-start-1">
          {!singleCandidateMode && <span class="inline-flex size-9 items-center justify-center rounded-full text-sm font-bold text-white" style={`background-color:${candidate.color || "#334155"}`}><span class="sr-only">Nomor urut </span>{candidate.number}</span>}
          <h1 class="mt-3 break-words text-[26px] leading-tight font-bold tracking-tight text-brand-ink sm:mt-4 sm:text-5xl">{candidate.name}</h1>
          <p class="mt-1 break-words text-base font-semibold text-brand-muted sm:mt-2 sm:text-xl">{candidate.nickname}</p>
          <p class="mt-3 break-words text-sm text-brand-muted sm:mt-4">Unit asal <span class="font-semibold text-brand-ink">{unitNameOf(candidate.komsat_path, unitNames)}</span></p>
        </header>
      </div>
    </div>

    <section aria-labelledby="profile-heading" class="border-t border-brand-border p-4 sm:p-6">
      <h2 id="profile-heading" class="text-xl font-bold tracking-tight text-brand-ink sm:text-2xl">Tentang kandidat</h2>
      {content
        ? <div class="markdown mt-3 max-w-[70ch] text-base leading-8 text-brand-ink sm:mt-4" set:html={content} />
        : <p class="mt-3 text-brand-muted">Deskripsi kandidat belum tersedia.</p>}
    </section>

    {isOpen && <footer class="border-t border-brand-border bg-background/60 p-4 sm:p-6">
      <Button href="/pilih-suara"><IconBoxMultiple size={19} stroke={1.8} aria-hidden="true" />Pilih Sekarang</Button>
      <p class="mt-2 text-xs text-brand-muted">Satu suara per anggota, dijaga kerahasiaannya. Pilihan Anda tidak ditampilkan di halaman ini.</p>
    </footer>}
  </article> : <Empty title="Kandidat tidak ditemukan" description="Data kandidat yang diminta tidak tersedia. Kembali ke daftar kandidat untuk melihat profil yang benar." icon={IconUserSearch}>
    <Button href="/kandidat" variant="secondary">Lihat daftar kandidat</Button>
  </Empty>}

  <div id="photo-lightbox" hidden role="dialog" aria-modal="true" aria-label="Foto kandidat diperbesar" class="fixed inset-0 z-40 flex items-center justify-center bg-foreground/80 p-4 backdrop-blur-sm">
    <button type="button" id="lightbox-close" aria-label="Tutup foto" class="absolute right-3 top-3 flex size-11 items-center justify-center rounded-full bg-card text-foreground shadow-md hover:bg-accent focus-visible:outline-2 focus-visible:outline-ring">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6l-12 12"/><path d="M6 6l12 12"/></svg>
    </button>
    <img id="lightbox-img" src={photoSrc} alt="" class="max-h-[88dvh] max-w-full rounded-lg object-contain shadow-2xl" />
  </div>

  <script is:inline>
document.addEventListener('click',(event)=>{const facade=event.target instanceof Element?event.target.closest('.markdown-video-facade'):null;if(!facade)return;const id=facade.dataset.videoId;if(!id)return;const iframe=document.createElement('iframe');iframe.src=`https://www.youtube.com/embed/${id}?autoplay=1`;iframe.title='Video kandidat';iframe.allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen';iframe.setAttribute('referrerpolicy','strict-origin-when-cross-origin');iframe.setAttribute('allowfullscreen','');facade.replaceWith(iframe)});
const zoom=document.querySelector('#photo-zoom'),lightbox=document.querySelector('#photo-lightbox'),lightboxClose=document.querySelector('#lightbox-close');
if(zoom&&lightbox){const open=()=>{lightbox.hidden=false;document.body.style.overflow='hidden';lightboxClose.focus()};const close=()=>{lightbox.hidden=true;document.body.style.overflow='';zoom.focus()};zoom.addEventListener('click',open);lightboxClose.addEventListener('click',close);lightbox.addEventListener('click',e=>{if(e.target===lightbox)close()});document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!lightbox.hidden)close()})}
</script>
</Base>
