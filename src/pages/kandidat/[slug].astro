---
import { env } from "cloudflare:workers";
import Base from "../../layouts/Base.astro";
import { stage } from "../../server/lib/stage";
const slug=Astro.params.slug??'';const match=/^(\d+)-(.+)$/.exec(slug);const db=(env as unknown as {DB?:D1Database}).DB;
const candidate=match?await db?.prepare('SELECT number,name,nickname,komsat_path,description,color FROM candidates WHERE number=? AND nickname=?').bind(Number(match[1]),decodeURIComponent(match[2])).first<any>():null;
const e=await db?.prepare('SELECT status_lock,opens_at,closes_at,closed_early_at FROM elections ORDER BY id LIMIT 1').first<any>();
let isOpen=false;if(e?.opens_at&&e?.closes_at){try{isOpen=stage(e,new Date().toISOString())==='open'}catch{isOpen=false}}
---
<Base title={candidate?`${candidate.nickname} · Kandidat`:"Kandidat tidak ditemukan"}>
  <a href="/kandidat" class="mb-5 inline-flex min-h-11 items-center font-semibold text-primary underline">Kembali ke Kandidat</a>
  {candidate ? <article class="overflow-hidden rounded-xl border border-border bg-card shadow-sm"><div class="grid md:grid-cols-2"><img src="/placeholder-candidate.png" alt="Ilustrasi kandidat" class="h-full max-h-[32rem] min-h-64 w-full bg-background object-cover"/><div class="p-5 sm:p-8"><span class="inline-flex size-12 items-center justify-center rounded-full text-lg font-bold text-white" style={`background-color:${candidate.color||'#334155'}`}>{candidate.number}</span><h1 class="mt-4 text-3xl font-bold tracking-tight">{candidate.name}</h1><p class="mt-1 text-lg font-semibold text-muted-foreground">{candidate.nickname}</p><p class="mt-2 text-sm text-muted-foreground">{candidate.komsat_path}</p><div class="mt-5 border-t border-border pt-5"><h2 class="text-sm font-semibold">Tentang kandidat</h2><p class="mt-2 whitespace-pre-wrap leading-7 text-muted-foreground">{candidate.description || "Deskripsi kandidat belum tersedia."}</p></div>{isOpen && <a href="/pilih-suara" class="mt-6 inline-flex min-h-11 items-center rounded-md bg-primary px-5 font-semibold text-primary-foreground hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-ring">Pilih Sekarang</a>}</div></div></article> : <section class="rounded-xl border border-border bg-card p-6 shadow-sm"><h1 class="text-2xl font-bold">Kandidat tidak ditemukan</h1><p class="mt-2 text-muted-foreground">Data kandidat yang diminta tidak tersedia.</p></section>}
</Base>
