---
import { IconArrowLeft, IconBoxMultiple } from "@tabler/icons-astro";
import { env } from "cloudflare:workers";
import Base from "../../layouts/Base.astro";
import { stage } from "../../server/lib/stage";
import { formatKomsatPath } from "../../lib/formatKomsat";
import { renderMarkdown } from "../../server/lib/markdown";
import { candidatePhotoSrc, PLACEHOLDER_CANDIDATE_PHOTO } from "../../lib/candidatePhoto";

const slug = Astro.params.slug ?? "";
const match = /^(\d+)-(.+)$/.exec(slug);
const db = (env as unknown as { DB?: D1Database }).DB;
const candidate = match
  ? await db?.prepare("SELECT number,name,nickname,komsat_path,description,color,photo_key FROM candidates WHERE number=? AND nickname=?")
      .bind(Number(match[1]), decodeURIComponent(match[2])).first<{
        number: number;
        name: string;
        nickname: string;
        komsat_path: string;
        description: string | null;
        color: string | null;
        photo_key: string | null;
      }>()
  : null;
const election = await db?.prepare("SELECT status_lock,opens_at,closes_at,closed_early_at FROM elections ORDER BY id LIMIT 1").first<any>();
let isOpen = false;
if (election?.opens_at && election?.closes_at) {
  try {
    isOpen = stage(election, new Date().toISOString()) === "open";
  } catch {
    isOpen = false;
  }
}
const content = candidate?.description?.trim() ? renderMarkdown(candidate.description) : "";
const photoSrc = candidatePhotoSrc(candidate?.photo_key);
---

<Base title={candidate ? `${candidate.nickname} · Kandidat` : "Kandidat tidak ditemukan"} canvas="white">
  <a href="/kandidat" class="mb-8 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-primary hover:underline focus-visible:outline-2 focus-visible:outline-ring">
    <IconArrowLeft size={18} stroke={1.8} aria-hidden="true" /> Semua Kandidat
  </a>

  {candidate ? <article>
    <div class="grid grid-cols-[6.5rem_minmax(0,1fr)] items-start gap-x-5 sm:grid-cols-[minmax(0,1fr)_12rem] sm:gap-x-8">
      <figure class="col-start-1 row-start-1 sm:col-start-2 sm:row-span-2">
        <img src={photoSrc} alt="" width="600" height="800" class="aspect-[3/4] w-full rounded-md bg-muted object-cover" />
        {photoSrc === PLACEHOLDER_CANDIDATE_PHOTO && <figcaption class="mt-2 text-xs leading-5 text-muted-foreground">Foto belum tersedia</figcaption>}
      </figure>
      <header class="col-start-2 row-start-1 min-w-0 sm:col-start-1">
        <span class="inline-flex size-8 items-center justify-center rounded-full text-sm font-bold text-white" style={`background-color:${candidate.color || "#334155"}`}><span class="sr-only">Nomor urut </span>{candidate.number}</span>
        <h1 class="mt-4 break-words text-3xl font-bold leading-tight tracking-tight sm:text-5xl">{candidate.name}</h1>
        <p class="mt-2 break-words text-lg font-medium text-muted-foreground sm:text-xl">{candidate.nickname}</p>
        <p class="mt-4 break-words text-sm text-muted-foreground">Komsat <span class="font-semibold text-foreground">{formatKomsatPath(candidate.komsat_path)}</span></p>
      </header>
      <section aria-labelledby="profile-heading" class="col-span-2 row-start-2 mt-8 border-t border-border pt-7 sm:col-span-1 sm:col-start-1 sm:mt-6 sm:pt-6">
        <h2 id="profile-heading" class="text-2xl font-bold tracking-tight">Tentang kandidat</h2>
        {content
          ? <div class="markdown mt-4 max-w-[70ch] text-base leading-8 text-foreground sm:text-lg sm:leading-9" set:html={content} />
          : <p class="mt-4 text-muted-foreground">Deskripsi kandidat belum tersedia.</p>}
      </section>
    </div>

    {isOpen && <footer class="mt-9 border-t border-border pt-6 sm:pt-8">
      <a href="/pilih-suara" class="inline-flex min-h-11 items-center gap-2 rounded-md bg-primary px-5 font-semibold text-primary-foreground hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-ring"><IconBoxMultiple size={19} stroke={1.8} aria-hidden="true" />Pilih Sekarang</a>
      <p class="mt-2 text-xs text-muted-foreground">Satu suara per anggota, dijaga kerahasiaannya.</p>
    </footer>}
  </article> : <section class="rounded-xl border border-border bg-card p-6 shadow-sm">
    <h1 class="text-2xl font-bold">Kandidat tidak ditemukan</h1>
    <p class="mt-2 text-muted-foreground">Data kandidat yang diminta tidak tersedia.</p>
  </section>}

  <script is:inline>
document.addEventListener('click',(event)=>{const facade=event.target instanceof Element?event.target.closest('.markdown-video-facade'):null;if(!facade)return;const id=facade.dataset.videoId;if(!id)return;const iframe=document.createElement('iframe');iframe.src=`https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;iframe.title='Video kandidat';iframe.allow='encrypted-media; picture-in-picture; fullscreen';iframe.setAttribute('referrerpolicy','strict-origin-when-cross-origin');iframe.setAttribute('sandbox','allow-scripts allow-popups');iframe.setAttribute('allowfullscreen','');facade.replaceWith(iframe)});
</script>
</Base>
