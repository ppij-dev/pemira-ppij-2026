---
import { env } from "cloudflare:workers";
import Base from "../../layouts/Base.astro";
import { stage } from "../../server/lib/stage";
const slug=Astro.params.slug??'';const match=/^(\d+)-(.+)$/.exec(slug);const db=(env as unknown as {DB?:D1Database}).DB;
const candidate=match?await db?.prepare('SELECT number,name,nickname,komsat_path,description,color FROM candidates WHERE number=? AND nickname=?').bind(Number(match[1]),decodeURIComponent(match[2])).first<any>():null;
const e=await db?.prepare('SELECT status_lock,opens_at,closes_at,closed_early_at FROM elections ORDER BY id LIMIT 1').first<any>();
let isOpen=false;if(e?.opens_at&&e?.closes_at){try{isOpen=stage(e,new Date().toISOString())==='open'}catch{isOpen=false}}
---
<Base title={candidate?`${candidate.nickname} · Kandidat`:"Kandidat tidak ditemukan"}>{candidate?<article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"><div class="grid md:grid-cols-2"><img src="/placeholder-candidate.png" alt="Ilustrasi kandidat" class="h-full max-h-[32rem] w-full object-cover"/><div class="p-6 sm:p-9"><span class="inline-flex size-12 items-center justify-center rounded-full text-lg font-bold text-white" style={`background-color:${candidate.color||'#334155'}`}>{candidate.number}</span><h1 class="mt-4 text-3xl font-bold">{candidate.name}</h1><p class="mt-1 text-lg text-slate-600">{candidate.nickname}</p><p class="mt-2 text-sm text-slate-500">{candidate.komsat_path}</p><p class="mt-6 whitespace-pre-wrap leading-7">{candidate.description}</p>{isOpen&&<a href="/pilih-suara" class="mt-8 inline-flex min-h-12 items-center rounded-lg bg-blue-800 px-5 font-semibold text-white">Pilih Sekarang</a>}</div></div></article>:<section class="rounded-2xl border bg-white p-8"><h1 class="text-2xl font-bold">Kandidat tidak ditemukan</h1><p class="mt-2 text-slate-600">Data kandidat yang diminta tidak tersedia.</p></section>}</Base>
