---
import { env } from "cloudflare:workers";
import { IconId, IconLogout, IconRosetteDiscountCheck, IconShieldCheck, IconSpeakerphone, IconUserCircle } from "@tabler/icons-astro";
import Base from "../layouts/Base.astro";
import Button from "../components/ui/Button.astro";
import Callout from "../components/ui/Callout.astro";
import FactList from "../components/ui/FactList.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import PanelCard from "../components/ui/PanelCard.astro";
import { AUTH_STAGE_COOKIE, AUTH_STAGE_PATH, SESSION_COOKIE, openAuthStage, openSession, type SessionData } from "../server/auth/session";
import { classifyRecovery, recoveryCopy, helpCode } from "../server/auth/recovery";
import { isAdminPageAuthorized, type AdminBindings } from "./admin/admin-auth";
import { getVoteMe } from "../server/voting/vote";
import { stage as getStage, type Stage } from "../server/lib/stage";
import { unitPathLabel, type UnitNames } from "../lib/formatKomsat";
import { memberCategoryLabel } from "../lib/memberCategory";
import { loadUnitNames } from "../server/lib/units";
import type { Bindings } from "../server/app";

const bindings = env as unknown as Bindings;
const raw = Astro.request.headers.get("cookie") ?? Astro.cookies.get(SESSION_COOKIE)?.value;
const session: SessionData | null = raw && bindings.APP_MASTER_KEY ? await openSession(raw, bindings.APP_MASTER_KEY) : null;

// Pemulihan masuk (recover-login-session): satu kartu dengan satu aksi coba
// lagi, diklasifikasi dari cookie tahap server — bukan dari parameter URL.
const authStage = bindings.APP_MASTER_KEY ? await openAuthStage(Astro.cookies.get(AUTH_STAGE_COOKIE)?.value, bindings.APP_MASTER_KEY) : null;
const recovery = session ? null : classifyRecovery(authStage);
const recoveryInfo = recovery ? recoveryCopy(recovery) : null;
const stageReturnTo = authStage && authStage.returnTo.startsWith("/") ? authStage.returnTo : "/akun";
const retryHref = `/api/auth/login?prompt=login&return_to=${encodeURIComponent(stageReturnTo)}`;
const helpCodeValue = recovery && authStage && bindings.APP_MASTER_KEY
  ? await helpCode(authStage.category, bindings.APP_MASTER_KEY, Math.floor(Date.now() / 1000))
  : null;
if (session && authStage) Astro.cookies.delete(AUTH_STAGE_COOKIE, { path: AUTH_STAGE_PATH });
Astro.response.headers.set("Cache-Control", "no-store");

let isAdmin = false;
let votedAt: string | null = null;
let currentStage: Stage | null = null;
let rollName: string | null = null;
let memberNumber: string | null = null;
let memberCategory: string | null = null;
let unitNames: UnitNames = {};
if (session) {
  const adminBindings = bindings as unknown as AdminBindings;
  isAdmin = await isAdminPageAuthorized(raw ?? undefined, adminBindings);
  try {
    const voter = await bindings.DB.prepare("SELECT name, member_number, category FROM voters WHERE member_id = ?").bind(session.member_id).first<{ name: string; member_number: string | null; category: string | null }>();
    rollName = voter?.name ?? null;
    memberNumber = voter?.member_number ?? null;
    memberCategory = voter?.category ?? null;
  } catch { rollName = null; }
  try { unitNames = await loadUnitNames(bindings.DB); } catch { unitNames = {}; }
  try { votedAt = (await getVoteMe(bindings.DB, session)).voted_at; } catch { votedAt = null; }
  try {
    const election = await bindings.DB.prepare("SELECT status_lock,opens_at,closes_at,closed_early_at FROM elections ORDER BY id LIMIT 1").first<any>();
    currentStage = election?.opens_at && election?.closes_at ? getStage(election, Date.now()) : "draft";
  } catch { currentStage = null; }
}

// Nama tampilan: utamakan nama resmi dari daftar pemilih (hasil sinkronisasi
// Service API); klaim nama One Login yang belum terisi berupa ID anggota.
const claimsLookLikeId = session ? session.name.trim() === session.member_id : false;
const displayName = rollName && rollName.trim() && rollName !== session?.member_id ? rollName : claimsLookLikeId ? null : session?.name ?? null;
const affiliationPath = Array.isArray(session?.affiliation) ? session!.affiliation[0] : session?.affiliation ?? null;
const formatJst = (value: string) => new Intl.DateTimeFormat("id-ID", { timeZone: "Asia/Tokyo", dateStyle: "long", timeStyle: "short" }).format(new Date(value)) + " JST";
const stageLabel = currentStage ? ({ draft: "Draf", scheduled: "Terjadwal", open: "Dibuka", closed: "Ditutup", published: "Diumumkan" } as const)[currentStage] : null;
const identityFacts = [
  ...(memberNumber ? [{ label: "Kartu anggota", value: memberNumber }] : []),
  { label: "Unit", value: affiliationPath ? unitPathLabel(affiliationPath, unitNames) : "Belum tersedia" },
  { label: "Kategori", value: memberCategory ? memberCategoryLabel(memberCategory) : "Belum ditentukan portal" },
  { label: "Keanggotaan", value: affiliationPath ? "Aktif" : "Tidak aktif" },
];
---

<Base title="Akun · PPIJ Pemilu">
  <PageHeader eyebrow="Akun" title="Akun" description="Sesi, status pemilihan, dan aksi akun Anda di situs ini." />

  <div class="mt-5 grid gap-4">
    {!session && recovery && recoveryInfo ? <PanelCard title={recoveryInfo.title} description="Masuk belum berhasil diselesaikan." icon={IconShieldCheck}>
      <Callout tone="warning" title="Masuk belum selesai">{recoveryInfo.body}</Callout>
      <Button href={retryHref} class="mt-4">{recoveryInfo.retryLabel}</Button>
      {recovery.kind === "session_unavailable" && <p class="mt-3 text-xs leading-5 text-brand-muted">Bila berulang, periksa apakah peramban memblokir cookie untuk situs ini, atau coba jendela penjelajahan pribadi.</p>}
      {helpCodeValue && <p class="mt-2 text-xs leading-5 text-brand-muted">Masih belum berhasil? Laporkan kode bantuan <strong class="font-mono text-brand-ink">{helpCodeValue}</strong> ke panitia pemilihan.</p>}
    </PanelCard>
    : !session ? <PanelCard title="Belum masuk" description="Masuk dengan PPIJ One Login untuk melihat status keanggotaan dan pemilihan Anda." icon={IconUserCircle}>
      <p class="text-sm leading-6 text-brand-muted">Situs ini hanya memakai data keanggotaan dari portal PPIJ; kata sandi Anda tidak pernah disimpan di sini.</p>
      <Button href="/api/auth/login?return_to=/akun" class="mt-4">Masuk</Button>
    </PanelCard>
    : <>
      <PanelCard title="Identitas" description="Data mengikuti portal keanggotaan PPIJ." icon={IconUserCircle}>
        <div class="flex items-center gap-3.5">
          <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-800" aria-hidden="true"><IconUserCircle size={30} stroke={1.6} /></span>
          <div class="min-w-0">
            {displayName ? <p class="break-words text-lg leading-tight font-bold text-brand-ink">{displayName}</p> : <p class="break-words text-lg leading-tight font-bold text-brand-muted">Nama belum tersedia dari portal</p>}
            <p class="mt-0.5 text-xs text-brand-muted">{memberNumber ? <>Kartu anggota <span class="font-mono text-brand-ink">{memberNumber}</span></> : "Nomor kartu belum tersedia dari portal"}</p>
          </div>
        </div>
        <div class="mt-4 border-t border-brand-border pt-1"><FactList items={identityFacts} variant="rows" /></div>
        <p class="mt-3 text-xs leading-5 text-brand-muted">Nama resmi mengikuti daftar pemilih hasil sinkronisasi portal. Perubahan data diri dilakukan di portal PPIJ, bukan di situs pemilihan ini.</p>
      </PanelCard>

      <PanelCard title="Status pemilihan" description={stageLabel ? `Tahap saat ini: ${stageLabel}.` : "Tahap pemilihan belum tersedia."} icon={IconSpeakerphone}>
        {votedAt
          ? <div class="grid gap-3">
              <Callout tone="success" title="Suara Anda sudah tercatat">Tercatat pada {formatJst(votedAt)}. Simpan kode bukti Anda untuk pemeriksaan mandiri.</Callout>
              <div><Button href="/surat-suara" variant="secondary"><IconRosetteDiscountCheck size={18} stroke={1.8} aria-hidden="true" />Buka Bukti Suara</Button></div>
            </div>
          : currentStage === "open"
            ? <div class="grid gap-3">
                <Callout tone="info" title="Anda belum menggunakan suara Anda">Pemungutan suara sedang dibuka. Satu suara per anggota, dan pilihan Anda rahasia.</Callout>
                <div><Button href="/pilih-suara"><IconSpeakerphone size={18} stroke={1.8} aria-hidden="true" />Pilih Sekarang</Button></div>
              </div>
            : <Callout tone="neutral" title="Belum ada suara tercatat">{currentStage === "scheduled" ? "Pemungutan suara belum dibuka. Jadwal tampil di beranda." : currentStage === "closed" || currentStage === "published" ? "Pemungutan suara telah ditutup." : "Pemilihan masih dalam persiapan."}</Callout>}
      </PanelCard>

      {isAdmin && <PanelCard title="Admin Voting" description="Anda terdaftar sebagai Admin Voting pemilihan ini." icon={IconShieldCheck}>
        <p class="text-sm leading-6 text-brand-muted">Panel Admin Voting memuat dasbor, daftar pemilih, kandidat, jadwal, dan audit. Setiap aksi panitia tercatat.</p>
        <Button href="/admin/dasbor" variant="secondary" class="mt-4"><IconShieldCheck size={18} stroke={1.8} aria-hidden="true" />Buka Admin</Button>
      </PanelCard>}

      <PanelCard title="Keluar" description="Mengakhiri sesi di perangkat ini. Anda dapat masuk kembali kapan saja." icon={IconId}>
        <p class="text-sm leading-6 text-brand-muted">Kode bukti yang tersimpan di peramban tetap ada setelah keluar, tetapi pilihan kandidat hanya tampil bila kode cocok dengan perangkat ini.</p>
        <Button id="logout" type="button" variant="secondary" class="mt-4 border-red-200 text-destructive hover:bg-red-50"><IconLogout size={18} stroke={1.8} aria-hidden="true" />Keluar</Button>
        <p id="logout-status" class="mt-2 text-sm text-brand-muted" role="status"></p>
      </PanelCard>
    </>}
  </div>

  <script is:inline>
const logout=document.querySelector('#logout'),status=document.querySelector('#logout-status');logout?.addEventListener('click',async()=>{if(!confirm('Keluar dari situs ini?'))return;status.textContent='Keluar…';try{await fetch('/api/auth/logout',{method:'POST'});location.assign('/')}catch{status.textContent='Keluar belum berhasil. Coba kembali.'}});
</script>
</Base>
