---
import { env } from "cloudflare:workers";
import { IconLogout, IconRosetteDiscountCheck, IconShieldCheck, IconSpeakerphone, IconUserCircle } from "@tabler/icons-astro";
import Base from "../layouts/Base.astro";
import { AUTH_STAGE_COOKIE, AUTH_STAGE_PATH, SESSION_COOKIE, openAuthStage, openSession, type SessionData } from "../server/auth/session";
import { classifyRecovery, recoveryCopy, helpCode } from "../server/auth/recovery";
import { isAdminPageAuthorized, type AdminBindings } from "./admin/admin-auth";
import { getVoteMe } from "../server/voting/vote";
import { stage as getStage, type Stage } from "../server/lib/stage";
import { formatUnitPath } from "../lib/formatKomsat";
import type { Bindings } from "../server/app";

const bindings = env as unknown as Bindings;
const raw = Astro.request.headers.get("cookie") ?? Astro.cookies.get(SESSION_COOKIE)?.value;
const session: SessionData | null = raw && bindings.APP_MASTER_KEY ? await openSession(raw, bindings.APP_MASTER_KEY) : null;

// Pemulihan masuk (recover-login-session): satu kartu dengan satu aksi coba
// lagi, diklasifikasi dari cookie tahap server — bukan dari parameter URL.
const authStage = bindings.APP_MASTER_KEY ? await openAuthStage(Astro.cookies.get(AUTH_STAGE_COOKIE)?.value, bindings.APP_MASTER_KEY) : null;
const recovery = session ? null : classifyRecovery(authStage);
const recoveryInfo = recovery ? recoveryCopy(recovery) : null;
const stageReturnTo = authStage && authStage.returnTo.startsWith("/") ? authStage.returnTo : "/akun";
const retryHref = `/api/auth/login?prompt=login&return_to=${encodeURIComponent(stageReturnTo)}`;
const helpCodeValue = recovery && authStage && bindings.APP_MASTER_KEY
  ? await helpCode(authStage.category, bindings.APP_MASTER_KEY, Math.floor(Date.now() / 1000))
  : null;
if (session && authStage) Astro.cookies.delete(AUTH_STAGE_COOKIE, { path: AUTH_STAGE_PATH });
Astro.response.headers.set("Cache-Control", "no-store");

let isAdmin = false;
let votedAt: string | null = null;
let currentStage: Stage | null = null;
let rollName: string | null = null;
let memberNumber: string | null = null;
if (session) {
  const adminBindings = bindings as unknown as AdminBindings;
  isAdmin = await isAdminPageAuthorized(raw ?? undefined, adminBindings);
  try {
    const voter = await bindings.DB.prepare("SELECT name, member_number FROM voters WHERE member_id = ?").bind(session.member_id).first<{ name: string; member_number: string | null }>();
    rollName = voter?.name ?? null;
    memberNumber = voter?.member_number ?? null;
  } catch { rollName = null; }
  try { votedAt = (await getVoteMe(bindings.DB, session)).voted_at; } catch { votedAt = null; }
  try {
    const election = await bindings.DB.prepare("SELECT status_lock,opens_at,closes_at,closed_early_at FROM elections ORDER BY id LIMIT 1").first<any>();
    currentStage = election?.opens_at && election?.closes_at ? getStage(election, Date.now()) : "draft";
  } catch { currentStage = null; }
}

// Nama tampilan: utamakan nama resmi dari daftar pemilih (hasil sinkronisasi
// Service API); klaim nama One Login yang belum terisi berupa ID anggota.
const claimsLookLikeId = session ? session.name.trim() === session.member_id : false;
const displayName = rollName && rollName.trim() && rollName !== session?.member_id ? rollName : claimsLookLikeId ? null : session?.name ?? null;
const affiliationPath = Array.isArray(session?.affiliation) ? session!.affiliation[0] : session?.affiliation ?? null;
const formatJst = (value: string) => new Intl.DateTimeFormat("id-ID", { timeZone: "Asia/Tokyo", dateStyle: "long", timeStyle: "short" }).format(new Date(value)) + " JST";
---

<Base title="Akun · PPIJ Pemilu">
  <div class="mb-6"><p class="text-sm font-semibold text-primary">AKUN</p><h1 class="mt-1 text-3xl font-bold tracking-tight">Akun</h1><p class="mt-2 text-muted-foreground">Sesi, status pemilihan, dan aksi akun Anda di situs ini.</p></div>

  {!session && recovery && recoveryInfo ? <section class="rounded-xl border border-amber-200 bg-amber-50 p-5 shadow-sm sm:p-6 text-amber-900" role="alert">
    <h2 class="text-xl font-semibold">{recoveryInfo.title}</h2>
    <p class="mt-2 text-sm leading-6">{recoveryInfo.body}</p>
    <a href={retryHref} class="mt-5 inline-flex min-h-11 items-center rounded-md bg-primary px-5 font-semibold text-primary-foreground hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-ring">{recoveryInfo.retryLabel}</a>
    {recovery.kind === "session_unavailable" && <p class="mt-4 text-xs leading-5 text-amber-900/80">Bila berulang, periksa apakah peramban memblokir cookie untuk situs ini, atau coba jendela penjelajahan pribadi.</p>}
    {helpCodeValue && <p class="mt-2 text-xs leading-5 text-amber-900/80">Masih belum berhasil? Laporkan kode bantuan <strong class="font-mono">{helpCodeValue}</strong> ke panitia pemilihan.</p>}
  </section>
  : !session ? <section class="rounded-xl border border-border bg-card p-5 shadow-sm sm:p-6">
    <h2 class="text-xl font-semibold">Belum masuk</h2>
    <p class="mt-2 text-muted-foreground">Masuk dengan PPIJ One Login untuk melihat status keanggotaan dan pemilihan Anda.</p>
    <a href="/api/auth/login?return_to=/akun" class="mt-5 inline-flex min-h-11 items-center rounded-md bg-primary px-5 font-semibold text-primary-foreground hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-ring">Masuk</a>
  </section> : <div class="grid gap-4">
    <section class="rounded-xl border border-border bg-card p-5 shadow-sm sm:p-6">
      <h2 class="text-lg font-semibold">Identitas</h2>
      <div class="mt-4 flex items-center gap-4">
        <span class="flex size-14 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-800" aria-hidden="true"><IconUserCircle size={34} stroke={1.5} /></span>
        <div class="min-w-0">
          {displayName ? <p class="break-words text-lg font-semibold">{displayName}</p> : <p class="break-words text-lg font-semibold text-muted-foreground">Nama belum tersedia dari portal</p>}
          {memberNumber && <p class="mt-0.5 text-xs font-semibold text-muted-foreground">Kartu anggota <span class="font-mono">{memberNumber}</span></p>}
          <p class="mt-0.5 break-all font-mono text-xs text-muted-foreground">{session.member_id}</p>
        </div>
      </div>
      <dl class="mt-5 space-y-3 border-t border-border pt-4 text-sm">
        <div class="flex flex-wrap items-center justify-between gap-2"><dt class="text-muted-foreground">Unit</dt><dd class="font-semibold">{affiliationPath ? formatUnitPath(affiliationPath) : "—"}</dd></div>
        <div class="flex flex-wrap items-center justify-between gap-2"><dt class="text-muted-foreground">Keanggotaan</dt><dd>{affiliationPath ? <span class="inline-flex rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-800">Aktif</span> : <span class="inline-flex rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-800">Tidak aktif</span>}</dd></div>
      </dl>
      <p class="mt-4 text-xs leading-5 text-muted-foreground">Data keanggotaan dikelola portal PPIJ; nama resmi mengikuti daftar pemilih hasil sinkronisasi. Perubahan data diri dilakukan di portal, bukan di situs pemilihan ini.</p>
    </section>

    <section class="rounded-xl border border-border bg-card p-5 shadow-sm sm:p-6">
      <h2 class="text-lg font-semibold">Status pemilihan</h2>
      {votedAt ? <div class="mt-3 flex flex-wrap items-center justify-between gap-3"><p class="flex items-center gap-2 text-sm"><IconRosetteDiscountCheck size={20} class="text-emerald-700" aria-hidden="true" />Anda sudah memilih pada {formatJst(votedAt)}.</p><a href="/surat-suara" class="inline-flex min-h-11 items-center rounded-md border border-border px-4 font-semibold hover:bg-accent focus-visible:outline-2 focus-visible:outline-ring">Buka Bukti Suara</a></div>
      : currentStage === "open" ? <div class="mt-3 flex flex-wrap items-center justify-between gap-3"><p class="text-sm text-muted-foreground">Anda belum menggunakan suara Anda.</p><a href="/pilih-suara" class="inline-flex min-h-11 items-center gap-2 rounded-md bg-primary px-4 font-semibold text-primary-foreground hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-ring"><IconSpeakerphone size={18} aria-hidden="true" />Pilih Sekarang</a></div>
      : <p class="mt-3 text-sm text-muted-foreground">{currentStage === "scheduled" ? "Pemungutan suara belum dibuka." : currentStage === "closed" || currentStage === "published" ? "Pemungutan suara telah ditutup." : "Pemilihan masih dalam persiapan."}</p>}
    </section>

    {isAdmin && <section class="rounded-xl border border-border bg-card p-5 shadow-sm sm:p-6">
      <h2 class="text-lg font-semibold">Admin Voting</h2>
      <p class="mt-2 text-sm text-muted-foreground">Anda terdaftar sebagai Admin Voting pemilihan ini.</p>
      <a href="/admin/dasbor" class="mt-4 inline-flex min-h-11 items-center gap-2 rounded-md border border-border px-4 font-semibold hover:bg-accent focus-visible:outline-2 focus-visible:outline-ring"><IconShieldCheck size={18} aria-hidden="true" />Buka Admin</a>
    </section>}

    <section class="rounded-xl border border-border bg-card p-5 shadow-sm sm:p-6">
      <h2 class="text-lg font-semibold">Keluar</h2>
      <p class="mt-2 text-sm text-muted-foreground">Mengakhiri sesi di perangkat ini. Anda dapat masuk kembali kapan saja.</p>
      <button id="logout" type="button" class="mt-4 inline-flex min-h-11 items-center gap-2 rounded-md border border-red-200 px-4 font-semibold text-destructive hover:bg-red-50 focus-visible:outline-2 focus-visible:outline-ring"><IconLogout size={18} aria-hidden="true" />Keluar</button>
      <p id="logout-status" class="mt-2 text-sm text-muted-foreground" role="status"></p>
    </section>
  </div>}

  <script is:inline>
const logout=document.querySelector('#logout'),status=document.querySelector('#logout-status');logout?.addEventListener('click',async()=>{if(!confirm('Keluar dari situs ini?'))return;status.textContent='Keluar…';try{await fetch('/api/auth/logout',{method:'POST'});location.assign('/')}catch{status.textContent='Keluar belum berhasil. Coba kembali.'}});
</script>
</Base>
